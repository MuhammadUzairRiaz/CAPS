COS(=O)(=O)OC dimethyl_sulfate
CS(=O)(=O)[O-] methanesulfonate
CC(=O)[O-] acetate
C[NH3+] methylammonium
CC(=O)OC(C)=O acetic_anhydride
O=C=NCCN=C=O ethylene_diisocyanate
CN=C=NC dimethylcarbodiimide
c1ccc2c(c1)[nH]c1ccccc12 carbazole
c1ccc2c(c1)oc1ccccc12 dibenzofuran
c1ccc2c(c1)sc1ccccc12 dibenzothiophene
