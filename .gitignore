# build products
build/
build-*/
dist/
studio/**/bin/
studio/**/obj/
# run outputs (regenerated by the benches and examples)
out/
bench/pack/*.pdb
!bench/pack/water.pdb
!bench/pack/ps8.pdb
bench/pack/*.pdb_FORCED
bench/pack/*.inp
bench/pack/*.log
# editors and OS
.DS_Store
*.user
.vscode/
.idea/
__pycache__/
*.pyc
packaging/icon/caps.iconset/

# force-field libraries built on the user's machine from their original sources (bench/ff/open): never committed
data/forcefields/*-toppar.json
# CAPS's own typing rules for those libraries (cgenff-toppar: bench/typing/make_cgenff_rules.py): tracked
!/data/typing/*-toppar.typing.json
!/data/typing/*-ambertools.typing.json
!/data/typing/cvff-frc-*.typing.json
# AmberTools' public-domain parameter files: the GAFF libraries built from them are tracked; a local GLYCAM build (removed
# from CAPS 2026-10-14, biomolecular) carries its own copyright notice and stays ignored
data/forcefields/glycam*-ambertools.json
