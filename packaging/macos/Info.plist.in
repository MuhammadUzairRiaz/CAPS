<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>CAPS Studio</string>
  <key>CFBundleDisplayName</key><string>CAPS Studio</string>
  <key>CFBundleIdentifier</key><string>io.github.muhammaduzairriaz.caps</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>CapsStudio</string>
  <key>CFBundleIconFile</key><string>caps.icns</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.education</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSHumanReadableCopyright</key><string>Copyright © 2026 Muhammad Uzair Riaz · BSD-3-Clause</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>CAPS project</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeIconFile</key><string>caps.icns</string>
      <key>LSItemContentTypes</key><array><string>io.github.muhammaduzairriaz.caps.project</string></array>
      <key>CFBundleTypeExtensions</key><array><string>capsproj</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Molecular structure or trajectory</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>data</string><string>lammpstrj</string><string>dump</string><string>pdb</string><string>xyz</string><string>gro</string><string>mol2</string></array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.muhammaduzairriaz.caps.project</string>
      <key>UTTypeDescription</key><string>CAPS project</string>
      <key>UTTypeIconFile</key><string>caps.icns</string>
      <key>UTTypeConformsTo</key><array><string>public.json</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>capsproj</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
