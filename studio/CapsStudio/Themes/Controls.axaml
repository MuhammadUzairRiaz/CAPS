<!-- CAPS component styles: the design system's components (design/generator/lib.py: btn, tbtn, seg, field, select,
     check, toggle, chip, tabs, section, panel_head, rail, statusbar) as Avalonia styles. Colours come from
     Themes/Tokens.axaml (DynamicResource, so Graphite and Paper both work). -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:CapsStudio.Views">
  <Styles.Resources>
    <!-- Fluent resources retuned to the tokens (controls not styled below) -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource AccHoverC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource AccHoverC}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource DimC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource MutedC}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AccHoverC}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource AccInkC}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource Bg3}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource Bg3}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource MutedC}" />
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{DynamicResource TextC}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource MutedC}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{DynamicResource TextC}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{DynamicResource AccC}" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource Bg3}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource SelC}" />
    <Thickness x:Key="TextControlThemePadding">8,5,8,5</Thickness>
    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  </Styles.Resources>

  <!-- ground and type -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sans}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.display"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="LetterSpacing" Value="0.88" />
  </Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
  <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{DynamicResource DimB}" /><Setter Property="FontSize" Value="11.5" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="FontSize" Value="11.5" /></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{DynamicResource Mono}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarnB}" /></Style>
  <Style Selector="TextBlock.err"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
  <Style Selector="TextBlock.acc"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="TextBlock.sel"><Setter Property="Foreground" Value="{DynamicResource SelB}" /></Style>

  <!-- buttons: btn (36, raised), .small (30), .primary (amber), .ghost (outline), .tool (tbtn 36 × 36), .link -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource DimB}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccInkB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccHoverB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccHoverB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccInkB}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccInkB}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccB}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccHoverB}" />
  </Style>
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <!-- an armed destructive tool (Delete asked once): red until clicked again or it times out -->
  <Style Selector="Button.tool.danger, Button.small.danger">
    <Setter Property="Foreground" Value="{DynamicResource ErrB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrB}" />
  </Style>
  <Style Selector="Button.tool.on, ToggleButton.tool:checked">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- module rail: 60 × 52, icon 19 + label 10.5; active: raised, amber icon and a 3 px bar on the left -->
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="52" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DimB}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.rail v|Icon"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="Button.rail.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="Button.rail.on v|Icon"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="Button.rail:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.rail Border.bar"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Button.rail.on Border.bar"><Setter Property="IsVisible" Value="True" /></Style>

  <!-- module bar across the top: icon + label, the active one raised with an amber underline; a pip for a step done -->
  <Style Selector="Button.modtab">
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.modtab v|Icon"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
  <Style Selector="Button.modtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="Button.modtab.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.modtab.on v|Icon"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="Button.modtab Border.bar"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Button.modtab.on Border.bar"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Button.modtab:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="Ellipse.pip"><Setter Property="Width" Value="6" /><Setter Property="Height" Value="6" /><Setter Property="Fill" Value="{DynamicResource OkB}" /></Style>
  <Style Selector="Ellipse.pip.warn"><Setter Property="Fill" Value="{DynamicResource WarnB}" /></Style>

  <!-- document tabs in the top bar -->
  <!-- project explorer rows: one per structure, the active one filled -->
  <Style Selector="Button.projrow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.projrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
  </Style>
  <Style Selector="Button.projrow.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
  </Style>
  <Style Selector="Button.doctab">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="7,7,0,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Button.doctab.on">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="Button.doctab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
  </Style>

  <!-- inputs: field / select (Bg0, 1 px line, radius 5, 30–32 px), focus in amber -->
  <Style Selector="TextBox, NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DimB}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <!-- a text box drawn by its container (the Start board's quick-start box) -->
  <Style Selector="TextBox.bare"><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.mono, NumericUpDown">
    <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DimB}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="ComboBoxItem"><Setter Property="FontSize" Value="12.5" /></Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
  <Style Selector="CheckBox"><Setter Property="FontSize" Value="12.5" /><Setter Property="MinHeight" Value="24" /></Style>
  <Style Selector="RadioButton"><Setter Property="FontSize" Value="12.5" /></Style>

  <!-- segmented control (seg): a Border.seg holding RadioButton.seg; selected: raised with an amber outline -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Height="28" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="RadioButton.seg:checked"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
  </Style>

  <!-- tiles: a choice drawn as an icon over a word (styles, builder kinds); the chosen one outlined in amber -->
  <Style Selector="RadioButton.tile">
    <Setter Property="Height" Value="58" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="B" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
  </Style>
  <Style Selector="RadioButton.tile:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="RadioButton.tile:checked /template/ Border#B"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
  <Style Selector="RadioButton.tile:checked"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="RadioButton.tile:disabled"><Setter Property="Opacity" Value="0.45" /></Style>

  <!-- periodic-table cells (Element picker): common elements bright, the chosen one amber -->
  <Style Selector="Button.pt"><Setter Property="Background" Value="{DynamicResource Bg0B}" /><Setter Property="BorderBrush" Value="{DynamicResource Bg2B}" /><Setter Property="Foreground" Value="{DynamicResource DimB}" /><Setter Property="ClipToBounds" Value="True" /></Style>
  <Style Selector="Button.pt.common"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
  <Style Selector="Button.pt.chosen"><Setter Property="Background" Value="{DynamicResource AccB}" /><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /></Style>

  <Style Selector="Border.dyad.meso"><Setter Property="Background" Value="{DynamicResource AccB}" /></Style>

  <Style Selector="v|Icon.lvl.err"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
  <Style Selector="v|Icon.lvl.warn"><Setter Property="Foreground" Value="{DynamicResource WarnB}" /></Style>
  <Style Selector="v|Icon.lvl.ok"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
  <Style Selector="Border.chip.err"><Setter Property="Background" Value="{DynamicResource ErrBgB}" /></Style>

  <!-- chips: 22 px pills; ToggleButton.chip is a calculation you switch on (amber when on) -->
  <!-- the selection bar (design/boards/SelectionBar) -->
  <Style Selector="Border.selbar">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="12,0,4,0" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SelB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
  </Style>
  <Style Selector="Button.selact">
    <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.selact:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
  <Style Selector="Button.selact:pointerover"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="Button.chipbtn">
    <Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="11" /><Setter Property="Background" Value="{DynamicResource HudB}" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11.5" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chipbtn:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.chip TextBlock"><Setter Property="FontSize" Value="11.5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource WarnBgB}" /></Style>
  <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnB}" /></Style>
  <Style Selector="Border.chip.acc"><Setter Property="Background" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="Border.chip.acc TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /></Style>
  <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{DynamicResource OkBgB}" /></Style>
  <Style Selector="Border.chip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
  <Style Selector="Border.chip.err"><Setter Property="Background" Value="{DynamicResource ErrBgB}" /></Style>
  <Style Selector="Border.chip.err TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
  <!-- Start board tiles: builders and recent work -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource Bg1B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DimB}" />
  </Style>
  <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg1B}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.tile.thumb"><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bg2B}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bg2B}" />
  </Style>
  <Style Selector="TabStrip.small TabStripItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Visualize pipeline rows and data-inspector rows -->
  <Style Selector="Button.pipestep">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.pipestep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
  </Style>
  <Style Selector="Button.pipestep.sel /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="Border.trow">
    <Setter Property="BorderBrush" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.trow.hl">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
    <Setter Property="Foreground" Value="{DynamicResource AccInkB}" />
  </Style>
  <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource DimB}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- panels, sections, cards, headers -->
  <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Bg1B}" /></Style>
  <Style Selector="Border.section">
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Bg1B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,9" />
  </Style>
  <Style Selector="Border.phead">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.hud">
    <Setter Property="Background" Value="{DynamicResource HudB}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Rectangle.vsep"><Setter Property="Width" Value="1" /><Setter Property="Height" Value="24" /><Setter Property="Fill" Value="{DynamicResource LineB}" /><Setter Property="Margin" Value="6,0" /></Style>

  <!-- toggle (lib.py toggle): label on the left, a 30 × 18 switch on the right, amber when on -->
  <Style Selector="CheckBox.toggle">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Background="Transparent" MinHeight="24">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{DynamicResource TextB}" />
          <Border Name="track" Grid.Column="1" Width="30" Height="18" CornerRadius="9" Background="{DynamicResource Bg3B}" VerticalAlignment="Center">
            <Border Name="knob" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource MutedB}" HorizontalAlignment="Left" Margin="2,0" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.toggle:checked /template/ Border#track"><Setter Property="Background" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="CheckBox.toggle:checked /template/ Border#knob">
    <Setter Property="Background" Value="{DynamicResource AccInkB}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="CheckBox.toggle:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>

  <!-- option cards (radio cards on the boards): raised when chosen, amber outline -->
  <Style Selector="Border.choice">
    <Setter Property="Background" Value="{DynamicResource Bg0B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.choice.on">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="Border.choice:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <!-- clickable option card: a radio button drawn as the boards' radio card -->
  <Style Selector="RadioButton.choice">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="8" Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Name="mark" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource DimB}" VerticalAlignment="Center">
              <Ellipse Name="dot" Width="8" Height="8" Fill="Transparent" />
            </Border>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.choice:pointerover /template/ Border#bd"><Setter Property="BorderBrush" Value="{DynamicResource DimB}" /></Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#mark"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="RadioButton.choice:checked /template/ Ellipse#dot"><Setter Property="Fill" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="RadioButton.choice:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="Border.radio">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource DimB}" />
  </Style>
  <Style Selector="Border.radio Ellipse"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="Fill" Value="Transparent" /></Style>
  <Style Selector="Border.radio.on"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
  <Style Selector="Border.radio.on Ellipse"><Setter Property="Fill" Value="{DynamicResource AccB}" /></Style>

  <!-- tabs: 38 px, underline in amber -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- scroll bars, tooltips, progress -->
  <!-- a selected list row: a raised surface with an accent bar, its text as readable as the rest (not ink on accent) -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccB}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
  </Style>
  <!-- a disabled button still says what it is (why it is off is often the question) -->
  <Style Selector="Button"><Setter Property="ToolTip.ShowOnDisabled" Value="True" /></Style>
  <Style Selector="ToggleButton"><Setter Property="ToolTip.ShowOnDisabled" Value="True" /></Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="Foreground" Value="{DynamicResource TextB}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccB}" />
    <Setter Property="Background" Value="{DynamicResource Bg3B}" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- Tool shelves (design/boards/Shelves): flat in a toolbar row, a capsule when floating, popped out or peeking -->
  <Style Selector="Border.shelf"><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="Border.shelf.floating">
    <Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" /><Setter Property="BoxShadow" Value="0 12 32 0 #70000000" />
  </Style>
  <Style Selector="Border.shelf.vertical"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="4" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
  <Style Selector="Button.shelftab">
    <Setter Property="Width" Value="14" /><Setter Property="MinWidth" Value="14" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="CornerRadius" Value="7" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="Foreground" Value="{DynamicResource DimB}" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="SizeAll" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.shelftab:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccB}" /><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /></Style>
  <Style Selector="Border.shelf.floating Button.shelftab"><Setter Property="Width" Value="22" /><Setter Property="MinWidth" Value="22" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="14,4,4,14" /><Setter Property="Background" Value="{DynamicResource AccB}" /><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /><Setter Property="Margin" Value="0,0,4,0" /></Style>
  <Style Selector="Border.shelf.vertical Button.shelftab"><Setter Property="Width" Value="34" /><Setter Property="MinWidth" Value="34" /><Setter Property="Height" Value="16" /><Setter Property="MinHeight" Value="16" />
    <Setter Property="Margin" Value="0,0,0,4" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="Border.shelf.vertical Rectangle.vsep"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="1" /><Setter Property="Margin" Value="0,4" /></Style>
  <Style Selector="Border.shelf.vertical TextBlock.shelflabel"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.shelf.vertical TextBlock.h3"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.shelf .compact TextBlock.dim"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.shelf .compact TextBlock.lbl"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Button.puck">
    <Setter Property="Width" Value="34" /><Setter Property="MinWidth" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="17" /><Setter Property="Margin" Value="4" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource AccB}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.puckbadge"><Setter Property="MinWidth" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Border.puckbadge TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.shelfguide"><Setter Property="Background" Value="{DynamicResource AccB}" /><Setter Property="CornerRadius" Value="2" /><Setter Property="BoxShadow" Value="0 0 14 0 #C0F0A83C" /></Style>
  <Style Selector="Border.dropzone"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="58" /></Style>
  <!-- the workspace switch in the top bar -->
  <Style Selector="Border.wsswitch"><Setter Property="Background" Value="{DynamicResource Bg0B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" /><Setter Property="Padding" Value="2" /></Style>
  <Style Selector="Button.ws"><Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="10,0" /><Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
  <Style Selector="Button.ws.on"><Setter Property="Background" Value="{DynamicResource AccB}" /><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.ws.on:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccHoverB}" /><Setter Property="Foreground" Value="{DynamicResource AccInkB}" /></Style>
</Styles>
