<!-- CAPS Dynamics (design/boards/Dynamics.dc.html): ensemble and integrator, interactions; pre-flight, run, export. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.DynamicsPage" x:DataType="vm:MainViewModel">
  <p:PageBase.Resources>
    <v:IntEqualsConverter x:Key="Eq" />
  </p:PageBase.Resources>
  <Grid RowDefinitions="Auto,*" Margin="22,16,22,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Dynamics · CAPS Dynamics" Classes="title" />
        <TextBlock Classes="muted"><Run Text="Molecular dynamics in CAPS, or a matching input deck for LAMMPS · " /><Run Text="{Binding ForceFieldLine}" /></TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnSaveTrajectory" IsVisible="{Binding HasFrames}" IsEnabled="{Binding Idle}" ToolTip.Tip="Save every frame as a LAMMPS dump">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save trajectory…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="primary" Click="OnRun" IsEnabled="{Binding CanRun}" IsVisible="{Binding !MdRunning}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="16" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding MdRunning}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="stop" Size="16" VerticalAlignment="Center" /><TextBlock Text="Stop" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
      <ScrollViewer>
        <StackPanel Spacing="16" IsEnabled="{Binding !MdRunning}">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Ensemble &amp; integrator" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="12">
                <Border Classes="seg">
                  <UniformGrid Columns="4">
                    <RadioButton Classes="seg" GroupName="ens" Content="NVE" IsChecked="{Binding MdEnsemble, Converter={StaticResource Eq}, ConverterParameter=0}" />
                    <RadioButton Classes="seg" GroupName="ens" Content="NVT" IsChecked="{Binding MdEnsemble, Converter={StaticResource Eq}, ConverterParameter=1}" />
                    <RadioButton Classes="seg" GroupName="ens" Content="NPT" IsChecked="{Binding MdEnsemble, Converter={StaticResource Eq}, ConverterParameter=2}" />
                    <RadioButton Classes="seg" GroupName="ens" Content="NPH" IsChecked="{Binding MdEnsemble, Converter={StaticResource Eq}, ConverterParameter=3}"
                                 ToolTip.Tip="Constant pressure and enthalpy: the Berendsen barostat, no thermostat" />
                  </UniformGrid>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="Integrator" Classes="label" /><TextBlock Grid.Column="1" Text="Multiple time step" Classes="label" /><TextBlock Grid.Column="2" Text="Δt (fs)" Classes="label" />
                  <ComboBox Grid.Row="1" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Velocity Verlet" /></ComboBox>
                  <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" IsEnabled="False" ToolTip.Tip="r-RESPA: coming" ToolTip.ShowOnDisabled="True"><ComboBoxItem Content="r-RESPA · off" /></ComboBox>
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding MdDtD}" Minimum="0.1" Maximum="5" Increment="0.25" FormatString="0.##" />
                </Grid>
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding MdHasThermostat}">
                  <TextBlock Text="Thermostat" Classes="label" /><TextBlock Grid.Column="1" Text="T (K)" Classes="label" /><TextBlock Grid.Column="2" Text="τ_T (fs)" Classes="label" />
                  <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:MainViewModel.Thermostats}" SelectedIndex="{Binding MdThermostat}" HorizontalAlignment="Stretch" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MdTempD}" Minimum="1" Maximum="5000" Increment="10" FormatString="0.#" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding MdTauTD}" Minimum="1" Increment="10" FormatString="0" />
                </Grid>
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding MdHasBarostat}">
                  <TextBlock Text="Barostat" Classes="label" /><TextBlock Grid.Column="1" Text="P (atm)" Classes="label" /><TextBlock Grid.Column="2" Text="τ_P (fs)" Classes="label" />
                  <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:MainViewModel.Barostats}" SelectedIndex="{Binding MdBarostat}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding MdCanChooseBarostat}" ToolTip.Tip="NPH uses the Berendsen barostat: stochastic cell rescaling needs a thermostat" ToolTip.ShowOnDisabled="True" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MdPressureD}" Increment="1" FormatString="0.##" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding MdTauPD}" Minimum="10" Increment="100" FormatString="0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:Icon Kind="link" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding MdCitation}" Classes="dim" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Interactions" Classes="h2" VerticalAlignment="Center" /></Border>
              <Grid Margin="16,12,16,16" ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Text="Electrostatics" Classes="label" /><TextBlock Grid.Column="1" Text="r_c (Å)" Classes="label" /><TextBlock Grid.Column="2" Text="{Binding ElecParamLabel}" Classes="label" />
                <ComboBox Grid.Row="1" SelectedIndex="{Binding SetElectrostatics}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="The same choice as Settings › Force fields and Dynamics › Electrostatics: it applies to Relax, Dynamics, Equilibrate and Analyze">
                  <ComboBoxItem Content="Damped shifted force" /><ComboBoxItem Content="Particle-mesh Ewald" />
                </ComboBox>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RelaxCutoffD}" Minimum="4" Maximum="30" Increment="0.5" FormatString="0.0" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElecParamText, Mode=OneWay}" IsReadOnly="True" Classes="mono" />
                <TextBlock Grid.Row="2" Text="van der Waals" Classes="label" Margin="0,8,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Mixing" Classes="label" Margin="0,8,0,0" /><TextBlock Grid.Row="2" Grid.Column="2" Text="Precision" Classes="label" Margin="0,8,0,0" />
                <TextBox Grid.Row="3" Text="Cut-off + tail correction" IsReadOnly="True" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="Force-field default" IsReadOnly="True" />
                <TextBox Grid.Row="3" Grid.Column="2" Text="Double" IsReadOnly="True" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Report" Classes="h2" VerticalAlignment="Center" /></Border>
              <TextBlock Margin="16,12,16,16" Text="{Binding MdLog}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding MdPreflightSummary}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="Pre-flight" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <ItemsControl Margin="16,10,16,14" ItemsSource="{Binding MdPreflight}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" Margin="0,4">
                      <v:Icon Kind="{Binding Icon}" Size="15" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding State}" Classes="mono" FontSize="11.5" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding MdEstimate}" Classes="dim" VerticalAlignment="Center" />
                  <TextBlock Text="Run" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="12">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding !MdRunning}">
                  <TextBlock Text="Steps" Classes="label" /><TextBlock Grid.Column="1" Text="Frame every (steps)" Classes="label" /><TextBlock Grid.Column="2" Text="Run on" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding MdStepsD}" Minimum="0" Increment="1000" FormatString="0" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MdFrameEveryD}" Minimum="1" Increment="100" FormatString="0" />
                  <ComboBox Grid.Row="1" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="{Binding ComputeText}" /></ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,70" ColumnSpacing="10" IsEnabled="{Binding !MdRunning}">
                  <CheckBox Classes="toggle" Content="Hold a molecule in place" IsChecked="{Binding HoldOn}" ToolTip.Tip="No force, no velocity, not in the temperature (an interface's surface is molecule 1)" />
                  <TextBlock Grid.Column="1" Text="molecule" Classes="dim" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="2" Value="{Binding HoldPick}" Minimum="1" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding !MdRunning}">
                  <CheckBox Classes="toggle" Content="Draw new velocities" IsChecked="{Binding MdNewVelocities}" />
                  <NumericUpDown Grid.Column="1" Width="110" Value="{Binding MdSeedD}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Seed" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Height="150">
                  <v:LinePlot x:Name="TPlot" AutoRange="True" XLabel="time (ps)" YLabel="T (K)" />
                  <v:LinePlot Grid.Column="1" x:Name="RhoPlot" AutoRange="True" XLabel="time (ps)" YLabel="density (g/cm³)" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip" ToolTip.Tip="Energies and forces of the data file match CAPS in LAMMPS (bench/ff/check_data_lammps.py)">
                    <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" VerticalAlignment="Center" /><TextBlock Text="step-0 parity validated" Foreground="{DynamicResource MutedB}" /></StackPanel>
                  </Border>
                  <TextBlock Text="Export to other engines" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <Border Classes="seg" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="seg" GroupName="eng" Content="LAMMPS" IsChecked="True" />
                    <RadioButton Classes="seg" GroupName="eng" Content="GROMACS" IsEnabled="False" ToolTip.Tip="coming" ToolTip.ShowOnDisabled="True" />
                  </StackPanel>
                </Border>
                <Border Classes="inset" Padding="12,10">
                  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding MdDeck}" FontFamily="{DynamicResource Mono}" FontSize="11.5" Foreground="{DynamicResource TextB}" />
                  </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="small" Click="OnSaveDeck" IsEnabled="{Binding HasDocument}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Save input deck…" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="small" Click="OnCopyDeck" IsEnabled="{Binding HasDocument}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="copy" Size="14" VerticalAlignment="Center" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</p:PageBase>
