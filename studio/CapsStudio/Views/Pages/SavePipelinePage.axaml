<!-- CAPS Save pipeline (design/boards/SavePipeline): plain text to diff, review and version; results record its hash. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.SavePipelinePage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Cancel" Click="OnBack" />
          <Button Classes="primary" Click="OnSave">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="14" VerticalAlignment="Center" /><TextBlock Text="Save…" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Save pipeline" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Plain text you can diff, review and version; results record its hash" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,360" ColumnSpacing="16" Margin="22,16">
      <Border Classes="card" CornerRadius="10">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center" ToolTip.Tip="{Binding PipelineYamlHash}">
                <TextBlock Classes="mono" Foreground="{DynamicResource MutedB}"><Run Text="sha256 " /><Run Text="{Binding PipelineYamlShort}" /></TextBlock>
              </Border>
              <TextBlock Text="{Binding PipelineFileName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"><SelectableTextBlock Text="{Binding PipelineYaml}" FontFamily="{DynamicResource Mono}" FontSize="12" LineHeight="19" Margin="16,10" /></ScrollViewer>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1"><StackPanel Spacing="14">
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <TextBlock Text="Steps in this pipeline" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding PipelineStepsText}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="16,10" />
          </StackPanel>
        </Border>
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,12" Spacing="10">
              <StackPanel Spacing="4"><TextBlock Text="Name" Classes="label" /><TextBox Text="{Binding PipelineName}" /></StackPanel>
              <CheckBox Classes="toggle" Content="Record the source file" IsChecked="{Binding PipelineWithSource}" />
              <StackPanel Spacing="4"><TextBlock Text="Scope" Classes="label" />
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.PipelineScopes}" SelectedIndex="{Binding PipelineScope}" IsEnabled="{Binding HasCapsProject}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding PipelineScopeNote}" Classes="mono dim" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
              <CheckBox Classes="toggle" Content="Store with every result it makes" IsChecked="{Binding PipelineStoreWithResults}"
                        ToolTip.Tip="Writing the outputs also writes this pipeline's YAML beside them" />
              <CheckBox Classes="toggle" Content="Ask before running a Python file" IsChecked="{Binding PipelineAskPython}"
                        ToolTip.Tip="On: Python steps arrive switched off when the file is loaded. Off: they stay on, but only for files in your own library or this project's pipelines folder" />
              <Button Classes="small" Click="OnSaveScope" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="save" Size="13" VerticalAlignment="Center" /><TextBlock Text="Save to scope" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small ghost" VerticalAlignment="Center" ToolTip.Tip="A file each run writes">
                  <StackPanel Orientation="Horizontal" Spacing="5"><v:Icon Kind="plus" Size="13" VerticalAlignment="Center" /><TextBlock Text="Add" VerticalAlignment="Center" /></StackPanel>
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="A table as CSV" Click="OnAddOutput" Tag="table" />
                      <MenuItem Header="A table as an SVG plot" Click="OnAddOutput" Tag="plot" />
                      <MenuItem Header="The global attributes as CSV" Click="OnAddOutput" Tag="attributes" />
                      <MenuItem Header="A render of the view (PNG or SVG)" Click="OnAddOutput" Tag="render" />
                      <MenuItem Header="The grid (.cube, .vtk or .npy)" Click="OnAddOutput" Tag="grid" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <TextBlock Text="Outputs" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <StackPanel Margin="16,10" Spacing="8">
              <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding !HasPipelineOutputs}"
                         Text="None: a run gives one row of attributes. Add the tables, plots and renders each run should write." />
              <ItemsControl ItemsSource="{Binding PipelineOutputs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PipelineOutputRow">
                    <StackPanel Spacing="4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="small ghost" Content="×" Padding="6,0" Click="OnRemoveOutput" Tag="{Binding}" ToolTip.Tip="Remove this output" />
                        <TextBlock Text="{Binding KindText}" Classes="label" VerticalAlignment="Center" />
                      </DockPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <TextBox Text="{Binding What}" Watermark="table name" Classes="mono" FontSize="11.5" IsVisible="{Binding HasWhat}" />
                        <TextBox Grid.Column="1" Text="{Binding Path}" Watermark="file" Classes="mono" FontSize="11.5" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRender}">
                        <NumericUpDown Value="{Binding Width}" Minimum="64" Maximum="8192" Increment="10" FormatString="0" Width="110" />
                        <TextBlock Text="×" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Height}" Minimum="64" Maximum="8192" Increment="10" FormatString="0" Width="110" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PipelineTableNames}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
              <Button Classes="small" Content="Write them now…" Click="OnWriteOutputs" IsVisible="{Binding HasPipelineOutputs}" ToolTip.Tip="From the shown frame's result, into a folder" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <TextBlock Text="Run it elsewhere" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,12" Spacing="8">
              <Border Background="{DynamicResource Bg0B}" CornerRadius="6" Padding="10,8"><SelectableTextBlock Text="{Binding PipelineRunCommand}" FontFamily="{DynamicResource Mono}" FontSize="11.5" TextWrapping="Wrap" /></Border>
              <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" Text="One row of attributes per input; the Batch page does the same in the Studio. Load it again from Visualize › … › Load pipeline." />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
