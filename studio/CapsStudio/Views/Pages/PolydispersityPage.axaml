<!-- CAPS Grow › Polydispersity (design/boards/Polydispersity): chain lengths drawn from a distribution, reported as drawn. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.PolydispersityPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.phead"><Setter Property="Padding" Value="16,11" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>
    <Style Selector="Border.len"><Setter Property="Background" Value="{DynamicResource Bg2B}" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Width" Value="40" /><Setter Property="Height" Value="26" /><Setter Property="Margin" Value="0,0,6,6" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnRedraw"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="undo" Size="14" VerticalAlignment="Center" /><TextBlock Text="Redraw" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Content="Use these lengths" Click="OnUse" ToolTip.Tip="Grow builds its chains with these lengths (one per chain, in this order)" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Grow · polydispersity" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Chain lengths drawn from a distribution, reported as drawn" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding PdM0}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PdStatus}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <ScrollViewer Margin="22,18">
      <Grid ColumnDefinitions="5*,6*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
        <!-- the grown cell, chains coloured short → long -->
        <Border Classes="pcard" Height="330">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="cyan short · amber long" Foreground="{DynamicResource MutedB}" /></Border>
                <TextBlock Text="{Binding PdCellTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Panel Background="{DynamicResource Bg0B}">
              <v:MolView x:Name="View" />
              <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" MaxWidth="360">
                <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center" Text="Use these lengths, then Grow: the cell appears here with each chain coloured by its length." />
              </Border>
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Classes="seg" x:Name="Styles">
                <UniformGrid Columns="3">
                  <RadioButton Classes="seg" GroupName="pdstyle" Content="All atoms" Click="OnStyle" Tag="0" />
                  <RadioButton Classes="seg" GroupName="pdstyle" Content="No H" Click="OnStyle" Tag="3" />
                  <RadioButton Classes="seg" GroupName="pdstyle" Content="Backbone" Click="OnStyle" Tag="4" IsChecked="True" />
                </UniformGrid>
              </Border>
            </Panel>
          </DockPanel>
        </Border>
        <!-- the distribution -->
        <Border Grid.Column="1" Classes="pcard" Height="330">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding PdK}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                <TextBlock Text="{Binding PdTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <v:XyChart x:Name="Dist" Margin="8,6,12,8" XLabel="degree of polymerisation N" YLabel="fraction" />
          </DockPanel>
        </Border>
        <!-- drawn lengths -->
        <Border Grid.Row="1" Classes="pcard" VerticalAlignment="Top">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding PdSeedText}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                <TextBlock Text="Drawn lengths (N)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding PdLengths}" Margin="14,12,8,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
                <Border Classes="len"><TextBlock Text="{Binding}" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="3*,2*" ColumnSpacing="14">
          <!-- target vs sample -->
          <Border Classes="pcard" VerticalAlignment="Top">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip ok"><TextBlock Text="computed" /></Border>
                  <TextBlock Text="Target vs sample" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,10,16,12" Spacing="2">
                <Grid ColumnDefinitions="*,90,110" Height="26">
                  <TextBlock Grid.Column="1" Text="TARGET" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="THIS SAMPLE" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding PdRows}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ModelRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="*,90,110" Height="30">
                        <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding A}" Classes="mono" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding B}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- options -->
          <Border Grid.Column="1" Classes="pcard" VerticalAlignment="Top">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead"><TextBlock Text="Options" FontSize="13.5" FontWeight="SemiBold" /></Border>
              <StackPanel Margin="16,12" Spacing="10">
                <StackPanel Spacing="4"><TextBlock Text="Distribution" Classes="label" /><ComboBox ItemsSource="{Binding PdDistNames}" SelectedIndex="{Binding PdDist}" HorizontalAlignment="Stretch" /></StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="4"><TextBlock Text="Nₙ" Classes="label" /><NumericUpDown Value="{Binding PdNn}" Minimum="2" Maximum="100000" Increment="1" FormatString="0.#" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding PdShowPdi}"><TextBlock Text="Đ" Classes="label" /><NumericUpDown Value="{Binding PdPdi}" Minimum="1.001" Maximum="10" Increment="0.01" FormatString="0.00#" /></StackPanel>
                </Grid>
                <StackPanel Spacing="4"><TextBlock Text="Match" Classes="label" /><ComboBox ItemsSource="{Binding PdMatchNames}" SelectedIndex="{Binding PdMatch}" HorizontalAlignment="Stretch" /></StackPanel>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="One length per chain in Grow; the chain count is Grow's." />
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding PdNote}" Classes="dim" TextWrapping="Wrap" Margin="4,0,0,0" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</p:PageBase>
