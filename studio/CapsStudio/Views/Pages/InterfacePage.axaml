<!-- CAPS Analyze › Interface (design/boards/Interface): density along the surface normal for the surface's elements
     and the film, gap, adsorbed layer, plateau and work of adhesion — this frame and averaged over the trajectory. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.InterfacePage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnExport" IsEnabled="{Binding Analyze.HasResults}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export CSV" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Interface analysis" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Density along the surface normal, layer thickness, adhesion" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding IfStatus}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid ColumnDefinitions="380,*" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="the surface is molecule 1" /></Border>
              <TextBlock Text="Cell" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Panel Background="{DynamicResource Bg0B}"><v:MolView x:Name="View" /></Panel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="z · surface normal · 0.5 Å bins" /></Border>
                <TextBlock Text="Density profile" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Panel Height="260">
                <v:LinePlot x:Name="Profile" XLabel="z (Å) · normal to the surface" YLabel="ρ (g/cm³)" AutoRange="True" />
              </Panel>
              <TextBlock x:Name="Legend" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Interface" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,150,150">
                <TextBlock Text="QUANTITY" Classes="h3" /><TextBlock Grid.Column="1" Text="THIS FRAME" Classes="h3" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="FROM TRAJECTORY" Classes="h3" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding IfRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InterfaceRow">
                    <Grid ColumnDefinitions="*,150,150" Height="26">
                      <TextBlock Text="{Binding Quantity}" FontSize="12.5" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ThisFrame}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding Trajectory}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedB}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding IfNote}" Classes="dim" TextWrapping="Wrap" />
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="Gap: from the outermost surface atom to where the film first reaches half its plateau density. Adsorbed layer: to where the film's density settles within 10 % of the plateau. Work of adhesion: −ΔE per area of the separated film and surface." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
