<!-- CAPS Nanostructure builder (design/boards/NanoBuilder.dc.html, Nanoparticle.dc.html): graphene sheets, carbon nanotubes
     and nanoparticles cut from crystals, alone or embedded in a grown polymer matrix (rubber fillers). -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.NanoPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Button.builder"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="FontSize" Value="12.5" /></Style>
    <Style Selector="Button.builder.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="RadioButton.tile">
      <Setter Property="Height" Value="64" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="B" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    </Style>
    <Style Selector="RadioButton.tile:checked /template/ Border#B"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
    <Style Selector="RadioButton.tile:checked"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="RadioButton.tile:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  </p:PageBase.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="48" Padding="12,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="BUILDERS" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.9" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Classes="builder" Content="Polymer" Click="OnPolymer" />
        <Button Classes="builder" Content="Crystal" Click="OnCrystal" />
        <Button Classes="builder" Content="Surface" Click="OnSurface" />
        <Button Classes="builder on" Content="Nanostructure" />
        <Button Classes="builder" Content="Biomolecule" Click="OnBio" />
        <Button Classes="builder" Content="Solvation" Click="OnSolvation" />
        <Button Classes="builder" Content="Coarse-grained" Click="OnCg" />
      </StackPanel>
    </Border>

    <Grid v:Panes.Split="True" ColumnDefinitions="*,420">
      <Panel>
        <v:MolView x:Name="Preview" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding NanoTitle}" FontSize="12" /></Border>
          <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding NanoSummary}" FontSize="12" Foreground="{DynamicResource MutedB}" /></Border>
          <Border Classes="hud" Padding="10,4" IsVisible="{Binding NanoIsPore}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="{Binding PoreChip}" FontSize="12" Foreground="{DynamicResource MutedB}" /></StackPanel></Border>
          <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding NanoAxisText}" FontSize="12" Foreground="{DynamicResource SelB}" /></Border>
          <Border Classes="hud" Padding="10,4" IsVisible="{Binding NanoBuilding}"><TextBlock Text="growing the matrix…" FontSize="12" Foreground="{DynamicResource AccB}" /></Border>
        </StackPanel>
      </Panel>

      <Border Grid.Column="1" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <TextBlock Text="Nanostructure builder" Classes="h2" VerticalAlignment="Center" />
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
              <v:SeedPicker DataContext="{Binding NanoSeed}" ShowLabel="False" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Where groups are grafted and how the matrix grows" />
              <Button Content="Cancel" Click="OnCancel" />
              <Button Classes="primary" Click="OnBuild" IsEnabled="{Binding NanoIdle}">
                <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="{Binding NanoBuildIcon}" Size="15" VerticalAlignment="Center" /><TextBlock Text="{Binding NanoBuildText}" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </WrapPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="TYPE" Classes="h3" />
                  <UniformGrid Columns="4" ColumnSpacing="6">
                    <RadioButton Classes="tile" GroupName="nk" IsChecked="{Binding NanoKind, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center"><v:Icon Kind="hex" Size="20" HorizontalAlignment="Center" /><TextBlock Text="Sheet" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="nk" IsChecked="{Binding NanoKind, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center"><v:Icon Kind="layers" Size="20" HorizontalAlignment="Center" /><TextBlock Text="Nanotube" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="nk" IsChecked="{Binding NanoKind, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center"><v:Icon Kind="atom" Size="20" HorizontalAlignment="Center" /><TextBlock Text="Particle" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="nk" IsChecked="{Binding NanoKind, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=3}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center"><v:Icon Kind="ring" Size="20" HorizontalAlignment="Center" /><TextBlock Text="Pore" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- nanotube -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsTube}">
                <StackPanel Spacing="10">
                  <TextBlock Text="CHIRALITY" Classes="h3" />
                  <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="8">
                    <StackPanel Spacing="6"><TextBlock Text="n" Classes="label" /><NumericUpDown Value="{Binding TubeN}" Minimum="1" Maximum="60" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="m" Classes="label" /><NumericUpDown Value="{Binding TubeM}" Minimum="0" Maximum="60" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Material" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.NanoMaterials}" SelectedIndex="{Binding NanoMaterial}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <Border Classes="seg" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="seg" Content="Armchair" GroupName="tk" IsChecked="{Binding TubeArmchair}" />
                      <RadioButton Classes="seg" Content="Zigzag" GroupName="tk" IsChecked="{Binding TubeZigzag}" />
                      <RadioButton Classes="seg" Content="Chiral" GroupName="tk" IsChecked="{Binding TubeChiral}" />
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Chiral angle" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Column="1" Text="{Binding TubeAngleText}" Classes="mono" />
                    <TextBlock Grid.Row="1" Text="Diameter" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TubeDiameterText}" Classes="mono" />
                    <TextBlock Grid.Row="2" Text="Translation |T|" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TubeTText}" Classes="mono" />
                  </Grid>
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="d = a·√(n² + nm + m²)/π, a = √3 × bond (2.46 Å carbon, 2.504 Å h-BN) — Saito, Dresselhaus &amp; Dresselhaus (1998)" />
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsTube}">
                <StackPanel Spacing="10">
                  <TextBlock Text="GEOMETRY" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Length · Å" Classes="label" /><NumericUpDown Value="{Binding TubeLength}" Minimum="3" Maximum="500" Increment="1" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding NanoBondLabel}" Classes="label" /><NumericUpDown Value="{Binding NanoCc}" Minimum="1.30" Maximum="1.60" Increment="0.01" FormatString="0.000" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Periodic along the tube axis" IsChecked="{Binding NanoPeriodic}" />
                  <CheckBox Classes="toggle" Content="Cap the ends with hydrogen" IsChecked="{Binding NanoCap}" />
                  <Grid ColumnDefinitions="*,90" ColumnSpacing="10">
                    <CheckBox Classes="toggle" Content="Multi-walled" IsChecked="{Binding TubeMultiWalled}" IsEnabled="{Binding TubeWallsAllowed}" ToolTip.ShowOnDisabled="True"
                              ToolTip.Tip="Concentric walls about 3.4 Å apart: armchair (n,n)@(n+5,n+5) or zigzag (n,0)@(n+9,0); chiral walls do not share a period along the axis" />
                    <NumericUpDown Grid.Column="1" Value="{Binding TubeWalls}" Minimum="2" Maximum="6" Increment="1" FormatString="0" IsVisible="{Binding TubeMultiWalled}" />
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Walls by (n, m), innermost first (any chirality)" Classes="label" />
                    <TextBox Text="{Binding TubeWallList}" Watermark="5,5  10,10  26,0" FontFamily="{DynamicResource Mono}"
                             ToolTip.Tip="Each wall its own chirality; a periodic tube is made long enough for every wall's period (stretched at most 2 %). Empty: the walls above" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.TubeRopes}" SelectedIndex="{Binding TubeRope}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="A rope (bundle) of identical tubes, each its own molecule" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding TubeIsRope}">
                      <TextBlock Text="gap Å" Classes="label" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding TubeGap}" Minimum="2.5" Maximum="10" Increment="0.1" FormatString="0.00" Width="90"
                                     ToolTip.Tip="Wall to wall between neighbouring tubes (3.4 Å: the graphite interlayer spacing)" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- sheet -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsSheet}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SHEET" Classes="h3" />
                  <ComboBox ItemsSource="{x:Static vm:MainViewModel.NanoMaterials}" SelectedIndex="{Binding NanoMaterial}" HorizontalAlignment="Stretch" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Width x · Å" Classes="label" /><NumericUpDown Value="{Binding SheetLx}" Minimum="5" Maximum="300" Increment="1" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Width y · Å" Classes="label" /><NumericUpDown Value="{Binding SheetLy}" Minimum="5" Maximum="300" Increment="1" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Layers" Classes="label" /><NumericUpDown Value="{Binding SheetLayers}" Minimum="1" Maximum="20" Increment="1" FormatString="0" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Periodic in the plane (off: a flake with H on the edges)" IsChecked="{Binding NanoPeriodic}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding NanoStackingText}" />
                </StackPanel>
              </Border>

              <!-- particle -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsParticle}">
                <StackPanel Spacing="10">
                  <TextBlock Text="LATTICE" Classes="h3" />
                  <StackPanel Spacing="6"><TextBlock Text="Material" Classes="label" /><ComboBox ItemsSource="{Binding Crystals}" SelectedIndex="{Binding ParticleCrystal}" HorizontalAlignment="Stretch" /></StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsParticle}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SHAPE" Classes="h3" />
                  <ComboBox ItemsSource="{x:Static vm:MainViewModel.ParticleShapes}" SelectedIndex="{Binding ParticleShape}" HorizontalAlignment="Stretch" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Radius · Å (circumscribed)" Classes="label" /><NumericUpDown Value="{Binding ParticleRadius}" Minimum="3" Maximum="60" Increment="0.5" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Centre" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.ParticleCentres}" SelectedIndex="{Binding ParticleCentre}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ParticleHasHeight}">
                    <StackPanel Spacing="6"><TextBlock Text="Height along z · Å" Classes="label" /><NumericUpDown Value="{Binding ParticleHeight}" Minimum="3" Maximum="200" Increment="1" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding ParticleIsFrustum}"><TextBlock Text="Top radius / base radius" Classes="label" /><NumericUpDown Value="{Binding ParticleTopRatio}" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding ParticleIsFibre}">
                    <TextBlock Text="Fibre length along z · Å (periodic; the crystal's c axis)" Classes="label" />
                    <NumericUpDown Value="{Binding FibreLength}" Minimum="3" Maximum="500" Increment="1" FormatString="0.0" />
                  </StackPanel>
                  <CheckBox Classes="toggle" Content="Passivate the surface (Si–OH, O–H)" IsChecked="{Binding ParticlePassivate}" IsVisible="{Binding !ParticleIsMetal}" />
                  <CheckBox Classes="toggle" Content="Relax the surface with a force field (UFF)" IsChecked="{Binding ParticleRelax}" IsVisible="{Binding !ParticleIsMetal}"
                            ToolTip.Tip="After cutting: atoms within 4 Å of the surface (under-coordinated atoms, H, OH) minimised with UFF, the core held as the crystal made it. Metals are not offered: UFF is no model of a metal surface — relax those with EAM in LAMMPS" />
                  <CheckBox Classes="toggle" Content="Cap with thiolate ligands" IsChecked="{Binding ParticleThiolate}" IsVisible="{Binding ParticleIsMetal}"
                            ToolTip.Tip="Alkanethiolates bound through S in three-fold hollows of the surface atoms (2.45 Å), √3 × d(M–M) apart, tails all-trans and pointing out; no metal–S bonds are written" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding ParticleIsMetal}" IsEnabled="{Binding ParticleThiolate}">
                    <StackPanel Spacing="6"><TextBlock Text="Ligand" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.ThiolateNames}" SelectedIndex="{Binding ThiolatePick}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Coverage (of the sites that fit)" Classes="label" /><NumericUpDown Value="{Binding ThiolateFraction}" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- functional groups on the structure shown: sidewalls, ends and edges of tubes and sheets -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsHoneycomb}">
                <StackPanel Spacing="10">
                  <TextBlock Text="FUNCTIONAL GROUPS" Classes="h3" />
                  <TextBlock Text="Grafted on the structure shown (build it first): sidewall groups on the sites' outward normals, end and edge groups in place of the rim hydrogens. Undo with ⌘Z; relax before dynamics."
                             Classes="dim" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Group (preset or SMILES with *)" Classes="label" />
                      <AutoCompleteBox Text="{Binding FnGroup}" ItemsSource="{x:Static vm:MainViewModel.FnGroups}" FilterMode="StartsWith" MinimumPrefixLength="0" Classes="mono" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Where" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.FnPatterns}" SelectedIndex="{Binding FnPattern}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6" IsVisible="{Binding FnHasShare}"><TextBlock Text="Share of sites" Classes="label" /><NumericUpDown Value="{Binding FnFraction}" Minimum="0.001" Maximum="1" Increment="0.01" FormatString="0.000" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Or exactly (0: share)" Classes="label" /><NumericUpDown Value="{Binding FnCountD}" Minimum="0" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Spacing · Å" Classes="label" /><NumericUpDown Value="{Binding FnSpacing}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.0" ToolTip.Tip="Grafted sites at least this far apart (2.5 Å keeps neighbours from both carrying a group)" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding FnIsBand}">
                    <StackPanel Spacing="6"><TextBlock Text="Band from (share of the length)" Classes="label" /><NumericUpDown Value="{Binding FnFrom}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="to" Classes="label" /><NumericUpDown Value="{Binding FnTo}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding FnIsHelix}"><TextBlock Text="Helix pitch · Å per turn" Classes="label" /><NumericUpDown Value="{Binding FnPitch}" Minimum="2" Maximum="1000" Increment="1" FormatString="0.0" /></StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Side" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.FnSides}" SelectedIndex="{Binding FnSide}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="On elements (blank: any)" Classes="label" /><TextBox Text="{Binding FnElements}" Watermark="C, or B for h-BN" Classes="mono" /></StackPanel>
                  </Grid>
                  <StackPanel Spacing="6"><TextBlock Text="Graft on" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.FnTargets}" SelectedIndex="{Binding FnTarget}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="The filler these settings build: the one built last (with its grafts) while the settings are unchanged, else built now. The structure open in the Studio: whatever is active there (a tube from a file …)" /></StackPanel>
                  <Button Classes="small" Click="OnFunctionalize" IsEnabled="{Binding Idle}" HorizontalAlignment="Left" Content="Graft"
                          ToolTip.Tip="Grafts the groups; the grafted structure becomes the Studio's active one, and a polymer matrix built next grows around it" />
                </StackPanel>
              </Border>

              <!-- silane coupling agents on the silanols of the structure shown (silica in rubber: TESPT couples it to the sulfur network) -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsParticle}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SILANE COUPLING AGENT" Classes="h3" />
                  <TextBlock Text="Grafted onto the surface silanols (Si–O–H) of the structure shown: build the silica passivated first. Each graft bonds the silane's silicon to a surface oxygen (one ethanol released); undo with ⌘Z."
                             Classes="dim" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Silane" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.SilaneChoices}" SelectedIndex="{Binding SilanePick}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Share of silanols" Classes="label" /><NumericUpDown Value="{Binding SilaneFractionD}" Minimum="0.01" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Spacing · Å" Classes="label" /><NumericUpDown Value="{Binding SilaneSpacingD}" Minimum="2" Maximum="30" Increment="0.5" FormatString="0.0" ToolTip.Tip="Grafted oxygens at least this far apart" /></StackPanel>
                  </Grid>
                  <Button Classes="small" Click="OnGraftSilane" IsEnabled="{Binding Idle}" HorizontalAlignment="Left" Content="Graft silane" ToolTip.Tip="On the filler chosen under Graft on (built first when needed)" />
                </StackPanel>
              </Border>

              <!-- pore (design/boards/SlitPore) -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsPore}">
                <StackPanel Spacing="10">
                  <TextBlock Text="PORE" Classes="h3" />
                  <Border Classes="seg" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="seg" Content="Slit" GroupName="pk" IsChecked="{Binding PoreType, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" />
                      <RadioButton Classes="seg" Content="Cylinder" GroupName="pk" IsChecked="{Binding PoreType, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" />
                      <RadioButton Classes="seg" Content="From CIF" GroupName="pk" IsChecked="{Binding PoreType, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" HorizontalAlignment="Stretch" ToolTip.Tip="A zeolite or MOF: the crystal's supercell, the fluid in its free space" />
                    </UniformGrid>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding !PoreIsFramework}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding PoreWidthLabel}" Classes="label" />
                      <NumericUpDown Value="{Binding PoreWidth}" Minimum="3.4" Maximum="200" Increment="0.5" FormatString="0.0" />
                      <TextBlock Text="{Binding PoreWidthNote}" FontSize="11" Foreground="{DynamicResource DimB}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding PoreIsSlit}"><TextBlock Text="Walls" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.PoreWallChoices}" SelectedIndex="{Binding PoreWalls}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding PoreIsCylinder}"><TextBlock Text="Wall around it · Å" Classes="label" /><NumericUpDown Value="{Binding PoreWall}" Minimum="2" Maximum="50" Increment="1" FormatString="0.0" /></StackPanel>
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding PoreNeedsCrystal}"><TextBlock Text="Material" Classes="label" /><ComboBox ItemsSource="{Binding Crystals}" SelectedItem="{Binding PoreCrystalItem}" HorizontalAlignment="Stretch" /></StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding PoreIsCylinder}">
                    <StackPanel Spacing="6"><TextBlock Text="Length · Å" Classes="label" /><NumericUpDown Value="{Binding PoreLength}" Minimum="3" Maximum="300" Increment="1" FormatString="0.0" /></StackPanel>
                    <CheckBox Grid.Column="1" Classes="toggle" Content="Passivate (OH)" ToolTip.Tip="Silanols and hydroxyls on the carved surface, pointing into the pore" IsChecked="{Binding PorePassivate}" VerticalAlignment="Bottom" />
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding PoreIsFramework}"><TextBlock Text="Supercell (each axis)" Classes="label" /><NumericUpDown Value="{Binding PoreRepeat}" Minimum="1" Maximum="8" Increment="1" FormatString="0" /></StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14" IsVisible="{Binding PoreIsSlit}">
                <StackPanel Spacing="10" IsVisible="{Binding NanoIsPore}">
                  <TextBlock Text="PERIODIC CELL" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="6"><TextBlock Text="x · Å" Classes="label" /><NumericUpDown Value="{Binding PoreLx}" Minimum="5" Maximum="300" Increment="1" FormatString="0.0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="y · Å" Classes="label" /><NumericUpDown Value="{Binding PoreLy}" Minimum="5" Maximum="300" Increment="1" FormatString="0.0" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Vacuum above walls (non-periodic in z)" IsChecked="{Binding PoreVacuum}" />
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14" IsVisible="{Binding NanoIsPore}">
                <StackPanel Spacing="10">
                  <TextBlock Text="FLUID" Classes="h3" />
                  <Grid ColumnDefinitions="*,90" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Molecule" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.PoreFluids}" SelectedIndex="{Binding PoreFluidIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding PoreHasFluid}"><TextBlock Text="Count" Classes="label" /><NumericUpDown Value="{Binding PoreCount}" Minimum="0" Maximum="5000" Increment="1" FormatString="0" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="Filled by CAPS Pack inside the pore region only, 2 Å from the walls; the walls are molecule 1 and stay held in Relax and Dynamics." />
                </StackPanel>
              </Border>

              <!-- matrix -->
              <Border Classes="section" Padding="16,14" IsVisible="{Binding !NanoIsPore}">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding NanoMatrix}" OnContent="" OffContent="" />
                    <TextBlock Text="POLYMER MATRIX" Classes="h3" VerticalAlignment="Center" />
                  </DockPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding NanoMatrix}">
                    <StackPanel Spacing="6"><TextBlock Text="Polymer" Classes="label" /><ComboBox ItemsSource="{Binding FilmPolymers}" SelectedItem="{Binding MatrixPolymer}" HorizontalAlignment="Stretch" /></StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                      <StackPanel Spacing="6"><TextBlock Text="Chains" Classes="label" /><NumericUpDown Value="{Binding MatrixChains}" Minimum="1" Maximum="2000" Increment="1" FormatString="0" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Units per chain" Classes="label" /><NumericUpDown Value="{Binding MatrixDp}" Minimum="2" Maximum="2000" Increment="1" FormatString="0" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Density · g/cm³" Classes="label" /><NumericUpDown Value="{Binding MatrixDensity}" Minimum="0.1" Maximum="2" Increment="0.05" FormatString="0.00" /></StackPanel>
                    </Grid>
                    <CheckBox Classes="toggle" Content="Around the structure shown (the filler as built and functionalised)" IsChecked="{Binding NanoAroundShown}"
                              ToolTip.Tip="Off: a new filler from the settings above. On: the structure in the view — build the filler, graft its groups, then grow the matrix around it" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="The filler is held at the centre of a periodic cell (a tube keeps its axis, a sheet its plane) while the chains grow around it; it stays held in Relax and Dynamics." />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Padding="16,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding NanoError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding NanoHasError}" />
                  <TextBlock Text="{Binding NanoLog}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</p:PageBase>
