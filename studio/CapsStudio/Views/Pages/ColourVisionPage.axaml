<!-- Colour-vision check (design/boards/ColourVision): element, chain and status colours as seen with protanopia,
     deuteranopia and tritanopia (Machado, Oliveira & Fernandes 2009, severity 1.0), pairs below ΔE*ab 12, how the UI
     keeps colour from being the only cue, and a preview of the 3D view with each deficiency. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ColourVisionPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.vcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.sw"><Setter Property="MinWidth" Value="36" /><Setter Property="Padding" Value="5,0" /><Setter Property="Height" Value="26" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Margin" Value="0,0,4,0" /></Style>
    <Style Selector="Border.sw TextBlock"><Setter Property="FontSize" Value="10.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Preview the view as" Classes="muted" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="seg" GroupName="cvd" Content="Normal" IsChecked="{Binding VisionPreview, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" />
            <RadioButton Classes="seg" GroupName="cvd" Content="Protanopia" IsChecked="{Binding VisionPreview, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" />
            <RadioButton Classes="seg" GroupName="cvd" Content="Deuteranopia" IsChecked="{Binding VisionPreview, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" />
            <RadioButton Classes="seg" GroupName="cvd" Content="Tritanopia" IsChecked="{Binding VisionPreview, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=3}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Colour-vision check" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Simulated with Machado, Oliveira &amp; Fernandes (2009), severity 1.0 · pairs flagged when ΔE*ab &lt; 12 · the palette and theme in use"
                     FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer>
      <Grid ColumnDefinitions="Auto,*" Margin="22,18" ColumnSpacing="18">
        <ItemsControl ItemsSource="{Binding VisionPalettes}" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VisionPalette">
              <Border Classes="vcard" Padding="16,12,16,14">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedB}" /></Border>
                    <TextBlock Text="{Binding Name}" Classes="h2" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VisionRow">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Vision}" Width="104" FontSize="12" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                          <ItemsControl ItemsSource="{Binding Swatches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:VisionSwatch">
                                <Border Classes="sw" Background="{Binding Fill}" ToolTip.Tip="{Binding Label}"><TextBlock Text="{Binding Label}" Foreground="{Binding Ink}" /></Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
          <Border Classes="vcard">
            <StackPanel>
              <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Pairs that become hard to tell apart ·" Classes="h2" />
                  <TextBlock Text="{Binding VisionSummary}" Classes="h2" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="150,130,*,70" Margin="16,10,16,4" IsVisible="{Binding HasVisionPairs}">
                <TextBlock Text="PALETTE" Classes="h3" /><TextBlock Grid.Column="1" Text="VISION" Classes="h3" />
                <TextBlock Grid.Column="2" Text="PAIR" Classes="h3" /><TextBlock Grid.Column="3" Text="ΔE*ab" Classes="h3" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding VisionPairs}" Margin="16,0,16,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VisionPairRow">
                    <Grid ColumnDefinitions="150,130,*,70" Height="28">
                      <TextBlock Text="{Binding Palette}" VerticalAlignment="Center" FontSize="12.5" />
                      <TextBlock Grid.Column="1" Text="{Binding Vision}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Column="2" Text="{Binding Pair}" Classes="mono" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding De}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Computed from the colours in use: the element and chain palette chosen in Settings and the status colours of this theme."
                         Classes="dim" Margin="16,0,16,14" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="vcard">
            <StackPanel>
              <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
                <TextBlock Text="How the UI compensates" Classes="h2" VerticalAlignment="Center" />
              </Border>
              <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" Margin="16,12,16,14" RowSpacing="10">
                <TextBlock Text="Chains" Classes="muted" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock TextWrapping="Wrap" FontSize="12.5"
                             Text="Hover and the inspector name the molecule under the pointer; the Okabe–Ito palette (Settings › Appearance) separates the eight chain colours for all three deficiencies." />
                  <CheckBox Classes="toggle" Content="Chain cues: dash every other chain's bonds and label chain ends" IsChecked="{Binding ChainCues}"
                            ToolTip.Tip="With colour by molecule: bonds dashed on alternate chains (flipped where the palette repeats), each chain's number at both ends of its backbone" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Status" Classes="muted" />
                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                           Text="Every status also has a word (done, running, failed) and, in checks, an icon — colour is never the only cue." />
                <TextBlock Grid.Row="2" Text="Elements" Classes="muted" />
                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                           Text="Element symbols on hover, in the inspector and as view labels (Appearance › Labels); the monochrome palette separates elements by lightness for greyscale figures." />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</p:PageBase>
