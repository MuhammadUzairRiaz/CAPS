<!-- CAPS Studio › Reader: a text output read in CAPS (LAMMPS logs and inputs, GROMACS .mdp and .xvg, CSV, notes): the text
     with find and follow, and the numbers in it as tables, any column drawn against another with its mean over the tail. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ReaderPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Content="Follow" IsChecked="{Binding ReaderFollow}" ToolTip.Tip="Re-read the file every 2 s while it grows (a run still writing its log) and keep the end in view" />
          <ToggleButton Content="Wrap" IsChecked="{Binding ReaderWrap}" />
          <Button Content="Reload" Click="OnReload" />
          <Button Content="Open another…" Click="OnOpen" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding ReaderName}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ReaderInfo}" FontSize="12.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,440" ColumnSpacing="14" Margin="22,18">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
          <TextBox x:Name="Find" Text="{Binding ReaderFind}" Watermark="Find in the text" Classes="mono" KeyDown="OnFindKey" />
          <TextBlock Grid.Column="1" Text="{Binding ReaderFindText}" Classes="dim" VerticalAlignment="Center" MinWidth="60" />
          <Button Grid.Column="2" Content="↑" Click="OnPrev" ToolTip.Tip="Previous match (Shift+Enter)" />
          <Button Grid.Column="3" Content="↓" Click="OnNext" ToolTip.Tip="Next match (Enter)" />
        </Grid>
        <Border Classes="pcard" Padding="0">
          <TextBox x:Name="Body" Text="{Binding ReaderText}" IsReadOnly="True" AcceptsReturn="True" Classes="mono" FontSize="12" BorderThickness="0"
                   Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
      </DockPanel>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard" IsVisible="{Binding ReaderHasTables}">
            <StackPanel Spacing="8">
              <TextBlock Text="Numbers in the file" FontSize="13.5" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ReaderTables}" SelectedIndex="{Binding ReaderTable}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                <TextBlock Text="Across (x)" Classes="label" /><TextBlock Grid.Column="1" Text="Up (y)" Classes="label" />
                <ComboBox Grid.Row="1" ItemsSource="{Binding ReaderColumns}" SelectedIndex="{Binding ReaderX}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ReaderColumns}" SelectedIndex="{Binding ReaderY}" HorizontalAlignment="Stretch" />
              </Grid>
              <v:LinePlot x:Name="Plot" Height="240" AutoRange="True" />
              <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="8">
                <TextBlock Text="Average from (%)" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding ReaderFromD}" Minimum="0" Maximum="99" Increment="10" FormatString="0" />
              </Grid>
              <TextBlock Text="{Binding ReaderStats}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{x:Static vm:CurveFit.Models}" SelectedIndex="{Binding ReaderFit}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding ReaderFitText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy as CSV" Click="OnCopyCsv" />
                <Button Content="Show in the text" Click="OnGoTo" />
              </StackPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Found: LAMMPS thermo blocks (one per run), GROMACS xvg columns with their legends, CSV and whitespace columns. The mean is over the rows from that share of the way in, its error from five blocks: an equilibrated tail, not the whole run." />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding !ReaderHasTables}">
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="No table of numbers in this file. A LAMMPS log, a GROMACS .xvg or a CSV shows its columns here to plot." />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
