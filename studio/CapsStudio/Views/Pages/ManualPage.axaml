<!-- CAPS theory manual (design/boards/TheoryManual.dc.html): one page per implemented method. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ManualPageView" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
    <Style Selector="Button.navitem"><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="20,0,12,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="6" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
    <Style Selector="Button.navitem.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="TextBlock.prose"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="23" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Manual version matches CAPS 0.1.0" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ManualCount, StringFormat='{}{0} methods, each with its equation, settings, tests and reference'}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <!-- navigation -->
    <Border DockPanel.Dock="Left" Width="260" Padding="8,12" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding ManualQuery}" Watermark="Search the manual" Margin="4,0,4,8" Height="32" FontSize="12" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding ManualNav}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ManualNavItem">
                <Panel>
                  <TextBlock Text="{Binding Text}" IsVisible="{Binding IsGroup}" Classes="h3" Margin="12,10,12,4" />
                  <Button Classes="navitem" Classes.on="{Binding Page.On}" Content="{Binding Text}" IsVisible="{Binding !IsGroup}" Click="OnPage" Tag="{Binding Page}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- side cards -->
    <ScrollViewer DockPanel.Dock="Right" Width="348">
      <StackPanel Spacing="14" Margin="0,30,28,30">
        <Border Classes="pcard">
          <StackPanel Spacing="8">
            <TextBlock Text="Implementation" FontSize="13.5" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Source" FontSize="12" Foreground="{DynamicResource MutedB}" />
              <TextBlock Grid.Column="1" Text="{Binding ManualCurrent.Source}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Tested by" FontSize="12" Foreground="{DynamicResource MutedB}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ManualCurrent.Tested}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="Deviation from the paper" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" MaxWidth="90" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ManualDeviation}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextB}" Classes.warnish="{Binding ManualHasDeviation}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="pcard">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ManualUsedTitle}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ItemsControl ItemsSource="{Binding ManualUsed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2"><v:Icon Kind="jobs" Size="14" Foreground="{DynamicResource DimB}" /><TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="250" /></StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No step of the open structure used this method." IsVisible="{Binding !ManualHasUsed}" Classes="dim" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="pcard">
          <StackPanel Spacing="8">
            <TextBlock Text="Cite" FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock Text="CAPS adds this reference to the provenance of every output that used the method." FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
            <Button Classes="small" HorizontalAlignment="Left" Click="OnCopyBibtex"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="copy" Size="13" VerticalAlignment="Center" /><TextBlock Text="Copy BibTeX" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <!-- the article -->
    <ScrollViewer>
      <StackPanel Spacing="16" Margin="40,30" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ManualCurrent.Group}" FontSize="12" Foreground="{DynamicResource DimB}" />
          <TextBlock Text="{Binding ManualCurrent.Title}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding ManualCurrent.Summary}" Classes="prose" />
        <Border Padding="22,18" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg1B}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ManualCurrent.EquationNote}" Classes="mono" FontSize="12" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <SelectableTextBlock Text="{Binding ManualCurrent.Equation}" FontFamily="Georgia, Times New Roman, serif" FontSize="19" TextWrapping="Wrap" LineHeight="30" />
          </DockPanel>
        </Border>
        <StackPanel>
          <Grid ColumnDefinitions="16*,50*,34*" Margin="0,0,0,6">
            <TextBlock Text="SYMBOL" Classes="h3" /><TextBlock Grid.Column="1" Text="MEANING" Classes="h3" /><TextBlock Grid.Column="2" Text="CAPS SETTING" Classes="h3" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ManualSymbols}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProvRow">
                <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,8">
                  <Grid ColumnDefinitions="16*,50*,34*" ColumnSpacing="8">
                    <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding Other}" FontSize="12.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="When to use it" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock Text="{Binding ManualCurrent.When}" Classes="prose" />
        <TextBlock Text="Reference" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding ManualRefs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</p:PageBase>
