<!-- CAPS Studio › DFT › Adsorption set: a molecule (SMILES with stereo, or a file) on a slab (a POSCAR, or a relaxed
     CONTCAR repeated in-plane); its anchors found by SMARTS as checkboxes; orientations × azimuths, the ones the surface's
     symmetry makes equivalent greyed; each complex's closest contact, heavy-atom contact and image distance with pass/fail;
     the trio slab / molecule / complexes written with one settings set and audited. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.AdsorbDftPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnToJobs" ToolTip.Tip="The VASP settings these folders were written with (k-density, cluster profile, PAW folder)">Settings…</Button>
          <Button Classes="primary" Click="OnBuild" IsEnabled="{Binding DftIdle}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="flask" Size="14" VerticalAlignment="Center" /><TextBlock Text="Build set" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="DFT adsorption set" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="E_bind = E(complex) − E(slab) − E(molecule): the three written with identical settings" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="22,6" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="small ghost" Content="Copy" Click="OnCopyCli" IsVisible="{Binding HasDftCli}" />
        <StackPanel Spacing="2">
          <SelectableTextBlock Text="{Binding DftCli}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DftStatus}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,430" ColumnSpacing="14" Margin="22,18">
      <Grid RowDefinitions="*,*" RowSpacing="12">
        <Border Classes="pcard" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <TextBlock Text="{Binding AdsSummary}" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
            <Panel Background="{DynamicResource Bg0B}"><v:MolView x:Name="View" /></Panel>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Classes="pcard" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="2*,70,70,70,60,*">
                  <TextBlock Text="COMPLEX" Classes="h3" /><TextBlock Grid.Column="1" Text="ANY (Å)" Classes="h3" /><TextBlock Grid.Column="2" Text="HEAVY" Classes="h3" />
                  <TextBlock Grid.Column="3" Text="IMAGE" Classes="h3" /><TextBlock Grid.Column="4" Text="" Classes="h3" /><TextBlock Grid.Column="5" Text="SYMMETRY" Classes="h3" />
                </Grid>
                <TextBlock Text="{Binding AdsSymmetry}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding AdsComplexes}" Margin="16,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DftComplexRow">
                    <Button Classes="row" Click="OnComplex" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,3" Opacity="{Binding RowOpacity}" ToolTip.Tip="{Binding Issues}">
                      <Grid ColumnDefinitions="2*,70,70,70,60,*">
                        <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding AnyText}" Classes="mono" FontSize="11.5" />
                        <TextBlock Grid.Column="2" Text="{Binding HeavyText}" Classes="mono" FontSize="11.5" />
                        <TextBlock Grid.Column="3" Text="{Binding ImageText}" Classes="mono" FontSize="11.5" />
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11.5" />
                        <TextBlock Grid.Column="5" Text="{Binding EquivalentText}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Slab" FontSize="13.5" FontWeight="SemiBold" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Content="Choose…" Click="OnSlab" />
                <TextBlock Text="{Binding AdsSlab}" Classes="mono dim" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <CheckBox Classes="toggle" Content="A relaxed CONTCAR (repeat it, re-centre it)" IsChecked="{Binding AdsFromRelaxed}" ToolTip.Tip="For production: the relaxed 1 × 1 slab, so the set has the relaxed lattice constant" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="3"><TextBlock Text="Repeat a" Classes="label" /><NumericUpDown Value="{Binding AdsNa}" Minimum="1" Maximum="20" FormatString="0" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Repeat b" Classes="label" /><NumericUpDown Value="{Binding AdsNb}" Minimum="1" Maximum="20" FormatString="0" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Molecule" FontSize="13.5" FontWeight="SemiBold" />
              <TextBox Text="{Binding AdsSmiles}" Classes="mono" Watermark="SMILES (stereo kept), e.g. C/C=C/CCC(C#N)C/C=C/C" />
              <Border Height="150" CornerRadius="8" Background="{DynamicResource Bg0B}"><v:MolView Smiles="{Binding AdsSmiles}" /></Border>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Content="From a file…" Click="OnMolFile" />
                <Button DockPanel.Dock="Right" Classes="small ghost" Content="×" Click="OnMolClear" Margin="0,0,6,0" />
                <TextBlock Text="{Binding AdsMolFile}" Classes="mono dim" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Text="ANCHORS (found by SMARTS: anchor-down orientations)" Classes="h3" />
              <TextBlock Text="Build once to find them; then untick the ones to leave out." Classes="dim" FontSize="11" />
              <ItemsControl ItemsSource="{Binding AdsAnchors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DftAnchorRow">
                    <CheckBox IsChecked="{Binding On}"><TextBlock><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Atoms}" Foreground="{DynamicResource DimB}" /></TextBlock></CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Content="parallel (long axis along x, flat side down)" IsChecked="{Binding AdsParallel}" />
              <CheckBox Content="upright (long axis along z, anchor end down)" IsChecked="{Binding AdsUpright}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Placement" FontSize="13.5" FontWeight="SemiBold" />
              <StackPanel Spacing="3"><TextBlock Text="Azimuths (°)" Classes="label" /><TextBox Text="{Binding AdsAzimuths}" Classes="mono" /></StackPanel>
              <CheckBox Classes="toggle" Content="Leave out symmetry-equivalent azimuths" IsChecked="{Binding AdsSkipEquivalent}" ToolTip.Tip="Rotations that map the outer layer onto itself give the same complex" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Pre-screen: force-field minima" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AdsPrescreen}" Minimum="0" Maximum="20" FormatString="0" Width="110"
                               ToolTip.Tip="The Adsorption Locator (UFF, simulated annealing) anneals the molecule over the surface; its lowest distinct configurations become complex_ff1 … with the same checks" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="3"><TextBlock Text="Closest contact (Å)" Classes="label" /><NumericUpDown Value="{Binding AdsDmin}" Minimum="0.5" Maximum="10" Increment="0.05" FormatString="0.00" ToolTip.Tip="Any molecule atom to any slab atom" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Heavy-atom contact (Å)" Classes="label" /><NumericUpDown Value="{Binding AdsDheavy}" Minimum="0.5" Maximum="10" Increment="0.1" FormatString="0.0" ToolTip.Tip="Non-H of the molecule to non-H of the slab" /></StackPanel>
              </Grid>
              <StackPanel Spacing="3"><TextBlock Text="Write into" Classes="label" /><TextBox Text="{Binding AdsOut}" Classes="mono" FontSize="11.5" /></StackPanel>
              <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" Text="Image distance on the unwrapped molecule: under 2.5 Å fails, under 4 Å warns, with the smallest larger supercell that passes. Failing complexes are not written." />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding HasAdsAudit}">
            <StackPanel Spacing="6">
              <TextBlock Text="Independent audit of the written complexes" FontSize="13.5" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding AdsAudit}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Row">
                    <Grid ColumnDefinitions="150,*" Margin="0,1"><TextBlock Text="{Binding Key}" Classes="mono" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
