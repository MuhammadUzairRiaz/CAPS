<!-- CAPS project home (design/boards/ProjectHome.dc.html): the folder's structures, what each holds, and a methods section
     written from provenance. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ProjectPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
    <Style Selector="Button.doc"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,12,12" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="Button.doc.on"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="TextBlock.st0"><Setter Property="Foreground" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="TextBlock.st1"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="TextBlock.st2"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnFolder"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="folder" Size="14" VerticalAlignment="Center" /><TextBlock Text="Other folder…" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Click="OnShare" IsEnabled="{Binding ProjectDocs.Count}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="link" Size="14" VerticalAlignment="Center" /><TextBlock Text="Share project" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnNew"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="plus" Size="14" VerticalAlignment="Center" /><TextBlock Text="New document" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding ProjectName}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProjectSubtitle}" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Methods text updates when provenance changes" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProjectFolderText}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid ColumnDefinitions="*,470" ColumnSpacing="16" Margin="22,18">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <ItemsControl ItemsSource="{Binding ProjectDocs}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectDoc">
                <Button Classes="doc" Classes.on="{Binding Selected}" Click="OnDoc" DoubleTapped="OnDocOpen" Tag="{Binding}" ToolTip.Tip="Click: its methods · double-click: open it">
                  <StackPanel>
                    <Border Height="120" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Spacing="3" Margin="12,10">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding !ProjectDocs.Count}" Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                     Text="Open a structure first: its folder becomes the project. Or choose another folder." />
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Click="OnExportTable" IsEnabled="{Binding ProjectDocs.Count}" ToolTip.Tip="The table as CSV, with the literature row when one is chosen">
                  <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="download" Size="13" VerticalAlignment="Center" /><TextBlock Text="Export table" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <ComboBox DockPanel.Dock="Right" Width="210" Margin="0,0,8,0" ItemsSource="{Binding ProjectReferences}" SelectedIndex="{Binding ProjectRefIndex}"
                          ToolTip.Tip="A literature row under the results: the ranges of data/reference/polymers.json (as Analyze compares with)" />
                <TextBlock Text="Results" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="28*,11*,13*,15*,11*,16*,12*" Margin="0,0,0,2">
                <TextBlock Text="STRUCTURE" Classes="h3" /><TextBlock Grid.Column="1" Text="ATOMS" Classes="h3" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="ρ (G/CM³)" Classes="h3" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="TG" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="C∞" Classes="h3" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="LAST STEP" Classes="h3" Margin="14,0,0,0" />
                <TextBlock Grid.Column="6" Text="STATUS" Classes="h3" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProjectDocs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectDoc">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,7">
                      <Grid ColumnDefinitions="28*,11*,13*,15*,11*,16*,12*">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Atoms}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding Density}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding Tg}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding Cinf}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding LastStep}" Classes="mono" FontSize="11.5" Margin="14,0,0,0" Foreground="{DynamicResource MutedB}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="12" Classes.st0="{Binding StatusLevel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}"
                                   Classes.st1="{Binding StatusLevel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}"
                                   Classes.st2="{Binding StatusLevel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,7" IsVisible="{Binding HasProjectRef}" ToolTip.Tip="{Binding ProjectRefSources}">
                <Grid ColumnDefinitions="28*,11*,13*,15*,11*,16*,12*">
                  <TextBlock Text="{Binding ProjectRefName}" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Grid.Column="2" Text="{Binding ProjectRefDensity}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Grid.Column="3" Text="{Binding ProjectRefTg}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Grid.Column="4" Text="{Binding ProjectRefCinf}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Grid.Column="6" Text="literature" FontSize="12" Foreground="{DynamicResource MutedB}" />
                </Grid>
              </Border>
              <TextBlock Text="Density from each file's cell; Tg and C∞ from the last Analyze run its provenance records (save after analysing); status from its last step." FontSize="11.5" Foreground="{DynamicResource DimB}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" Classes="pcard">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Methods section · generated from provenance" FontSize="13.5" FontWeight="SemiBold" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Classes="small" Click="OnCopyMethods" IsEnabled="{Binding ProjectHasMethods}"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="copy" Size="13" VerticalAlignment="Center" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Classes="small" Click="OnBibtex" IsEnabled="{Binding ProjectHasMethods}"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="download" Size="13" VerticalAlignment="Center" /><TextBlock Text="BibTeX" VerticalAlignment="Center" /></StackPanel></Button>
              </StackPanel>
              <TextBlock Text="{Binding ProjectMethodsFor}" FontSize="11.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="10">
              <SelectableTextBlock Text="{Binding ProjectMethods}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ProjectRefs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding}" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</p:PageBase>
