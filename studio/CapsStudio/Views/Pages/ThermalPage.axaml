<!-- CAPS Studio › Modules › Thermal conductivity: Green–Kubo or reverse NEMD on the open structure (caps thermal), the
     material's dimensionality said by the user (3D bulk, 2D sheet), short runs here and the LAMMPS inputs for a cluster. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ThermalPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Write LAMMPS inputs…" Click="OnLammps" IsEnabled="{Binding ThCanRun}" />
          <Button Classes="primary" Click="OnRun" IsEnabled="{Binding Idle}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run here" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Thermal conductivity · molecular dynamics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Heat-flux autocorrelation (Green–Kubo) or kinetic-energy exchanges between slabs (Müller-Plathe) on the open structure" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding ThProgress}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="420,*" ColumnSpacing="14" Margin="22,18">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Material" FontSize="13.5" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{x:Static vm:MainViewModel.ThDims}" SelectedIndex="{Binding ThDim}" HorizontalAlignment="Stretch" PlaceholderText="2D or 3D: say which (not guessed)" />
              <StackPanel Spacing="4" IsVisible="{Binding ThIs2D}">
                <TextBlock Text="Effective thickness · Å (0: the atoms' extent plus van der Waals radii)" Classes="label" TextWrapping="Wrap" />
                <NumericUpDown Value="{Binding ThThick}" Minimum="0" Maximum="100" Increment="0.05" FormatString="0.00"
                               ToolTip.Tip="κ of a sheet depends on this choice; the interlayer spacing of the bulk parent is the usual one (graphite 3.35 Å). The sheet conductance κ·t does not" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Method" FontSize="13.5" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{x:Static vm:MainViewModel.ThMethods}" SelectedIndex="{Binding ThMethod}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Text="T · K" Classes="label" /><TextBlock Grid.Column="1" Text="NVT first · ps" Classes="label" /><TextBlock Grid.Column="2" Text="Sampled · ps" Classes="label" />
                <NumericUpDown Grid.Row="1" Value="{Binding ThT}" Minimum="1" Maximum="5000" Increment="10" FormatString="0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ThEq}" Minimum="0" Increment="1" FormatString="0.##" />
                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding ThPs}" Minimum="0.1" Increment="1" FormatString="0.##" />
                <TextBlock Grid.Row="2" Text="Time step · fs" Classes="label" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Sample every" Classes="label" /><TextBlock Grid.Row="2" Grid.Column="2" Text="Correlation · ps" Classes="label" />
                <NumericUpDown Grid.Row="3" Value="{Binding ThDt}" Minimum="0.1" Maximum="5" Increment="0.5" FormatString="0.##" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ThEvery}" Minimum="1" FormatString="0 'steps'" />
                <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding ThCorr}" Minimum="0.01" Increment="0.5" FormatString="0.##" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsVisible="{Binding ThNemd}">
                <TextBlock Text="Flux along" Classes="label" /><TextBlock Grid.Column="1" Text="Slabs" Classes="label" /><TextBlock Grid.Column="2" Text="Exchange every" Classes="label" />
                <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:MainViewModel.ThAxes}" SelectedIndex="{Binding ThAxis}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ThSlabs}" Minimum="10" Increment="2" FormatString="0" />
                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding ThSwap}" Minimum="1" FormatString="0 'steps'" />
              </Grid>
              <TextBlock Text="{Binding ThSteps}" Classes="dim" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Keep runs here short; κ needs nanoseconds. The LAMMPS inputs run the same method (compute heat/flux on centroid/stress/atom, or fix thermal/conductivity) for as long as you set:" />
              <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
                <TextBlock Text="LAMMPS sampled run · ps" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding ThLmpPs}" Minimum="1" Increment="500" FormatString="0" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding ThHasError}">
            <TextBlock Text="{Binding ThError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrB}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="6">
              <TextBlock Text="Result" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ThResult}" Classes="mono" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ThNotes}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Click="OnQha" IsEnabled="{Binding HasDocument}" Content="Expansion"
                        ToolTip.Tip="Phonons at strained cells: the free energy's minimum at each temperature gives the cell, the expansion and the bulk modulus" />
                <TextBlock Text="Thermal expansion (quasi-harmonic)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="For a crystal: how its cell changes with temperature from its vibrations. Each axis on its own shows anisotropy, such as a polymer crystal shrinking along its chains while it swells across them." />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4"><TextBlock Text="The cell changes" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.QhaModes}" SelectedIndex="{Binding QhaMode}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Strain range" Classes="label" /><NumericUpDown Value="{Binding QhaRange}" Minimum="0.005" Maximum="0.1" Increment="0.005" FormatString="0.000" ToolTip.Tip="The linear strain at the ends of the grid: widen it when a minimum is marked extrapolated" /></StackPanel>
              </Grid>
              <TextBox Text="{Binding QhaTemps}" Classes="mono" Watermark="temperatures in K: 0, 100, 200, 300" />
              <TextBlock Text="{Binding QhaError}" Classes="err" TextWrapping="Wrap" IsVisible="{Binding QhaHasError}" />
              <SelectableTextBlock Text="{Binding QhaResult}" FontFamily="{DynamicResource Mono}" FontSize="11" />
              <TextBlock Text="{Binding QhaNote}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Click="OnPhonons" IsEnabled="{Binding HasDocument}" Content="Vibrations"
                        ToolTip.Tip="Phonons of the open crystal with its force field: the atoms relaxed in a supercell, force constants by small displacements" />
                <TextBlock Text="Lattice vibrations" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="For a crystal (a polymer crystal, a filler): how its atoms vibrate across the Brillouin zone. The acoustic branches' slopes are the sound speeds — along the chain axis, the fibre's stiffness — and the modes give the heat capacity and entropy." />
              <TextBlock Text="{Binding PhError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding PhHasError}" />
              <v:SciPlot x:Name="Bands" Height="240" IsVisible="{Binding PhHas}" />
              <v:SciPlot x:Name="Dos" Height="170" IsVisible="{Binding PhHas}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding PhHas}">
                <StackPanel Spacing="4"><TextBlock Text="SOUND SPEEDS (ACOUSTIC BRANCHES)" Classes="h3" /><TextBlock Text="{Binding PhSound}" Classes="mono" FontSize="12" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="HARMONIC" Classes="h3" /><TextBlock Text="{Binding PhSummary}" Classes="mono" FontSize="12" TextWrapping="Wrap" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding PhNote}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding PhHas}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Click="OnDielectric" IsEnabled="{Binding HasDocument}" Content="Dielectric"
                        ToolTip.Tip="The crystal's dielectric tensors, refractive indices, piezoelectric constants and reflectivity from its force field's lattice dynamics (shells for the electrons)" />
                <TextBlock Text="Dielectric and piezoelectric response" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="For a filler or polymer crystal in a sensing rubber (ZnO, BaTiO3, β-PVDF): how it polarises in a field and under strain, and how it reflects infrared light. Shell models give the electrons' part (ε^∞, refractive index)." />
              <TextBlock Text="{Binding DlError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding DlHasError}" />
              <TextBlock Text="{Binding DlText}" Classes="mono" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding DlHas}" />
              <v:SciPlot x:Name="Reflect" Height="200" IsVisible="{Binding DlHas}" />
              <TextBlock Text="{Binding DlNote}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding DlHas}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Click="OnZmelt" IsEnabled="{Binding HasDocument}" Content="Melt it"
                        ToolTip.Tip="One constant-energy run per starting temperature from the perfect crystal; the bottom of the Z the runs draw is the melting point" />
                <TextBlock Text="Melting point (Z method)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="For an inorganic filler, a salt or a small-molecule crystal at its own volume: heated from rest, the crystal superheats and then drops back to its melting point once it melts. The cell must be twice the cut-off wide. Polymer crystals melt more reliably in a heating scan." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ZmTemperatures}" Width="200" Watermark="starting T, K" ToolTip.Tip="Starting temperatures in K: the crystal settles near half of each; reach about twice the expected melting point" />
                <NumericUpDown Value="{Binding ZmSteps}" Minimum="500" Increment="1000" FormatString="0 steps" Width="110" ShowButtonSpinner="False" ToolTip.Tip="Steps of each run: melting near the limit takes time" />
                <NumericUpDown Value="{Binding ZmDt}" Minimum="0.1" Maximum="10" Increment="0.5" FormatString="0.0 fs" Width="70" ShowButtonSpinner="False" />
                <NumericUpDown Value="{Binding ZmBisect}" Minimum="0" Maximum="8" Increment="1" FormatString="0 extra" Width="80" ShowButtonSpinner="False"
                               ToolTip.Tip="Runs added between the last crystal and the first melted start, to find the bottom of the Z" />
              </StackPanel>
              <TextBlock Text="{Binding ZmError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding ZmHasError}" />
              <v:SciPlot x:Name="Zcurve" Height="220" IsVisible="{Binding ZmHas}" />
              <TextBlock Text="{Binding ZmText}" Classes="mono" FontSize="12" IsVisible="{Binding ZmHas}" />
              <TextBlock Text="{Binding ZmNote}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding ZmHas}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock x:Name="CurveTitle" Text="Running integral κ(t) (x solid, y dashed, z dotted) or the slab temperatures" FontSize="13.5" FontWeight="SemiBold" />
              <v:SciPlot x:Name="Curve" Height="220" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
