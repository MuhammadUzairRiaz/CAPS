<!-- CAPS Pack (design/boards/Pack.dc.html): molecules and regions, objective, input; the packed cell, convergence and the guarantee. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.PackPage" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*" Margin="22,16,22,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Packing · CAPS Pack" Classes="title" />
        <TextBlock Text="Places copies of molecules you already have — solvents, gases, additives, fillers, curatives, pre-built chains — as rigid bodies into an empty box or around the current structure, without overlaps (as Packmol and Materials Studio's Amorphous Cell Packing). It does not make polymer chains: Polymer cell grows those. The packed cell can go straight to Export; Minimise and Dynamics are optional." Classes="muted" TextWrapping="Wrap" MaxWidth="900" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnSave" IsVisible="{Binding GrownUnsaved}" ToolTip.Tip="Save the packed cell">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save cell…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnOpenInput" IsEnabled="{Binding Idle}" ToolTip.Tip="Open a packmol-format input (.inp)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="folder" Size="16" VerticalAlignment="Center" /><TextBlock Text="Open input…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCopyPython" ToolTip.Tip="This packing as a Python script (caps.pack with this input)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="copy" Size="16" VerticalAlignment="Center" /><TextBlock Text="Copy as Python" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnQueue" IsVisible="{Binding !Idle}" ToolTip.Tip="Queue this packing with its input as it is now; it packs a new cell when the current run ends (Jobs lists it)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="plus" Size="15" VerticalAlignment="Center" /><TextBlock Text="Queue packing" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="primary" Click="OnPack" IsEnabled="{Binding Idle}" IsVisible="{Binding !Packing}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="16" VerticalAlignment="Center" /><TextBlock Text="Pack" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding Packing}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="stop" Size="16" VerticalAlignment="Center" /><TextBlock Text="Cancel" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid v:Panes.Split="True" Grid.Row="1" ColumnDefinitions="560,*" ColumnSpacing="16">
      <ScrollViewer>
        <StackPanel Spacing="16">
          <!-- what comes after packing: straight to the engines, or minimise / run dynamics in CAPS first -->
          <Border Classes="card" IsVisible="{Binding PackDone}" BorderBrush="{DynamicResource OkB}">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Packed · next" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <TextBlock Text="The cell is ready for LAMMPS or GROMACS. Minimising or running dynamics in CAPS first is optional." Classes="muted" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Classes="primary" Margin="0,0,8,6" Click="OnExportEngines">
                    <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="15" VerticalAlignment="Center" /><TextBlock Text="Export to LAMMPS / GROMACS…" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Margin="0,0,8,6" Click="OnMinimise" Content="Minimise (optional)" ToolTip.Tip="Remove the last close contacts before dynamics" />
                  <Button Margin="0,0,8,6" Click="OnDynamics" Content="Dynamics (optional)" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- start from an empty box, or around the current structure (Amorphous Cell's Packing) -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Pack into" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="8" IsEnabled="{Binding Idle}">
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.PackStartModes}" SelectedIndex="{Binding PackStart}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Around the current structure: a grown polymer cell, a surface slab … stays fixed and the molecules fill its free space (it needs a rectangular cell)" />
                <TextBlock Text="{Binding PackStartNote}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Pack's own force field -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Force field" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Force field" Classes="muted" FontSize="11.5" />
                    <ComboBox ItemsSource="{Binding Field.Library}" SelectedIndex="{Binding PackFfIndex}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Charges" Classes="muted" FontSize="11.5" />
                    <ComboBox ItemsSource="{x:Static vm:FieldViewModel.ChargeModes}" SelectedIndex="{Binding PackChargeMode}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Grid>
                <CheckBox Classes="toggle" Content="Assign when packing finishes" IsChecked="{Binding PackAssignField}" />
                <TextBlock Text="Pack keeps its own choice: Grow and the Force field step have theirs." Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Molecules & regions -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding PackCellText}" Classes="dim" VerticalAlignment="Center" />
                  <TextBlock Text="Molecules &amp; regions" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="8">
                <TextBlock Text="Nothing to pack yet: add a molecule, open an input, or start from the example." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasPackItems}" />
                <ItemsControl ItemsSource="{Binding PackItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackItem">
                      <Border Classes="choice" Margin="0,0,0,8" ToolTip.Tip="{Binding File}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <Border Width="3" CornerRadius="2" Background="{Binding Brush}" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="mono" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel IsEnabled="{Binding Idle}">
                  <Button Classes="small" Margin="0,0,8,6" Click="OnAddMolecule">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="plus" Size="14" VerticalAlignment="Center" /><TextBlock Text="Add molecule" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="small" Margin="0,0,8,6" Click="OnExample" IsVisible="{Binding $parent[v:MainWindow].HasSamples}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="flask" Size="14" VerticalAlignment="Center" /><TextBlock Text="Water example" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="small" Margin="0,0,8,6" Click="OnNew">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="file" Size="14" VerticalAlignment="Center" /><TextBlock Text="New input" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Border Classes="chip" Margin="0,4,0,6" VerticalAlignment="Top"><TextBlock Text="box · cube · sphere · cylinder · plane" Foreground="{DynamicResource MutedB}" /></Border>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Objective -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Objective" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="12">
                <Border Classes="inset" Padding="14,12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="f = Σ(i&lt;j) max(0, d_tol² − |x_i − x_j|²)²" Classes="mono" FontSize="13" />
                    <TextBlock Text="  + Σ(i) w · g_region(x_i)" Classes="mono" FontSize="13" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:Icon Kind="link" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Top" />
                  <TextBlock Text="Overlap penalty after Martínez et al., J. Comput. Chem. 30, 2157 (2009). Rigid bodies: centre of mass + rotation, analytic gradients." Classes="dim" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="Tolerance d_tol" Classes="label" /><TextBlock Grid.Column="1" Text="Optimiser" Classes="label" /><TextBlock Grid.Column="2" Text="Neighbour list" Classes="label" />
                  <TextBox Grid.Row="1" Text="{Binding PackTolText}" IsReadOnly="True" Classes="mono" ToolTip.Tip="Set with the tolerance line of the input" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="L-BFGS (m = 10)" IsReadOnly="True" />
                  <TextBox Grid.Row="1" Grid.Column="2" Text="Cell list, threaded" IsReadOnly="True" />
                </Grid>
                <v:SeedPicker DataContext="{Binding PackSeedChoice}" ToolTip.Tip="Written as the input's seed line; new each run replaces it with a fresh seed for every pack" />
                <StackPanel Spacing="6" IsVisible="{Binding PackIntoCurrent}">
                  <TextBlock Text="Fill to a density · the last molecule's number from the whole cell's target" Classes="label" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding FillDensity}" Minimum="0.01" Maximum="5" Increment="0.05" FormatString="0.000 g/cm³" Width="140" ShowButtonSpinner="False" />
                    <Button Classes="small" Content="Set the number" Click="OnFillToDensity" ToolTip.Tip="N = (ρ V N_A − m of the structure) / m of the molecule, whole molecules" />
                  </StackPanel>
                  <TextBlock Text="{Binding FillText}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,120,Auto" ColumnSpacing="8" IsEnabled="{Binding !PackIntoCurrent}">
                  <CheckBox Content="Then compress the cell to" IsChecked="{Binding PackCompress}" VerticalAlignment="Center"
                            ToolTip.Tip="Stage 3: pack at a low density (an easy, fast packing), then compress the cell by affine steps of 6 % with capped-force push-off and minimisation (the built-in force field) to this density" />
                  <NumericUpDown Grid.Column="1" Value="{Binding PackCompressTo}" Minimum="0.05" Maximum="5" Increment="0.05" FormatString="0.00" IsEnabled="{Binding PackCompress}" />
                  <TextBlock Grid.Column="2" Text="g/cm³" Classes="dim" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Input -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="CAPS syntax · packmol files open too" Foreground="{DynamicResource MutedB}" ToolTip.Tip="cell X Y Z · distance d · seed n · molecule FILE / count n / in box from … to … · in sphere at … radius … · not in … · above plane normal … at … · fixed at x y z / end" /></Border>
                  <TextBlock Text="Input" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="8">
                <TextBox Text="{Binding PackText}" AcceptsReturn="True" Classes="mono" FontSize="12" MinHeight="180" MaxHeight="360" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" IsEnabled="{Binding Idle}" />
                <TextBlock Text="{Binding PackBaseNote}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Report" Classes="h2" VerticalAlignment="Center" /></Border>
              <TextBlock Margin="16,12,16,16" Text="{Binding PackLog}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="*,250" RowSpacing="16">
        <Border Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="38,*">
            <Border Classes="phead">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip" IsVisible="{Binding Packing}">
                  <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="overlap minimisation" Foreground="{DynamicResource AccB}" /></StackPanel>
                </Border>
                <TextBlock Text="Packed cell" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Decorator Grid.Row="1" x:Name="ViewSlot" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="16">
          <Border Classes="card">
            <Grid RowDefinitions="38,*">
              <Border Classes="phead"><TextBlock Text="Convergence" Classes="h2" VerticalAlignment="Center" /></Border>
              <v:LinePlot Grid.Row="1" x:Name="ConvPlot" Margin="10,6,12,8" AutoRange="True" XLabel="round" YLabel="log₁₀ penalty" />
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="38,*">
              <Border Classes="phead"><TextBlock Text="Guarantee" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Row="1" Margin="14,12" Spacing="10">
                <UniformGrid Columns="2">
                  <Border Classes="inset" Margin="0,0,5,5"><StackPanel Spacing="2"><TextBlock Text="d_min now" Classes="label" /><TextBlock Text="{Binding PackDmin}" Classes="mono acc" FontSize="16" /></StackPanel></Border>
                  <Border Classes="inset" Margin="5,0,0,5"><StackPanel Spacing="2"><TextBlock Text="target" Classes="label" /><TextBlock Text="{Binding PackTolText}" Classes="mono" FontSize="16" /></StackPanel></Border>
                  <Border Classes="inset" Margin="0,5,5,0"><StackPanel Spacing="2"><TextBlock Text="in violation" Classes="label" /><TextBlock Text="{Binding PackBad}" Classes="mono" FontSize="16" /></StackPanel></Border>
                  <Border Classes="inset" Margin="5,5,0,0"><StackPanel Spacing="2"><TextBlock Text="round" Classes="label" /><TextBlock Text="{Binding PackLoop}" Classes="mono" FontSize="16" /></StackPanel></Border>
                </UniformGrid>
                <TextBlock Text="Fails loudly if d_min is not met: a cell below tolerance is never written." Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</p:PageBase>
