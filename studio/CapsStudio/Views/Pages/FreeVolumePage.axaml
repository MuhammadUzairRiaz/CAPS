<!-- CAPS Analyze › Free volume (design/boards/FreeVolume.dc.html): probe insertion on a grid, the largest voids drawn in
     the cell, the fractional free volume and the pore size distribution. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.FreeVolumePage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <v:AnalyzeSide DockPanel.Dock="Left" />
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnExport" IsEnabled="{Binding FvHasVoids}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export voids as PDB" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Analyze · free volume" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Probe insertion on a grid, with the distribution of void sizes" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Voids from the current frame; FFV and pore sizes over the chosen frames" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding FvFooter}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,420" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="current frame" /></Border>
              <TextBlock Text="Voids in the cell" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Panel Background="{DynamicResource Bg0B}">
            <v:MolView x:Name="View" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Left" IsVisible="{Binding FvHasVoids}">
              <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="{Binding FvChip}" /></StackPanel></Border>
            </StackPanel>
            <TextBlock IsVisible="{Binding !FvHasVoids}" Classes="dim" FontSize="12.5" Margin="16" VerticalAlignment="Bottom" TextWrapping="Wrap"
                       Text="Run to find the largest empty spheres: the distance to the nearest van der Waals surface is computed on the grid, and its maxima are taken biggest first without overlaps." />
          </Panel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <UniformGrid Columns="2">
            <Border Classes="pcard" Padding="14,12" Margin="0,0,5,0">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding FvFfv.Label}" FontSize="12" Foreground="{DynamicResource MutedB}" />
                <TextBlock Text="{Binding FvFfv.Value}" Classes="mono" FontSize="20" />
                <TextBlock Text="{Binding FvFfv.Caption}" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="pcard" Padding="14,12" Margin="5,0,0,0">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding FvAccessible.Label}" FontSize="12" Foreground="{DynamicResource MutedB}" />
                <TextBlock Text="{Binding FvAccessible.Value}" Classes="mono" FontSize="20" />
                <TextBlock Text="{Binding FvAccessible.Caption}" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Pore size distribution" FontSize="13.5" FontWeight="SemiBold" />
              <Panel Height="200">
                <v:LinePlot x:Name="Psd" XLabel="pore diameter (Å)" YLabel="fraction of free volume per Å" AutoRange="True" Bars="True" EmptyText="" />
                <TextBlock IsVisible="{Binding !FvHasPsd}" Classes="dim" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Run to compute" />
              </Panel>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" Text="Each free point takes the diameter of the largest atom-free sphere containing it (Gelb &amp; Gubbins)." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Method" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Probe radius · Å" Classes="label" /><NumericUpDown Value="{Binding FvProbe}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.0#" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Grid · Å" Classes="label" /><NumericUpDown Value="{Binding FvGrid}" Minimum="0.2" Maximum="2" Increment="0.1" FormatString="0.0#" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Voids drawn" Classes="label" /><NumericUpDown Value="{Binding FvCount}" Minimum="1" Maximum="500" Increment="10" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <StackPanel Spacing="6"><TextBlock Text="Atomic radii" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.FvRadiiModes}" SelectedIndex="{Binding FvRadii}" HorizontalAlignment="Stretch"
                ToolTip.Tip="The radii of the van der Waals spheres the probe must stay out of: Bondi's (the usual choice, and the one Bondi's FFV factor 1.3 belongs to), UFF's, or the Lennard-Jones size of the force field assigned in Field (consistent with the simulation's own repulsion)" /></StackPanel>
              <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                <TextBlock Text="{Binding FvRadiiCite}" FontSize="11.5" Foreground="{DynamicResource MutedB}" FontStyle="Italic" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="{Binding FvStatus}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
