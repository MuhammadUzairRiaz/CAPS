<!-- CAPS Studio › Analyze › Study table: results from several structures and runs in one sheet — formula columns, a chart of
     any column against another with a fit, and statistics (describe, correlations, regression, principal components). -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.StudyPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
    <Style Selector="TextBox.cell"><Setter Property="Width" Value="120" /><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="12" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TextBox.cell:readonly"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Open…" Click="OnLoad" />
          <Button Content="Save…" Click="OnSave" />
          <Button Content="Export CSV…" Click="OnExport" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Study table" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StudySummary}" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,420" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Background="{DynamicResource Bg2B}">
              <TextBlock Text="ROW" Classes="h3" Width="188" Padding="10,8" />
              <ItemsControl ItemsSource="{Binding Study.Columns}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudyColumn">
                    <Border Width="120" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,1" Padding="6,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" Padding="4,0" FontSize="11" Background="Transparent" Click="OnRemoveColumn" ToolTip.Tip="Remove the column" />
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}" />
                          <TextBlock Text="{Binding Formula}" FontSize="10" Classes="mono" Foreground="{DynamicResource AccB}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsFormula}" ToolTip.Tip="{Binding Header}" />
                          <TextBlock Text="{Binding Error}" FontSize="10" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Study.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StudyRow">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="×" Width="24" Padding="0" FontSize="11" Background="Transparent" Click="OnRemoveRow" ToolTip.Tip="Remove the row" />
                    <Border Width="164" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,1" Padding="6,3">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="↗" Padding="4,0" FontSize="11" Background="Transparent" IsVisible="{Binding HasPath}" Click="OnOpenRow"
                                ToolTip.Tip="{Binding Path}" />
                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                      </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudyCell">
                          <TextBox Classes="cell mono" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding ReadOnly}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Row" Margin="6" Click="OnAddRow" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Rows from" FontSize="13.5" FontWeight="SemiBold" />
              <WrapPanel>
                <Button Content="The open structure" Click="OnAddOpen" Margin="0,0,6,6" ToolTip.Tip="Atoms, mass, density, cell and the Analyze results shown now, as one row" />
                <Button Content="Batch results" Click="OnAddBatch" Margin="0,0,6,6" ToolTip.Tip="Every finished input of Analyze › Batch with its attributes" />
                <Button Content="Reader table" Click="OnAddReader" Margin="0,0,6,6" ToolTip.Tip="The table chosen in the Reader (a LAMMPS log, an xvg, a CSV)" />
                <Button Content="CSV file…" Click="OnImport" Margin="0,0,6,6" />
                <Button Content="Paste" Click="OnPaste" Margin="0,0,6,6" ToolTip.Tip="Rows copied from a spreadsheet (tab- or comma-separated; a first row of names becomes the columns)" />
              </WrapPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Columns are matched by name across sources; a row with a file opens it with ↗." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="New column" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding StudyNewName}" Watermark="name" />
                <TextBox Grid.Column="1" Text="{Binding StudyNewFormula}" Classes="mono" Watermark="formula, blank to type values" />
                <Button Grid.Column="2" Content="Add" Click="OnAddColumn" />
              </Grid>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Formulas use the columns to their left by name, or [name with spaces]: 1000 / [Tg (K)], ln(D), sqrt(a^2 + b^2), max(x, y). Constants pi, e, R, kB, NA." />
              <TextBlock Text="{Binding StudyError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding StudyHasError}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Chart" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                <TextBlock Text="Across (x)" Classes="label" /><TextBlock Grid.Column="1" Text="Up (y)" Classes="label" />
                <ComboBox Grid.Row="1" ItemsSource="{Binding StudyColumnNames}" SelectedIndex="{Binding StudyX}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StudyColumnNames}" SelectedIndex="{Binding StudyY}" HorizontalAlignment="Stretch" />
              </Grid>
              <v:LinePlot x:Name="Plot" Height="240" AutoRange="True" Markers="True" />
              <ComboBox ItemsSource="{x:Static vm:CurveFit.Models}" SelectedIndex="{Binding StudyFit}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding StudyFitText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Statistics" FontSize="13.5" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{x:Static vm:MainViewModel.StudyModes}" SelectedIndex="{Binding StudyMode}" HorizontalAlignment="Stretch" />
              <ItemsControl ItemsSource="{Binding StudyPicks}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudyPick">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Margin="0,0,10,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding StudyStatsText}" Classes="mono" FontSize="11" />
              </ScrollViewer>
              <Button Content="Add PC1 and PC2 as columns" Click="OnScores" IsVisible="{Binding StudyIsPca}" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Regression: y is the chart's Up column, the ticked columns predict it (least squares with an intercept; t = coefficient / standard error). Components: of the ticked columns, standardised. Rows missing a value in a chosen column are left out." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
