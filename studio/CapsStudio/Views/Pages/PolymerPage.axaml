<!-- CAPS Polymer builder (design/boards/PolymerBuilder.dc.html): library, repeat units, sequence, stereo; one chain previewed. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.PolymerPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="ListBox#Library ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="ListBox#Library ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg2B}" /></Style>
    <Style Selector="ListBox#Library ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg2B}" /></Style>
    <Style Selector="Border.unit"><Setter Property="Background" Value="{DynamicResource Bg2B}" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,10" /></Style>
  </p:PageBase.Styles>

  <Grid ColumnDefinitions="300,*,420">
    <!-- library -->
    <Border Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="10">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" Classes="chip" Content="Rubbers" IsChecked="{Binding LibraryRubberOnly}" />
              <TextBlock Text="Library" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox Text="{Binding LibraryQuery}" Watermark="Search name or SMILES" />
            <TextBlock Text="{Binding LibraryCount}" Classes="dim" />
          </StackPanel>
        </Border>
        <ListBox x:Name="Library" ItemsSource="{Binding LibraryShown}" Background="Transparent" Padding="8" DoubleTapped="OnLibraryUse">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryEntry">
              <StackPanel Margin="10,7" Spacing="2" ToolTip.Tip="Double-click: use it (a repeat unit goes into the chosen slot)">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="tool" Width="22" MinWidth="22" Height="22" MinHeight="22" Padding="0" Margin="4,0,0,0" IsVisible="{Binding User}"
                          Click="OnRemoveUserPolymer" Tag="{Binding}" ToolTip.Tip="Remove it from your polymers"><v:Icon Kind="trash" Size="12" /></Button>
                  <Border DockPanel.Dock="Right" Classes="chip" Height="18" IsVisible="{Binding HasKind}"><TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Smiles}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- preview -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <Panel>
        <v:MolView x:Name="Preview" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding PolyPreviewCaption}" FontSize="12" /></Border>
          <Border Classes="hud" Padding="10,4" IsVisible="{Binding PolyBuilding}"><TextBlock Text="building…" FontSize="12" Foreground="{DynamicResource AccB}" /></Border>
        </StackPanel>
        <Button Classes="small" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnPreview" IsEnabled="{Binding !PolyHasError}">
          <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="rotate" Size="13" VerticalAlignment="Center" /><TextBlock Text="Build preview" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </Panel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="16,12" Background="{DynamicResource Bg1B}">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PolyPreview}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
            <TextBlock Text="Sequence" Classes="h3" VerticalAlignment="Center" />
          </DockPanel>
          <v:SequenceStrip x:Name="Strip" Height="26" />
          <TextBlock Text="{Binding PolyError}" Classes="err" FontSize="12" IsVisible="{Binding PolyHasError}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- inspector -->
    <Border Grid.Column="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="48" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="small" Click="OnBlend" VerticalAlignment="Center" ToolTip.Tip="Blends of two or more polymers (NR/BR, SBR/BR …)">
              <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="grow" Size="13" VerticalAlignment="Center" /><TextBlock Text="Blend…" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <TextBlock Text="Polymer builder" Classes="h2" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Click="OnBuildOne" IsEnabled="{Binding !PolyHasError}" HorizontalAlignment="Stretch" ToolTip.Tip="One chain, opened as the Studio document">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="cube" Size="15" VerticalAlignment="Center" /><TextBlock Text="Build in document" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="primary" Click="OnSendGrow" IsEnabled="{Binding !PolyHasError}" HorizontalAlignment="Stretch" ToolTip.Tip="Grow a periodic cell of these chains">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="grow" Size="15" VerticalAlignment="Center" /><TextBlock Text="Send to CAPS Grow" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer>
          <StackPanel>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="small" Click="OnAddUnit" IsEnabled="{Binding PolyCanAdd}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="plus" Size="13" VerticalAlignment="Center" /><TextBlock Text="Unit" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <TextBlock Text="REPEAT UNITS" Classes="h3" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="Units" ItemsSource="{Binding PolyUnits}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PolyUnit">
                      <Border Classes="unit" PointerPressed="OnUnitPressed" Tag="{Binding}">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccB}">
                              <TextBlock Text="{Binding Letter}" Foreground="{DynamicResource AccInkB}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding Name}" Classes="bare" FontSize="13" FontWeight="Medium" Watermark="name" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="tool" Width="26" MinWidth="26" Height="26" MinHeight="26" Padding="0" Click="OnRemoveUnit" Tag="{Binding}" ToolTip.Tip="Remove this unit">
                              <v:Icon Kind="close" Size="13" />
                            </Button>
                          </Grid>
                          <TextBox Text="{Binding Smiles}" Classes="mono" FontSize="12" Watermark="*CC(*)c1ccccc1 — head first" />
                          <TextBlock Text="{Binding Info}" Classes="dim" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Error}" Classes="err" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                          <Grid ColumnDefinitions="Auto,90,*" ColumnSpacing="8" IsVisible="{Binding $parent[p:PolymerPage].((vm:MainViewModel)DataContext).PolyShowWeights}">
                            <TextBlock Text="Share" Classes="label" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Weight}" Minimum="0" Maximum="100" Increment="0.05" FormatString="0.###" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,90,*" ColumnSpacing="8" IsVisible="{Binding $parent[p:PolymerPage].((vm:MainViewModel)DataContext).CompShown}">
                            <TextBlock Text="Target %" Classes="label" VerticalAlignment="Center" ToolTip.Tip="The ratio you want, by moles or by weight as the composition below is set" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Target}" Minimum="0" Maximum="100" Increment="5" FormatString="0.##" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,90,*" ColumnSpacing="8" IsVisible="{Binding $parent[p:PolymerPage].((vm:MainViewModel)DataContext).PolyShowBlocks}">
                            <TextBlock Text="Block length" Classes="label" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Block}" Minimum="1" Maximum="2000" Increment="1" FormatString="0" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="Attachment points: the first * is the head, the second the tail; chains end in hydrogen." />
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="ARCHITECTURE" Classes="h3" />
                <WrapPanel>
                  <ToggleButton Classes="chip" Content="Linear" Tag="0" Click="OnArch" Margin="0,0,6,6"
                                IsChecked="{Binding PolyArch, Mode=OneWay, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                  <ToggleButton Classes="chip" Content="Branched" Tag="1" Click="OnArch" Margin="0,0,6,6" ToolTip.Tip="Random long-chain branches"
                                IsChecked="{Binding PolyArch, Mode=OneWay, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                  <ToggleButton Classes="chip" Content="Star" Tag="2" Click="OnArch" Margin="0,0,6,6" ToolTip.Tip="3 or 4 arms on one core carbon"
                                IsChecked="{Binding PolyArch, Mode=OneWay, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                  <ToggleButton Classes="chip" Content="Comb" Tag="3" Click="OnArch" Margin="0,0,6,6" ToolTip.Tip="A side chain on every n-th backbone unit"
                                IsChecked="{Binding PolyArch, Mode=OneWay, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=3}" />
                  <ToggleButton Classes="chip" Content="Dendrimer" Tag="4" Click="OnArch" Margin="0,0,6,6" ToolTip.Tip="A star core whose ends split in two, generation after generation"
                                IsChecked="{Binding PolyArch, Mode=OneWay, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=4}" />
                  <Button Classes="chip" Content="Network →" Click="OnNetwork" Margin="0,0,6,6" ToolTip.Tip="Networks are made by crosslinking a grown cell: React (C–C, sulfur or peroxide cures, epoxy–amine)" />
                </WrapPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding PolyHasCore}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Arms on the core" Classes="label" />
                    <NumericUpDown Value="{Binding PolyArms}" Minimum="3" Maximum="4" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Units per core arm" Classes="label" />
                    <TextBlock Text="{Binding GrowDpD, StringFormat='{}{0:0} (the DP below)'}" Classes="mono" VerticalAlignment="Center" Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding PolyHasSideChains}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding PolySideLabel}" Classes="label" />
                    <NumericUpDown Value="{Binding PolyArmDp}" Minimum="1" Maximum="500" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding PolyIsDendrimer}">
                    <TextBlock Text="Generations" Classes="label" />
                    <NumericUpDown Value="{Binding PolyGenerations}" Minimum="1" Maximum="6" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding PolyIsComb}">
                    <TextBlock Text="Every n-th backbone unit" Classes="label" />
                    <NumericUpDown Value="{Binding PolySpacing}" Minimum="1" Maximum="500" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding PolyIsBranched}">
                    <TextBlock Text="Branch probability per unit" Classes="label" />
                    <NumericUpDown Value="{Binding PolyBranchP}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding PolyArchNote}" IsVisible="{Binding !PolyIsLinear}" />
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="SEQUENCE" Classes="h3" />
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.SequenceKinds}" SelectedIndex="{Binding PolySequence}" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding PolyShowPattern}">
                  <TextBlock Text="Pattern" Classes="label" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding PolyPattern}" Classes="mono" Watermark="AAB" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Degree of polymerisation" Classes="label" />
                    <NumericUpDown Value="{Binding GrowDpD}" Minimum="2" Maximum="2000" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Name" Classes="label" />
                    <TextBox Text="{Binding PolyName}" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <v:SeedPicker DataContext="{Binding PolySeed}" ToolTip.Tip="The sequence and chain drawn: a fixed seed shows the same chain every time (the strip, the 3D preview and Build in document agree); new each run draws another on every change" />
                  <Button Content="New draw" Click="OnPolyRedraw" VerticalAlignment="Bottom" IsVisible="{Binding PolySeed.Fresh}" ToolTip.Tip="Draw another sequence and chain" />
                </StackPanel>
                <Button Content="Save to your library" Click="OnSaveToLibrary" HorizontalAlignment="Left"
                        ToolTip.Tip="This polymer (a repeat unit, or the copolymer with its sequence and shares) in your library, beside the built-in ones" />
                <!-- composition: the ratio wanted, by moles or weight, as unit shares and what a chain of this DP holds -->
                <StackPanel Spacing="8" IsVisible="{Binding CompShown}">
                  <TextBlock Text="COMPOSITION" Classes="h3" Margin="0,6,0,0" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="Target % of each unit" Classes="label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.CompBases}" SelectedIndex="{Binding CompBasis}" HorizontalAlignment="Stretch" />
                  </Grid>
                  <Grid ColumnDefinitions="22,*,56,62,112" ColumnSpacing="6">
                    <TextBlock Text="" /><TextBlock Grid.Column="1" Text="UNIT" Classes="h3" /><TextBlock Grid.Column="2" Text="MOL" Classes="h3" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="WEIGHT" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="EXACT · RANDOM" Classes="h3" HorizontalAlignment="Right" ToolTip.Tip="Units per chain: exact composition, and the mean ± one standard deviation when drawn at random" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding CompRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CompRow">
                        <Grid ColumnDefinitions="22,*,56,62,112" ColumnSpacing="6" Height="24">
                          <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Mol}" Classes="mono" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Wt}" Classes="mono" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding PerChain}" Classes="mono" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding CompText}" Classes="dim" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Use: random" Click="OnCompRandom" ToolTip.Tip="These mole fractions as the unit shares; each unit drawn on its own" />
                    <Button Content="Use: exact composition" Click="OnCompExact" ToolTip.Tip="Every chain holds exactly the counts shown, in random order" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="STEREO &amp; LINKAGE" Classes="h3" />
                <Border Classes="seg" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="seg" Content="Atactic" GroupName="tac" IsChecked="{Binding GrowTacticity, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                    <RadioButton Classes="seg" Content="Isotactic" GroupName="tac" IsChecked="{Binding GrowTacticity, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                    <RadioButton Classes="seg" Content="Syndiotactic" GroupName="tac" IsChecked="{Binding GrowTacticity, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="Auto,160,*" ColumnSpacing="8" IsVisible="{Binding GrowTacticity, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}">
                  <TextBlock Text="Dyads (m/r pattern)" Classes="label" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding PolyDyads}" Classes="mono" Watermark="e.g. mmr" ToolTip.Tip="The dyads along the chain, repeated: m keeps the previous unit's configuration, r mirrors it" />
                  <TextBlock Grid.Column="2" Text="{Binding PolyDyadsNote}" Classes="dim" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Linkage" Classes="label" />
                    <ComboBox SelectedIndex="{Binding PolyLinkage}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Head-to-tail" />
                      <ComboBoxItem Content="Head-to-head / tail-to-tail" ToolTip.Tip="Every second unit reversed: ~CH2–CHX–CHX–CH2~ (HH-polypropylene, HH-PVC)" />
                      <ComboBoxItem Content="Random reversals (defects)" ToolTip.Tip="Each unit reversed with the given chance: the regio-defects of PVDF, PVF, PPO" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PolyRandomLinkage}">
                      <NumericUpDown Value="{Binding PolyInversion}" Minimum="0" Maximum="100" Increment="1" FormatString="0.#" Width="110" />
                      <TextBlock Text="% of units reversed" Classes="dim" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="End groups (head / tail)" Classes="label" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.EndGroups}" SelectedIndex="{Binding HeadCap}" HorizontalAlignment="Stretch" ToolTip.Tip="The group on the chain's first unit (e.g. an initiator fragment); hydrogen by default" />
                      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.EndGroups}" SelectedIndex="{Binding TailCap}" HorizontalAlignment="Stretch" ToolTip.Tip="The group on the chain's last unit" />
                    </Grid>
                    <TextBlock Text="{Binding PolyEndsText}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Tacticity mirrors whole units: a meso dyad repeats the previous unit's configuration, a racemo dyad mirrors it. cis/trans double bonds come from the unit's SMILES (C/C=C\C is cis)." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</p:PageBase>
