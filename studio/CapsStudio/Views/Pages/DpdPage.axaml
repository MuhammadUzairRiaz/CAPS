<!-- CAPS Studio › Polymer cell › Mesoscale (DPD): bead species (block sequences), χ between bead types, a DPD run
     (Groot–Warren); the segregation over the run, S(q) with the domain spacing, the beads in the view. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.DpdPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <v:SeedPicker DataContext="{Binding DpdSeed}" ShowLabel="False" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding DpdRunning}" />
          <Button Classes="primary" Click="OnRun" IsEnabled="{Binding Idle}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run DPD" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Mesoscale · dissipative particle dynamics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Block copolymers, blends and solutions as coarse beads: microdomains and their spacing from χ (Groot &amp; Warren 1997)" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding DpdProgress}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="420,*" ColumnSpacing="14" Margin="22,18">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Content="Add" Click="OnAddSpecies" />
                <TextBlock Text="Species" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="*,120,80,Auto" ColumnSpacing="8">
                <TextBlock Text="Name" Classes="label" /><TextBlock Grid.Column="1" Text="Beads" Classes="label" /><TextBlock Grid.Column="2" Text="Molecules" Classes="label" />
              </Grid>
              <ItemsControl ItemsSource="{Binding DpdSpecies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DpdSpeciesRow">
                    <Grid ColumnDefinitions="*,120,80,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                      <TextBox Text="{Binding Name}" />
                      <TextBox Grid.Column="1" Text="{Binding Sequence}" Classes="mono" Watermark="A5B5" ToolTip.Tip="One letter per bead type (A–Z); A5B5 = five A then five B" />
                      <NumericUpDown Grid.Column="2" Value="{Binding Count}" Minimum="1" FormatString="0" />
                      <Button Grid.Column="3" Classes="small" Content="×" Click="OnRemoveSpecies" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Content="Add" Click="OnAddChi" />
                <TextBlock Text="χ between bead types" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding DpdChis}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DpdChiRow">
                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                      <TextBox Text="{Binding Pair}" Classes="mono" Watermark="AB" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Chi}" Increment="0.1" FormatString="0.00" />
                      <Button Grid.Column="2" Classes="small" Content="×" Click="OnRemoveChi" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Like beads repel with a = 75 kT/ρ (25 at ρ = 3); unlike pairs with a + χ/0.286 (Groot &amp; Warren's mapping at ρ = 3). The order–disorder transition of a symmetric diblock is near χN ≈ 10.5; pairs not listed have χ = 0." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Run" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Text="Steps (dt 0.04)" Classes="label" /><TextBlock Grid.Column="1" Text="Density ρ" Classes="label" /><TextBlock Grid.Column="2" Text="r_c · Å" Classes="label" />
                <NumericUpDown Grid.Row="1" Value="{Binding DpdSteps}" Minimum="100" Increment="5000" FormatString="0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DpdDensity}" Minimum="1" Maximum="10" Increment="1" FormatString="0.#" />
                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding DpdRc}" Minimum="1" Maximum="50" Increment="0.5" FormatString="0.00" ToolTip.Tip="The length a bead's cut-off stands for, for the view (6.46 Å: three waters per bead)" />
              </Grid>
              <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                <TextBlock Text="Chain stiffness k_θ (kT) · k_θ (1 + cos θ) at each middle bead" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap" />
                <NumericUpDown Grid.Column="1" Value="{Binding DpdAngleK}" Minimum="0" Maximum="50" Increment="1" FormatString="0.#"
                               ToolTip.Tip="0: flexible chains; a few kT: semiflexible (rigid rods, liquid-crystalline blocks)" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding DpdHasError}">
            <TextBlock Text="{Binding DpdError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrB}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
              <TextBlock Text="Segregation ψ" Classes="label" /><TextBlock Grid.Column="1" Text="Domain spacing" Classes="label" /><TextBlock Grid.Column="2" Text="kT" Classes="label" />
              <TextBlock Grid.Row="1" Text="{Binding DpdOrder}" Classes="mono" FontSize="18" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DpdSpacing}" Classes="mono" FontSize="18" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DpdKt}" Classes="mono" FontSize="18" />
            </Grid>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding DpdDomains, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="4">
              <TextBlock Text="Domains at the end" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DpdDomains}" Classes="mono" TextWrapping="Wrap" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Cells about r_c wide where one type outnumbers the other, joined through their faces (periodic): one domain holding nearly all of its type's cells is a continuous phase." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Segregation over the run (0 mixed, 1 separated)" FontSize="13.5" FontWeight="SemiBold" />
              <v:LinePlot x:Name="Order" Height="150" XLabel="step" YLabel="ψ" AutoRange="True" />
              <TextBlock Text="Structure factor of the first bead type" FontSize="13.5" FontWeight="SemiBold" />
              <v:LinePlot x:Name="Sq" Height="150" XLabel="q (1/r_c)" YLabel="S(q)" AutoRange="True" />
              <TextBlock Text="{Binding DpdNote}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
