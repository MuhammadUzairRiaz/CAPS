<!-- CAPS React (design/boards/React.dc.html): templates and protocol; conversion and gel point; Flory–Stockmayer; system. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ReactPage" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*" Margin="22,16,22,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="React · crosslinking" Classes="title" />
        <TextBlock Text="Form bonds by distance, retype, relax, and track the gel point" Classes="muted" />
        <v:StructurePicker ShowResultOption="False" Margin="0,8,0,0" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnSave" IsEnabled="{Binding HasDocument}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save network…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCopyPython" ToolTip.Tip="This run on the open structure as a Python script (the caps package), with these settings">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="copy" Size="16" VerticalAlignment="Center" /><TextBlock Text="Copy as Python" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnQueue" IsVisible="{Binding !Idle}" ToolTip.Tip="Queue this run with the settings as they are now; it starts when the current run ends (Jobs lists it)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="plus" Size="15" VerticalAlignment="Center" /><TextBlock Text="Queue" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <ComboBox ItemsSource="{Binding RunWhereChoices}" SelectedIndex="{Binding RunWhereIndex}" IsVisible="{Binding HasHosts}" MinWidth="150" VerticalAlignment="Center"
                  ToolTip.Tip="Where the run goes: this machine, or a host from Settings › Compute &amp; remote (the result comes back to Jobs)" />
        <Button Classes="primary" Click="OnRun" IsEnabled="{Binding CanReact}" IsVisible="{Binding !Reacting}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="react" Size="16" VerticalAlignment="Center" /><TextBlock Text="Crosslink" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding Reacting}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="stop" Size="16" VerticalAlignment="Center" /><TextBlock Text="Stop" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="480,*,360" ColumnSpacing="16">
      <ScrollViewer>
        <StackPanel Spacing="16" IsEnabled="{Binding !Reacting}">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="small" Content="Editor…" Click="OnTemplateEditor" ToolTip.Tip="Draw, check and test the templates" />
                  <Border DockPanel.Dock="Right" Classes="chip" Margin="0,0,6,0"><TextBlock Text="atom-mapped" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="Reaction templates" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.ReactionSets}" SelectedIndex="{Binding RxSet}" HorizontalAlignment="Stretch" />
                <!-- sulfur donors: H–Sx–H, x fixed or spread, dosed in phr (the cure then makes C–Sx–C bridges) -->
                <Border Classes="inset" IsVisible="{Binding RxShowInsert}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="SULFUR DONORS" Classes="h3" />
                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                      <TextBlock Text="Sx from" Classes="label" /><TextBlock Grid.Column="1" Text="to" Classes="label" /><TextBlock Grid.Column="2" Text="Sulfur · phr" Classes="label" />
                      <NumericUpDown Grid.Row="1" Value="{Binding RxSxMinD}" Minimum="1" Maximum="8" Increment="1" FormatString="0" ShowButtonSpinner="False" ToolTip.Tip="Sulfur atoms per donor H–Sx–H (1: H2S, a monosulfide bridge)" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RxSxMaxD}" Minimum="1" Maximum="8" Increment="1" FormatString="0" ShowButtonSpinner="False" ToolTip.Tip="The same for one length; a range draws x evenly (random sulfur chains)" />
                      <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding RxPhrD}" Minimum="0.01" Increment="0.5" FormatString="0.##" ShowButtonSpinner="False" ToolTip.Tip="Parts of sulfur per hundred of rubber (the cell's mass)" />
                      <Button Grid.Row="1" Grid.Column="3" Classes="small" Content="Insert" Click="OnInsertSulfur" IsEnabled="{Binding CanReact}" />
                    </Grid>
                    <TextBlock Text="{Binding RxSulfurText}" Classes="dim" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding RxInsertSmiles}" Classes="mono" Watermark="SS" ToolTip.Tip="Or any curative as SMILES" />
                      <NumericUpDown Grid.Column="1" Value="{Binding RxInsertCount}" Minimum="1" Increment="1" FormatString="0" ShowButtonSpinner="False" ToolTip.Tip="How many" />
                      <Button Grid.Column="2" Classes="small" Content="Insert" Click="OnInsertCurative" IsEnabled="{Binding CanReact}" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBox Text="{Binding RxText}" AcceptsReturn="True" Classes="mono" FontSize="11.5" MinHeight="160" MaxHeight="300" TextWrapping="NoWrap" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <ComboBox ItemsSource="{x:Static vm:MainViewModel.RxBuiltinLabels}" SelectedIndex="{Binding RxAddIndex}" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Classes="small" Content="Add reaction" Click="OnAddReaction" ToolTip.Tip="Run this reaction together with the others in the text" />
                  <Button Grid.Column="2" Classes="small" Content="Import LAMMPS…" Click="OnImportBondReact" ToolTip.Tip="A fix bond/react set (pre, post, map; the data file for the elements) as a CAPS reaction" />
                </Grid>
                <!-- several reactions: automatic by distance, or by relative weights -->
                <StackPanel Spacing="6" IsVisible="{Binding RxSeveral}">
                  <TextBlock Text="SEVERAL REACTIONS" Classes="h3" />
                  <RadioButton GroupName="rxsel" IsChecked="{Binding RxByDistance}" Content="Automatic: the closest reactive pairs first, whatever the reaction" />
                  <RadioButton GroupName="rxsel" IsChecked="{Binding RxByWeights}" Content="By relative rates (weights below)" />
                  <ItemsControl ItemsSource="{Binding RxReactions}" IsVisible="{Binding RxByWeights}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RxReaction">
                        <Grid ColumnDefinitions="*,90" Margin="0,2">
                          <TextBlock Text="{Binding Name}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" Value="{Binding WeightD}" Minimum="0.01" Increment="0.5" FormatString="0.##" ShowButtonSpinner="False" ToolTip.Tip="Relative rate" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="pre → post with mapped atoms; bonds form, break or move; the force field retypes after each cycle" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Network" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <CheckBox Classes="toggle" Content="Links only between different chains" IsChecked="{Binding RxBetweenChains}"
                          ToolTip.Tip="Each atom keeps the chain it started in; a curative belongs to the chains it has joined, so a crosslinker cannot close back onto the same chain" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Stop at" Classes="label" />
                  <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.RxTargetKinds}" SelectedIndex="{Binding RxTargetKind}" HorizontalAlignment="Stretch" />
                    <NumericUpDown Grid.Column="1" Value="{Binding RxTargetValueD}" Minimum="0.0001" Increment="1" FormatString="0.###" IsVisible="{Binding !RxTargetIsConversion}" ShowButtonSpinner="False" />
                  </Grid>
                  <TextBlock Text="{Binding RxTargetHelp}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Classes="toggle" Content="Keep byproducts (H₂, H₂O) as molecules in the cell" IsChecked="{Binding RxKeepByproducts}"
                          ToolTip.Tip="Off: the leaving atoms are removed; on: they stay as their own molecules (the force field must describe them)" />
                <CheckBox Classes="toggle" Content="Crosslink with the assigned force field" IsChecked="{Binding RxUseField}" />
                <TextBlock Text="{Binding RxFieldText}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Protocol" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <RadioButton Classes="choice" GroupName="rxp" IsChecked="{Binding RxPolymatic}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Polymatic cycle" FontWeight="SemiBold" />
                    <TextBlock Text="Abbott, Hart &amp; Colina, Theor. Chem. Acc. 132, 1334 (2013): react → retype → minimise → optional MD" Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="rxp" IsChecked="{Binding RxDuringMd}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="REACTER-style during MD" FontWeight="SemiBold" />
                    <TextBlock Text="One continuous NVT run, reactions checked at intervals, each reacted site settled locally with the rest held · after Gissinger, Jensen &amp; Wise, Polymer 128, 211 (2017)" Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="Capture (Å, 0 = template)" Classes="label" /><TextBlock Grid.Column="1" Text="Target conversion" Classes="label" /><TextBlock Grid.Column="2" Text="Cycles at most" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding RxCaptureD}" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.##" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RxTargetD}" Minimum="0.001" Maximum="1" Increment="0.05" FormatString="0.###" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding RxCyclesD}" Minimum="1" Increment="10" FormatString="0" />
                  <TextBlock Grid.Row="2" Text="Reactions per cycle" Classes="label" Margin="0,8,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RxMdLabel}" Classes="label" Margin="0,8,0,0" /><TextBlock Grid.Row="2" Grid.Column="2" Text="T (K)" Classes="label" Margin="0,8,0,0" />
                  <NumericUpDown Grid.Row="3" Value="{Binding RxPerCycleD}" Minimum="1" Increment="1" FormatString="0" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding RxMdPsD}" Minimum="0" Increment="0.1" FormatString="0.##" IsEnabled="{Binding RxMdEnabled}" />
                  <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding RxTempD}" Minimum="1" Increment="10" FormatString="0" IsEnabled="{Binding RxMdEnabled}" />
                </Grid>
                <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                  <CheckBox Classes="toggle" Content="Auto capture: widen when no pair is found, up to" IsChecked="{Binding RxAutoCapture}" />
                  <NumericUpDown Grid.Column="1" Value="{Binding RxCaptureMaxD}" Minimum="1" Maximum="20" Increment="0.5" FormatString="0.# Å" IsEnabled="{Binding RxAutoCapture}" ShowButtonSpinner="False" />
                </Grid>
                <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                  <CheckBox Classes="toggle" Content="Relax after each cycle" IsChecked="{Binding RxRelax}" />
                  <NumericUpDown Grid.Column="1" Value="{Binding RxSeedD}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Seed" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="3*,2*,2*" RowSpacing="16">
        <v:LiveRunView />
        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="38,*">
            <Border Classes="phead">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="chip" IsVisible="{Binding Reacting}"><TextBlock Text="reacting" Foreground="{DynamicResource AccB}" /></Border>
                <TextBlock Text="Links between chains" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <v:LinePlot Grid.Row="1" x:Name="ConvPlot" Margin="10,6,12,8" AutoRange="True" XLabel="cycle" YLabel="links (dashed: the target)" />
          </Grid>
        </Border>
        <Border Grid.Row="2" Classes="card">
          <Grid RowDefinitions="38,*">
            <Border Classes="phead"><TextBlock Text="Gel point" Classes="h2" VerticalAlignment="Center" /></Border>
            <v:LinePlot Grid.Row="1" x:Name="GelPlot" Margin="10,6,12,8" AutoRange="True" XLabel="conversion α" YLabel="largest cluster (mass fraction)" />
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="16">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Flory–Stockmayer check" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="10">
                <Border Classes="inset"><TextBlock Text="α_c = 1 / √( r (f_A − 1)(f_B − 1) )" Classes="mono" FontSize="13" HorizontalAlignment="Center" /></Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="r" Classes="label" /><TextBlock Grid.Column="1" Text="f_A" Classes="label" /><TextBlock Grid.Column="2" Text="f_B" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding RxRatioD}" Minimum="0.01" Maximum="1" Increment="0.05" FormatString="0.##" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RxFaD}" Minimum="1" Increment="1" FormatString="0.#" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding RxFbD}" Minimum="1" Increment="1" FormatString="0.#" />
                </Grid>
                <UniformGrid Columns="2">
                  <Border Classes="inset" Margin="0,0,5,0"><StackPanel Spacing="2"><TextBlock Text="α_c theory" Classes="label" /><TextBlock Text="{Binding RxAlphaC}" Classes="mono acc" FontSize="16" /></StackPanel></Border>
                  <Border Classes="inset" Margin="5,0,0,0"><StackPanel Spacing="2"><TextBlock Text="simulated gel point" Classes="label" /><TextBlock Text="{Binding RxGelText}" Classes="mono" FontSize="16" /></StackPanel></Border>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:Icon Kind="link" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Top" />
                  <TextBlock Text="Flory, J. Am. Chem. Soc. 63, 3083 (1941); Stockmayer, J. Chem. Phys. 11, 45 (1943). Simulated: peak of the reduced weight-average mass." Classes="dim" TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="System" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Structure" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Title}" Classes="mono" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" /></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Contents" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding HudInfo}" Classes="mono" FontSize="12" /></Grid>
                <TextBlock Text="{Binding ForceFieldLine}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Network" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="6">
                <TextBlock Text="{Binding RxLiveText}" Classes="mono acc" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Reacting}" />
                <TextBlock Text="{Binding RxNetworkText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
                <TextBlock Text="In the live view each chain keeps its colour as they join; the atoms of the links are highlighted." Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="LAMMPS fix bond/react" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="8">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="File stem" Classes="label" /><TextBlock Grid.Column="1" Text="Templates each" Classes="label" /><TextBlock Grid.Column="2" Text="MD steps" Classes="label" />
                  <TextBox Grid.Row="1" Text="{Binding RxBrStem}" Classes="mono" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RxVariantsD}" Minimum="1" Maximum="50" Increment="1" FormatString="0" ShowButtonSpinner="False"
                                 ToolTip.Tip="LAMMPS matches by atom type: one template per chemical environment of the reactive sites, the most frequent first" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding RxBrStepsD}" Minimum="1" Increment="10000" FormatString="0" ShowButtonSpinner="False" />
                </Grid>
                <Button Content="Write fix bond/react files…" Click="OnExportBondReact" IsEnabled="{Binding CanReact}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding RxBrText}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Report" Classes="h2" VerticalAlignment="Center" /></Border>
              <TextBlock Margin="16,12,16,16" Text="{Binding RxLog}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</p:PageBase>
