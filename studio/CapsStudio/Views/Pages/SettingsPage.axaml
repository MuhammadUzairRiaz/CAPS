<!-- CAPS Settings (design/boards/Settings.dc.html): appearance, the 3D view, force fields, compute, files. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.SettingsPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Button.tile.sel"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="Button.tile.sel:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MutedB}" />
    </Style>
    <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    </Style>
    <Style Selector="Button.nav.on"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="Border.swatch"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Setter Property="CornerRadius" Value="3" /></Style>
    <Style Selector="Ellipse.state"><Setter Property="Fill" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="Ellipse.state.ok"><Setter Property="Fill" Value="{DynamicResource OkB}" /></Style>
    <Style Selector="Ellipse.state.bad"><Setter Property="Fill" Value="{DynamicResource ErrB}" /></Style>
    <Style Selector="TextBlock.state"><Setter Property="Foreground" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="TextBlock.state.ok"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
    <Style Selector="TextBlock.state.bad"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
    <Style Selector="ListBox.hosts ListBoxItem"><Setter Property="Padding" Value="14,0" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="Background" Value="{DynamicResource Bg0B}" /></Style>
    <Style Selector="ListBox.hosts ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
  </p:PageBase.Styles>

  <Grid RowDefinitions="*,32">
    <Grid v:Panes.Split="True" ColumnDefinitions="240,*,380">
      <!-- categories -->
      <Border Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" Padding="12,16">
        <ItemsControl x:Name="Nav">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>

      <!-- the chosen category -->
      <ScrollViewer Grid.Column="1">
        <Panel Margin="40,34,40,34" MaxWidth="760" HorizontalAlignment="Left">
          <!-- Appearance -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}">
            <StackPanel Spacing="6">
              <TextBlock Text="Appearance" Classes="title" />
              <TextBlock Text="Theme, scale and colour palettes. Changes apply live and are saved per user." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Theme" Classes="h2" />
              <UniformGrid Columns="3" Margin="-6,0">
                <Button Classes="tile thumb" Classes.sel="{Binding ThemeDark}" Margin="6,0" Click="OnThemeDark">
                  <StackPanel>
                    <Border Height="96" Background="#0F1113" CornerRadius="10,10,0,0" ClipToBounds="True">
                      <Grid ColumnDefinitions="*,70" Margin="12">
                        <Border Background="#16191C" CornerRadius="4">
                          <Canvas Width="60" Height="40">
                            <Line StartPoint="20,24" EndPoint="36,14" Stroke="#A5ABB1" StrokeThickness="2" />
                            <Line StartPoint="36,14" EndPoint="44,30" Stroke="#A5ABB1" StrokeThickness="2" />
                            <Ellipse Canvas.Left="12" Canvas.Top="16" Width="16" Height="16" Fill="#8B969E" />
                            <Ellipse Canvas.Left="30" Canvas.Top="7" Width="12" Height="12" Fill="#E35049" />
                            <Ellipse Canvas.Left="38" Canvas.Top="24" Width="12" Height="12" Fill="#2271DB" />
                          </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="10,4,0,0">
                          <Border Height="4" Background="#A5ABB1" CornerRadius="2" />
                          <Border Height="4" Width="40" HorizontalAlignment="Left" Background="#868D94" CornerRadius="2" />
                          <Border Height="4" Background="#F0A83C" CornerRadius="2" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <TextBlock Text="Graphite (dark)" Margin="12,10" FontSize="12.5" />
                  </StackPanel>
                </Button>
                <Button Classes="tile thumb" Classes.sel="{Binding ThemeLight}" Margin="6,0" Click="OnThemeLight">
                  <StackPanel>
                    <Border Height="96" Background="#F4F2EE" CornerRadius="10,10,0,0" ClipToBounds="True">
                      <Grid ColumnDefinitions="*,70" Margin="12">
                        <Border Background="#FFFFFF" CornerRadius="4">
                          <Canvas Width="60" Height="40">
                            <Line StartPoint="20,24" EndPoint="36,14" Stroke="#6B7178" StrokeThickness="2" />
                            <Line StartPoint="36,14" EndPoint="44,30" Stroke="#6B7178" StrokeThickness="2" />
                            <Ellipse Canvas.Left="12" Canvas.Top="16" Width="16" Height="16" Fill="#8B969E" />
                            <Ellipse Canvas.Left="30" Canvas.Top="7" Width="12" Height="12" Fill="#E35049" />
                            <Ellipse Canvas.Left="38" Canvas.Top="24" Width="12" Height="12" Fill="#2271DB" />
                          </Canvas>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="10,4,0,0">
                          <Border Height="4" Background="#6B7178" CornerRadius="2" />
                          <Border Height="4" Width="40" HorizontalAlignment="Left" Background="#A5ABB1" CornerRadius="2" />
                          <Border Height="4" Background="#C9851F" CornerRadius="2" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <TextBlock Text="Paper (light)" Margin="12,10" FontSize="12.5" />
                  </StackPanel>
                </Button>
                <Button Classes="tile thumb" Classes.sel="{Binding ThemeSystem}" Margin="6,0" Click="OnThemeSystem">
                  <StackPanel>
                    <Grid Height="96" ColumnDefinitions="*,*" ClipToBounds="True">
                      <Border Background="#0F1113" CornerRadius="10,0,0,0" />
                      <Border Grid.Column="1" Background="#F4F2EE" CornerRadius="0,10,0,0" />
                      <Canvas Grid.ColumnSpan="2" Width="60" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line StartPoint="20,24" EndPoint="36,14" Stroke="#868D94" StrokeThickness="2" />
                        <Line StartPoint="36,14" EndPoint="44,30" Stroke="#868D94" StrokeThickness="2" />
                        <Ellipse Canvas.Left="12" Canvas.Top="16" Width="16" Height="16" Fill="#8B969E" />
                        <Ellipse Canvas.Left="30" Canvas.Top="7" Width="12" Height="12" Fill="#E35049" />
                        <Ellipse Canvas.Left="38" Canvas.Top="24" Width="12" Height="12" Fill="#2271DB" />
                      </Canvas>
                    </Grid>
                    <TextBlock Text="Match system" Margin="12,10" FontSize="12.5" />
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Interface scale" Classes="h2" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <Slider Minimum="80" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SetScale}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ScaleText}" Classes="mono" VerticalAlignment="Center" Width="48" TextAlignment="Right" />
                <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center"><TextBlock Text="Ctrl + / Ctrl −" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
              </Grid>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Element and category palette" Classes="h2" />
              <ItemsControl ItemsSource="{Binding PaletteChoices}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteChoice">
                    <Button Classes="tile" Padding="14,10" Click="OnPalette" Tag="{Binding Index}" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                      <StackPanel Orientation="Horizontal" Spacing="14">
                        <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><Border Classes="swatch" Background="{Binding}" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="PaletteNote" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Atoms, molecule and chain colours follow the palette in the view, the builder preview and exported figures. The monochrome palette separates elements by lightness alone, so figures read in greyscale." />
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Motion" Classes="h2" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" GroupName="motion" Content="Follow system" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=system}" />
                  <RadioButton Classes="seg" GroupName="motion" Content="Reduce" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=on}" />
                  <RadioButton Classes="seg" GroupName="motion" Content="Full" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=off}" />
                </StackPanel>
                <TextBlock Text="{Binding MotionText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
              </StackPanel>
              <Button Classes="small" Click="OnColourVision" HorizontalAlignment="Left" ToolTip.Tip="The palettes as seen with protanopia, deuteranopia and tritanopia, and a preview of the view">
                <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="eye" Size="14" VerticalAlignment="Center" /><TextBlock Text="Colour-vision check…" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- Units (design/boards/Units) -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=5}">
            <StackPanel Spacing="6">
              <TextBlock Text="Units &amp; number formats" Classes="title" />
              <TextBlock Text="How quantities are shown. Display only: files keep the units of their format, and every export states them." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Unit system" Classes="h2" />
              <ListBox ItemsSource="{Binding UnitSystems}" SelectedIndex="{Binding SetUnitSystem}" Background="Transparent" MaxWidth="560" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Per quantity" Classes="h2" />
              <Grid ColumnDefinitions="120,160" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Energy" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.EnergyUnits}" SelectedItem="{Binding SetUnitEnergy}" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="1" Text="Length" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.LengthUnits}" SelectedItem="{Binding SetUnitLength}" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2" Text="Pressure" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.PressureUnits}" SelectedItem="{Binding SetUnitPressure}" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="3" Text="Time" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.TimeUnits}" SelectedItem="{Binding SetUnitTime}" HorizontalAlignment="Stretch" />
              </Grid>
              <TextBlock Classes="dim" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Text="Applied to the Analyze results; the underlying values stay in CAPS units (Å, ps, kcal/mol, K, atm, g/cm³)." />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Conversions used by CAPS" Classes="h2" />
              <ItemsControl ItemsSource="{Binding UnitTable}" MaxWidth="700" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UnitRow">
                    <Grid ColumnDefinitions="120,140,*" Margin="0,3">
                      <TextBlock Text="{Binding Quantity}" Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding From}" Classes="mono" FontSize="12" />
                      <StackPanel Grid.Column="2"><TextBlock Text="{Binding Value}" Classes="mono" FontSize="12" /><TextBlock Text="{Binding Basis}" Classes="dim" /></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Number formats: thousands with a thin space (12 840 atoms), uncertainties as 1.041 ± 0.003 with no more digits than the error supports, exponents as 2.3 × 10⁻¹⁰ in the interface and e-notation in CSV, the minus sign U+2212 on screen and ASCII in files." />
            </StackPanel>
          </StackPanel>

          <!-- 3D view -->
          <!-- Accessibility (design/boards/Settings) -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=6}">
            <StackPanel Spacing="6">
              <TextBlock Text="Accessibility" Classes="title" />
              <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                         Text="Motion, contrast, focus and what a screen reader hears. Changes apply at once and are saved per user." />
            </StackPanel>
            <StackPanel Spacing="12">
              <TextBlock Text="Motion" Classes="h2" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="seg" GroupName="motion2" Content="Follow system" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=system}" />
                <RadioButton Classes="seg" GroupName="motion2" Content="Reduce" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=on}" />
                <RadioButton Classes="seg" GroupName="motion2" Content="Full" IsChecked="{Binding SetReduceMotion, Converter={x:Static v:StringEqualsConverter.Instance}, ConverterParameter=off}" />
              </StackPanel>
              <TextBlock Text="{Binding MotionText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Seeing and focus" Classes="h2" />
              <CheckBox Classes="toggle" Content="High-contrast outlines" IsChecked="{Binding SetHighContrast}"
                        ToolTip.Tip="Atom outlines in the view twice as wide and near-black (near-white on light), panel borders and secondary text firmer" />
              <CheckBox Classes="toggle" Content="Always show focus rings" IsChecked="{Binding SetFocusRings}"
                        ToolTip.Tip="An accent ring on the focused control after a click too, not only when Tab moved the focus" />
              <CheckBox Classes="toggle" Content="Show announcements in the view" IsChecked="{Binding ShowAnnouncement}"
                        ToolTip.Tip="What a screen reader hears while walking the atoms, also shown as a bar in the view for sighted keyboard users" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Screen readers" Classes="h2" />
              <CheckBox Classes="toggle" Content="Announce job progress to screen readers" IsChecked="{Binding SetAnnounceProgress}"
                        ToolTip.Tip="A running job (Grow, Dynamics, Equilibrate) is read out politely at 25, 50 and 75 %; a job that ends is always announced" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                         Text="Announcements are polite: they wait for the reader to finish. The 3D view is walked with the arrow keys ([ and ] the molecules, B the bonds)." />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="Shortcut conflicts" Classes="h2" />
              <TextBlock Classes="muted" FontSize="12" Text="None: your shortcuts leave the Studio's own keys as they are." IsVisible="{Binding !HasShortcutConflicts}" />
              <ItemsControl ItemsSource="{Binding ShortcutConflicts}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutConflict">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="620" HorizontalAlignment="Left">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="Resolve" Click="OnResolveConflict" Tag="{Binding}"
                                ToolTip.Tip="Your key goes; the Studio's own comes back" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="small" Content="Open shortcut editor" Click="OnOpenShortcuts" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>

          <!-- Python & scripting (design/boards/Settings) -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=7}">
            <StackPanel Spacing="6">
              <TextBlock Text="Python &amp; scripting" Classes="title" />
              <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                         Text="The interpreter macros, render overlays and Python pipeline steps run with, and how your own scripts and notebooks reach this Studio's caps package." />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Interpreter" Classes="h2" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="620" HorizontalAlignment="Left">
                <TextBox Text="{Binding SetPythonExe}" Classes="mono" Watermark="python3 (or CAPS_PYTHON)" />
                <Button Grid.Column="1" Content="Check" Click="OnCheckPython" IsEnabled="{Binding !PythonChecking}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="12"><Run Text="In use: " /><Run Text="{Binding PythonSource}" /></TextBlock>
              <TextBlock Text="{Binding PythonCheck}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Your own scripts and notebooks" Classes="h2" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                         Text="These two lines in a shell (or a notebook's environment) make import caps use this Studio's package and library; nothing is installed into the interpreter." />
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="620" HorizontalAlignment="Left" Background="{DynamicResource Bg0B}">
                <SelectableTextBlock Text="{Binding PythonShellLines}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
              </Border>
              <Button Classes="small" Content="Copy" Click="OnCopyPythonLines" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}">
            <StackPanel Spacing="6">
              <TextBlock Text="3D view" Classes="title" />
              <TextBlock Text="How structures are drawn when they open. The Studio's toolbar changes them for the session." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="18" ColumnSpacing="20" MaxWidth="620" HorizontalAlignment="Left">
              <TextBlock Text="Display style" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.Styles}" SelectedIndex="{Binding SetStyle}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Text="Background" VerticalAlignment="Center" />
              <Border Grid.Row="1" Grid.Column="1" Classes="seg" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" Content="Follow the theme" GroupName="bg" IsChecked="{Binding SetBackground, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                  <RadioButton Classes="seg" Content="Dark" GroupName="bg" IsChecked="{Binding SetBackground, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                  <RadioButton Classes="seg" Content="White" GroupName="bg" IsChecked="{Binding SetBackground, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Row="2" Text="Outlines" VerticalAlignment="Center" />
              <CheckBox Grid.Row="2" Grid.Column="1" Classes="toggle" IsChecked="{Binding SetOutlines}" />
              <TextBlock Grid.Row="3" Text="Depth cue" VerticalAlignment="Center" />
              <CheckBox Grid.Row="3" Grid.Column="1" Classes="toggle" IsChecked="{Binding SetDepthCue}" />
              <TextBlock Grid.Row="4" Text="GPU rendering" VerticalAlignment="Top" Margin="0,4,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                <CheckBox Classes="toggle" IsChecked="{Binding SetGpuView}" Content="Draw the 3D view with OpenGL (large structures turn smoothly)" />
                <TextBlock Text="{Binding GpuStatus}" Classes="dim" TextWrapping="Wrap" />
                <TextBlock Text="The same atoms, colours and shading as the CPU renderer; images, figures and movies are always rendered on the CPU." Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Force fields -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}">
            <StackPanel Spacing="6">
              <TextBlock Text="Force fields" Classes="title" />
              <TextBlock Text="The force field Field offers first, and the one the molecule builder cleans structures up with." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="20" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="Default force field" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Field.Library}" SelectedIndex="{Binding SetForceField}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FfEntry"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="2" Text="Electrostatics" VerticalAlignment="Center" />
              <Border Grid.Row="2" Grid.Column="1" Classes="seg" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="seg" Content="Damped shifted force" GroupName="elec" IsChecked="{Binding SetElectrostatics, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                  <RadioButton Classes="seg" Content="Particle-mesh Ewald" GroupName="elec" IsChecked="{Binding SetElectrostatics, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                </StackPanel>
              </Border>
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="10">
                <Grid ColumnDefinitions="Auto,86,Auto,80,Auto,72" ColumnSpacing="8" IsVisible="{Binding PmeOn}">
                  <TextBlock Text="Ewald tolerance 1e" Classes="label" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding SetEwaldExponent}" Minimum="-10" Maximum="-3" Increment="1" FormatString="0" />
                  <TextBlock Grid.Column="2" Text="Grid ≤ Å" Classes="label" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Value="{Binding SetPmeSpacing}" Minimum="0.3" Maximum="3" Increment="0.1" FormatString="0.0" />
                  <TextBlock Grid.Column="4" Text="Order" Classes="label" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="5" Value="{Binding SetPmeOrder}" Minimum="3" Maximum="10" Increment="1" FormatString="0" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                           Text="Particle-mesh Ewald sums the electrostatics of periodic cells in full (the reciprocal part runs in Fortran); cells without periodic faces keep the damped shifted force. Relax, Dynamics, Equilibrate, Analyze and the LAMMPS input all follow this choice." />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Library" VerticalAlignment="Top" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding Field.LibraryNote}" Classes="muted" />
                <TextBlock Text="{Binding LibraryPath}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Compute & remote (design/boards/RemoteCompute) -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=3}">
            <StackPanel Spacing="6">
              <TextBlock Text="Compute &amp; remote" Classes="title" />
              <TextBlock Text="Jobs run here, or on a remote host reached with SSH: the job's files go with it and the results come back with their provenance." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="20" MaxWidth="620" HorizontalAlignment="Left">
              <TextBlock Text="Worker threads" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <NumericUpDown Value="{Binding SetThreadsD}" Minimum="0" Maximum="64" Increment="1" FormatString="0" Width="110" />
                <TextBlock Text="{Binding ThreadsText}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" TextWrapping="Wrap" FontSize="12"
                         Text="0 uses one thread per core, up to 16. Each worker owns a fixed share of the work, so a run gives the same numbers for the same thread count." />
            </Grid>
            <CheckBox Classes="toggle" IsChecked="{Binding SetNotifyRuns}" Content="Tell me when a run of a minute or more ends (a system notification)" MaxWidth="620" HorizontalAlignment="Left"
                      ToolTip.Tip="macOS Notification Centre, or notify-send on Linux; Windows shows it in the Studio's status bar only" />
            <StackPanel Spacing="10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small" Click="OnAddHost"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="plus" Size="13" VerticalAlignment="Center" /><TextBlock Text="Add host" VerticalAlignment="Center" /></StackPanel></Button>
                <TextBlock Text="Hosts" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
              <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Classes="hosts" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HostRow">
                    <DockPanel Height="44">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Classes="state" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsError}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding State}" Classes="mono state" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsError}" FontSize="11.5" VerticalAlignment="Center" />
                      </StackPanel>
                      <v:Icon Kind="server" Size="18" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding HostEditable}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small ghost" Content="Remove host" Click="OnRemoveHost" />
                <TextBlock Text="{Binding HostTitle}" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="*,*,90" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Name" Classes="label" /><TextBox Text="{Binding HostName}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Hostname" Classes="label" /><TextBox Text="{Binding HostHostname}" FontFamily="{DynamicResource Mono}" Watermark="hpc-login2.example.edu" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Port" Classes="label" /><NumericUpDown Value="{Binding HostPort}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="User" Classes="label" /><TextBox Text="{Binding HostUser}" Watermark="username" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Scheduler" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.Schedulers}" SelectedItem="{Binding HostScheduler}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Default partition" Classes="label" /><TextBox Text="{Binding HostPartition}" Watermark="gpu" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="CAPS folder on the host" Classes="label" /><TextBox Text="{Binding HostRoot}" FontFamily="{DynamicResource Mono}" Watermark="~/CAPS"
                            ToolTip.Tip="Job folders (TITLE/KIND-N), bin/caps and the source live here; ~ is your home on the host" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Authentication" Classes="label" /><TextBox Text="SSH agent (no passwords stored)" IsReadOnly="True" Foreground="{DynamicResource MutedB}" /></StackPanel>
              </Grid>
              <!-- cluster jobs: what caps job writes into each job script (the host's ~/CAPS/host.json) -->
              <Border Classes="card" Padding="16" CornerRadius="10">
                <StackPanel Spacing="12">
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding HostPresetNames}" PlaceholderText="Start from…" MinWidth="200" SelectionChanged="OnHostPreset"
                              ToolTip.Tip="Generic starting points: they fill the scheduler, scratch and defaults; your account and modules are yours to add" />
                    <StackPanel Spacing="2">
                      <TextBlock Text="Jobs on this host" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="What each job asks the scheduler for. CAPS runs threads, not MPI ranks: one node, one task, this many cores." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{Binding HostIsQueue}">
                    <StackPanel Spacing="6"><TextBlock Text="Account / project" Classes="label" /><TextBox Text="{Binding HostAccount}" Watermark="(none)" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Cores per job" Classes="label" /><NumericUpDown Value="{Binding HostCpus}" Minimum="1" Maximum="4096" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Memory per core" Classes="label" /><TextBox Text="{Binding HostMem}" Watermark="2G" FontFamily="{DynamicResource Mono}" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="6"><TextBlock Text="Time limit" Classes="label" /><TextBox Text="{Binding HostTime}" Watermark="24:00:00" FontFamily="{DynamicResource Mono}" /></StackPanel>
                  </Grid>
                  <NumericUpDown Value="{Binding HostCpus}" Minimum="1" Maximum="4096" FormatString="0" IsVisible="{Binding !HostIsQueue}" HorizontalAlignment="Left" Width="160" ToolTip.Tip="Threads per run on the workstation" />
                  <TextBlock Text="{Binding HostNodeText}" Classes="muted" FontSize="12" />
                  <Grid ColumnDefinitions="*,*,90" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Scratch" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.ScratchKinds}" SelectedIndex="{Binding HostScratchIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HostUsesWorkspace}"><TextBlock Text="Workspace file system (-F)" Classes="label" /><TextBox Text="{Binding HostWsFilesystem}" Watermark="(the site's default)" FontFamily="{DynamicResource Mono}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6" IsVisible="{Binding HostUsesWorkspace}"><TextBlock Text="Days" Classes="label" /><NumericUpDown Value="{Binding HostWsDays}" Minimum="1" Maximum="365" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HostUsesScratchVar}"><TextBlock Text="Scratch variable or path" Classes="label" /><TextBox Text="{Binding HostScratchVar}" Watermark="$SCRATCH" FontFamily="{DynamicResource Mono}" /></StackPanel>
                  </Grid>
                  <CheckBox Content="Keep the workspace after a job (it is released only after the results were copied back)" IsChecked="{Binding HostKeepWorkspace}" IsVisible="{Binding HostUsesWorkspace}" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Modules for jobs" Classes="label" />
                      <TextBox Text="{Binding HostModules}" AcceptsReturn="True" MinHeight="54" FontFamily="{DynamicResource Mono}" FontSize="12" Watermark="module purge&#10;module load GCC" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Modules for building caps" Classes="label" />
                      <TextBox Text="{Binding HostBuildModules}" AcceptsReturn="True" MinHeight="54" FontFamily="{DynamicResource Mono}" FontSize="12" Watermark="module purge&#10;module load GCC CMake" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,2*" ColumnSpacing="10" IsVisible="{Binding HostIsQueue}">
                    <StackPanel Spacing="6"><TextBlock Text="Mail (optional)" Classes="label" /><TextBox Text="{Binding HostMailType}" Watermark="END,FAIL" FontFamily="{DynamicResource Mono}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Mail address (optional)" Classes="label" /><TextBox Text="{Binding HostMailUser}" Watermark="(no mail)" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="small" Click="OnTestHost" IsEnabled="{Binding HostIdle}" Margin="0,0,8,6"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="link" Size="13" VerticalAlignment="Center" /><TextBlock Text="Test connection" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Classes="small" Click="OnInstallCaps" IsEnabled="{Binding HostInstallIdle}" Margin="0,0,8,6"
                        ToolTip.Tip="Builds the caps command line on the host at this Studio's version, as a short job (never on the login node when there is a queue)"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="download" Size="13" VerticalAlignment="Center" /><TextBlock Text="Install / update caps" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Classes="small" Click="OnFindHostJobs" IsEnabled="{Binding HostIdle}" Margin="0,0,8,6"
                        ToolTip.Tip="Jobs started on the host with caps job new appear in Jobs and are followed like the Studio's own"><StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="search" Size="13" VerticalAlignment="Center" /><TextBlock Text="Find my jobs" VerticalAlignment="Center" /></StackPanel></Button>
              </WrapPanel>
              <TextBlock Text="{Binding HostTestText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding HostInstallText}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="small ghost" Content="Reset" Click="OnResetTemplate" IsEnabled="{Binding HostEditable}" />
                <Border DockPanel.Dock="Right" Classes="chip" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="editable" Foreground="{DynamicResource MutedB}" /></Border>
                <TextBlock Text="Job script" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding HostJobScript}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource Mono}" FontSize="11.5" MinHeight="220" MaxHeight="420" IsEnabled="{Binding HostEditable}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                         Text="{}The selected host's job script. {title} {job} {jobdir} {account} {partition} {cpus} {mem} {time} {mail_lines} {modules} {scratch_setup} {command} {keep_workspace} {array} {caps} are filled for each job; a #SBATCH or #PBS line whose value is empty is left out. Reset returns to the built-in script for the host's scheduler." />
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="Transfers" Classes="h2" />
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="20" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Upload" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Column="1" Text="inputs + recipe, hashed (sha256)" Classes="mono" FontSize="12" />
                <TextBlock Grid.Row="1" Text="Download" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="outputs + provenance manifest" Classes="mono" FontSize="12" />
                <TextBlock Grid.Row="2" Text="Large trajectories" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="stay remote until opened" Classes="mono" FontSize="12" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- Files -->
          <StackPanel Spacing="22" IsVisible="{Binding SettingsTab, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=4}">
            <StackPanel Spacing="6">
              <TextBlock Text="Files" Classes="title" />
              <TextBlock Text="What CAPS keeps, and where." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="20" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="Settings" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsPath}" Classes="mono" FontSize="12" />
              <TextBlock Grid.Row="1" Text="Recent files" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding RecentPath}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                <Button Classes="small" Content="Clear the list" Click="OnClearRecent" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Force-field library" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LibraryPath}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="Samples" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SamplesPath}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
            </Grid>
            <StackPanel Spacing="8">
              <TextBlock Text="Updates" Classes="h2" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="small" Content="Check for updates" Click="OnCheckUpdates" IsEnabled="{Binding !UpdateChecking}" />
                <TextBlock Text="{Binding UpdateText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="dim" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                         Text="CAPS looks for a new release only when you ask (the project's GitHub releases); it never installs anything by itself." />
            </StackPanel>
          </StackPanel>
        </Panel>
      </ScrollViewer>

      <!-- right: shortcuts -->
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="0,34,40,16">
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <TextBlock Text="Keyboard" Classes="h2" VerticalAlignment="Center" />
            </Border>
            <ItemsControl x:Name="Keys" Margin="16,10,16,12" />
          </StackPanel>
        </Border>
        <!-- Your shortcuts: a key for any command of the palette -->
        <Border Classes="card" CornerRadius="10">
          <StackPanel>
            <Border Height="42" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Your shortcuts" Classes="h2" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Button Classes="link" Content="Export…" FontSize="11.5" Click="OnExportShortcuts" ToolTip.Tip="Your keys as a JSON file (caps-shortcuts), to carry to another machine or share" />
                  <Button Classes="link" Content="Import…" FontSize="11.5" Click="OnImportShortcuts" ToolTip.Tip="Keys from a caps-shortcuts JSON file join yours" />
                  <Button Classes="link" Content="Reset" FontSize="11.5" Click="OnResetShortcuts" ToolTip.Tip="Remove every key you set" />
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Margin="16,10,16,12" Spacing="8">
              <TextBox Text="{Binding ShortcutFilter}" Watermark="Find a command to give a key…" FontSize="12.5" />
              <ItemsControl ItemsSource="{Binding ShortcutRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutRow">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" MinHeight="36" Margin="0,2">
                      <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" />
                        <TextBlock Text="{Binding Section}" Classes="dim" FontSize="10.5" />
                      </StackPanel>
                      <Border Grid.Column="1" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                              >
                        <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="{DynamicResource MutedB}" />
                      </Border>
                      <Button Grid.Column="2" Classes="small" Content="{Binding ButtonText}" Click="OnRecordShortcut" Tag="{Binding}" MinWidth="64" />
                      <Button Grid.Column="3" Classes="icon small" Click="OnClearShortcut" Tag="{Binding}" IsVisible="{Binding HasGesture}" ToolTip.Tip="Remove this key">
                        <v:Icon Kind="close" Size="12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ShortcutNote}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasShortcutNote}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- footer -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}">
          <Run Text="Settings saved to " /><Run Text="{Binding SettingsPath}" />
        </TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="link" Content="Export" Click="OnExport" FontSize="11.5" />
          <TextBlock Text="·" Classes="dim" VerticalAlignment="Center" />
          <Button Classes="link" Content="Import" Click="OnImport" FontSize="11.5" />
          <TextBlock Text="·" Classes="dim" VerticalAlignment="Center" />
          <Button Classes="link" Content="Reset" Click="OnReset" FontSize="11.5" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</p:PageBase>
