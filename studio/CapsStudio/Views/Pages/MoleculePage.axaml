<!-- CAPS Molecule (design/boards/Sketch.dc.html): the molecule's identifiers, properties, conformers and what to do with it,
     in the inspector column; the sketch docks left of the Studio view (MoleculeSketchPane). -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.MoleculePage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg2B}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg1B}" />
    </Style>
  </p:PageBase.Styles>

  <Grid>
    <!-- inspector -->
    <Border Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="48" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
          <TextBlock Text="Structure" Classes="h2" VerticalAlignment="Center" />
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
          <!-- Save and Use in Pack share row 0; Open in Studio gets its own full-width row so the Use in Pack label is not squeezed -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="OnUseAsUnit" IsEnabled="{Binding MolIsRepeatUnit}" ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="A SMILES with two * (head, then tail) becomes unit A of the Polymer builder">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="grow" Size="16" VerticalAlignment="Center" /><TextBlock Text="Use as repeat unit" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Click="OnSave" IsEnabled="{Binding MolCanUse}" ToolTip.Tip="Save the chosen conformer (mol2, PDB, XYZ or LAMMPS data)">
              <v:Icon Kind="save" Size="16" />
            </Button>
            <Button Grid.Column="1" Click="OnPack" IsEnabled="{Binding MolCanUse}" HorizontalAlignment="Stretch" ToolTip.Tip="Save it and add it to Pack's list of molecules">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="pack" Size="16" VerticalAlignment="Center" /><TextBlock Text="Use in Pack" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="OnInsertIntoDocument" IsEnabled="{Binding MolCanUse}" ToolTip.Tip="Put the chosen conformer into the structure open in Studio: click where it goes (the wheel turns it)">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="fragment" Size="16" VerticalAlignment="Center" /><TextBlock Text="Insert into document" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Classes="primary" Click="OnOpenInStudio" IsEnabled="{Binding MolCanUse}" ToolTip.Tip="Open the chosen conformer as the Studio document">
              <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="plus" Size="16" VerticalAlignment="Center" /><TextBlock Text="Open in Studio" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer>
          <StackPanel>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="IDENTIFIERS" Classes="h3" />
                <StackPanel Spacing="6">
                  <TextBlock Text="SMILES" Classes="label" />
                  <TextBox Text="{Binding MolSmiles}" Classes="mono" Watermark="e.g. C=Cc1ccccc1" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding MolError}" Classes="err" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding MolHasError}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14" IsVisible="{Binding MolHasDoc}">
              <StackPanel Spacing="8">
                <TextBlock Text="CONFORMERS" Classes="h3" />
                <Grid ColumnDefinitions="36,76,*" Margin="10,0">
                  <TextBlock Text="#" Classes="h3" FontSize="10" />
                  <TextBlock Grid.Column="1" Text="E REL." Classes="h3" FontSize="10" HorizontalAlignment="Right" Margin="0,0,14,0" />
                  <TextBlock Grid.Column="2" Text="METHOD" Classes="h3" FontSize="10" />
                </Grid>
                <ListBox ItemsSource="{Binding MolConformers}" SelectedIndex="{Binding MolConf}" Background="Transparent" MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConformerRow">
                      <Grid ColumnDefinitions="36,76,*" Margin="10,0" Height="32">
                        <TextBlock Text="{Binding Number}" Classes="mono" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Energy}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Method}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="kcal/mol above the lowest; the view shows the chosen one" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="ANALOGS (R GROUPS)" Classes="h3" />
                <TextBox Text="{Binding AnalogCore}" Classes="mono" Watermark="core with [*:1], [*:2] … e.g. c1cc([*:1])ccc1[*:2]" TextWrapping="Wrap" />
                <TextBox Text="{Binding AnalogGroups}" Classes="mono" AcceptsReturn="True" Height="64" Watermark="1: H, Cl, C(=O)O&#x0a;2: C, *OC"
                         ToolTip.Tip="One line per R group: its number, then the substituents (SMILES whose first atom bonds to the core, or a leading * marking it; H for none)" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="small" Content="{Binding AnalogButton}" Click="OnAnalogs" IsEnabled="{Binding AnalogReady}" />
                  <TextBlock Text="{Binding AnalogText}" Classes="dim" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="PROPERTIES" Classes="h3" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="24,24,24,24,24" >
                  <TextBlock Text="Formula" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding MolFormula}" Classes="mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="Mol. weight" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MolMass}" Classes="mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Text="Atoms" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MolAtoms}" Classes="mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Text="Stereocentres" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MolStereo}" Classes="mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Text="Valence check" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MolValence}" Classes="mono" Classes.ok="{Binding MolOk}" Classes.err="{Binding MolHasError}"
                             VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="12">
                <TextBlock Text="3D EMBEDDING" Classes="h3" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Method" Classes="label" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.MolMethods}" SelectedIndex="{Binding MolMethod}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Distance bounds (Crippen–Havel, 4D → 3D as in ETKDG) with chirality, sp² planarity and E/Z; the rotor search then turns each rotatable bond to its staggered positions with the clean-up force field's own torsions (CAPS carries no CSD torsion table, so no ETKDG ‘ET’ term)" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Conformers" Classes="label" />
                    <NumericUpDown Value="{Binding MolConfCount}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="Clean with" Classes="label" />
                    <ComboBox ItemsSource="{Binding CleanChoices}" SelectedIndex="{Binding MolClean}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanChoice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Hydrogens" Classes="label" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.MolHydrogenModes}" SelectedIndex="{Binding MolHydrogens}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Add: implicit hydrogens from the organic-subset valences, placed by hybridisation. As written: only the atoms the SMILES names (for united-atom force fields such as TraPPE-UA)" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:Icon Kind="link" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" MaxWidth="340"
                             Text="Blaney &amp; Dixon, Rev. Comput. Chem. 5, 299 (1994); 4D → 3D as in Riniker &amp; Landrum, J. Chem. Inf. Model. 55, 2562 (2015)" />
                </StackPanel>
                <TextBlock Text="{Binding MolNotes}" Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <!-- coarse-grained: bead templates from the force field's sources, or bead SMILES -->
            <Border Classes="section" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="COARSE-GRAINED" Classes="h3" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Force field" Classes="label" />
                    <ComboBox ItemsSource="{Binding CgFfNames}" SelectedIndex="{Binding CgFf}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Template" Classes="label" />
                    <ComboBox ItemsSource="{Binding CgTemplates}" SelectedItem="{Binding CgTemplate}" IsEnabled="{Binding CgHasTemplates}" HorizontalAlignment="Stretch"
                              PlaceholderText="{Binding CgTemplateHint}" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="6">
                  <TextBlock Text="Bead SMILES" Classes="label" />
                  <TextBox Text="{Binding CgBeadText}" Classes="mono" TextWrapping="Wrap" Watermark="[Q0+1][Qa-1][Na]([Na][C1][C1])[C1][C1]" />
                </StackPanel>
                <Button Click="OnBuildBeads" HorizontalAlignment="Stretch" ToolTip.Tip="One site per bead, named by its type; bond lengths from the force field">
                  <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="atom" Size="16" VerticalAlignment="Center" /><TextBlock Text="Build beads" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="MARTINI and Dry MARTINI type bead structures by name. SDK also maps all-atom structures onto its beads in the Force field step (alkanes, lipids, water)." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</p:PageBase>
