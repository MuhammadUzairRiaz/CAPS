<!-- CAPS Grow (design/boards/Grow.dc.html): components, cell and growth method on the left; the live cell on the right. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.GrowPage" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*" Margin="22,16,22,16" RowSpacing="16">
    <!-- header -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Polymer cell · CAPS Grow" Classes="title" />
        <TextBlock Text="Makes new polymer chains: from repeat units, monomer by monomer, each chain grown inside a periodic cell at the density you set (an amorphous polymer or rubber, as Materials Studio's Amorphous Cell Construction). To put molecules you already have — solvent, gas, fillers, curatives — into a box or into this cell, use Packing. The cell can go straight to Export; Minimise and Dynamics are optional." Classes="muted" TextWrapping="Wrap" MaxWidth="900" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnSaveRecipe" ToolTip.Tip="This build as a YAML recipe: caps run RECIPE.yaml, or Start › From a recipe">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save recipe" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnSave" IsVisible="{Binding GrownUnsaved}" ToolTip.Tip="Save the grown cell (LAMMPS data, PDB or XYZ)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save cell…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCopyPython" ToolTip.Tip="This build in Python (the caps package); right-click for the caps command">
          <Button.ContextFlyout>
            <MenuFlyout>
              <MenuItem Header="Copy as Python" Click="OnCopyPython" />
              <MenuItem Header="Copy caps command" Click="OnCopyCommand" />
            </MenuFlyout>
          </Button.ContextFlyout>
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="copy" Size="16" VerticalAlignment="Center" /><TextBlock Text="Copy as Python" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="primary" Click="OnGrow" IsVisible="{Binding NotGrowing}" IsEnabled="{Binding Idle}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="16" VerticalAlignment="Center" /><TextBlock Text="Grow cell" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding Growing}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="stop" Size="16" VerticalAlignment="Center" /><TextBlock Text="Cancel" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="560,*" ColumnSpacing="16">
      <ScrollViewer x:Name="SettingsPane">
        <StackPanel Spacing="16" IsEnabled="{Binding NotGrowing}">
          <!-- Components -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding GrowDispersityChip}" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="Components" Classes="h2" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12" Spacing="10">
                <Grid ColumnDefinitions="*,86,86,110,80" ColumnSpacing="8">
                  <TextBlock Text="COMPONENT" Classes="h3" /><TextBlock Grid.Column="1" Text="CHAINS" Classes="h3" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="DP" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="DISPERSITY" Classes="h3" />
                  <TextBlock Grid.Column="4" Text="ATOMS" Classes="h3" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,86,86,110,80" ColumnSpacing="8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalAlignment="Center" ToolTip.Tip="{Binding GrowComponentName}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccB}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding GrowComponentName}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <NumericUpDown Grid.Column="1" Value="{Binding GrowChainsD}" Minimum="1" Maximum="2000" Increment="1" FormatString="0" ShowButtonSpinner="False" TextAlignment="Right" />
                  <NumericUpDown Grid.Column="2" Value="{Binding GrowDpD}" Minimum="2" Maximum="2000" Increment="1" FormatString="0" ShowButtonSpinner="False" TextAlignment="Right" />
                  <Button Grid.Column="3" Classes="small ghost" Click="OnDispersity" HorizontalAlignment="Left" ToolTip.Tip="Chain lengths from a distribution (Grow › Polydispersity)">
                    <TextBlock Text="{Binding GrowDispersityText}" Classes="mono" />
                  </Button>
                  <TextBlock Grid.Column="4" Text="{Binding GrowAtomsText}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding GrowSmall}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GrowSmallRow">
                      <Grid ColumnDefinitions="*,86,86,110,80" ColumnSpacing="8" Margin="0,2">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Fill="{DynamicResource SelB}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <NumericUpDown Grid.Column="1" Value="{Binding CountD}" Minimum="1" Maximum="100000" Increment="1" FormatString="0" ShowButtonSpinner="False" TextAlignment="Right"
                                       ToolTip.Tip="Molecules put into the free space after the chains" />
                        <TextBlock Grid.Column="2" Text="{Binding Smiles}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="after the chains" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Classes="ghost" Content="×" HorizontalAlignment="Right" Click="OnRemoveSmall" Tag="{Binding}" ToolTip.Tip="Remove" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel IsVisible="{Binding GrowPolydisperse}">
                  <Button DockPanel.Dock="Right" Classes="small ghost" Content="Monodisperse" Click="OnClearLengths" />
                  <TextBlock Text="{Binding GrowLengthsText}" Classes="dim" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel IsVisible="{Binding GrowHasStereo}">
                  <Button DockPanel.Dock="Right" Classes="small ghost" Content="Clear" Click="OnClearStereo" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="Atactic chains drawn from " /><Run Text="{Binding GrowStereoText}" /></TextBlock>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                  <Button Classes="small" Click="OnChoosePolymer" ToolTip.Tip="Any repeat units: homopolymers and copolymers, from the library or SMILES">
                    <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="plus" Size="14" VerticalAlignment="Center" /><TextBlock Text="Choose polymer…" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="small ghost" Click="OnUsePs" IsVisible="{Binding GrowHasSpec}" Content="Back to polystyrene" />
                </StackPanel>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="Solvent, gas or fillers in the grown cell: Pack › Pack into › Around the current structure." />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Force field (design/boards/PipelineGrow): chosen here, assigned when growing finishes -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip" IsVisible="{Binding GrowAssignField}"><TextBlock Text="assigned after growing" Foreground="{DynamicResource OkB}" /></Border>
                  <StackPanel Orientation="Horizontal" Spacing="8"><v:Icon Kind="tag" Size="15" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="Force field" Classes="h2" VerticalAlignment="Center" /></StackPanel>
                </DockPanel>
              </Border>
              <StackPanel Margin="16,12" Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Force field" Classes="muted" FontSize="11.5" />
                    <ComboBox ItemsSource="{Binding Field.Library}" SelectedIndex="{Binding GrowFfIndex}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Charges" Classes="muted" FontSize="11.5" />
                    <ComboBox ItemsSource="{x:Static vm:FieldViewModel.ChargeModes}" SelectedIndex="{Binding GrowChargeMode}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Grid>
                <CheckBox Classes="toggle" Content="Assign when growing finishes" IsChecked="{Binding GrowAssignField}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <v:Icon Kind="check" Size="15" Foreground="{DynamicResource OkB}" IsVisible="{Binding GrowFieldOk}" VerticalAlignment="Top" />
                  <v:Icon Kind="alert" Size="15" Foreground="{DynamicResource WarnB}" IsVisible="{Binding GrowFieldWarn}" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding GrowFieldLine}" FontSize="12" TextWrapping="Wrap" MaxWidth="470" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="small" Content="Assign now" Click="OnAssignField" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Type the structure in the viewer with this force field" />
                  <Button Classes="small" Content="Compare all force fields" Click="OnCompareFields" IsEnabled="{Binding HasDocument}"
                          ToolTip.Tip="Which library force fields describe this structure, and what the others lack (Force field step)" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Cell -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Cell" Classes="h2" VerticalAlignment="Center" /></Border>
              <Grid Margin="16,12,16,16" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Text="Size from" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding GrowSizeLabel}" Classes="label" />
                <TextBlock Grid.Column="2" Text="Shape" Classes="label" />
                <Border Grid.Row="1" Classes="seg">
                  <UniformGrid Columns="2">
                    <RadioButton Classes="seg" GroupName="gsize" Content="Density" IsChecked="{Binding GrowUseDensity}" Click="OnDensityMode" />
                    <RadioButton Classes="seg" GroupName="gsize" Content="Box" IsChecked="{Binding GrowUseBox}" />
                  </UniformGrid>
                </Border>
                <Panel Grid.Row="1" Grid.Column="1">
                  <NumericUpDown Value="{Binding GrowDensityD}" Minimum="0.01" Maximum="2" Increment="0.05" FormatString="0.000" IsVisible="{Binding GrowUseDensity}" />
                  <NumericUpDown Value="{Binding GrowBoxD}" Minimum="5" Maximum="500" Increment="1" FormatString="0.00" IsVisible="{Binding GrowUseBox}" />
                </Panel>
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{x:Static vm:MainViewModel.GrowShapes}" SelectedIndex="{Binding GrowShape}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="A periodic cube, a film with vacuum, chains in a cylinder along z (a pore), or around one (a place for a fibre); the edges follow from the density" />
                <TextBlock Grid.Row="2" Text="Tacticity" Classes="label" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Seed" Classes="label" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Contact scale" Classes="label" Margin="0,8,0,0" />
                <ComboBox Grid.Row="3" ItemsSource="{x:Static vm:MainViewModel.Tacticities}" SelectedIndex="{Binding GrowTacticity}" HorizontalAlignment="Stretch" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding GrowSeedD}" Minimum="0" Increment="1" FormatString="0" />
                <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding GrowScaleD}" Minimum="0.5" Maximum="1.2" Increment="0.05" FormatString="0.00"
                               ToolTip.Tip="Contacts closer than this fraction of the van der Waals sum are rejected; below 1 needs a push-off in Relax" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding GrowEstimate}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource DimB}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="Lower the contact scale when a chain cannot be placed (repeat-unit chains)" IsChecked="{Binding GrowAutoScale}" Margin="0,6,0,0"
                          ToolTip.Tip="Steps 0.85, 0.75, 0.7, 0.6 for crowded backbones (polyisobutylene, methacrylates); relax with push-off afterwards" />
              </Grid>
              <Grid Margin="16,0,16,16" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4" IsVisible="{Binding GrowHasRegion}">
                <TextBlock Text="{Binding GrowRegionALabel}" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding GrowRegionBLabel}" Classes="label" />
                <NumericUpDown Grid.Row="1" Value="{Binding GrowRegionAD}" Minimum="2" Maximum="500" Increment="1" FormatString="0.0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GrowRegionBD}" Minimum="0" Maximum="1000" Increment="5" FormatString="0.0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GrowRegionNote}" Classes="dim" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Growth method -->
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Growth method" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="8">
                <Border Classes="choice" Classes.on="{Binding GrowMethodIs0}" Tag="0" Tapped="OnMethod" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="radio" Classes.on="{Binding GrowMethodIs0}" VerticalAlignment="Center"><Ellipse /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="Self-avoiding growth, the roomiest trial" FontWeight="SemiBold" />
                      <TextBlock Text="All chains grown together, periodic contact checks against every placed atom, back-tracking and restarts; keeping the roomiest trial stretches chains (trans-rich)" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="choice" Classes.on="{Binding GrowMethodIs1}" Tag="1" Tapped="OnMethod" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="radio" Classes.on="{Binding GrowMethodIs1}" VerticalAlignment="Center"><Ellipse /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="Rosenbluth, soft spheres (Theodorou–Suter)" FontWeight="SemiBold" />
                      <TextBlock Text="A trial drawn by its Boltzmann weight: soft-sphere overlaps and Jorgensen's butane torsions · Macromolecules 18, 1467 (1985)" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="choice" Classes.on="{Binding GrowMethodIs2}" Tag="2" Tapped="OnMethod" Cursor="Hand">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="radio" Classes.on="{Binding GrowMethodIs2}" VerticalAlignment="Center"><Ellipse /></Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="Configurational-bias growth, Lennard-Jones" FontWeight="SemiBold" />
                      <TextBlock Text="Siepmann &amp; Frenkel's trial selection with UFF Lennard-Jones by element (not the Field assignment) · regrowth with the Field assignment and acceptance: Equilibrate › Chain ends · Mol. Phys. 75, 59 (1992)" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,120" ColumnSpacing="10" IsVisible="{Binding !GrowMethodIs0}">
                  <TextBlock Text="Temperature of the Boltzmann weights (K)" Classes="label" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding GrowMethodTempD}" Minimum="100" Maximum="2000" Increment="25" FormatString="0" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,4,0,0">
                  <StackPanel Spacing="4" ToolTip.Tip="Torsion and ring trials per growth step; the roomiest is kept">
                    <TextBlock Text="Trial directions k" Classes="label" /><NumericUpDown Value="{Binding GrowTrialsD}" Minimum="4" Maximum="5000" Increment="20" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Look-ahead" Classes="label" /><TextBlock Text="1 atom" Classes="mono" Margin="0,7,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" ToolTip.Tip="Unit templates are cleaned with the default force field (Settings), UFF where it cannot type them">
                    <TextBlock Text="Unit clean-up" Classes="label" /><TextBlock Text="{Binding GrowCleanFf}" Classes="mono" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <CheckBox Classes="toggle" Content="Live cell while growing" IsChecked="{Binding GrowLiveView}" />
                <CheckBox Classes="toggle" Content="Curved start (gauche-rich first bonds)" IsChecked="{Binding GrowCurve}" Margin="0,4,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Report" Classes="h2" VerticalAlignment="Center" /></Border>
              <TextBlock Margin="16,12,16,16" Text="{Binding GrowLog}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Live cell (while growing it takes the whole page, centred; the settings are locked then anyway) -->
      <Grid Grid.Column="1" x:Name="LivePane" RowDefinitions="*,Auto,Auto" RowSpacing="12">
        <Border Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="38,*">
            <Border Classes="phead">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Border Classes="chip" IsVisible="{Binding Growing}">
                    <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="growing" Foreground="{DynamicResource AccB}" /></StackPanel>
                  </Border>
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="seg" GroupName="gdisp" Content="All atoms" Tag="0" Click="OnDisplay" IsChecked="True" />
                      <RadioButton Classes="seg" GroupName="gdisp" Content="No H" Tag="3" Click="OnDisplay" />
                      <RadioButton Classes="seg" GroupName="gdisp" Content="Backbone" Tag="4" Click="OnDisplay" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock Text="Live cell" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Decorator Grid.Row="1" x:Name="ViewSlot" />
            <!-- while growing: the chains so far (snapshots from the grower), over the 3D view -->
            <Panel Grid.Row="1" IsVisible="{Binding GrowLiveShown}" Background="{DynamicResource Bg0B}">
              <v:MolView x:Name="LiveView" />
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Classes="chip" IsHitTestVisible="False">
                <TextBlock Text="{Binding GrowLiveAtoms}" Foreground="{DynamicResource MutedB}" />
              </Border>
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Classes="chip" IsHitTestVisible="False">
                <TextBlock Text="drag rotates · wheel zooms · double-click resets" Foreground="{DynamicResource MutedB}" />
              </Border>
            </Panel>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="1" Columns="3">
          <Border Classes="card" Margin="0,0,6,6" Padding="14,10">
            <StackPanel Spacing="3"><TextBlock Text="Chains grown" Classes="label" /><TextBlock Text="{Binding GrowDoneText}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="6,0,6,6" Padding="14,10">
            <StackPanel Spacing="3"><TextBlock Text="Units placed" Classes="label" /><TextBlock Text="{Binding GrowUnitsText}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="6,0,0,6" Padding="14,10">
            <StackPanel Spacing="3"><TextBlock Text="Restarts" Classes="label" /><TextBlock Text="{Binding GrowRestarts}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="0,6,6,6" Padding="14,10" ToolTip.Tip="Smallest (distance − contact limit) over the pairs accepted so far">
            <StackPanel Spacing="3"><TextBlock Text="Closest contact margin" Classes="label" /><TextBlock Text="{Binding GrowMarginText}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="6,6,6,6" Padding="14,10">
            <StackPanel Spacing="3"><TextBlock Text="Density now" Classes="label" /><TextBlock Text="{Binding GrowDensityNowText}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
          <Border Classes="card" Margin="6,6,0,6" Padding="14,10">
            <StackPanel Spacing="3"><TextBlock Text="Elapsed" Classes="label" /><TextBlock Text="{Binding GrowElapsedText}" Classes="mono" FontSize="18" /></StackPanel>
          </Border>
        </UniformGrid>
        <StackPanel Grid.Row="2" Spacing="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding GrowDoneText}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
            <TextBlock Text="Overall" Classes="label" />
          </DockPanel>
          <ProgressBar Value="{Binding GrowUnitFraction}" Minimum="0" Maximum="1" Height="6" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</p:PageBase>
