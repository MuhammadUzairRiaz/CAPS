<!-- CAPS coarse-grained melts (design/boards/CoarseGrained.dc.html): Kremer–Grest bead-spring chains, drawn, and written for
     LAMMPS with the push-off and the FENE + WCA run. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.CgPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Button.builder"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="FontSize" Value="12.5" /></Style>
    <Style Selector="Button.builder.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="Ellipse.stage"><Setter Property="Fill" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="Ellipse.stage.running"><Setter Property="Fill" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="Ellipse.stage.done"><Setter Property="Fill" Value="{DynamicResource OkB}" /></Style>
    <Style Selector="Ellipse.stage.failed"><Setter Property="Fill" Value="{DynamicResource ErrB}" /></Style>
    <Style Selector="TextBlock.stage"><Setter Property="Foreground" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="TextBlock.stage.running"><Setter Property="Foreground" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="TextBlock.stage.done"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
    <Style Selector="TextBlock.stage.failed"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="48" Padding="12,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="BUILDERS" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.9" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Classes="builder" Content="Polymer" Click="OnPolymer" />
        <Button Classes="builder" Content="Crystal" Click="OnCrystal" />
        <Button Classes="builder" Content="Surface" Click="OnSurface" />
        <Button Classes="builder" Content="Nanostructure" Click="OnNano" />
        <Button Classes="builder" Content="Biomolecule" Click="OnBio" />
        <Button Classes="builder" Content="Solvation" Click="OnSolvation" />
        <Button Classes="builder on" Content="Coarse-grained" />
      </StackPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,420">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="28" Padding="14,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Box length from M·N/ρ · σ = 1 Å in CAPS files" FontSize="11.5" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CgFooter}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Panel>
          <v:MolView x:Name="Preview" ShowCell="True" DrawStyle="2" ColourMode="1" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding CgHud}" FontSize="12" /></Border>
          </StackPanel>
          <TextBlock Text="{Binding CgInfo}" FontSize="11.5" Foreground="{DynamicResource MutedB}" Margin="14,10" VerticalAlignment="Bottom" TextWrapping="Wrap" />
        </Panel>
      </DockPanel>
      <Border Grid.Column="1" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" Height="20" Padding="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding CgModelChip}" FontSize="11" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" /></Border>
              <TextBlock Text="Coarse-grained model" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
              <Button Click="OnExport" IsVisible="{Binding CgIsKg}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="15" VerticalAlignment="Center" /><TextBlock Text="LAMMPS deck…" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Classes="primary" Click="OnBuild" IsEnabled="{Binding CgIdle}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="grow" Size="15" VerticalAlignment="Center" /><TextBlock Text="{Binding CgBuildText}" VerticalAlignment="Center" /></StackPanel></Button>
            </WrapPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="8">
                  <TextBlock Text="MODEL" Classes="h3" />
                  <Border Classes="seg" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="seg" Content="Kremer–Grest" GroupName="cgmodel" IsChecked="{Binding CgModel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}"
                                   ToolTip.Tip="Generic bead-spring chains (FENE + WCA): universal polymer physics in reduced units, or mapped to a polymer by σ, T and the bead mass" />
                      <RadioButton Classes="seg" Content="MARTINI" GroupName="cgmodel" IsChecked="{Binding CgModel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}"
                                   ToolTip.Tip="Chemistry-specific beads (about four heavy atoms each) with the MARTINI force field of the library: a melt packed, assigned and compressed, ready for GROMACS or LAMMPS" />
                      <RadioButton Classes="seg" Content="From a polymer" GroupName="cgmodel" IsChecked="{Binding CgModel, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}"
                                   ToolTip.Tip="Your polymer mapped to beads from an all-atom reference: bonds and angles by Boltzmann inversion, a repulsive size from the bead g(r)" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="dim" TextWrapping="Wrap" IsVisible="{Binding CgIsKg}"
                             Text="Kremer–Grest melts come with their own force field (FENE + WCA): the Field page shows it assigned, CAPS runs them, and the Export page writes their LAMMPS deck." />
                </StackPanel>
              </Border>
              <!-- the three kinds of coarse-grained model, in plain words -->
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="6">
                  <TextBlock Text="WHICH MODEL" Classes="h3" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="Kremer–Grest: generic beads on springs — no chemistry, just what every flexible chain does (entanglement, reptation). Use it for polymer physics, or map it to a polymer by σ, T and the bead mass." />
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="MARTINI: about four heavy atoms per bead, bead types from a published table (polar, apolar, charged …). Use it for mixtures, membranes and interfaces where transferable chemistry matters." />
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="From a polymer: your polymer's own beads (one per repeat unit, backbone + side group, or n backbone atoms), their bonds and angles taken from an all-atom melt of it. Use it to reach long times and big cells for one specific polymer, and backmap to atoms afterwards." />
                </StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding CgIsMapped}">
                <Border Classes="section" Padding="16,14">
                  <StackPanel Spacing="10">
                    <TextBlock Text="POLYMER AND MAPPING" Classes="h3" />
                    <StackPanel Spacing="6"><TextBlock Text="Polymer" Classes="label" /><ComboBox ItemsSource="{Binding CgBackmapPolymers}" SelectedIndex="{Binding MpPolymer}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="Beads" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.MpSchemes}" SelectedIndex="{Binding MpScheme}" HorizontalAlignment="Stretch" /></StackPanel>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding MpHelp}" />
                    <StackPanel Spacing="6" IsVisible="{Binding MpIsN}"><TextBlock Text="Backbone atoms per bead" Classes="label" /><NumericUpDown Value="{Binding MpPerBead}" Minimum="1" Maximum="20" Increment="1" FormatString="0" /></StackPanel>
                    <TextBlock Text="ALL-ATOM REFERENCE MELT" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="6"><TextBlock Text="Chains" Classes="label" /><NumericUpDown Value="{Binding MpChains}" Minimum="2" Maximum="500" Increment="2" FormatString="0" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Units per chain" Classes="label" /><NumericUpDown Value="{Binding MpDp}" Minimum="3" Maximum="500" Increment="5" FormatString="0" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="6"><TextBlock Text="Density · g/cm³" Classes="label" /><NumericUpDown Value="{Binding MpDensity}" Minimum="0.3" Maximum="3" Increment="0.02" FormatString="0.00" ToolTip.Tip="The melt's real density at that temperature (a handbook value); the reference is compressed to it" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Temperature · K" Classes="label" /><NumericUpDown Value="{Binding MpTemp}" Minimum="50" Maximum="2000" Increment="10" FormatString="0" ToolTip.Tip="k_B T of the Boltzmann inversion (and the repulsion's ε)" /></StackPanel>
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="CAPS grows the chains, compresses them to the density with its built-in force field, maps them and inverts: bonds and angles r₀ = ⟨r⟩, k = k_B T / (2 var) (Tschöp et al. 1998); a repulsive WCA per bead pair with σ where the non-bonded g(r) reaches 1/e (where −k_B T ln g = k_B T). A starting model: its density and g(r) need iterative Boltzmann inversion (Reith et al. 2003) to match the atoms. For better statistics, run the all-atom cell first and map its trajectory:" />
                    <Button Classes="small" HorizontalAlignment="Left" Content="Map the open all-atom structure (every frame)" Click="OnMapOpen" IsEnabled="{Binding HasDocument}"
                            ToolTip.Tip="The structure open in the Studio — a grown cell, or its trajectory after Dynamics — mapped with the beads chosen above" />
                    <TextBlock Text="{Binding MpLog}" Classes="dim mono" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel IsVisible="{Binding CgIsMartini}">
                <Border Classes="section" Padding="16,14">
                  <StackPanel Spacing="10">
                    <TextBlock Text="MARTINI CHAINS" Classes="h3" />
                    <StackPanel Spacing="6"><TextBlock Text="Force field" Classes="label" /><ComboBox ItemsSource="{Binding MtForceFields}" SelectedIndex="{Binding MtFfIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="Repeat unit · bead SMILES" Classes="label" /><TextBox Text="{Binding MtRepeat}" Classes="mono" Watermark="[C1]"
                      ToolTip.Tip="The beads of one repeat unit, as bead SMILES ([TYPE], [TYPE±q], branches in parentheses); the chain is the unit repeated" /></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="Examples" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.MtExamples}" SelectedIndex="{Binding MtExample}" HorizontalAlignment="Stretch" PlaceholderText="choose an example mapping" /></StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="6"><TextBlock Text="Repeats per chain" Classes="label" /><NumericUpDown Value="{Binding MtRepeats}" Minimum="1" Maximum="5000" Increment="5" FormatString="0" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Chains" Classes="label" /><NumericUpDown Value="{Binding MtChains}" Minimum="1" Maximum="20000" Increment="5" FormatString="0" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="6"><TextBlock Text="Density · g/cm³" Classes="label" /><NumericUpDown Value="{Binding MtDensity}" Minimum="0.1" Maximum="3" Increment="0.05" FormatString="0.00" /></StackPanel>
                      <v:SeedPicker Grid.Column="1" DataContext="{Binding MtSeedChoice}" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="One chain is built from the repeat unit, the chains packed at a quarter of the density, the MARTINI force field assigned from the bead names and the cell compressed to the density with it. The melt opens in the Studio assigned: relax and equilibrate it, then export it to GROMACS (MARTINI's home: Lennard-Jones with GROMACS's force switch) or LAMMPS." />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel IsVisible="{Binding CgIsKg}">
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="CHAINS" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Chains M" Classes="label" /><NumericUpDown Value="{Binding CgChains}" Minimum="1" Maximum="20000" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Beads per chain N" Classes="label" /><NumericUpDown Value="{Binding CgBeads}" Minimum="2" Maximum="100000" Increment="10" FormatString="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Density ρσ³" Classes="label" /><NumericUpDown Value="{Binding CgDensity}" Minimum="0.06" Maximum="1.2" Increment="0.05" FormatString="0.00" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Box L · σ" Classes="label" /><TextBox Text="{Binding CgBoxText, Mode=OneWay}" IsReadOnly="True" Classes="mono" /></StackPanel>
                  </Grid>
                  <v:SeedPicker DataContext="{Binding CgSeedChoice}" />
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="8">
                  <TextBlock Text="POTENTIAL" Classes="h3" />
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="FENE · K = 30 ε/σ², R₀ = 1.5 σ" Classes="mono" FontSize="12" /><TextBlock Text="Bonds" FontSize="12.5" Foreground="{DynamicResource MutedB}" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="WCA · cut at 2^1/6 σ" Classes="mono" FontSize="12" /><TextBlock Text="Non-bonded" FontSize="12.5" Foreground="{DynamicResource MutedB}" /></DockPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Bending k_θ · ε" Classes="label" /><NumericUpDown Value="{Binding CgKTheta}" Minimum="0" Maximum="50" Increment="0.25" FormatString="0.00" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Units" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.CgUnitModes}" SelectedIndex="{Binding CgUnits}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Reduced: LAMMPS units lj. Real: the same model mapped onto a polymer by your σ, temperature (ε = k_B T) and bead mass, written in LAMMPS units real" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding CgMapped}">
                    <StackPanel Spacing="6"><TextBlock Text="σ · Å" Classes="label" /><NumericUpDown Value="{Binding CgSigma}" Minimum="0.5" Maximum="50" Increment="0.1" FormatString="0.00" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="T · K (ε = k_B T)" Classes="label" /><NumericUpDown Value="{Binding CgTemp}" Minimum="1" Maximum="5000" Increment="1" FormatString="0.#" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Bead mass · g/mol" Classes="label" /><NumericUpDown Value="{Binding CgMass}" Minimum="1" Maximum="100000" Increment="1" FormatString="0.##" /></StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding CgMapText}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding CgMapped}" />
                  <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                    <TextBlock Text="Kremer &amp; Grest, J. Chem. Phys. 92, 5057 (1990)" FontSize="11.5" Foreground="{DynamicResource MutedB}" FontStyle="Italic" />
                  </Border>
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="LAMMPS RUN" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Push-off steps" Classes="label" /><NumericUpDown Value="{Binding CgPushSteps}" Minimum="100" Increment="1000" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Run steps (Δt 0.01 τ)" Classes="label" /><NumericUpDown Value="{Binding CgRunSteps}" Minimum="100" Increment="10000" FormatString="0" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="Soft repulsion ramped to 60 ε with displacements limited (Auhl et al. 2003), then FENE + WCA under a Langevin thermostat at T = 1. Checked in LAMMPS: P ≈ 5.0 at ρσ³ = 0.85." />
                </StackPanel>
              </Border>
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="8">
                  <TextBlock Text="BACKMAP TO ALL ATOMS" Classes="h3" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" Text="One repeat unit per bead: all-atom chains of the melt's lengths are grown, each unit carried rigidly onto its bead (turned to fit its neighbours), then relaxed (push-off, minimisation) and typed with GAFF (GAFF2 where the library has it). Map the melt to real units first (σ, T, bead mass above) and build it as the Studio structure." />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="Bead →" VerticalAlignment="Center" Classes="label" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CgBackmapPolymers}" SelectedIndex="{Binding CgBackmapUnit}" ToolTip.Tip="The repeat unit each bead stands for (its first unit)" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="small primary" Content="Backmap the open melt" Click="OnCgBackmap" IsEnabled="{Binding HasDocument}" />
                    <Button Classes="small ghost" Content="Model resolution › Backmap →" Click="OnModelResolution" Foreground="{DynamicResource AccB}"
                            ToolTip.Tip="MARTINI and other beads coarse-grained from an all-atom cell go back onto those atoms there" />
                  </StackPanel>
                  <TextBlock Text="{Binding CgBackmapLog}" Classes="dim mono" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              </StackPanel>
              <TextBlock Text="{Binding CgError}" Foreground="{DynamicResource ErrB}" FontSize="12" Margin="16,8" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</p:PageBase>
