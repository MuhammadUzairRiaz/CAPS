<!-- CAPS Analyze › Surface area (design/boards/SurfaceArea): Shrake–Rupley SASA per atom and group, exposure in the view, point-count convergence. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.SurfaceAreaPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnExport"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export per-atom CSV" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Surface area" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Solvent-accessible area per atom and per group" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding SaStatus}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid ColumnDefinitions="*,440" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding SaTotal, StringFormat='SASA {0}'}" /></Border>
              <TextBlock Text="Exposure per atom" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="buried" Classes="dim" Margin="0,0,8,0" />
              <TextBlock DockPanel.Dock="Right" Text="fully exposed" Classes="dim" Margin="8,0,0,0" />
              <Border Height="10" CornerRadius="3">
                <Border.Background><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#440154" Offset="0" /><GradientStop Color="#3B528B" Offset="0.25" /><GradientStop Color="#21918C" Offset="0.5" /><GradientStop Color="#5EC962" Offset="0.75" /><GradientStop Color="#FDE725" Offset="1" />
                </LinearGradientBrush></Border.Background>
              </Border>
            </DockPanel>
          </Border>
          <Panel Background="{DynamicResource Bg0B}"><v:MolView x:Name="View" /></Panel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Solvent-accessible surface area" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,90,60"><TextBlock Text="PART" Classes="h3" /><TextBlock Grid.Column="1" Text="Å²" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="%" Classes="h3" HorizontalAlignment="Right" /></Grid>
              <ItemsControl ItemsSource="{Binding SaGroups}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SasaGroupRow">
                  <Grid ColumnDefinitions="*,90,60" Height="24"><TextBlock Text="{Binding Part}" FontSize="12.5" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Area}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Share}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <StackPanel Spacing="4"><TextBlock Text="Probe radius · Å" Classes="label" /><NumericUpDown Value="{Binding SaProbe}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.00" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Points per atom" Classes="label" /><NumericUpDown Value="{Binding SaPoints}" Minimum="8" Maximum="2000" Increment="50" FormatString="0" /></StackPanel>
              </Grid>
              <TextBlock Text="Radii: Bondi 1964 (van der Waals)" Classes="dim" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasFrames}">
                <CheckBox Classes="toggle" Content="Over the trajectory's frames" IsChecked="{Binding SaOverFrames}" ToolTip.Tip="The total at every n-th frame, and its mean ± standard deviation; the per-atom areas and colours stay the frame shown" />
                <NumericUpDown Grid.Column="1" Value="{Binding SaEvery}" Minimum="1" Increment="1" FormatString="every 0" Width="110" IsEnabled="{Binding SaOverFrames}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding SaHasSeries}">
            <StackPanel Spacing="8">
              <TextBlock Text="Over the frames" FontSize="13.5" FontWeight="SemiBold" />
              <v:LinePlot x:Name="Series" Height="140" XLabel="frame" YLabel="SASA (Å²)" AutoRange="True" />
              <TextBlock Text="{Binding SaSeriesText}" Classes="mono" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Point-count convergence" FontSize="13.5" FontWeight="SemiBold" />
              <v:LinePlot x:Name="Conv" Height="140" XLabel="points per atom" YLabel="SASA (Å²)" AutoRange="True" />
              <Grid ColumnDefinitions="*,*,*"><TextBlock Text="POINTS" Classes="h3" /><TextBlock Grid.Column="1" Text="SASA (Å²)" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="Δ VS 400" Classes="h3" HorizontalAlignment="Right" /></Grid>
              <ItemsControl ItemsSource="{Binding SaConvergence}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SasaConvRow">
                  <Grid ColumnDefinitions="*,*,*" Height="20"><TextBlock Text="{Binding Points}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Area}" Classes="mono" HorizontalAlignment="Right" /><TextBlock Grid.Column="2" Text="{Binding Delta}" Classes="mono" HorizontalAlignment="Right" /></Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Shrake &amp; Rupley, J. Mol. Biol. 79, 351 (1973), golden-spiral points; radii from Bondi, J. Phys. Chem. 68, 441 (1964)." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
