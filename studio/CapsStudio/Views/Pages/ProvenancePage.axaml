<!-- CAPS provenance viewer (design/boards/Provenance): everything that produced the open structure, in order, with
     parameters, seeds, citations and approximations; compared with another run; BibTeX and the manifest. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ProvenancePage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="Ellipse.dot.differs"><Setter Property="Fill" Value="{DynamicResource WarnB}" /></Style>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnCompare" ToolTip.Tip="A file saved with its provenance (FILE.provenance.json beside it)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Compare with" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ProvCompareText}" IsVisible="{Binding ProvHasCompare}" VerticalAlignment="Center" />
              <TextBlock Text="another run…" IsVisible="{Binding ProvNoCompare}" VerticalAlignment="Center" />
              <v:Icon Kind="chev" Size="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnClearCompare" IsVisible="{Binding ProvHasCompare}" ToolTip.Tip="Stop comparing"><v:Icon Kind="close" Size="14" /></Button>
          <Button Click="OnBibtex" IsEnabled="{Binding ProvHasSteps}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export BibTeX" VerticalAlignment="Center" /></StackPanel></Button>
          <ToggleButton IsChecked="{Binding ProvJsonOpen}" IsEnabled="{Binding ProvHasSteps}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="file" Size="14" VerticalAlignment="Center" /><TextBlock Text="View JSON" VerticalAlignment="Center" /></StackPanel></ToggleButton>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding ProvTitle}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Everything that produced this file, in order, with parameters, seeds, citations and approximations" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ProvGenerator}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProvFooter}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,480" ColumnSpacing="14" Margin="22,18">
      <!-- steps -->
      <Border Classes="pcard">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Classes="chip" Classes.warn="{Binding ProvDiffers}"><TextBlock Text="{Binding ProvStepsChip}" /></Border>
            <TextBlock Text="Steps" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ProvError}" IsVisible="{Binding ProvHasError}" Foreground="{DynamicResource WarnB}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
          <Panel>
            <TextBlock IsVisible="{Binding ProvEmpty}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                       Text="Nothing recorded yet. Building, growing, typing, relaxing, running dynamics or editing a structure records each step here; saving writes the record beside the file (FILE.provenance.json) and opening the file reads it back." />
            <ScrollViewer IsVisible="{Binding !ProvJsonOpen}">
              <ItemsControl ItemsSource="{Binding ProvSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvStepRow">
                    <Grid ColumnDefinitions="14,*" ColumnSpacing="14">
                      <Grid RowDefinitions="Auto,*">
                        <Ellipse Width="12" Height="12" Margin="0,4,0,0" Classes="dot" Classes.differs="{Binding Differs}" />
                        <Rectangle Grid.Row="1" Width="2" Fill="{DynamicResource LineB}" HorizontalAlignment="Center" IsVisible="{Binding !Last}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Engine}" Classes="mono" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                          <Border Classes="chip warn" IsVisible="{Binding Differs}"><TextBlock Text="differs from run B" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Params}" IsVisible="{Binding HasParams}" FontSize="12.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBox IsVisible="{Binding ProvJsonOpen}" Text="{Binding ProvJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="{DynamicResource Mono}" FontSize="11.5"
                     TextWrapping="NoWrap" Background="{DynamicResource Bg0B}" />
          </Panel>
        </DockPanel>
      </Border>
      <!-- difference, approximations, inputs -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard" IsVisible="{Binding ProvHasCompare}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ProvCompareText, StringFormat='Difference from {0}'}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <ItemsControl ItemsSource="{Binding ProvDiff}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvRow">
                    <DockPanel Height="26">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" Classes="mono" FontSize="12" />
                        <TextBlock Text="vs" FontSize="12" Foreground="{DynamicResource DimB}" />
                        <TextBlock Text="{Binding Other}" Classes="mono" FontSize="12" />
                      </StackPanel>
                      <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ProvDiffNotes}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource WarnB}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ProvDiffSummary}" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="4">
              <TextBlock Text="Approximations" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Grid ColumnDefinitions="45*,55*" Margin="0,0,0,4">
                <TextBlock Text="APPROXIMATION" Classes="h3" />
                <TextBlock Grid.Column="1" Text="VALUE" Classes="h3" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProvApprox}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,7">
                      <Grid ColumnDefinitions="45*,55*">
                        <TextBlock Text="{Binding Key}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No energy evaluation recorded yet." IsVisible="{Binding !ProvApprox.Count}" Classes="dim" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="4">
              <TextBlock Text="Inputs" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
              <Grid ColumnDefinitions="55*,45*" Margin="0,0,0,4">
                <TextBlock Text="INPUT" Classes="h3" />
                <TextBlock Grid.Column="1" Text="SHA-256" Classes="h3" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ProvInputs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,7">
                      <Grid ColumnDefinitions="55*,45*">
                        <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Built in CAPS: no input files." IsVisible="{Binding !ProvInputs.Count}" Classes="dim" FontSize="12" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
