<!-- CAPS Studio › Analyze › Sorption: a gas or small molecule in the open structure held fixed — Widom insertion
     (μ_ex, Henry constant, solubility coefficient) and GCMC at each pressure (the isotherm, the isosteric heat). -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.SorptionPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <v:SeedPicker DataContext="{Binding SorbSeed}" ShowLabel="False" InlineLabel="True" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding SorbRunning}" />
          <Button Classes="primary" Click="OnRun" IsEnabled="{Binding Idle}">
            <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Compute" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Sorption" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="How much gas the open structure takes up: Widom insertion and grand-canonical Monte Carlo with the assigned force field" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding SorbProgress}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="380,*" ColumnSpacing="14" Margin="22,18">
      <ScrollViewer>
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Sorbate" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,150" ColumnSpacing="8">
                <TextBox Text="{Binding Sorbate}" Classes="mono" Watermark="SMILES" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.SorbPresets}" SelectedItem="{Binding SorbPreset}" PlaceholderText="Common gases" HorizontalAlignment="Stretch" />
              </Grid>
              <CheckBox Content="A gas mixture" IsChecked="{Binding SorbMix}" ToolTip.Tip="Several gases at once, each at its share of the pressure (ideal gas): co-adsorption, competition and selectivity" />
              <StackPanel Spacing="4" IsVisible="{Binding SorbMix}">
                <TextBox Text="{Binding SorbMixText}" Classes="mono" AcceptsReturn="True" MinHeight="64" Watermark="one gas per line: SMILES  mole fraction" />
                <TextBlock Text="{Binding SorbMixHint}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,90" ColumnSpacing="8">
                <CheckBox Content="Bend at rotatable bonds" IsChecked="{Binding SorbFlex}"
                          ToolTip.Tip="The molecule is cut at its rotatable bonds and grown in piece by piece, each piece at several trial angles weighted by its energy (configurational bias). Bond lengths, angles and rings keep the built shape. For oils, plasticisers, curatives and solvents." />
                <TextBlock Grid.Column="1" Text="trials" Classes="label" VerticalAlignment="Center" IsVisible="{Binding SorbFlex}" />
                <NumericUpDown Grid.Column="2" Value="{Binding SorbTrialsD}" Minimum="1" Maximum="64" Increment="2" FormatString="0" IsVisible="{Binding SorbFlex}" />
              </Grid>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Typed with the structure's force field (the Field assignment, else the built-in one); rigid unless it bends. The structure is the host: a polymer or rubber cell, a filler or a porous crystal, held fixed." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Conditions" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Text="T (K)" Classes="label" /><TextBlock Grid.Column="1" Text="Widom insertions" Classes="label" />
                <NumericUpDown Grid.Row="1" Value="{Binding SorbTD}" Minimum="1" Increment="10" FormatString="0" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SorbInsertD}" Minimum="0" Increment="50000" FormatString="0" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="GCMC pressures (kPa)" Classes="label" Margin="0,4,0,0" />
                <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SorbPressures}" Classes="mono" Watermark="blank: Widom only" TextWrapping="Wrap"
                         ToolTip.Tip="kPa: a list (10, 50, 100) or a log sweep: 0.1..1000 x8 gives 8 pressures evenly spaced in log p" />
                <TextBlock Grid.Row="4" Text="Steps per pressure" Classes="label" Margin="0,4,0,0" />
                <NumericUpDown Grid.Row="5" Value="{Binding SorbStepsD}" Minimum="1000" Increment="100000" FormatString="0" />
              </Grid>
              <CheckBox Content="Density map of the sorbate (where it sits in the host)" IsChecked="{Binding SorbMapOn}"
                        ToolTip.Tip="The sorbed molecules' centres over each pressure's production steps, on a 24 × 24 × 24 grid of the cell" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Widom: random places and orientations of one molecule, averaging the Boltzmann factor of each insertion's energy (Widom 1963). GCMC: insertions, deletions, moves and rotations at an ideal-gas reservoir's pressure (Frenkel &amp; Smit 2002); the first quarter of each run equilibrates." />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Held loading" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                <TextBlock Text="Molecules per cell (0: off)" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding SorbHeldD}" Minimum="0" Increment="1" FormatString="0" />
              </Grid>
              <CheckBox Content="Keep the loaded cell as the structure" IsChecked="{Binding SorbKeep}" IsEnabled="{Binding SorbHeldOn}"
                        ToolTip.Tip="The host with the molecules becomes the open structure: its end state and, last, the lowest-energy arrangement met (undo with ⌘Z)" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Exactly this many molecules (shared out by the mole fractions for a mixture), moved, turned and regrown by Monte Carlo for the steps above: where they sit, how strongly each one is bound and what the loaded cell's energy is. A mixture's gases follow its mole fractions." />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding SorbHasError}">
            <TextBlock Text="{Binding SorbError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrB}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Low pressure (Widom)" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="Solubility coefficient S" Classes="label" /><TextBlock Grid.Column="1" Text="{Binding SorbS}" Classes="mono" />
                <TextBlock Grid.Row="1" Text="Henry constant" Classes="label" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SorbHenry}" Classes="mono" />
                <TextBlock Grid.Row="2" Text="Excess chemical potential" Classes="label" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SorbMu}" Classes="mono" />
                <v:MathView Grid.Row="3" Tex="\langle e^{-\beta\Delta U}\rangle" FontSize="12" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            ToolTip.Tip="Widom average: the Boltzmann factor of the test molecule's insertion energy, averaged over all insertions" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SorbW}" Classes="mono" />
              </Grid>
              <TextBlock Text="{Binding SorbIg}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding SorbHasIg}"
                         ToolTip.Tip="A bending molecule's insertions are weighed against the same growth with nothing around it: μ_ex = −kT ln(⟨W⟩ / ⟨W⟩ alone)" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Isotherm (GCMC)" FontSize="13.5" FontWeight="SemiBold" />
              <v:SciPlot x:Name="Iso" Height="240" />
              <Grid ColumnDefinitions="*,*,*,*,*">
                <TextBlock Text="P (kPa)" Classes="h3" /><TextBlock Grid.Column="1" Text="PER CELL" Classes="h3" /><TextBlock Grid.Column="2" Text="mol/kg" Classes="h3" />
                <TextBlock Grid.Column="3" Text="cm³(STP)/cm³" Classes="h3" /><TextBlock Grid.Column="4" Text="Qₛₜ (kcal/mol)" Classes="h3" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SorbRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SorbRow">
                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,2">
                      <TextBlock Text="{Binding Pressure}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Loading}" Classes="mono" />
                      <TextBlock Grid.Column="2" Text="{Binding MolKg}" Classes="mono" /><TextBlock Grid.Column="3" Text="{Binding Cm3}" Classes="mono" />
                      <TextBlock Grid.Column="4" Text="{Binding Heat}" Classes="mono" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SorbNote}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding SorbHasSpecies}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SorbSpeciesTitle}" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="1.6*,*,*,1.3*,*,*">
                <TextBlock Text="GAS" Classes="h3" /><TextBlock Grid.Column="1" Text="y" Classes="h3" /><TextBlock Grid.Column="2" Text="S (WIDOM)" Classes="h3" />
                <TextBlock Grid.Column="3" Text="PER CELL" Classes="h3" /><TextBlock Grid.Column="4" Text="SELECTIVITY" Classes="h3" /><TextBlock Grid.Column="5" Text="Qₛₜ" Classes="h3" ToolTip.Tip="Isosteric heat per gas, kcal/mol" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SorbSpeciesRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SorbSpeciesRow">
                    <Grid ColumnDefinitions="1.6*,*,*,1.3*,*,*" Margin="0,2">
                      <TextBlock Text="{Binding Smiles}" Classes="mono" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Y}" Classes="mono" />
                      <TextBlock Grid.Column="2" Text="{Binding S}" Classes="mono" /><TextBlock Grid.Column="3" Text="{Binding Loading}" Classes="mono" />
                      <TextBlock Grid.Column="4" Text="{Binding Selectivity}" Classes="mono" /><TextBlock Grid.Column="5" Text="{Binding Heat}" Classes="mono" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Selectivity (xᵢ/x₁)/(yᵢ/y₁): the adsorbed phase's share against the gas's. S from Widom is each gas alone at infinite dilution; the loadings are the competition at that pressure. Qₛₜ per gas from the multicomponent fluctuations (kcal/mol). The isotherm plot draws the gases' mol/kg." />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding SorbHasHeld}">
            <StackPanel Spacing="8">
              <TextBlock Text="At the held loading" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="Energy of the loaded cell" Classes="label" /><TextBlock Grid.Column="1" Text="{Binding SorbHeldE}" Classes="mono" />
                <TextBlock Grid.Row="1" Text="Adsorption energy" Classes="label"
                           ToolTip.Tip="(⟨U⟩ − the molecules' own torsional energy in the gas) / N: negative means bound" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SorbHeldAds}" Classes="mono" />
              </Grid>
              <TextBlock Text="{Binding SorbHeldSplit}" Classes="dim" TextWrapping="Wrap" />
              <v:SciPlot x:Name="Held" Height="200" />
              <TextBlock Text="How strongly single molecules are held: each one's energy with the host and the other molecules, sampled over the run" Classes="dim" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SorbHeldNote}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding SorbHasMap}">
            <StackPanel Spacing="8">
              <TextBlock Text="Where the sorbate sits" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding SorbMapPressures}" SelectedIndex="{Binding SorbMapIndex}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.SorbMapFaces}" SelectedIndex="{Binding SorbMapFace}" HorizontalAlignment="Stretch" />
              </Grid>
              <v:SciPlot x:Name="Map" Height="260" />
              <TextBlock Text="{Binding SorbMapText}" Classes="dim" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
