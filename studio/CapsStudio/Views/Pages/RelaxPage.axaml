<!-- CAPS Relax (design/boards/Relax.dc.html): method, push-off and cell; energy and force; constraints; stop criteria. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.RelaxPage" x:DataType="vm:MainViewModel">
  <p:PageBase.Resources>
    <v:IntEqualsConverter x:Key="Eq" />
  </p:PageBase.Resources>
  <Grid RowDefinitions="Auto,*" Margin="22,16,22,16" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Minimise · CAPS Relax" Classes="title" />
        <TextBlock Classes="muted"><Run Text="Energy minimisation with the same force field as Dynamics · " /><Run Text="{Binding ForceFieldLine}" /></TextBlock>
        <v:StructurePicker ShowResultOption="True" Margin="0,8,0,0" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnSave" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Save the structure (LAMMPS data carries the force field)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="save" Size="16" VerticalAlignment="Center" /><TextBlock Text="Save…" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCopyPython" ToolTip.Tip="This run on the open structure as a Python script (the caps package), with these settings">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="copy" Size="16" VerticalAlignment="Center" /><TextBlock Text="Copy as Python" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnQueue" IsVisible="{Binding !Idle}" ToolTip.Tip="Queue this run with the settings as they are now; it starts when the current run ends (Jobs lists it)">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="plus" Size="15" VerticalAlignment="Center" /><TextBlock Text="Queue" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <ComboBox ItemsSource="{Binding RunWhereChoices}" SelectedIndex="{Binding RunWhereIndex}" IsVisible="{Binding HasHosts}" MinWidth="150" VerticalAlignment="Center"
                  ToolTip.Tip="Where the run goes: this machine, or a host from Settings › Compute &amp; remote (the result comes back to Jobs)" />
        <Button Classes="primary" Click="OnRelax" IsEnabled="{Binding CanRelax}" IsVisible="{Binding !Relaxing}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="relax" Size="16" VerticalAlignment="Center" /><TextBlock Text="Minimise" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Click="OnCancel" IsVisible="{Binding Relaxing}">
          <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="stop" Size="16" VerticalAlignment="Center" /><TextBlock Text="Cancel" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="470,*,*" RowDefinitions="300,*" ColumnSpacing="16" RowSpacing="16">
      <!-- left column: method, push-off and cell -->
      <ScrollViewer Grid.RowSpan="2">
        <StackPanel Spacing="16" IsEnabled="{Binding !Relaxing}">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Method" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="8">
                <RadioButton Classes="choice" GroupName="rmethod" IsChecked="{Binding RelaxMethod, Converter={StaticResource Eq}, ConverterParameter=0}">
                  <StackPanel Spacing="2"><TextBlock Text="Steepest descent" FontWeight="SemiBold" /><TextBlock Text="Robust first pass for bad contacts" Classes="dim" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="rmethod" IsChecked="{Binding RelaxMethod, Converter={StaticResource Eq}, ConverterParameter=1}">
                  <StackPanel Spacing="2"><TextBlock Text="Polak–Ribière conjugate gradient" FontWeight="SemiBold" /><TextBlock Text="Low memory, smooth landscapes" Classes="dim" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="rmethod" IsChecked="{Binding RelaxMethod, Converter={StaticResource Eq}, ConverterParameter=2}">
                  <StackPanel Spacing="2"><TextBlock Text="L-BFGS" FontWeight="SemiBold" /><TextBlock Text="Liu &amp; Nocedal, Math. Program. 45, 503 (1989) · m = 10" Classes="dim" /></StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="rmethod" IsChecked="{Binding RelaxMethod, Converter={StaticResource Eq}, ConverterParameter=3}">
                  <StackPanel Spacing="2"><TextBlock Text="FIRE" FontWeight="SemiBold" /><TextBlock Text="Bitzek et al., Phys. Rev. Lett. 97, 170201 (2006)" Classes="dim" /></StackPanel>
                </RadioButton>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <Border Classes="phead"><TextBlock Text="Push-off &amp; cell" Classes="h2" VerticalAlignment="Center" /></Border>
              <StackPanel Margin="16,12,16,16" Spacing="12">
                <CheckBox Classes="toggle" Content="Soft-core push-off before minimising" IsChecked="{Binding RelaxPushoff}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding RelaxPushoff}">
                  <TextBlock Text="Force cap (kcal/mol/Å)" Classes="label" /><TextBlock Grid.Column="1" Text="λ ramp over (ps)" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding RelaxCap}" Minimum="5" Maximum="5000" Increment="50" FormatString="0"
                                 ToolTip.Tip="The last cap: the LJ force is linear inside the radius where it would exceed this" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RelaxRampPs}" Minimum="1" Maximum="1000" Increment="5" FormatString="0.#" IsEnabled="{Binding RelaxPushoffMdEnabled}"
                                 ToolTip.Tip="NVT molecular dynamics with the cap raised geometrically in ten steps over this time, before minimising" />
                </Grid>
                <CheckBox Content="Push off by MD first (NVT, the cap ramped)" IsChecked="{Binding RelaxPushoffMd}" IsEnabled="{Binding RelaxPushoff}"
                          ToolTip.Tip="Overlapping chains move apart by motion rather than straight down the steepest path; needs a force field and takes longer" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <v:Icon Kind="link" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding RelaxPushoffText}" Classes="dim" TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
                <CheckBox Classes="toggle" Content="Compress to a target density" IsChecked="{Binding RelaxCompress}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding RelaxCompress}">
                  <TextBlock Text="Target density (g/cm³)" Classes="label" /><TextBlock Grid.Column="1" Text="Step per stage" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding RelaxDensityD}" Minimum="0.05" Maximum="3" Increment="0.05" FormatString="0.000" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RelaxStepD}" Minimum="0.005" Maximum="0.5" Increment="0.01" FormatString="0.000" />
                </Grid>
                <CheckBox Classes="toggle" Content="Relax the box towards a pressure" IsChecked="{Binding RelaxBox}" />
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.RelaxBoxModes}" SelectedIndex="{Binding RelaxBoxMode}" HorizontalAlignment="Stretch" IsEnabled="{Binding RelaxBox}"
                          ToolTip.Tip="Each axis on its own follows its diagonal pressure (orthorhombic cells): a film or slab relaxes its thickness alone, or its area at a fixed thickness" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="Pressure (atm)" Classes="label" /><TextBlock Grid.Column="1" Text="Cut-off (Å)" Classes="label" />
                  <NumericUpDown Grid.Row="1" Value="{Binding RelaxPressureD}" Increment="1" FormatString="0.0" IsEnabled="{Binding RelaxBox}" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RelaxCutoffD}" Minimum="4" Maximum="30" Increment="0.5" FormatString="0.0" />
                </Grid>
                <CheckBox Classes="toggle" Content="Electrostatics (damped shifted force)" IsChecked="{Binding RelaxCoulomb}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- energy and force -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="38,*">
          <Border Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" IsVisible="{Binding Relaxing}"><TextBlock Text="running" Foreground="{DynamicResource AccB}" /></Border>
              <TextBlock Text="Energy" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <v:LinePlot Grid.Row="1" x:Name="EnergyPlot" Margin="10,6,12,8" AutoRange="True" XLabel="iteration" YLabel="E (kcal/mol)" />
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="38,*">
          <Border Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Foreground="{DynamicResource MutedB}"><Run Text="target " /><Run Text="{Binding RelaxFtolD}" /></TextBlock></Border>
              <TextBlock Text="Max force" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <v:LinePlot Grid.Row="1" x:Name="ForcePlot" Margin="10,6,12,8" AutoRange="True" XLabel="iteration" YLabel="log₁₀ |F|max (kcal/mol/Å)" />
        </Grid>
      </Border>

      <!-- constraints and restraints, and the report -->
      <Border Grid.Row="1" Grid.Column="1" Classes="card">
        <Grid RowDefinitions="38,Auto,*">
          <Border Classes="phead"><TextBlock Text="Constraints &amp; restraints" Classes="h2" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="8">
            <Border Classes="choice" IsEnabled="{Binding !Relaxing}">
              <Grid ColumnDefinitions="Auto,*,Auto,70" ColumnSpacing="8">
                <v:Icon Kind="pin" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="Hold a molecule in place" IsChecked="{Binding HoldOn}" FontWeight="SemiBold" ToolTip.Tip="Its atoms feel no force and do not move (an interface's surface is molecule 1)" />
                <TextBlock Grid.Column="2" Text="molecule" Classes="dim" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="3" Value="{Binding HoldPick}" Minimum="1" Increment="1" FormatString="0" ShowButtonSpinner="False" />
              </Grid>
            </Border>
            <Border Classes="choice" IsEnabled="{Binding !Relaxing}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <v:Icon Kind="ruler" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Restraints" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="k (r − r₀)² for a pair, k (φ − φ₀)² for a dihedral, added to the energy that is minimised" />
                  <Button Grid.Column="2" Classes="small" Content="Add measured" Click="OnAddRestraint" IsEnabled="{Binding CanAddRestraint}"
                          ToolTip.Tip="Shift-click two atoms (a distance) or four (a dihedral) in the view, then add: held at the target while minimising" ToolTip.ShowOnDisabled="True" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RelaxRestraints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestraintRow">
                      <Grid ColumnDefinitions="*,Auto,80,Auto,70,Auto" ColumnSpacing="6" Margin="0,2">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Atoms}" Classes="mono" FontSize="11.5" />
                          <TextBlock Text="{Binding MeasuredText}" Classes="dim" FontSize="10.5" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TargetLabel}" Classes="dim" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="2" Value="{Binding R0D}" Minimum="-180" Maximum="180" Increment="0.1" FormatString="0.##" ShowButtonSpinner="False" />
                        <TextBlock Grid.Column="3" Text="k" Classes="dim" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="4" Value="{Binding KD}" Minimum="0" Maximum="10000" Increment="5" FormatString="0.#" ShowButtonSpinner="False"
                                       ToolTip.Tip="{Binding KTip}" />
                        <Button Grid.Column="5" Classes="ghost" Content="×" Click="OnRemoveRestraint" Tag="{Binding}" ToolTip.Tip="Remove" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding !HasRestraints}"
                           Text="Shift-click two atoms in the view to measure them, then add the pair: it is pulled to r₀ while minimising (contact, hydrogen bond, gap closing)." />
              </StackPanel>
            </Border>
          </StackPanel>
          <ScrollViewer Grid.Row="2" Margin="16,4,16,12">
            <TextBlock Text="{Binding RelaxLog}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- stop criteria -->
      <Border Grid.Row="1" Grid.Column="2" Classes="card">
        <Grid RowDefinitions="38,*">
          <Border Classes="phead"><TextBlock Text="Stop when any is met" Classes="h2" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Row="1" Margin="16,12,16,16" Spacing="10" IsEnabled="{Binding !Relaxing}">
            <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
              <TextBlock Text="|F|max below (kcal/mol/Å)" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
              <NumericUpDown Grid.Column="1" Value="{Binding RelaxFtolD}" Minimum="0.001" Maximum="100" Increment="0.05" FormatString="0.###" TextAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
              <TextBlock Text="Iterations (per stage)" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
              <NumericUpDown Grid.Column="1" Value="{Binding RelaxIterationsD}" Minimum="10" Maximum="1000000" Increment="1000" FormatString="0" TextAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
              <TextBlock Text="ΔE per step below (relative)" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.RelaxEtols}" SelectedIndex="{Binding RelaxEtolIndex}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="A stage also stops when the energy changes by less than this fraction per step (1e-8: the force criterion decides)" />
            </Grid>
            <Grid ColumnDefinitions="*,120" ColumnSpacing="10" IsVisible="{Binding RelaxBox}">
              <TextBlock Text="Box stress below (atm)" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
              <NumericUpDown Grid.Column="1" Value="{Binding RelaxPressureTolD}" Minimum="1" Maximum="100000" Increment="10" FormatString="0" TextAlignment="Right"
                             ToolTip.Tip="The box relaxation stops when the pressure is this close to its target" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding FixedAtomsText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="small" Content="Hold selection" Click="OnHoldSelection" ToolTip.Tip="The selected atoms stay where they are in Relax, Dynamics and Equilibrate (chain ends, an anchor, a substrate)" />
                <Button Classes="small ghost" Content="Free" Click="OnFreeAtoms" IsVisible="{Binding HasFixedAtoms}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="The criterion that stopped each stage goes into the report." Classes="dim" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</p:PageBase>
