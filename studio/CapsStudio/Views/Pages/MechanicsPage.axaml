<!-- CAPS Analyze › Mechanics (design/boards/Mechanics.dc.html): elastic constants by constant strain (or stress
     fluctuations) and uniaxial stress–strain at a stated rate. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.MechanicsPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <v:AnalyzeSide DockPanel.Dock="Left" />
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnExport" IsEnabled="{Binding Analyze.HasResults}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export CSV / LaTeX" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Analyze · mechanics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Elastic constants by constant strain, and uniaxial stress–strain at a stated rate" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="MD strain rates are orders of magnitude above experiment; reported with every value" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding MechFooter}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,400" ColumnSpacing="14" Margin="22,18">
      <DockPanel>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding MechCells}" Margin="0,0,0,14">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultCell">
              <Border Classes="pcard" Padding="14,12" Margin="0,0,10,0">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Text="{Binding Value}" Classes="mono" FontSize="20" Foreground="{DynamicResource TextB}" Classes.dim="{Binding !HasValue}" />
                  <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource DimB}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="pcard">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding MechCurveChip}" /></Border>
              <TextBlock Text="Uniaxial tension" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="stress–strain, smoothed ±0.5 %" /></StackPanel></Border>
              <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="linear fit window" /></StackPanel></Border>
            </StackPanel>
            <Panel>
              <v:LinePlot x:Name="Curve" XLabel="engineering strain (%)" YLabel="true stress (GPa)" AutoRange="True" MinHeight="240" EmptyText="" />
              <TextBlock IsVisible="{Binding !MechHasCurve}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                         Text="Run with “Stress–strain” on: the current frame is equilibrated at 1 atm, then stretched along the axis at the chosen rate while the stress is sampled." />
            </Panel>
          </DockPanel>
        </Border>
      </DockPanel>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="8">
              <TextBlock Text="Stiffness matrix" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="12*,21*,12*,21*,13*,21*">
                <TextBlock Grid.Column="1" Text="GPa" FontSize="11" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="GPa" FontSize="11" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="GPa" FontSize="11" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding CijCells}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CijCell">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,7" Margin="0,0,8,0">
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !Blank}">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding MechNote}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" LineHeight="17" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Protocol" FontSize="13.5" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Method" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.MechMethods}" SelectedIndex="{Binding MechMethod}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding MechIsStrain}"><TextBlock Text="Strain · ± %" Classes="label" /><NumericUpDown Value="{Binding MechStrainPercent}" Minimum="0.0001" Maximum="1" Increment="0.05" FormatString="0.###" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding !MechIsStrain}"><TextBlock Text="Run · ps" Classes="label" /><NumericUpDown Value="{Binding Analyze.FluctPsD}" Minimum="1" Increment="10" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <CheckBox Classes="toggle" Content="Uniaxial tension (stress–strain)" IsChecked="{Binding MechTensile}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding MechTensile}">
                <StackPanel Spacing="6"><TextBlock Text="Tension rate" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.MechRates}" SelectedIndex="{Binding MechRate}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Lateral" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.MechLaterals}" SelectedIndex="{Binding MechLateral}" HorizontalAlignment="Stretch" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding MechTensile}">
                <StackPanel Spacing="6"><TextBlock Text="Axis" Classes="label" /><ComboBox ItemsSource="{x:Static vm:AnalyzeViewModel.Axes}" SelectedIndex="{Binding Analyze.TensAxis}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Temperature · K" Classes="label" /><NumericUpDown Value="{Binding Analyze.TensTD}" Minimum="1" Increment="10" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                <TextBlock Text="{Binding MechCite}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>
              <TextBlock Text="{Binding Analyze.Log}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
