<!-- CAPS Dynamics › Electrostatics (design/boards/Electrostatics): Ewald splitting, cut-off and PME mesh derived from one tolerance. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ElectrostaticsPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.phead"><Setter Property="Padding" Value="16,11" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>
    <Style Selector="Border.cur"><Setter Property="Background" Value="{DynamicResource Bg2B}" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Reset to defaults" Click="OnReset" />
          <Button Classes="primary" Content="Apply" Click="OnApply" ToolTip.Tip="Relax, Dynamics and Equilibrate use these settings from now on" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Dynamics · electrostatics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Ewald splitting, cut-off and PME mesh, derived from one tolerance" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding EsStatusRight}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding EsStatus}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer Margin="22,18">
      <Grid v:Panes.Split="True" ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip ok"><TextBlock Text="computed" /></Border>
                  <TextBlock Text="Real-space part of the Coulomb sum" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="10,8,14,14" Spacing="8">
                <v:XyChart x:Name="Curve" Height="250" XLabel="r (Å)" YLabel="erfc(βr) · real-space share" YMin="0" ShowLegend="False" />
                <TextBlock Classes="dim" TextWrapping="Wrap" Margin="6,0,0,0" Text="At the cut-off the real-space term has fallen to the tolerance (red); the rest is carried by the reciprocal-space mesh." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead"><TextBlock Text="Tolerance vs splitting parameter" FontSize="13.5" FontWeight="SemiBold" /></Border>
              <StackPanel Margin="16,8,16,12">
                <Grid ColumnDefinitions="*,110,90" Height="26">
                  <TextBlock Text="TOLERANCE ERFC(βr_c)" Classes="h3" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="β (Å⁻¹)" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="βr_c" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding EsTable}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EwaldRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Classes.cur="{Binding Current}">
                      <Grid ColumnDefinitions="*,110,90" Height="30">
                        <TextBlock Text="{Binding Tolerance}" Classes="mono" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Beta}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding BetaRc}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="14">
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead"><TextBlock Text="Settings" FontSize="13.5" FontWeight="SemiBold" /></Border>
              <Grid Margin="16,12,16,14" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <StackPanel Spacing="4"><TextBlock Text="Method" Classes="label" /><ComboBox ItemsSource="{Binding EsMethods}" SelectedIndex="{Binding EsMethod}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" IsEnabled="{Binding EsPme}"><TextBlock Text="Order" Classes="label" /><NumericUpDown Value="{Binding EsOrder}" Minimum="3" Maximum="10" Increment="1" FormatString="0" /></StackPanel>
                <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Cut-off r_c · Å" Classes="label" /><NumericUpDown Value="{Binding EsCutoff}" Minimum="4" Maximum="30" Increment="0.5" FormatString="0.0" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" IsEnabled="{Binding EsPme}"><TextBlock Text="Tolerance" Classes="label" /><ComboBox ItemsSource="{Binding EsTolerances}" SelectedIndex="{Binding EsTolerance}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Grid.Row="2" Spacing="4" IsEnabled="{Binding EsPme}"><TextBlock Text="Max grid spacing · Å" Classes="label" /><NumericUpDown Value="{Binding EsSpacing}" Minimum="0.3" Maximum="3" Increment="0.05" FormatString="0.0#" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="LJ" Classes="label" />
                  <ComboBox SelectedIndex="{Binding LjTailChoice}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Dynamics and Equilibrate: the long-range dispersion correction to energy and pressure for a homogeneous fluid beyond r_c (as LAMMPS pair_modify tail yes), or none (interfaces, films)">
                    <ComboBoxItem Content="cut-off + tail correction" /><ComboBoxItem Content="cut-off only" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="4" IsVisible="{Binding EsNoCell}"><TextBlock Text="Box edge · Å (no periodic cell open)" Classes="label" /><NumericUpDown Value="{Binding EsBox}" Minimum="5" Maximum="10000" Increment="1" FormatString="0.0" /></StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <Border Classes="pcard" IsVisible="{Binding EsPme}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding EsFft}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                  <TextBlock Text="Derived" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,10,16,12" Spacing="4">
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding EsBeta}" Classes="mono" FontSize="14" /><TextBlock Text="β" Classes="muted" VerticalAlignment="Center" /></DockPanel>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding EsMeshText}" Classes="mono" FontSize="14" /><TextBlock Text="Mesh" Classes="muted" VerticalAlignment="Center" /></DockPanel>
                <Grid ColumnDefinitions="*,90,70,100" Height="26" Margin="0,8,0,0">
                  <TextBlock Text="AXIS" Classes="h3" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="L (Å)" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="GRID" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="SPACING (Å)" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding EsMesh}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MeshRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="*,90,70,100" Height="28">
                        <TextBlock Text="{Binding Axis}" Classes="mono" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding L}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Grid}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Spacing}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock Text="{Binding EsWarn}" Classes="err" TextWrapping="Wrap" Margin="4,0,0,0" />
          <TextBlock Classes="dim" TextWrapping="Wrap" Margin="4,0,0,0"
                     Text="β solves erfc(β r_c) = tolerance, the convention GROMACS uses for ewald-rtol. Grid sizes round up to FFT-friendly numbers. Essmann et al., J. Chem. Phys. 103, 8577 (1995). Damped shifted force: Fennell &amp; Gezelter, J. Chem. Phys. 124, 234104 (2006)." />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</p:PageBase>
