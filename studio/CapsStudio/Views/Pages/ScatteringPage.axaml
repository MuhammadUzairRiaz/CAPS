<!-- CAPS Analyze › Scattering (design/boards/Scattering.dc.html): X-ray and neutron patterns of the cell, peaks in q, d and
     2θ, deuteration contrast, a measured curve overlaid. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ScatteringPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <v:AnalyzeSide DockPanel.Dock="Left" />
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnLoadExperiment" ToolTip.Tip="Two columns (q in Å⁻¹, or 2θ in degrees with the X-ray source's wavelength, and intensity), or a PANalytical .xrdml, GSAS, Bruker .uxd or Rigaku .asc file"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Load experimental curve" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Analyze · scattering" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="X-ray and neutron patterns from the simulated cell, ready to overlay on measured data" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Faber–Ziman normalisation · CPU sum over the cell's k-vectors" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ScatterFooter}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,400" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <ToggleButton Content="Total scattering I(q)" IsChecked="{Binding QView}" ToolTip.Tip="The amorphous halo and local order: the reciprocal-lattice sum with the g(r) transform above it" />
              <ToggleButton Content="Powder pattern 2θ" IsChecked="{Binding PowderView}" ToolTip.Tip="The cell's reflections as a diffractometer records them: Kα doublet, peak shapes, size and strain" />
            </StackPanel>
            <TextBlock Text="{Binding ScatterTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
            <WrapPanel IsVisible="{Binding QView}">
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding ScatterXray}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="{Binding XrayChip}" /></StackPanel></Border>
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding ScatterNeutron}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="{Binding NeutronChip}" /></StackPanel></Border>
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding HasExperiment}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="···" Foreground="{DynamicResource MutedB}" /><TextBlock Text="{Binding ExperimentName}" /><Button Classes="tool" Padding="2" MinHeight="14" Height="16" Click="OnClearExperiment"><v:Icon Kind="close" Size="10" /></Button></StackPanel></Border>
            </WrapPanel>
            <TextBlock Text="{Binding ScatterText}" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" LineHeight="18" IsVisible="{Binding QView}" />
          </StackPanel>
          <v:SciPlot x:Name="Plot" />
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Method" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="Direct sum over the cell's reciprocal lattice up to the switch-over, the partial g(r) transformed above it" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Direct up to · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.QDirectD}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="q max · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.QmaxD}" Minimum="1" Maximum="40" Increment="1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Δq · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.DqD}" Minimum="0.002" Maximum="0.2" Increment="0.005" FormatString="0.000" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Plot to · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding ScatterPlotTo}" Minimum="1" Maximum="40" Increment="1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="{Binding BeamLabel}" IsChecked="{Binding ScatterXray}" />
                <CheckBox Content="Neutron" IsChecked="{Binding ScatterNeutron}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Click="OnPowder" IsEnabled="{Binding HasDocument}" Content="Pattern" />
                <TextBlock Text="Powder pattern" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="Every reflection of the cell (h k l, d, 2θ, multiplicity, |F|), broadened as a diffractometer and the crystallites would broaden it" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.PowderAnodes}" SelectedIndex="{Binding PowAnode}" HorizontalAlignment="Stretch" />
                <CheckBox Grid.Column="1" Content="Kα2" IsChecked="{Binding PowKa2}" ToolTip.Tip="The Kα2 line at half Kα1's intensity" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="2θ from · °" Classes="label" /><NumericUpDown Value="{Binding PowFromD}" Minimum="0.5" Maximum="170" Increment="5" FormatString="0.#" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="to · °" Classes="label" /><NumericUpDown Value="{Binding PowToD}" Minimum="1" Maximum="175" Increment="5" FormatString="0.#" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Instrument W · °²" Classes="label" /><NumericUpDown Value="{Binding PowWD}" Minimum="0" Maximum="1" Increment="0.001" FormatString="0.####" ShowButtonSpinner="False"
                  ToolTip.Tip="The instrument's own Gaussian width, FWHM² = W (0.0025: 0.05°)" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Crystallite · nm" Classes="label" /><NumericUpDown Value="{Binding PowSizeD}" Minimum="0" Maximum="10000" Increment="5" FormatString="0.#" ShowButtonSpinner="False"
                  ToolTip.Tip="Scherrer broadening Kλ/(L cos θ), K 0.9; 0: none (lamellar crystals of a rubber or PE: 5–20 nm)" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Strain · %" Classes="label" /><NumericUpDown Value="{Binding PowStrainD}" Minimum="0" Maximum="10" Increment="0.05" FormatString="0.###" ShowButtonSpinner="False"
                  ToolTip.Tip="Microstrain broadening 4ε tan θ" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="B · Å²" Classes="label" /><NumericUpDown Value="{Binding PowBD}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.##" ShowButtonSpinner="False"
                  ToolTip.Tip="Temperature factor e^(−B s²) on every atom; averaging an MD run's frames brings its own thermal damping instead" /></StackPanel>
              </Grid>
              <ComboBox ItemsSource="{x:Static vm:MainViewModel.PowderProfiles}" SelectedIndex="{Binding PowProfile}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,90" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Oriented along h k l (blank: random)" Classes="label" /><TextBox Text="{Binding PowPreferred}" Classes="mono" Watermark="e.g. 0 0 1"
                  ToolTip.Tip="Preferred orientation (March–Dollase): r below 1 for plates lying on these planes, above 1 for needles along them; a drawn fibre or a rolled film" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="r" Classes="label" /><NumericUpDown Value="{Binding PowRD}" Minimum="0.05" Maximum="20" Increment="0.1" FormatString="0.##" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <CheckBox Content="Average the trajectory's frames" IsChecked="{Binding PowAllFrames}" ToolTip.Tip="|F|² over every frame: the thermal motion damps the reflections and adds diffuse scattering" />
              <TextBlock Text="{Binding PowError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding PowHasError}" />
              <Grid ColumnDefinitions="1.3*,*,*,0.6*,*" IsVisible="{Binding PowderView}">
                <TextBlock Text="H K L" Classes="h3" /><TextBlock Grid.Column="1" Text="D (Å)" Classes="h3" /><TextBlock Grid.Column="2" Text="2Θ (°)" Classes="h3" />
                <TextBlock Grid.Column="3" Text="M" Classes="h3" /><TextBlock Grid.Column="4" Text="I" Classes="h3" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding PowderRows}" IsVisible="{Binding PowderView}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PowderRow">
                    <Grid ColumnDefinitions="1.3*,*,*,0.6*,*" Margin="0,2">
                      <TextBlock Text="{Binding Hkl}" Classes="mono" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding D}" Classes="mono" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="{Binding TwoTheta}" Classes="mono" FontSize="12" /><TextBlock Grid.Column="3" Text="{Binding M}" Classes="mono" FontSize="12" />
                      <TextBlock Grid.Column="4" Text="{Binding I}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PowText}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" IsVisible="{Binding PowderView}" />
              <StackPanel Spacing="6" IsVisible="{Binding CanRefine}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Click="OnRefine" Content="Refine against it" IsEnabled="{Binding HasDocument}"
                          ToolTip.Tip="Fit the measured pattern (loaded in 2θ) with the open crystal: the lattice, zero shift, peak widths, background and scale" />
                  <CheckBox Content="Pawley (free intensities)" IsChecked="{Binding RefinePawley}"
                            ToolTip.Tip="Each reflection's intensity free: the cell and the peak shapes without the structure's intensities" />
                </DockPanel>
                <TextBlock Text="{Binding RefineError}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" IsVisible="{Binding RefineHasError}" />
                <TextBlock Text="{Binding RefineText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding RefineHas}" />
                <Button Click="OnIndex" Content="Index it" HorizontalAlignment="Left"
                        ToolTip.Tip="The cells whose reflections fall on the measured pattern's lines (its peaks found, Kα2 dropped), best M20 first" />
                <TextBlock Text="{Binding IndexText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding IndexHas}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Atomic displacement parameters" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="U_ij, U_iso and B = 8π²U_iso of each atom over the frames of the open trajectory, about its mean position; for a supercell of a crystal, per site of the unit cell. Compare with diffraction, or map mobility near a fibre." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="supercell" Classes="label" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AdpNa}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="54" ShowButtonSpinner="False" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AdpNb}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="54" ShowButtonSpinner="False" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding AdpNc}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="54" ShowButtonSpinner="False"
                               ToolTip.Tip="Repeats of the unit cell in the trajectory's cell: atoms on the same place of the unit cell form a site" />
              </StackPanel>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Click="OnAdp" Content="Compute" IsEnabled="{Binding HasDocument}" />
                <Button Click="OnAdpColour" Content="Colour by U_iso" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Mobile atoms bright (viridis)" />
                <Button Click="OnAdpCif" Content="Write CIF with U_ij…" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Mean positions (sites) with their anisotropic U on the CIF's axes" />
              </WrapPanel>
              <TextBlock Text="{Binding AdpError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AdpHasError}" />
              <TextBlock Text="{Binding AdpText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding AdpHas}" />
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding BeamLabel}" FontSize="13.5" FontWeight="SemiBold" />
              <StackPanel Spacing="6"><TextBlock Text="Form factors" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.FormFactorModes}" SelectedIndex="{Binding FormFactorMode}" HorizontalAlignment="Stretch"
                ToolTip.Tip="X-ray: Cromer–Mann form factors of the neutral atoms (every element to Cf except Tm). Electron: Peng et al. 1996 elastic scattering factors, for electron diffraction (SAED) of amorphous and crystalline films" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Source (for 2θ)" Classes="label" /><ComboBox ItemsSource="{Binding BeamSources}" SelectedIndex="{Binding XraySourceIndex}" HorizontalAlignment="Stretch" /></StackPanel>
              <ItemsControl ItemsSource="{Binding ScatterPeaks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="*,*,*">
                        <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='d {0}'}" Classes="mono" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Other, StringFormat='2θ {0}'}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Neutron" FontSize="13.5" FontWeight="SemiBold" />
              <StackPanel>
                <Grid ColumnDefinitions="55*,45*" Margin="0,0,0,4">
                  <TextBlock Text="NUCLEUS" Classes="h3" />
                  <TextBlock Grid.Column="1" Text="B COH (FM)" Classes="h3" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ScatterLengths}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProvRow">
                      <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6">
                        <Grid ColumnDefinitions="55*,45*">
                          <TextBlock Text="{Binding Key}" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Isotope pattern" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.IsotopePatterns}" SelectedIndex="{Binding IsotopePattern}" HorizontalAlignment="Stretch" /></StackPanel>
              <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                <TextBlock Text="Scattering lengths: Sears, Neutron News 3, 26 (1992)" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Analyze.Log}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
