<!-- CAPS Analyze › Scattering (design/boards/Scattering.dc.html): X-ray and neutron patterns of the cell, peaks in q, d and
     2θ, deuteration contrast, a measured curve overlaid. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ScatteringPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <v:AnalyzeSide DockPanel.Dock="Left" />
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnLoadExperiment" ToolTip.Tip="Two columns: q (Å⁻¹) or 2θ (degrees, with the X-ray source's wavelength) and intensity"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Load experimental curve" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Analyze · scattering" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="X-ray and neutron patterns from the simulated cell, ready to overlay on measured data" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Faber–Ziman normalisation · CPU sum over the cell's k-vectors" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ScatterFooter}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid v:Panes.Split="True" ColumnDefinitions="*,400" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ScatterTitle}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
            <WrapPanel>
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding ScatterXray}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="{Binding XrayChip}" /></StackPanel></Border>
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding ScatterNeutron}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="{Binding NeutronChip}" /></StackPanel></Border>
              <Border Classes="chip" Margin="0,0,6,0" IsVisible="{Binding HasExperiment}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="···" Foreground="{DynamicResource MutedB}" /><TextBlock Text="{Binding ExperimentName}" /><Button Classes="tool" Padding="2" MinHeight="14" Height="16" Click="OnClearExperiment"><v:Icon Kind="close" Size="10" /></Button></StackPanel></Border>
            </WrapPanel>
            <TextBlock Text="{Binding ScatterText}" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" LineHeight="18" />
          </StackPanel>
          <v:LinePlot x:Name="Plot" XLabel="q (Å⁻¹)" YLabel="I(q) · normalised" AutoRange="True" />
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Method" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="Direct sum over the cell's reciprocal lattice up to the switch-over, the partial g(r) transformed above it" FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Direct up to · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.QDirectD}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="q max · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.QmaxD}" Minimum="1" Maximum="40" Increment="1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Δq · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding Analyze.DqD}" Minimum="0.002" Maximum="0.2" Increment="0.005" FormatString="0.000" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="6"><TextBlock Text="Plot to · Å⁻¹" Classes="label" /><NumericUpDown Value="{Binding ScatterPlotTo}" Minimum="1" Maximum="40" Increment="1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="{Binding BeamLabel}" IsChecked="{Binding ScatterXray}" />
                <CheckBox Content="Neutron" IsChecked="{Binding ScatterNeutron}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding BeamLabel}" FontSize="13.5" FontWeight="SemiBold" />
              <StackPanel Spacing="6"><TextBlock Text="Form factors" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.FormFactorModes}" SelectedIndex="{Binding FormFactorMode}" HorizontalAlignment="Stretch"
                ToolTip.Tip="X-ray: Cromer–Mann form factors of the neutral atoms (every element to Cf except Tm). Electron: Peng et al. 1996 elastic scattering factors, for electron diffraction (SAED) of amorphous and crystalline films" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Source (for 2θ)" Classes="label" /><ComboBox ItemsSource="{Binding BeamSources}" SelectedIndex="{Binding XraySourceIndex}" HorizontalAlignment="Stretch" /></StackPanel>
              <ItemsControl ItemsSource="{Binding ScatterPeaks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProvRow">
                    <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="*,*,*">
                        <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='d {0}'}" Classes="mono" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Other, StringFormat='2θ {0}'}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="pcard">
            <StackPanel Spacing="10">
              <TextBlock Text="Neutron" FontSize="13.5" FontWeight="SemiBold" />
              <StackPanel>
                <Grid ColumnDefinitions="55*,45*" Margin="0,0,0,4">
                  <TextBlock Text="NUCLEUS" Classes="h3" />
                  <TextBlock Grid.Column="1" Text="B COH (FM)" Classes="h3" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ScatterLengths}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProvRow">
                      <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6">
                        <Grid ColumnDefinitions="55*,45*">
                          <TextBlock Text="{Binding Key}" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="Isotope pattern" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.IsotopePatterns}" SelectedIndex="{Binding IsotopePattern}" HorizontalAlignment="Stretch" /></StackPanel>
              <Border Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
                <TextBlock Text="Scattering lengths: Sears, Neutron News 3, 26 (1992)" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" FontStyle="Italic" />
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Analyze.Log}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
