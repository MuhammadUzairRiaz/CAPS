<!-- CAPS Builders › Polymer › Tacticity (design/boards/Tacticity): the built chain's stereo sequence against the statistical model. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.TacticityPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.phead"><Setter Property="Padding" Value="16,11" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Redraw" Click="OnRedraw" ToolTip.Tip="Another chain from the same model (next seed)" />
          <Button Classes="primary" Content="Apply to chains" Click="OnApply" ToolTip.Tip="Grow draws its atactic chains from this model" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Tacticity statistics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Stereo sequence of the built chain against the statistical model" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="model values exact · chain values counted from the built structure" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TsStatus}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer Margin="22,18">
      <Grid v:Panes.Split="True" ColumnDefinitions="400,*" ColumnSpacing="14">
        <StackPanel Spacing="14">
          <Border Classes="pcard" Height="260">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding TsLabel}" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="First 8 units" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Panel Background="{DynamicResource Bg0B}">
                <v:MolView x:Name="View" />
                <TextBlock Text="Building the chain…" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" IsVisible="{Binding TsBuilding}" />
              </Panel>
            </DockPanel>
          </Border>
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip ok"><TextBlock Text="computed" /></Border>
                  <TextBlock Text="Triads" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,8,16,14" Spacing="10">
                <StackPanel>
                  <Grid ColumnDefinitions="*,90,110" Height="26">
                    <TextBlock Text="TRIAD" Classes="h3" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="MODEL" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding TsChainHeader}" Classes="h3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding TsTriads}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ModelRow">
                      <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,90,110" Height="29">
                          <TextBlock Text="{Binding Label}" Classes="mono" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding A}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding B}" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <StackPanel Spacing="4" IsVisible="{Binding TsBernoulli}"><TextBlock Text="P_m" Classes="label" /><NumericUpDown Value="{Binding TsPm}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding TsMarkov}"><TextBlock Text="P(r|m)" Classes="label" /><NumericUpDown Value="{Binding TsPmr}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Model" Classes="label" /><ComboBox ItemsSource="{Binding TsModelNames}" SelectedIndex="{Binding TsModel}" HorizontalAlignment="Stretch" /></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="DP" Classes="label" /><NumericUpDown Value="{Binding TsDp}" Minimum="5" Maximum="2000" Increment="10" FormatString="0" /></StackPanel>
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding TsMarkov}" Width="115" HorizontalAlignment="Left"><TextBlock Text="P(m|r)" Classes="label" /><NumericUpDown Value="{Binding TsPrm}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                <TextBlock Text="{Binding TsError}" Classes="err" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="14">
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="{Binding TsSeedText}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBlock Text="{Binding TsDyadTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <StackPanel Margin="16,14" Spacing="10">
                <v:SequenceStrip x:Name="Dyads" Height="30" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#F0A83C" VerticalAlignment="Center" /><TextBlock Text="{Binding TsMeso}" FontSize="12" Foreground="{DynamicResource MutedB}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#2271DB" VerticalAlignment="Center" /><TextBlock Text="{Binding TsRacemo}" FontSize="12" Foreground="{DynamicResource MutedB}" /></StackPanel>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="pcard">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="phead"><TextBlock Text="Pentads" FontSize="13.5" FontWeight="SemiBold" /></Border>
              <StackPanel Margin="16,10,16,14" Spacing="10">
                <v:XyChart x:Name="Pentads" Height="250" />
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="Pentads are what ¹³C NMR resolves. Enter measured pentads and CAPS fits P_m, or first-order Markov P(r|m) and P(m|r) if Bernoulli fails the test mm·rr = (mr/2)²." />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding TsMeasured}" Classes="mono" Watermark="measured pentads: mmmm, mmmr, rmmr, mmrr, mmrm, rmrm, rmrr, rrrr, rrrm, mrrm" />
                  <Button Grid.Column="1" Classes="small" Content="Fit" Click="OnFit" />
                </Grid>
                <TextBlock Text="{Binding TsFit}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</p:PageBase>
