<!-- CAPS Import (design/boards/ImportDialog): a structure file without a topology, with where its bonds come from, bond
     orders, molecules, unwrapping and the cell previewed on frame 0 and a ten-carbon fragment; then force field and checks. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ImportDialog" x:DataType="vm:MainViewModel">
  <Panel>
    <Border Background="#B307080A" PointerPressed="OnBackdrop" />
    <Border Width="1040" Height="720" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg1B}" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="52" Padding="20,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="tool" Click="OnCancel" ToolTip.Tip="Close (Esc)"><v:Icon Kind="close" Size="16" /></Button>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding ImportTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="chip ok"><TextBlock Text="{Binding ImportFormatChip}" /></Border>
              <Border Classes="chip" Classes.warn="{Binding ImportBondsWarn}"><TextBlock Text="{Binding ImportBondsChip}" /></Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" Click="OnCancel" />
              <Button Classes="primary" Click="OnImport" IsEnabled="{Binding ImportIdle}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="15" VerticalAlignment="Center" /><TextBlock Text="Import as new document" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="{Binding ImportError}" Foreground="{DynamicResource ErrB}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <Grid ColumnDefinitions="460,*">
          <Border Padding="20,18" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0">
            <StackPanel Spacing="10">
              <TextBlock Text="FILE PREVIEW" Classes="h3" />
              <Border Padding="12,10" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding ImportHead}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewLine">
                      <DockPanel Height="19">
                        <TextBlock DockPanel.Dock="Left" Width="22" Text="{Binding Number}" TextAlignment="Right" Classes="mono" FontSize="11.5" Foreground="{DynamicResource DimB}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Text}" Classes="mono" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <DockPanel Height="26"><TextBlock DockPanel.Dock="Right" Text="{Binding ImportAtoms}" Classes="mono" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Atoms" Foreground="{DynamicResource MutedB}" FontSize="12.5" VerticalAlignment="Center" /></DockPanel>
              <DockPanel Height="26"><TextBlock DockPanel.Dock="Right" Text="{Binding ImportCell}" Classes="mono" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Cell" Foreground="{DynamicResource MutedB}" FontSize="12.5" VerticalAlignment="Center" /></DockPanel>
              <DockPanel Height="26"><TextBlock DockPanel.Dock="Right" Text="{Binding ImportUnits}" Classes="mono" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Units" Foreground="{DynamicResource MutedB}" FontSize="12.5" VerticalAlignment="Center" /></DockPanel>
              <TextBlock Text="BOND PERCEPTION PREVIEW · FIRST 10 HEAVY ATOMS" Classes="h3" Margin="0,6,0,0" />
              <Border Height="200" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}" ClipToBounds="True">
                <v:MolView x:Name="Frag" />
              </Border>
              <TextBlock Text="{Binding ImportFragmentText}" FontSize="11.5" Foreground="{DynamicResource DimB}" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Column="1">
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="BONDS" Classes="h3" />
                  <Border Classes="seg" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="seg" Content="Perceive from distances" GroupName="ibonds" IsChecked="{Binding ImportBondMode, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" />
                      <RadioButton Classes="seg" Content="Read from file" GroupName="ibonds" IsChecked="{Binding ImportBondMode, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" />
                      <RadioButton Classes="seg" Content="None" GroupName="ibonds" IsChecked="{Binding ImportBondMode, Converter={x:Static v:IntEqualsConverter.Instance}, ConverterParameter=2}" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding ImportPerceives}">
                    <StackPanel Spacing="6"><TextBlock Text="Radii" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.ImportRadii}" SelectedIndex="0" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Tolerance · Å" Classes="label" /><NumericUpDown Value="{Binding ImportTolerance}" Minimum="0" Maximum="1.5" Increment="0.05" FormatString="0.00" ShowButtonSpinner="False" ToolTip.Tip="Added to the sum of the two covalent radii" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Assign bond orders and aromaticity after perceiving" IsChecked="{Binding ImportOrders}" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="9">
                  <TextBlock Text="MOLECULES &amp; CELL" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Split into molecules by connectivity" IsChecked="{Binding ImportSplit}" />
                  <CheckBox Classes="toggle" Content="Unwrap molecules across periodic boundaries" IsChecked="{Binding ImportUnwrap}" />
                  <CheckBox Classes="toggle" Content="Use cell from file" IsChecked="{Binding ImportUseCell}" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="AFTER IMPORT" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Force field" Classes="label" /><ComboBox ItemsSource="{Binding ImportForceFields}" SelectedIndex="{Binding ImportForceField}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Charges" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.ImportChargeModes}" SelectedIndex="{Binding ImportCharges}" IsEnabled="{Binding ImportChargesEnabled}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Run validation checks" IsChecked="{Binding ImportChecks}" />
                </StackPanel>
              </Border>
              <Border Classes="section" BorderThickness="0">
                <StackPanel Spacing="6">
                  <TextBlock Text="RESULT ON FRAME 0" Classes="h3" />
                  <TextBlock Text="{Binding ImportSummary}" Classes="mono" FontSize="12.5" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ImportNotes}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Panel>
</p:PageBase>
