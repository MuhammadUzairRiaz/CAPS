<!-- CAPS Crystal builder (design/boards/CrystalBuilder.dc.html): a space group (530 settings from their Hall symbols), a
     lattice and an asymmetric unit expanded into a cell; symmetry found, sites snapped onto special positions, primitive
     cells and supercells; CIF import. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.CrystalPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Button.builder"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="12,0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /><Setter Property="FontSize" Value="12.5" /></Style>
    <Style Selector="Button.builder.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <!-- space-group cards: two columns, the chosen one outlined in the accent -->
    <Style Selector="ListBox.groups"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBox.groups ListBoxItem">
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="B" Height="30" Margin="0,0,0,6" Padding="10,0" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.groups ListBoxItem:pointerover /template/ Border#B"><Setter Property="BorderBrush" Value="{DynamicResource MutedB}" /></Style>
    <Style Selector="ListBox.groups ListBoxItem:selected /template/ Border#B"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
    <Style Selector="TextBox.cell"><Setter Property="MinHeight" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="Padding" Value="4,0" /><Setter Property="FontSize" Value="11.5" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontFamily" Value="{DynamicResource Mono}" /></Style>
    <Style Selector="ToggleButton.small"><Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" /><Setter Property="CornerRadius" Value="6" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource Bg2B}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="ToggleButton.small:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="ToggleButton.small:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="ToggleButton.small:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg2B}" /><Setter Property="Foreground" Value="{DynamicResource DimB}" /><Setter Property="Opacity" Value="0.6" /></Style>
    <Style Selector="Button.x"><Setter Property="MinHeight" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Width" Value="22" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="TextBox.cell.num"><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  </p:PageBase.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="48" Padding="12,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="BUILDERS" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.9" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Classes="builder" Content="Polymer" Click="OnPolymer" />
        <Button Classes="builder on" Content="Crystal" />
        <Button Classes="builder" Content="Surface" Click="OnSurface" />
        <Button Classes="builder" Content="Nanostructure" Click="OnNano" />
        <Button Classes="builder" Content="Biomolecule" Click="OnBio" />
        <Button Classes="builder" Content="Solvation" Click="OnSolvation" ToolTip.Tip="Pack molecules into regions (CAPS Pack)" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,420">
      <!-- preview: the supercell dashed, one unit cell in the accent -->
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="28" Padding="14,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Symmetry: CAPS · Hall symbols (ITA Vol. B, Table A1.4.2.7)" FontSize="11.5" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
              <TextBlock Text="{Binding CrystalAtomsText}" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
              <TextBlock Text="{Binding CrystalVolumeText}" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Panel>
          <v:MolView x:Name="Preview" ShowCell="True" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding CrystalHudGroup}" FontSize="12" /></Border>
            <Border Classes="hud" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="unit cell" FontSize="12" Foreground="{DynamicResource MutedB}" /></StackPanel>
            </Border>
            <Border Classes="hud" Padding="10,4"><TextBlock Text="{Binding CrystalHudSuper}" FontSize="12" Foreground="{DynamicResource MutedB}" /></Border>
            <Border Classes="hud" Padding="10,4" IsVisible="{Binding CrystalBusy}"><TextBlock Text="finding the symmetry…" FontSize="12" Foreground="{DynamicResource AccB}" /></Border>
          </StackPanel>
        </Panel>
      </DockPanel>

      <!-- inspector -->
      <Border Grid.Column="1" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="48" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" Height="20" Padding="8,0" VerticalAlignment="Center"><TextBlock Text="ITA Vol. A · 230 groups" FontSize="11" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" /></Border>
              <TextBlock Text="Crystal builder" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Click="OnCancel" />
              <Button Classes="primary" Click="OnBuild" IsEnabled="{Binding CrystalIdle}">
                <StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="cube" Size="15" VerticalAlignment="Center" /><TextBlock Text="Build crystal" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <!-- space group -->
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip" Height="20" Padding="8,0"><TextBlock Text="{Binding CrystalSystemText}" FontSize="11" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="SPACE GROUP" Classes="h3" VerticalAlignment="Center" />
                  </DockPanel>
                  <Border Height="32" Padding="8,0" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg0B}">
                    <DockPanel>
                      <v:Icon DockPanel.Dock="Left" Kind="search" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox x:Name="GroupSearch" Text="{Binding CrystalQuery}" Watermark="Symbol, number or system — Pnma, 14, cubic" BorderThickness="0" Background="Transparent"
                               Padding="0" MinHeight="0" VerticalContentAlignment="Center" FontFamily="{DynamicResource Mono}" FontSize="12.5" />
                    </DockPanel>
                  </Border>
                  <ListBox Classes="groups" ItemsSource="{Binding CrystalGroups}" SelectedItem="{Binding CrystalGroupPick}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="6" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpaceGroupItem">
                        <DockPanel ToolTip.Tip="{Binding Tip}">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding NumberText}" Classes="mono" FontSize="12" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" Classes="mono" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Binding CrystalQueryNote}" Classes="dim" FontSize="11.5" IsVisible="{Binding CrystalQueryNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>

              <!-- lattice -->
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="LATTICE" Classes="h3" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Spacing="6"><TextBlock Text="a · Å" Classes="label" /><NumericUpDown Value="{Binding CrystalA}" Minimum="0.5" Maximum="500" Increment="0.01" FormatString="0.0###" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="b · Å" Classes="label" /><NumericUpDown Value="{Binding CrystalB}" IsEnabled="{Binding CrystalBFree}" Minimum="0.5" Maximum="500" Increment="0.01" FormatString="0.0###" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="c · Å" Classes="label" /><NumericUpDown Value="{Binding CrystalC}" IsEnabled="{Binding CrystalCFree}" Minimum="0.5" Maximum="500" Increment="0.01" FormatString="0.0###" ShowButtonSpinner="False" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Spacing="6"><TextBlock Text="α · °" Classes="label" /><NumericUpDown Value="{Binding CrystalAlpha}" IsEnabled="{Binding CrystalAlphaFree}" Minimum="10" Maximum="170" Increment="0.1" FormatString="0.0##" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="β · °" Classes="label" /><NumericUpDown Value="{Binding CrystalBeta}" IsEnabled="{Binding CrystalBetaFree}" Minimum="10" Maximum="170" Increment="0.1" FormatString="0.0##" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="γ · °" Classes="label" /><NumericUpDown Value="{Binding CrystalGamma}" IsEnabled="{Binding CrystalGammaFree}" Minimum="10" Maximum="170" Increment="0.1" FormatString="0.0##" ShowButtonSpinner="False" /></StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding CrystalLatticeRule}" Classes="dim" FontSize="11.5" />
                  <TextBlock Text="{Binding CrystalCite}" Classes="dim" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding CrystalHasCite}" />
                </StackPanel>
              </Border>

              <!-- asymmetric unit -->
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip" Height="20" Padding="8,0"><TextBlock Text="{Binding CrystalExpandText}" FontSize="11" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="ASYMMETRIC UNIT" Classes="h3" VerticalAlignment="Center" />
                  </DockPanel>
                  <Grid ColumnDefinitions="46,34,*,*,*,44,20" ColumnSpacing="3">
                    <TextBlock Text="Label" Classes="label" />
                    <TextBlock Grid.Column="1" Text="El." Classes="label" />
                    <TextBlock Grid.Column="2" Text="x" Classes="label" Margin="5,0,0,0" />
                    <TextBlock Grid.Column="3" Text="y" Classes="label" Margin="5,0,0,0" />
                    <TextBlock Grid.Column="4" Text="z" Classes="label" Margin="5,0,0,0" />
                    <TextBlock Grid.Column="5" Text="Occ." Classes="label" Margin="5,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding CrystalSites}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CrystalSiteRow">
                        <Grid ColumnDefinitions="46,34,*,*,*,44,20" ColumnSpacing="3" Margin="0,0,0,4" ToolTip.Tip="{Binding Multiplicity, StringFormat='{}{0} atoms per cell'}">
                          <TextBox Classes="cell" Text="{Binding Label}" />
                          <TextBox Grid.Column="1" Classes="cell" Text="{Binding Element}" />
                          <TextBox Grid.Column="2" Classes="cell num" Text="{Binding X}" />
                          <TextBox Grid.Column="3" Classes="cell num" Text="{Binding Y}" />
                          <TextBox Grid.Column="4" Classes="cell num" Text="{Binding Z}" />
                          <TextBox Grid.Column="5" Classes="cell num" Text="{Binding Occ}" />
                          <Button Grid.Column="6" Classes="x" Click="OnRemoveSite" Tag="{Binding}" ToolTip.Tip="Remove the site" VerticalAlignment="Center">
                            <v:Icon Kind="close" Size="12" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Click="OnAddSite">
                      <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="plus" Size="13" VerticalAlignment="Center" /><TextBlock Text="Add site" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnImportCif">
                      <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="file" Size="13" VerticalAlignment="Center" /><TextBlock Text="Import CIF" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <ComboBox x:Name="Library" ItemsSource="{Binding CrystalLibrary}" PlaceholderText="From the library" MinWidth="150" SelectionChanged="OnLibrary" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- symmetry tools -->
              <Border Classes="section" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="SYMMETRY TOOLS" Classes="h3" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Content="Apply symmetry" Click="OnApplySymmetry" ToolTip.Tip="Snap each site onto its special position (x = 0.333 → 1/3)" />
                    <Button Classes="small" Click="OnFindSymmetry" IsEnabled="{Binding CrystalIdle}" ToolTip.Tip="The highest-symmetry setting that maps this crystal onto itself">
                      <StackPanel Orientation="Horizontal" Spacing="6"><v:Icon Kind="search" Size="13" VerticalAlignment="Center" /><TextBlock Text="Find symmetry" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <ToggleButton Classes="small" Content="Primitive cell" IsChecked="{Binding CrystalPrimitive}" IsEnabled="{Binding CrystalCanPrimitive}"
                                  ToolTip.Tip="The primitive cell of a centred lattice (A, B, C, I, F, R)" ToolTip.ShowOnDisabled="True" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Supercell" Classes="label" /><TextBox Text="{Binding CrystalSupercell}" FontFamily="{DynamicResource Mono}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Tolerance" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.CrystalTolerances}" SelectedIndex="{Binding CrystalTolerance}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" Text="Images closer than the tolerance are one atom; Find symmetry allows the same distance between an atom and its image." />
                </StackPanel>
              </Border>

              <Border Padding="16,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding CrystalError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CrystalHasError}" />
                  <TextBlock Text="{Binding CrystalLog}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</p:PageBase>
