<!-- CAPS Analyze › Chains (design/boards/ChainStats): R_ee, R_g, their ratio, C_n and C∞, the R_ee distribution. -->
<p:PageBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:CapsStudio.ViewModels" xmlns:v="using:CapsStudio.Views" xmlns:p="using:CapsStudio.Views.Pages"
            x:Class="CapsStudio.Views.Pages.ChainStatsPage" x:DataType="vm:MainViewModel" Background="{DynamicResource Bg0B}">
  <p:PageBase.Styles>
    <Style Selector="Border.pcard"><Setter Property="Background" Value="{DynamicResource Bg1B}" /><Setter Property="BorderBrush" Value="{DynamicResource LineB}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,14" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style>
  </p:PageBase.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="22,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="OnExport" IsEnabled="{Binding Analyze.HasResults}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export CSV" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="primary" Click="OnRun" IsVisible="{Binding Analyze.NotWorking}" IsEnabled="{Binding HasDocument}"><StackPanel Orientation="Horizontal" Spacing="7"><v:Icon Kind="play" Size="14" VerticalAlignment="Center" /><TextBlock Text="Run" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Content="Cancel" Click="OnCancel" IsVisible="{Binding Analyze.Working}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Text="Chain statistics" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Size and stiffness of chains: R_ee, R_g, C_n" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="28" Padding="22,0" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding CsStatus}" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
    <Grid ColumnDefinitions="360,*" ColumnSpacing="14" Margin="22,18">
      <Border Classes="pcard" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <TextBlock Text="Chains · backbone trace" FontSize="13.5" FontWeight="SemiBold" />
          </Border>
          <Panel Background="{DynamicResource Bg0B}"><v:MolView x:Name="View" /></Panel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="pcard">
            <UniformGrid Columns="3">
              <StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsBonds.Label}" Classes="label" /><TextBlock Text="{Binding CsBonds.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsBonds.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsRee.Label}" Classes="label" /><TextBlock Text="{Binding CsRee.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsRee.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsRg.Label}" Classes="label" /><TextBlock Text="{Binding CsRg.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsRg.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsRatio.Label}" Classes="label" /><TextBlock Text="{Binding CsRatio.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsRatio.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsCn.Label}" Classes="label" /><TextBlock Text="{Binding CsCn.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsCn.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="3" Margin="0,0,12,12"><TextBlock Text="{Binding CsCinf.Label}" Classes="label" /><TextBlock Text="{Binding CsCinf.Value}" Classes="mono" FontSize="17" /><TextBlock Text="{Binding CsCinf.Caption}" Classes="dim" TextWrapping="Wrap" /></StackPanel>
            </UniformGrid>
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="pcard">
              <StackPanel Spacing="8">
                <TextBlock Text="Characteristic ratio" FontSize="13.5" FontWeight="SemiBold" />
                <v:LinePlot x:Name="Cn" Height="200" XLabel="n (bonds in sub-chain)" YLabel="C_n = ⟨R²ₙ⟩ / n l²" AutoRange="True" />
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="Averaged over every sub-chain of each length (Theodorou &amp; Suter 1985)." />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="pcard">
              <StackPanel Spacing="8">
                <TextBlock Text="End-to-end distance" FontSize="13.5" FontWeight="SemiBold" />
                <v:LinePlot x:Name="Ree" Height="200" XLabel="R_ee (Å)" YLabel="probability density" AutoRange="True" Bars="True" />
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="An ideal Gaussian chain has ⟨R²ₑₑ⟩/⟨R²g⟩ = 6; a few chains are a small sample, so expect scatter." />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</p:PageBase>
