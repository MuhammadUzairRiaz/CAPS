<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CapsStudio.ViewModels"
        xmlns:local="using:CapsStudio.Views"
        xmlns:pages="using:CapsStudio.Views.Pages"
        x:Class="CapsStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CAPS Studio"
        Icon="/Assets/caps_256.png"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640">

  <LayoutTransformControl x:Name="ScaleRoot">
  <Grid RowDefinitions="44,*,26">

    <!-- Top bar (design/generator/lib.py topbar): logo, document tabs, command palette, compute -->
    <Border Grid.Row="0" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="72,Auto,Auto,*,Auto">
        <Viewbox Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="CAPS · Chain Assembly and Packing Suite">
          <Canvas Width="30" Height="30">
            <Path Data="M15 2 L26.3 8.5 L26.3 21.5 L15 28 L3.7 21.5 L3.7 8.5 Z" Stroke="{DynamicResource AccB}" StrokeThickness="2" />
            <Path Data="M15 9.5 V11.7 M19.8 17.8 L17.9 16.7 M10.2 17.8 L12.1 16.7" Stroke="{DynamicResource TextB}" StrokeThickness="1.4" />
            <Ellipse Canvas.Left="11.6" Canvas.Top="11.6" Width="6.8" Height="6.8" Fill="{DynamicResource AccB}" />
            <Ellipse Canvas.Left="13" Canvas.Top="5.5" Width="4" Height="4" Fill="{DynamicResource TextB}" />
            <Ellipse Canvas.Left="19.5" Canvas.Top="16.8" Width="4" Height="4" Fill="{DynamicResource TextB}" />
            <Ellipse Canvas.Left="6.5" Canvas.Top="16.8" Width="4" Height="4" Fill="{DynamicResource TextB}" />
          </Canvas>
        </Viewbox>
        <TextBlock Grid.Column="1" Text="{Binding Crumb}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,18,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
          <Button Classes="doctab on" IsVisible="{Binding NoDocument}" Click="OnModuleStudio" ToolTip.Tip="Start">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:Icon Kind="cube" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
              <TextBlock Text="Start" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="doctab on" IsVisible="{Binding HasDocument}" ToolTip.Tip="{Binding Title}" Click="OnModuleStudio">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:Icon Kind="cube" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Classes="tool" Width="18" MinWidth="18" Height="18" MinHeight="18" Padding="0" Click="OnCloseDocument" IsEnabled="{Binding Idle}"
                      ToolTip.Tip="Close (⌘W)" VerticalAlignment="Center">
                <local:Icon Kind="close" Size="12" />
              </Button>
            </StackPanel>
          </Button>
          <Button Classes="tool" Width="30" MinWidth="30" Height="30" MinHeight="30" Margin="4,0,0,3" Command="{Binding $parent[local:MainWindow].OpenCommand}"
                  ToolTip.Tip="Open a structure or trajectory (⌘O)" IsEnabled="{Binding Idle}">
            <local:Icon Kind="plus" Size="15" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
          <Button Width="300" Height="30" MinHeight="30" Padding="10,0" HorizontalContentAlignment="Stretch" FontWeight="Normal" Click="OnCommandPalette"
                  ToolTip.Tip="Command palette (⌘K)">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <local:Icon Kind="search" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Run a command or find anything" Foreground="{DynamicResource DimB}" FontSize="12.5" VerticalAlignment="Center" />
              <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                <TextBlock Text="⌘K" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" />
              </Border>
            </Grid>
          </Button>
          <Button Classes="ghost" Height="30" MinHeight="30" Padding="10,0" FontWeight="Normal" FontSize="12" ToolTip.Tip="Where calculations run">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource OkB}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ComputeText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="72,*,330" RowDefinitions="48,*">

      <!-- Module rail (lib.py rail): the workflow left to right, then the cross-cutting areas; settings at the bottom -->
      <Border Grid.Column="0" Grid.RowSpan="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Classes="rail" Classes.on="{Binding IsSettings}" Height="44" MinHeight="44" Margin="0,0,0,8" HorizontalAlignment="Center"
                  ToolTip.Tip="Settings" Click="OnSettingsRail">
            <local:Icon Kind="gear" Size="19" />
          </Button>
          <StackPanel Spacing="2" Margin="0,8,0,0" HorizontalAlignment="Center">
          <Button Classes="rail" Classes.on="{Binding IsStudioRail}" Click="OnModuleStudio" ToolTip.Tip="Build, view and inspect structures">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="hex" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Studio" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsGrow}" Click="OnModuleGrow" ToolTip.Tip="Grow amorphous polymer cells">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="grow" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Grow" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsPack}" Click="OnModulePack" ToolTip.Tip="Pack molecules into regions (packmol input accepted)">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="pack" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Pack" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsRelax}" Click="OnModuleRelax" ToolTip.Tip="Energy minimisation, push-off and compression">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="relax" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Relax" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsDynamics}" Click="OnModuleDynamics" ToolTip.Tip="Molecular dynamics: NVE, NVT, NPT">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="dyn" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Dynamics" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsEquilibrate}" Click="OnModuleEquilibrate" ToolTip.Tip="Published equilibration protocols with convergence checks">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="equil" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Equilibrate" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsReact}" Click="OnModuleReact" ToolTip.Tip="Crosslinking and reactions from atom-mapped templates">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="react" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="React" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsAnalyzeRail}" Click="OnModuleAnalyze" ToolTip.Tip="Properties with errors, compared with experiment">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="chart" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Analyze" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsField}" Click="OnModuleField" ToolTip.Tip="Force fields: typing, charges and parameters, explained">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="tag" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Field" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsJobs}" Click="OnModuleJobs" ToolTip.Tip="Every run with its progress, curves, log and provenance">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="jobs" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Jobs" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsBench}" Click="OnModuleBench" ToolTip.Tip="The validation suite that regenerates the paper tables">
            <Panel Width="60" Height="52">
              <Border Classes="bar" Width="3" Height="30" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="bench" Size="19" HorizontalAlignment="Center" />
                <TextBlock Text="Bench" HorizontalAlignment="Center" FontSize="10.5" />
              </StackPanel>
            </Panel>
          </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Centre: toolbar, viewport, frame bar -->
      <!-- Toolbar (Main board): tools, builder tools, view options on the right -->
      <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="10,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" ToolTip.Tip="Display style" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="eye" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding StyleText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Ball &amp; stick" Tag="0" Click="OnStyleItem" /><MenuItem Header="Space filling" Tag="1" Click="OnStyleItem" />
                  <MenuItem Header="Sticks" Tag="2" Click="OnStyleItem" /><MenuItem Header="No hydrogens" Tag="3" Click="OnStyleItem" />
                  <MenuItem Header="Backbone" Tag="4" Click="OnStyleItem" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Colour atoms by" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="layers" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding ColourText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Element" Tag="0" Click="OnColourItem" /><MenuItem Header="Molecule" Tag="1" Click="OnColourItem" />
                  <MenuItem Header="Type" Tag="2" Click="OnColourItem" /><MenuItem Header="Distance to molecule centre" Tag="3" Click="OnColourItem" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Projection and camera" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="cube" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding ProjectionText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Perspective" Click="OnPerspectiveOn" /><MenuItem Header="Orthographic" Click="OnPerspectiveOff" />
                  <Separator />
                  <MenuItem Header="Reset view (R)" Click="OnResetView" /><MenuItem Header="Top" Click="OnViewTop" />
                  <MenuItem Header="Front" Click="OnViewFront" /><MenuItem Header="Side" Click="OnViewSide" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Rectangle Classes="vsep" />
            <ToggleButton Classes="tool" IsChecked="{Binding ShowRdf}" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Analysis dock: g(r), thermo, minimisation, molecules, chains">
              <local:Icon Kind="chart" Size="18" />
            </ToggleButton>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" Classes.on="{Binding !MeasureTool}" Click="OnToolSelect" ToolTip.Tip="Select: click an atom · ⇧ click adds (up to 4 measure)"><local:Icon Kind="cursor" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Lasso select — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="lasso" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Translate — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="move" Size="18" /></Button>
            <Button Classes="tool" Click="OnResetView" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reset the view (R); drag in the view rotates"><local:Icon Kind="rotate" Size="18" /></Button>
            <Rectangle Classes="vsep" />
          <Button Classes="tool" ToolTip.Tip="Place atom — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="atom" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Draw bond — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="bond" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Fragment — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="hex" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Fuse ring — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="ring" Size="18" /></Button>
            <Button Height="36" MinHeight="36" Padding="10,0" Margin="4,0,0,0" IsEnabled="False" ToolTip.Tip="Element for new atoms — builder coming" ToolTip.ShowOnDisabled="True">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="22" Height="22" CornerRadius="4" Background="#8B969E"><TextBlock Text="C" FontWeight="Bold" FontSize="12" Foreground="#0F1113" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="sp³" FontSize="12" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                <local:Icon Kind="chev" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Classes="vsep" />
            <Button Classes="tool" Classes.on="{Binding MeasureTool}" Click="OnToolMeasure" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Measure: click 2–4 atoms for a distance, angle or dihedral"><local:Icon Kind="ruler" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Pin monitor — coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="pin" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Mirror / invert — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="mirror" Size="18" /></Button>
            <Rectangle Classes="vsep" />
          <Button Classes="tool" ToolTip.Tip="Auto-clean — builder coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="wand" Size="18" VerticalAlignment="Center" /><TextBlock Text="Auto-clean" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Classes="tool" ToolTip.Tip="Undo — command layer coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="undo" Size="18" /></Button>
          <Button Classes="tool" ToolTip.Tip="Redo — command layer coming" ToolTip.ShowOnDisabled="True" IsEnabled="False"><local:Icon Kind="redo" Size="18" /></Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="0,*,Auto,Auto">
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
        <!-- Project (Main board): documents and what is in them; fragments for the builder -->
        <Border Grid.Column="0" Width="260" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" IsVisible="{Binding IsStudio}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tool" Width="30" MinWidth="30" Height="30" MinHeight="30" Command="{Binding $parent[local:MainWindow].OpenCommand}" ToolTip.Tip="Add a file">
                  <local:Icon Kind="plus" Size="16" />
                </Button>
                <TextBlock Text="Project" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
              <StackPanel>
                <Border Classes="phead">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="Monomers ▾" Foreground="{DynamicResource MutedB}" /></Border>
                    <TextBlock Text="Fragments" Classes="h2" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
                <StackPanel Margin="10" Spacing="10" IsEnabled="False" ToolTip.Tip="The builder arrives with Studio editing" ToolTip.ShowOnDisabled="True">
                  <Border Classes="inset" Padding="8,0" Height="30">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <local:Icon Kind="search" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                      <TextBlock Text="Search fragments" Foreground="{DynamicResource DimB}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <UniformGrid Columns="3">
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="ring" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Benzene" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="hex" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Cyclohexane" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="link" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Ester" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="link" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Amide" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="atom" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Methyl" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="bond" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Vinyl" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="flask" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Water" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="atom" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Na⁺ / Cl⁻" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border Margin="3" Height="62" Background="{DynamicResource Bg2B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="6" Opacity="0.6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:Icon Kind="hex" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                        <TextBlock Text="Styrene" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </StackPanel>
            </Border>
            <ScrollViewer>
              <StackPanel Margin="6,8" Spacing="1">
                <Border Height="26" Padding="10,0" CornerRadius="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <local:Icon Kind="chev" Size="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                    <local:Icon Kind="folder" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                    <TextBlock Text="Open documents" Foreground="{DynamicResource MutedB}" FontSize="12.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Height="26" Padding="24,0,8,0" CornerRadius="5" Background="{DynamicResource Bg3B}" IsVisible="{Binding HasDocument}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <local:Icon Kind="chevr" Size="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                    <local:Icon Kind="cube" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="180" />
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding MoleculeRows}" IsVisible="{Binding HasDocument}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoleculeRow">
                      <Border Height="26" Padding="38,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <local:Icon Kind="hex" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                          <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center">
                            <Run Text="Molecule " /><Run Text="{Binding Molecule}" /><Run Text=" · " /><Run Text="{Binding Atoms}" /><Run Text=" atoms" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="26" Padding="38,0,8,0" IsVisible="{Binding Field.Assigned}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <local:Icon Kind="tag" Size="14" Foreground="{DynamicResource SelB}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Field.ForceFieldName}" FontSize="12.5" Foreground="{DynamicResource SelB}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="180" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <!-- Visualize pipeline (design/boards/VisPipeline): steps run bottom to top, data source, visual elements -->
        <Border Grid.Column="0" Width="300" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" IsVisible="{Binding IsVisualize}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                  <Button Classes="tool" Width="30" Height="30" MinHeight="30" Click="OnAddStep" ToolTip.Tip="Add step"><local:Icon Kind="plus" Size="15" /></Button>
                  <Button Classes="tool" Width="30" Height="30" MinHeight="30" Click="OnPipelineMenu" ToolTip.Tip="Save, load or clear the pipeline"><local:Icon Kind="dots" Size="15" /></Button>
                </StackPanel>
                <TextBlock Text="Pipeline" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10" Spacing="2">
              <TextBlock Text="VISUAL ELEMENTS" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" Margin="10,6,0,4" />
              <CheckBox Classes="toggle" Content="Simulation cell" IsChecked="{Binding ShowCell}" Margin="10,2" />
              <CheckBox Classes="toggle" Content="Colour legend" IsChecked="{Binding PipeLegendVisible}" Margin="10,2" />
              <CheckBox Classes="toggle" Content="Outlines" IsChecked="{Binding Outlines}" Margin="10,2" />
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Margin="8,4,8,8" Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
              <Button Classes="ghost" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPipeSource">
                <StackPanel Spacing="3">
                  <TextBlock Text="DATA SOURCE" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" />
                  <TextBlock Text="{Binding PipeSourceTitle}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PipeSourceDetail}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
                </StackPanel>
              </Button>
            </Border>
            <ScrollViewer>
              <StackPanel Margin="8" Spacing="3">
                <TextBlock Text="STEPS · RUN BOTTOM TO TOP" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" Margin="10,4" />
                <TextBlock Text="No steps: the file is shown as read. Add one with +." Classes="dim" TextWrapping="Wrap" Margin="10,4" IsVisible="{Binding !PipelineRows.Count}" />
                <ItemsControl ItemsSource="{Binding PipelineRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PipelineRow">
                      <StackPanel>
                      <Border IsVisible="{Binding GroupHeader}" Padding="6,6,10,4" Margin="0,4,0,2" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                          <Button Classes="ghost" Padding="2" BorderThickness="0" Background="Transparent" Click="OnGroupFold" Tag="{Binding}" ToolTip.Tip="Fold or unfold the group">
                            <local:Icon Kind="{Binding GroupChevron}" Size="12" Foreground="{DynamicResource MutedB}" />
                          </Button>
                          <local:Icon Grid.Column="1" Kind="layers" Size="13" Foreground="{DynamicResource SelB}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Group}" /><Run Text="  " /><Run Text="{Binding GroupLabel}" FontWeight="Normal" Foreground="{DynamicResource DimB}" FontSize="11" />
                          </TextBlock>
                          <CheckBox Grid.Column="3" Classes="toggle" IsChecked="{Binding GroupOn}" ToolTip.Tip="Every step of the group on or off" />
                        </Grid>
                      </Border>
                      <Button Classes="pipestep" Classes.sel="{Binding Selected}" Click="OnPipeStep" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Margin="0,0,0,3" IsVisible="{Binding RowVisible}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                          <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" Padding="0" />
                          <local:Icon Grid.Column="1" Kind="{Binding Icon}" Size="14" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{Binding SummaryBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PipeError}" Foreground="{DynamicResource ErrB}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasPipeError}" Margin="10,4" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" x:Name="ViewHost" Background="{DynamicResource Bg0B}" ClipToBounds="True" Focusable="True" IsTabStop="True"
                AutomationProperties.Name="3D view · arrow keys walk the atoms, [ and ] the molecules, B the bonds">
          <Panel>
            <Image x:Name="ViewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <!-- Empty state -->
            <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" Text="The structure appears here when the run starts">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="NoDocument" />
                  <Binding Path="!IsStudio" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- HUD (Main board): selection and system chips, live monitors -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasDocument}">
              <Border Classes="chip" Background="{DynamicResource HudB}" IsVisible="{Binding HasSelection}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding HudSelection}" Foreground="{DynamicResource TextB}" />
                </StackPanel>
              </Border>
              <Border Classes="chip" Background="{DynamicResource HudB}">
                <TextBlock Text="{Binding HudInfo}" Foreground="{DynamicResource MutedB}" />
              </Border>
              <Border Classes="chip" Background="{DynamicResource HudB}" IsVisible="{Binding LoadIndexing}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" VerticalAlignment="Center" />
                  <TextBlock Text="frame 0 · ready" Foreground="{DynamicResource OkB}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Classes="hud" Width="230" Padding="12,10" Margin="14,12" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasMeasure}">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <local:Icon Kind="pin" Size="13" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                  <TextBlock Text="LIVE MONITORS" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding MeasureText}" Classes="mono" Foreground="{DynamicResource AccB}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding ShowLegend}" Classes="hud"
                    Padding="12,10" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="190">
              <StackPanel Spacing="6">
                <TextBlock Text="Distance to molecule centre" Classes="dim" />
                <Rectangle Height="10" RadiusX="2" RadiusY="2">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="#440154" /><GradientStop Offset="0.125" Color="#472D7B" /><GradientStop Offset="0.25" Color="#3B528B" />
                      <GradientStop Offset="0.375" Color="#2C728E" /><GradientStop Offset="0.5" Color="#21918C" /><GradientStop Offset="0.625" Color="#28AE80" />
                      <GradientStop Offset="0.75" Color="#5EC962" /><GradientStop Offset="0.875" Color="#ADDC30" /><GradientStop Offset="1" Color="#FDE725" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding LegendLo}" Classes="mono" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding LegendHi}" Classes="mono" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock x:Name="HintText" IsVisible="False" />
            <!-- Visualize: the colour coding's legend -->
            <Border Classes="hud" Padding="12,10" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="260" IsVisible="{Binding ShowPipeLegend}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding PipeLegendTitle}" Classes="dim" />
                <ItemsControl ItemsSource="{Binding PipeLegendEntries}" IsVisible="{Binding PipeLegendCategorical}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegendSwatch">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,10,1">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="4" IsVisible="{Binding PipeLegendContinuous}" Width="180">
                  <Rectangle Height="10" RadiusX="2" RadiusY="2" IsVisible="{Binding !PipeLegendDiverging}">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#440154" /><GradientStop Offset="0.25" Color="#3B528B" /><GradientStop Offset="0.5" Color="#21918C" />
                        <GradientStop Offset="0.75" Color="#5EC962" /><GradientStop Offset="1" Color="#FDE725" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Rectangle Height="10" RadiusX="2" RadiusY="2" IsVisible="{Binding PipeLegendDiverging}">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#2166AC" /><GradientStop Offset="0.25" Color="#92C5DE" /><GradientStop Offset="0.5" Color="#F7F7F7" />
                        <GradientStop Offset="0.75" Color="#F4A582" /><GradientStop Offset="1" Color="#B2182B" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Grid ColumnDefinitions="*,*">
                    <TextBlock Text="{Binding PipeLegendLo}" Classes="mono" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding PipeLegendHi}" Classes="mono" FontSize="11" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Render (design/boards/RenderOverlays): the output frame and its overlays -->
            <local:RenderGuideView x:Name="RenderGuide" IsVisible="{Binding IsRender}" IsHitTestVisible="False" />
            <!-- Keyboard walk (design/boards/VisAccess): what a screen reader says, shown for sighted keyboard users -->
            <TextBlock Text="{Binding Announcement}" Opacity="0" IsHitTestVisible="False" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                       AutomationProperties.LiveSetting="Polite" />
            <Border Margin="16,14" Padding="12,10" VerticalAlignment="Bottom" CornerRadius="8" Background="{DynamicResource Bg1B}"
                    BorderBrush="{DynamicResource SelB}" BorderThickness="1" IsVisible="{Binding ShowAnnouncementBar}" IsHitTestVisible="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <local:Icon Kind="eye" Size="16" Foreground="{DynamicResource SelB}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="SCREEN READER ANNOUNCES" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.9" Foreground="{DynamicResource SelB}" />
                  <TextBlock Text="{Binding Announcement}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
              </Grid>
            </Border>
          </Panel>
        </Border>
        </Grid>

        <!-- Visualize: data inspector (design/boards/DataInspector) -->
        <Border Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Height="236">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasDocument" />
              <Binding Path="IsVisualize" />
            </MultiBinding>
          </Border.IsVisible>
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBox Width="260" Classes="mono" Watermark="Filter: Molecule == 1" Text="{Binding InspectorFilter}" IsVisible="{Binding IsParticlesTab}" FontSize="12" />
                  <ComboBox Width="240" ItemsSource="{Binding PipeTables}" SelectedItem="{Binding PipeTableName}" IsVisible="{Binding InspectorShowsTables}" />
                  <ComboBox Width="200" ItemsSource="{Binding PipeYColumns}" SelectedItem="{Binding PipeYColumnName}" IsVisible="{Binding InspectorShowsTables}" ToolTip.Tip="Column plotted" />
                  <Button Classes="small" Click="OnSeries" IsEnabled="{Binding SeriesIdle}" IsVisible="{Binding InspectorShowsTables}"
                          ToolTip.Tip="Run the pipeline on every frame and tabulate its attributes (cluster count, MSD, density …)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="history" Size="13" VerticalAlignment="Center" /><TextBlock Text="Over all frames" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </StackPanel>
                <TabStrip SelectedIndex="{Binding InspectorTab}" Classes="small">
                  <TabStripItem Content="Particles" /><TabStripItem Content="Bonds" /><TabStripItem Content="Global attributes" /><TabStripItem Content="Data tables" />
                </TabStrip>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="12,3">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsVisible="{Binding InspectorShowsTable}">
                  <Button Classes="small" Content="‹" Click="OnInspectorPrev" IsEnabled="{Binding InspectorCanPrev}" />
                  <Button Classes="small" Content="›" Click="OnInspectorNext" IsEnabled="{Binding InspectorCanNext}" />
                </StackPanel>
                <TextBlock Text="{Binding InspectorNote}" FontSize="11.5" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Panel>
              <!-- particle and bond rows, and a data table's rows -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !InspectorShowsAttributes}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <StackPanel Margin="12,4">
                    <ItemsControl ItemsSource="{Binding InspectorColumns}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Width="96" Classes="label" TextAlignment="Right" Margin="0,0,8,2" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding InspectorRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableRow">
                          <Border Classes="trow" Classes.hl="{Binding Selected}" Height="21">
                            <ItemsControl ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Text="{Binding}" Width="96" Classes="mono" FontSize="11.5" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <local:LinePlot Grid.Column="1" Width="360" Margin="8,4,12,4" x:Name="PipeTablePlot" AutoRange="True" IsVisible="{Binding InspectorShowsTables}" />
              </Grid>
              <ScrollViewer IsVisible="{Binding InspectorShowsAttributes}">
                <ItemsControl ItemsSource="{Binding PipeAttributes}" Margin="14,6" MaxWidth="520" HorizontalAlignment="Left">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Row">
                      <Border Padding="0,3" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource MutedB}" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,10" Height="230">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasDocument" />
              <Binding Path="ShowRdf" />
              <Binding Path="ShowAnalysisPanel" />
            </MultiBinding>
          </Border.IsVisible>
          <TabControl x:Name="AnalysisTabs" Padding="0" Margin="0,-6,0,0">
            <TabItem Header="g(r)" FontSize="13">
              <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                <local:LinePlot x:Name="RdfPlot" XLabel="r (Å)" YLabel="g(r)" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="RADIAL DISTRIBUTION" Classes="h3" />
                  <ComboBox ItemsSource="{x:Static vm:MainViewModel.RdfPairs}" SelectedIndex="{Binding RdfPairIndex}" HorizontalAlignment="Stretch" />
                  <CheckBox Content="Only between molecules" IsChecked="{Binding RdfInter}" />
                  <TextBlock Text="{Binding RdfNote}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

            </TabItem>
            <TabItem Header="Minimisation" FontSize="13">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <local:LinePlot x:Name="EnergyPlot" XLabel="iteration" YLabel="energy (kcal/mol)" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="ForcePlot" XLabel="iteration" YLabel="log₁₀ |F|max · dashed: tolerance" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Thermo" FontSize="13">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <local:LinePlot x:Name="TempPlot" XLabel="time (ps)" YLabel="T (K) · dashed: target" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="PressPlot" XLabel="time (ps)" YLabel="pressure (atm)" AutoRange="True" />
                <local:LinePlot Grid.Column="2" x:Name="DensPlot" XLabel="time (ps)" YLabel="density (g/cm³)" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Molecules" FontSize="13">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="70,70,110,90,90" Margin="0,4,0,4">
                  <TextBlock Text="MOL" Classes="h3" /><TextBlock Grid.Column="1" Text="ATOMS" Classes="h3" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="MASS (g/mol)" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="RG (Å)" Classes="h3" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="κ²" Classes="h3" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding MoleculeRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MoleculeRow">
                        <Grid ColumnDefinitions="70,70,110,90,90" Margin="0,1">
                          <TextBlock Text="{Binding Molecule}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Atoms}" Classes="mono" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="2" Text="{Binding Mass}" Classes="mono" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding Rg}" Classes="mono" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="{Binding Kappa2}" Classes="mono" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding MoleculeNote}" Classes="dim" Margin="0,4,0,0" />
              </Grid>
            </TabItem>
            <TabItem Header="Network" FontSize="13">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <local:LinePlot x:Name="ConvPlot" XLabel="cycle" YLabel="conversion α" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="GelPlot" XLabel="conversion α" YLabel="largest cluster (mass fraction)" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Around atom" FontSize="13" x:Name="FocusTab">
              <Grid ColumnDefinitions="440,*" ColumnSpacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Text="AROUND THE FOCUSED ATOM" Classes="h3" />
                  <Grid ColumnDefinitions="22*,22*,26*,30*" Margin="0,2">
                    <TextBlock Text="Neighbour" Classes="label" /><TextBlock Grid.Column="1" Text="Name" Classes="label" />
                    <TextBlock Grid.Column="2" Text="Molecule" Classes="label" /><TextBlock Grid.Column="3" Text="Distance (Å)" Classes="label" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding FocusRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FocusRow">
                        <Border Height="26" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="22*,22*,26*,30*">
                            <TextBlock Text="{Binding Id}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Molecule}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes="mono" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Click the view (or Tab to it), then ↑ ↓ to walk the atoms." Classes="dim" IsVisible="{Binding !HasFocusAtom}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="0,18,0,0">
                  <TextBlock Text="{Binding FocusTitle}" Classes="mono" FontSize="12" Foreground="{DynamicResource AccB}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="19"
                             Text="The 3D view is one focusable region. Inside it, keys walk the structure the way a reader walks text: atom, bond, molecule, frame. The amber ring marks focus; the announcement is also shown on screen, for sighted keyboard users." />
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Chains" FontSize="13">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="18">
                <local:LinePlot x:Name="ChainPlot" XLabel="n (backbone bonds apart)" YLabel="⟨R²(n)⟩ / (n ⟨b²⟩)" AutoRange="True" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="INTERNAL DISTANCES" Classes="h3" />
                  <TextBlock Text="{Binding ChainNote}" Classes="dim" TextWrapping="Wrap" />
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             Text="Mean-square distance between backbone atoms n bonds apart, divided by n ⟨b²⟩ (Theodorou and Suter 1985). Chains packed in strained shapes overshoot or bend away from a smooth rise to a plateau." />
                </StackPanel>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <!-- Reading the other frames (design/boards/VisLoading): how far the file has been read -->
        <Border Grid.Row="3" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="16,12" IsVisible="{Binding LoadIndexing}">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="the timeline opens when the frames are read · orbit, pick and measure now" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
              <TextBlock Text="frame 0" Classes="mono" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="10" MinHeight="10" CornerRadius="5" />
            <Grid ColumnDefinitions="*,Auto,*">
              <TextBlock Text="0" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
              <TextBlock Grid.Column="1" Text="{Binding LoadFramesText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
              <TextBlock Grid.Column="2" Text="{Binding LoadEndText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,8" IsVisible="{Binding HasFrames}" IsEnabled="{Binding Idle}">
          <StackPanel Spacing="6">
          <!-- Timeline (design/boards/Timeline): a sparkline and markers once a time series is computed -->
          <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasTimeline}">
            <ComboBox ItemsSource="{Binding TimelineAttributes}" SelectedItem="{Binding SparkAttribute}" FontSize="11.5" HorizontalAlignment="Stretch" ToolTip.Tip="Attribute drawn over the frames" />
            <local:TimelineView Grid.Column="1" x:Name="Timeline" Height="40" Cursor="Hand" />
            <TextBlock Grid.Column="2" Text="{Binding MarkerNote}" FontSize="11" Foreground="{DynamicResource WarnB}" VerticalAlignment="Center" MaxWidth="200" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Content="{Binding PlayLabel}" Click="OnPlay" Width="64" Margin="0,0,12,0" ToolTip.Tip="Play / pause (Space) · ← → step frames" />
            <TextBlock Grid.Column="1" Text="Frame" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="2" Minimum="0" Maximum="{Binding FrameMax}" Value="{Binding Frame}" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="3" Text="{Binding FrameLabel}" Classes="mono" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Inspector -->
      <Border Grid.Row="1" Grid.Column="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
        <Panel>
        <!-- Studio inspector (Main board): Atom · Molecule · View · File -->
        <TabControl IsVisible="{Binding IsStudio}" Padding="0" Margin="0">
          <TabControl.Styles>
            <Style Selector="TabItem"><Setter Property="Margin" Value="6,0,0,0" /></Style>
          </TabControl.Styles>
          <TabItem Header="Atom">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section" IsVisible="{Binding !HasAtom}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="SELECTED ATOM" Classes="h3" />
                    <TextBlock Text="Click an atom in the view. ⇧ click adds up to four for a distance, angle or dihedral." Classes="muted" TextWrapping="Wrap" FontSize="12.5" />
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="h3"><Run Text="SELECTED ATOM · " /><Run Text="{Binding PickedTitle}" /></TextBlock>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                      <TextBlock Text="Element" Classes="label" /><TextBlock Grid.Column="1" Text="Type" Classes="label" />
                      <TextBox Grid.Row="1" Text="{Binding PickedElement}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickedType}" IsReadOnly="True" Classes="mono" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="x (Å)" Classes="label" /><TextBlock Grid.Column="1" Text="y (Å)" Classes="label" /><TextBlock Grid.Column="2" Text="z (Å)" Classes="label" />
                      <TextBox Grid.Row="1" Text="{Binding PickedX}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickedY}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PickedZ}" IsReadOnly="True" Classes="mono" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PickedRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="FORCE-FIELD TYPE" Classes="h3" />
                    <WrapPanel>
                      <Border Classes="chip acc" Margin="0,0,6,0"><TextBlock Text="{Binding PickedFf}" /></Border>
                      <Border Classes="chip" Background="{DynamicResource Bg3B}" Margin="0,0,6,0"><TextBlock Text="{Binding PickedType}" Classes="mono" Foreground="{DynamicResource TextB}" /></Border>
                      <Border Classes="chip"><TextBlock Text="{Binding PickedCharge}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                    </WrapPanel>
                    <Border Classes="inset">
                      <TextBlock Text="{Binding PickedWhy}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedB}" LineHeight="18" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="NEAREST ATOMS" Classes="h3" />
                    <ItemsControl ItemsSource="{Binding NeighbourRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasDocument}">
                  <StackPanel Spacing="9">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="link" Content="All checks…" Padding="0" FontSize="11.5" Click="OnChecks" />
                      <TextBlock Text="VALIDATION" Classes="h3" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FileChecks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileCheckRow">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2" ToolTip.Tip="{Binding Detail}">
                            <local:Icon Kind="{Binding Icon}" Size="15" Foreground="{Binding Colour}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Molecule">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="8">
                    <TextBlock Text="MOLECULES" Classes="h3" />
                    <Grid ColumnDefinitions="50,60,*,64,54">
                      <TextBlock Text="Mol" Classes="label" /><TextBlock Grid.Column="1" Text="Atoms" Classes="label" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="Mass" Classes="label" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="Rg (Å)" Classes="label" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="κ²" Classes="label" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MoleculeRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoleculeRow">
                          <Grid ColumnDefinitions="50,60,*,64,54" Margin="0,2">
                            <TextBlock Text="{Binding Molecule}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Atoms}" Classes="mono" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding Mass}" Classes="mono" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding Rg}" Classes="mono" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding Kappa2}" Classes="mono" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoleculeNote}" Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="View">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="DISPLAY" Classes="h3" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="Background" Classes="label" />
                      <Border Classes="seg">
                        <UniformGrid Columns="2">
                          <RadioButton Classes="seg" GroupName="vbg" Content="Dark" IsChecked="{Binding !ViewIsLight}" Click="OnViewBgDark" />
                          <RadioButton Classes="seg" GroupName="vbg" Content="White (paper)" IsChecked="{Binding ViewIsLight}" Click="OnViewBgLight" />
                        </UniformGrid>
                      </Border>
                    </StackPanel>
                    <CheckBox Classes="toggle" Content="Outlines" IsChecked="{Binding Outlines}" />
                    <CheckBox Classes="toggle" Content="Depth cue" IsChecked="{Binding DepthCue}" />
                    <CheckBox Classes="toggle" Content="Cell edges" IsChecked="{Binding ShowCell}" />
                    <CheckBox Classes="toggle" Content="Wrap atoms into the cell" IsChecked="{Binding Wrap}" />
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="KEYBOARD &amp; READER" Classes="h3" />
                    <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                      <TextBlock Text="↑ ↓" Classes="mono" FontSize="12" /><TextBlock Grid.Column="1" Text="previous / next atom in molecule" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="1" Text="[ ]" Classes="mono" FontSize="12" /><TextBlock Grid.Row="1" Grid.Column="1" Text="previous / next molecule" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="2" Text="B" Classes="mono" FontSize="12" /><TextBlock Grid.Row="2" Grid.Column="1" Text="step along bonds" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="3" Text="Space" Classes="mono" FontSize="12" /><TextBlock Grid.Row="3" Grid.Column="1" Text="select focused atom" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="4" Text="M" Classes="mono" FontSize="12" /><TextBlock Grid.Row="4" Grid.Column="1" Text="measure to last selected" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="5" Text="← →" Classes="mono" FontSize="12" /><TextBlock Grid.Row="5" Grid.Column="1" Text="previous / next frame" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="6" Text="{Binding KeyAnnounce}" Classes="mono" FontSize="12" /><TextBlock Grid.Row="6" Grid.Column="1" Text="announce selection" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="7" Text="Esc" Classes="mono" FontSize="12" /><TextBlock Grid.Row="7" Grid.Column="1" Text="leave the walk" FontSize="12" Foreground="{DynamicResource MutedB}" />
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Verbosity" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Verbosities}" SelectedIndex="{Binding ReaderVerbosity}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <CheckBox Classes="toggle" Content="Announce frame changes" IsChecked="{Binding AnnounceFrames}" />
                    <CheckBox Classes="toggle" Content="Show announcements in the view" IsChecked="{Binding ShowAnnouncement}" />
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="EXPORT FIGURE" Classes="h3" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="Background" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Backgrounds}" SelectedIndex="{Binding ExportBackground}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Size" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.SizePresets}" SelectedIndex="{Binding SizePreset}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Click="OnExportPng">
                        <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="download" Size="16" VerticalAlignment="Center" /><TextBlock Text="Export PNG…" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                      <Button Content="Export SVG…" Click="OnExportSvg" />
                    </StackPanel>
                    <Button Classes="small" Click="OnViewportsPage" HorizontalAlignment="Left" ToolTip.Tip="Top, front, left and perspective views together">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="cube" Size="13" VerticalAlignment="Center" /><TextBlock Text="Four views…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnRenderPage" HorizontalAlignment="Left" ToolTip.Tip="Output frame, ambient occlusion, overlays, image sequences">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="eye" Size="13" VerticalAlignment="Center" /><TextBlock Text="Render…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnFigurePage" HorizontalAlignment="Left" ToolTip.Tip="Journal and slide sizes, backgrounds side by side, title, scale bar and legend">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="sliders" Size="13" VerticalAlignment="Center" /><TextBlock Text="Figure page…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Transparent keeps an alpha channel in PNG and writes no background shape in SVG. Same camera as the view." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="File">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="6">
                    <TextBlock Text="FILE" Classes="h3" />
                    <WrapPanel IsEnabled="{Binding Idle}" Margin="0,2,0,6">
                      <Button Classes="small" Margin="0,0,6,6" Click="OnSaveData" ToolTip.Tip="LAMMPS data with the force field when every atom is typed (⌘S)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="save" Size="14" VerticalAlignment="Center" /><TextBlock Text="LAMMPS data…" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                      <Button Classes="small" Margin="0,0,6,6" Content="PDB…" Click="OnSavePdb" />
                      <Button Classes="small" Margin="0,0,6,6" Content="XYZ…" Click="OnSaveXyz" />
                      <Button Classes="small" Margin="0,0,6,6" Content="Trajectory…" Click="OnSaveTrajectory" IsVisible="{Binding HasFrames}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding SummaryRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <ScrollViewer IsVisible="{Binding !IsStudio}">
          <StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- Visualize: the selected step's editor -->
        <DockPanel IsVisible="{Binding IsVisualize}" Background="{DynamicResource Bg1B}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasPipeSelected}"><TextBlock Text="{Binding PipeStepNumber}" Foreground="{DynamicResource MutedB}" /></Border>
              <TextBlock Text="{Binding PipeStepTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="18,10,18,14" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" IsVisible="{Binding HasPipeSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="small" Click="OnStepUp" ToolTip.Tip="Move up (runs later)"><local:Icon Kind="chev" Size="13" RenderTransform="rotate(180deg)" /></Button>
              <Button Classes="small" Click="OnStepDown" ToolTip.Tip="Move down (runs earlier)"><local:Icon Kind="chev" Size="13" /></Button>
              <Button Classes="small" Content="Remove step" Click="OnStepRemove" />
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section" IsVisible="{Binding HasPipeSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SETTINGS" Classes="h3" />
                  <TextBlock Text="No settings: the step runs as it is." Classes="dim" IsVisible="{Binding !StepFields.Count}" />
                  <ItemsControl ItemsSource="{Binding StepFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StepField">
                        <StackPanel Spacing="4" Margin="0,0,0,10">
                          <TextBlock Text="{Binding Label}" Classes="label" IsVisible="{Binding !IsBool}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsText}">
                            <TextBox Text="{Binding Text}" Classes.mono="{Binding IsMono}" Watermark="{Binding Hint}" AcceptsReturn="False" />
                            <Button Grid.Column="1" Classes="small" Content="Choose…" IsVisible="{Binding IsFile}" Click="OnStepFile" Tag="{Binding}" />
                          </Grid>
                          <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                          <CheckBox Classes="toggle" Content="{Binding Label}" IsChecked="{Binding On}" IsVisible="{Binding IsBool}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding HasPipeSelected}">
                <StackPanel Spacing="6">
                  <TextBlock Text="RESULT" Classes="h3" />
                  <TextBlock Text="{Binding PipeSelected.Summary}" FontSize="12.5" TextWrapping="Wrap" Foreground="{Binding PipeSelected.SummaryBrush}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="PIPELINE AT THIS FRAME" Classes="h3" />
                  <TextBlock Text="{Binding PipelineAtFrameText}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="PLAYBACK" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Every (frames)" Classes="label" /><NumericUpDown Value="{Binding PlaybackEvery}" Minimum="1" Maximum="10000" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Frames per second" Classes="label" /><NumericUpDown Value="{Binding PlaybackFps}" Minimum="1" Maximum="60" Increment="1" FormatString="0" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Loop" IsChecked="{Binding PlaybackLoop}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MARKERS" Classes="h3" />
                  <ComboBox ItemsSource="{Binding TimelineAttributes}" SelectedItem="{Binding MarkerAttribute}" HorizontalAlignment="Stretch" ToolTip.Tip="A marker wherever this attribute changes" />
                  <TextBlock Text="{Binding MarkerNote}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" />
                  <CheckBox Classes="toggle" Content="Show on the timeline" IsChecked="{Binding ShowMarkers}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="DATA SOURCE" Classes="h3" />
                  <TextBlock Text="{Binding PipeSourceTitle}" FontSize="12.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PipeSourceDetail}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="18"
                             Text="Steps never change the file. They run on every frame you show, bottom to top; each reads what the steps below it made. Pick a step to edit it, or add one with +." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Render (design/boards/RenderOverlays) -->
        <DockPanel IsVisible="{Binding IsRender}" Background="{DynamicResource Bg1B}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="small" Content="Back" Click="OnRenderBack" VerticalAlignment="Center" />
              <TextBlock Text="Render" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding RenderProgress}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource AccB}" IsVisible="{Binding Rendering}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Click="OnRenderImage" IsEnabled="{Binding RenderIdle}">
                  <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="eye" Size="14" VerticalAlignment="Center" /><TextBlock Text="Render image" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Content="Movie…" Click="OnRenderMovie" IsEnabled="{Binding RenderIdle}" ToolTip.Tip="Every chosen frame as a numbered PNG in a folder" />
                <Button Content="Stop" Click="OnRenderStop" IsVisible="{Binding Rendering}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="OUTPUT" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Width (px)" Classes="label" /><NumericUpDown Value="{Binding RenderW}" Minimum="64" Maximum="8192" Increment="16" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Height (px)" Classes="label" /><NumericUpDown Value="{Binding RenderH}" Minimum="64" Maximum="8192" Increment="16" FormatString="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Renderer" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="CAPS · CPU ray cast" Classes="mono" FontSize="12" /></Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Background" Classes="label" />
                    <Border Classes="seg">
                      <UniformGrid Columns="3">
                        <RadioButton Classes="seg" GroupName="rbg" Content="Dark" IsChecked="{Binding RenderBgDark}" />
                        <RadioButton Classes="seg" GroupName="rbg" Content="White" IsChecked="{Binding RenderBgWhite}" />
                        <RadioButton Classes="seg" GroupName="rbg" Content="Transparent" IsChecked="{Binding RenderBgTransparent}" />
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="QUALITY" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Ambient occlusion" IsChecked="{Binding RenderAo}" />
                  <CheckBox Classes="toggle" Content="Depth cue (fog)" IsChecked="{Binding RenderDepth}" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Antialias" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.RenderAntialias}" SelectedIndex="{Binding RenderAa}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Frames" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.RenderFrameChoices}" SelectedIndex="{Binding RenderFrames}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="4">
                  <TextBlock Text="OVERLAYS" Classes="h3" Margin="0,0,0,6" />
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvLabel}" />
                        <StackPanel><TextBlock Text="Text label" FontSize="12" /><TextBlock Text="{Binding OvLabelNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" /></StackPanel>
                      </DockPanel>
                      <TextBox Text="{Binding OvText}" Classes="mono" FontSize="11.5" IsVisible="{Binding OvLabel}" />
                      <TextBox Text="{Binding OvSub}" Classes="mono" FontSize="11.5" IsVisible="{Binding OvLabel}" />
                      <TextBlock Text="{x:Static vm:MainViewModel.RenderTokens}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" IsVisible="{Binding OvLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvLegend}" />
                      <StackPanel><TextBlock Text="Colour legend" FontSize="12" /><TextBlock Text="{Binding OvLegendNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvBar}" />
                      <StackPanel><TextBlock Text="Scale bar" FontSize="12" /><TextBlock Text="{Binding OvBarNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvTripod}" />
                      <StackPanel><TextBlock Text="Axis tripod" FontSize="12" /><TextBlock Text="bottom right · follows the camera" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Opening a large trajectory (design/boards/VisLoading): the stages, then the inspector again -->
        <DockPanel Background="{DynamicResource Bg1B}" IsVisible="{Binding ShowLoadPanel}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding LoadStep}" Foreground="{DynamicResource AccB}" /></Border>
              <TextBlock Text="{Binding LoadTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,16" Spacing="8">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="File size" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="{Binding LoadSize}" Classes="mono" FontSize="12.5" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Time left" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="{Binding LoadTimeLeft}" Classes="mono" FontSize="12.5" /></Grid>
            <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                       Text="Frame 0 is already usable: orbit, pick and measure work while the other frames are read. Cancel keeps the frames read so far." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" Click="OnLoadCancel" />
              <Button Click="OnLoadBackground">
                <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="jobs" Size="14" VerticalAlignment="Center" /><TextBlock Text="Open in background" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LoadStages}" Margin="18,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LoadStage">
                  <Border Padding="0,10" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <local:Icon Kind="{Binding Icon}" Size="15" Foreground="{Binding Colour}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding State}" Classes="mono" FontSize="11" Foreground="{Binding Colour}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" Margin="25,0,0,0" TextWrapping="Wrap" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Margin="25,0,0,0" Height="6" MinHeight="6" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- Field: typing report (design/boards/ForceField). Covers the viewport and the inspector; its own view shows the types. -->
      <!-- React (design/boards/React.dc.html) -->
      <!-- Polymer builder (design/boards/PolymerBuilder) -->
      <pages:PolymerPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsPolymer}" />
      <!-- Surface & interface builder (design/boards/SurfaceBuilder) -->
      <pages:SurfacePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSurface}" />
      <!-- Crystal builder (design/boards/CrystalBuilder) -->
      <pages:CrystalPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCrystal}" />
      <!-- Nanostructure builder (design/boards/NanoBuilder, Nanoparticle) -->
      <pages:NanoPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsNano}" />
      <!-- Blend builder (design/boards/BlendBuilder) -->
      <pages:BlendPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBlend}" />
      <!-- Add pipeline step (design/boards/PipelineSteps) -->
      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding StepLibraryOpen}" ZIndex="2">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="22,10" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Width="320" Watermark="Search steps" Text="{Binding StepSearch}" />
                <Button Content="Close" Click="OnCloseStepLibrary" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="Add pipeline step" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Each step is also a command: the same JSON runs with caps pipeline FILE --steps" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer Padding="22,14">
            <ItemsControl ItemsSource="{Binding StepLibraryRows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepKind">
                  <Button Classes="tile" Margin="6" Padding="14,10" Click="OnPickStep" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <local:Icon Kind="{Binding Icon}" Size="18" Foreground="{DynamicResource AccB}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="{Binding About}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Group}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Nothing open (design/boards/VisEmpty): Analyze before a trajectory is open -->
      <pages:EmptyPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding ShowEmpty}" ZIndex="1" />
      <!-- Studio › Viewports (design/boards/FourViewports) -->
      <pages:ViewportsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsViewports}" />
      <!-- Analyze › Visualize › Colour by (design/boards/ColourBy) -->
      <pages:ColourByPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsColourBy}" />
      <!-- Analyze › Compare (design/boards/CompareCells) -->
      <pages:ComparePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCompare}" />
      <!-- Analyze › Batch (design/boards/BatchRun) -->
      <pages:BatchPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBatch}" />
      <!-- Save pipeline (design/boards/SavePipeline) -->
      <pages:SavePipelinePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSavePipeline}" />
      <!-- Open file (design/boards/OpenLammps, OpenGromacs) -->
      <pages:OpenPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsOpenPreview}" ZIndex="3" />
      <!-- Export › Figure bundle (design/boards/FigureBundle) -->
      <pages:BundlePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBundle}" />
      <!-- Export › Data (design/boards/ExportData) -->
      <pages:ExportPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsExport}" />
      <!-- Export › Figure (design/boards/FigureBackground) -->
      <pages:FigurePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsFigure}" />
      <!-- File checks (design/boards/VisProblems) -->
      <pages:ChecksPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsChecks}" />
      <!-- Bench (design/boards/Bench) -->
      <pages:BenchPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBench}" />
      <!-- Jobs (design/boards/Jobs, FailedJob) -->
      <pages:JobsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsJobs}" />
      <!-- Settings (design/boards/Settings) -->
      <pages:SettingsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSettings}" />
      <!-- Molecule (design/boards/Sketch): sketch or SMILES to 3D -->
      <pages:MoleculePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsMolecule}" />
      <!-- Start (design/boards/Start): the Studio with nothing open -->
      <pages:StartPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
        <pages:StartPage.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="NoDocument" />
            <Binding Path="IsStudio" />
          </MultiBinding>
        </pages:StartPage.IsVisible>
      </pages:StartPage>
      <pages:ReactPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsReact}" />

      <!-- Equilibrate (design/boards/Convergence.dc.html) -->
      <pages:EquilibratePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsEquilibrate}" />

      <!-- Dynamics (design/boards/Dynamics.dc.html) -->
      <pages:DynamicsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsDynamics}" />

      <!-- Relax (design/boards/Relax.dc.html) -->
      <pages:RelaxPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsRelax}" />

      <!-- Pack (design/boards/Pack.dc.html) -->
      <pages:PackPage x:Name="PackPageView" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsPack}" />

      <!-- Grow (design/boards/Grow.dc.html) -->
      <pages:GrowPage x:Name="GrowPageView" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsGrow}" />

      <!-- Analyze › Properties: calculations over the frames, results compared with experiment -->
      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsAnalyze}">
        <Border.Styles>
          <Style Selector="ToggleButton.chip">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
          </Style>
          <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccB}" />
            <Setter Property="Foreground" Value="#16191C" />
          </Style>
          <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
          </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,*,Auto" Margin="22,16,22,0">
          <!-- header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock FontSize="20" FontWeight="SemiBold">
                <Run Text="Analyze · " /><Run Text="{Binding Analyze.SourceText}" />
              </TextBlock>
              <TextBlock Classes="muted" Text="Properties with their uncertainty and method, compared against experiment, ready for the paper tables" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <StackPanel Spacing="3">
                <TextBlock Text="Compare with" Classes="dim" />
                <ComboBox Width="220" ItemsSource="{Binding Analyze.References}" SelectedIndex="{Binding Analyze.RefIndex}" />
              </StackPanel>
              <Button Click="OnOpenVisualize" VerticalAlignment="Bottom" ToolTip.Tip="Pipeline of selection, colouring and measuring steps, with the data inspector">
                <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="eye" Size="14" VerticalAlignment="Center" /><TextBlock Text="Visualize" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Content="Export CSV / LaTeX…" Click="OnAnalyzeExport" IsEnabled="{Binding Analyze.HasResults}" VerticalAlignment="Bottom" />
              <Button Classes="primary" Content="Run selected" Click="OnAnalyzeRun" IsVisible="{Binding Analyze.NotWorking}" VerticalAlignment="Bottom">
                <Button.IsEnabled>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasDocument" />
                    <Binding Path="Idle" />
                  </MultiBinding>
                </Button.IsEnabled>
              </Button>
              <Button Content="Cancel" Click="OnAnalyzeCancel" IsVisible="{Binding Analyze.Working}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,14,0,12">
            <!-- calculations and source -->
            <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
              <ScrollViewer>
                <StackPanel Margin="16,12" Spacing="10" IsEnabled="{Binding Analyze.NotWorking}">
                  <TextBlock Text="CALCULATIONS" Classes="h3" />
                  <ItemsControl ItemsSource="{Binding Analyze.Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalcGroup">
                        <StackPanel Spacing="5" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Name}" Classes="dim" />
                          <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CalcChip">
                                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}" IsEnabled="{Binding Available}" ToolTip.Tip="{Binding Tip}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="SOURCE" Classes="h3" Margin="0,6,0,0" />
                  <TextBlock Text="Trajectory" Classes="dim" />
                  <TextBlock Text="{Binding Analyze.SourceText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Analyze.FramesText}" Classes="mono" FontSize="11" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                    <Grid.Styles><Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style></Grid.Styles>
                    <TextBlock Text="First frame" Classes="dim" /><TextBlock Grid.Column="1" Text="Last (−1: end)" Classes="dim" /><TextBlock Grid.Column="2" Text="Every" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FirstD}" Minimum="0" Increment="1" FormatString="0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.LastD}" Minimum="-1" Increment="1" FormatString="0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Analyze.StrideD}" Minimum="1" Increment="1" FormatString="0" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                    <TextBlock Text="ps per frame (0: file)" Classes="dim" /><TextBlock Grid.Column="1" Text="MD step (fs)" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FramePsD}" Minimum="0" Increment="0.5" FormatString="0.###" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TimestepFsD}" Minimum="0.01" Increment="0.5" FormatString="0.##" />
                  </Grid>

                  <TextBlock Text="GROUPS" Classes="h3" Margin="0,6,0,0" />
                  <TextBlock Text="g(r) pair" Classes="dim" />
                  <ComboBox ItemsSource="{x:Static vm:AnalyzeViewModel.Pairs}" SelectedIndex="{Binding Analyze.PairIndex}" HorizontalAlignment="Stretch" />
                  <CheckBox Content="Only between molecules" IsChecked="{Binding Analyze.InterOnly}" />

                  <TextBlock Text="SETTINGS" Classes="h3" Margin="0,6,0,0" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Probe radius (Å)" Classes="dim" /><TextBlock Grid.Column="1" Text="Grid (Å)" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.ProbeD}" Minimum="0" Increment="0.1" FormatString="0.00" ToolTip.Tip="0: points outside every van der Waals sphere; He 1.28 Å, N₂ 1.82 Å" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.GridD}" Minimum="0.1" Maximum="2" Increment="0.1" FormatString="0.00" />
                    <TextBlock Grid.Row="2" Text="Fit MSD from" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="to (fraction of run)" Classes="dim" Margin="0,4,0,0" />
                    <NumericUpDown Grid.Row="3" Value="{Binding Analyze.FitFromD}" Minimum="0" Maximum="0.95" Increment="0.05" FormatString="0.00" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.FitToD}" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" />
                  </Grid>
                  <!-- protocols: shown when switched on -->
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.TgChip.IsOn}">
                    <TextBlock Text="COOLING PROTOCOL (Tg)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="From (K)" Classes="dim" /><TextBlock Grid.Column="1" Text="To (K)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.TgFromD}" Minimum="10" Maximum="2000" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TgToD}" Minimum="10" Maximum="2000" Increment="10" FormatString="0" />
                      <TextBlock Grid.Row="2" Text="Step (K)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="NPT per step (ps)" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.TgStepD}" Minimum="1" Increment="5" FormatString="0" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.TgPsD}" Minimum="1" Increment="50" FormatString="0" />
                    </Grid>
                    <TextBlock Text="Equilibrate at the start temperature first (ps)" Classes="dim" />
                    <NumericUpDown Value="{Binding Analyze.EqPsD}" Minimum="0" Increment="10" FormatString="0" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Fit: two lines, free hinge, bootstrap error. Runs on a copy of the current frame; simulated cooling rates are 10⁹–10¹¹ K/s, so Tg comes out above experiment." />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.TensileChip.IsOn}">
                    <TextBlock Text="DEFORMATION (stress–strain)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="Axis" Classes="dim" /><TextBlock Grid.Column="1" Text="Temperature (K)" Classes="dim" />
                      <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:AnalyzeViewModel.Axes}" SelectedIndex="{Binding Analyze.TensAxis}" HorizontalAlignment="Stretch" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TensTD}" Minimum="1" Increment="10" FormatString="0" />
                      <TextBlock Grid.Row="2" Text="Rate (1/ps)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Final strain" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.TensRateD}" Minimum="0.000001" Increment="0.0005" FormatString="0.######" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.TensMaxD}" Minimum="0.005" Maximum="2" Increment="0.05" FormatString="0.###" />
                    </Grid>
                    <TextBlock Text="{Binding Analyze.TensRateText}" Classes="mono" FontSize="11" />
                    <TextBlock Text="NPT first (ps)" Classes="dim" />
                    <NumericUpDown Value="{Binding Analyze.EqPsD}" Minimum="0" Increment="10" FormatString="0" />
                    <CheckBox Content="Lateral faces fixed (uniaxial strain)" IsChecked="{Binding Analyze.TensFixed}" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.PullOn}">
                    <TextBlock Text="PULL TEST (interface)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="Distance (Å)" Classes="dim" /><TextBlock Grid.Column="1" Text="Rate (Å/ps)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.PullDistD}" Minimum="0.5" Maximum="200" Increment="1" FormatString="0.0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.PullRateD}" Minimum="0.01" Maximum="100" Increment="0.5" FormatString="0.##" />
                      <TextBlock Grid.Row="2" Text="Temperature (K)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="NVT first (ps)" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.PullTD}" Minimum="1" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.PullEqD}" Minimum="0" Increment="1" FormatString="0.#" />
                    </Grid>
                    <TextBlock Text="Shear axis" Classes="dim" />
                    <ComboBox ItemsSource="{x:Static vm:AnalyzeViewModel.PullAxes}" SelectedIndex="{Binding Analyze.PullAxis}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="The surface (molecule 1) is held; a spring (10 kcal/mol/Å²) drags the film's centre. Steered-MD forces grow with the rate: compare systems at one rate." />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.StrainChip.IsOn}">
                    <TextBlock Text="STATIC ELASTIC CONSTANTS" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="Strain ±" Classes="dim" /><TextBlock Grid.Column="1" Text="Configurations" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.CijStrainD}" Minimum="0.000001" Maximum="0.01" Increment="0.0001" FormatString="0.######" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.CijConfigsD}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.FluctChip.IsOn}">
                    <TextBlock Text="STRESS FLUCTUATIONS" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="NVT temperature (K)" Classes="dim" /><TextBlock Grid.Column="1" Text="Sampled (ps)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FluctTD}" Minimum="1" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.FluctPsD}" Minimum="1" Increment="50" FormatString="0" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Bonded systems converge slowly: the fluctuation term cancels most of the Born term. Check the block errors; the static method is cheaper." />
                  </StackPanel>
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             Text="Energies use the force field assigned in Field; without one, the built-in GAFF typing of C and H. Protocols (Tg, stress–strain, static Cij) run on a copy of the current frame. Grey calculations are not built yet." />
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- results -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,280" RowSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Analyze.Log}" Classes="muted" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding Analyze.Progress}" Minimum="0" Maximum="1" Height="4" IsVisible="{Binding Analyze.Working}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Analyze.Results}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultCard">
                      <Border Width="272" Margin="0,0,12,12" Padding="14,12" CornerRadius="10" BorderBrush="{DynamicResource LineB}" BorderThickness="1"
                              Background="{DynamicResource Bg1B}" ToolTip.Tip="{Binding Method}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Name}" Classes="dim" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="SemiBold" Classes="mono" />
                            <TextBlock Text="{Binding ErrorText}" Classes="mono" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding UnitText}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasRef}" Spacing="1">
                            <TextBlock Text="{Binding RefText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RefSource}" Classes="dim" FontSize="11" TextWrapping="Wrap" FontStyle="Italic" />
                            <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Text="{Binding ExtraText}" IsVisible="{Binding HasExtra}" Classes="mono" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
                          <TextBlock Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarnB}" />
                          <TextBlock Text="{Binding Method}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Grid.Row="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}" Padding="14,10"
                      IsVisible="{Binding Analyze.HasResults}">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="CURVE" Classes="h3" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Analyze.Curves}" SelectedIndex="{Binding Analyze.CurveIndex}" MinWidth="320" HorizontalAlignment="Left" />
                  </Grid>
                  <local:LinePlot Grid.Row="1" x:Name="PropPlot" AutoRange="True" />
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <TextBlock Grid.Row="2" Classes="dim" Margin="0,0,0,10">
            <Run Text="{Binding Analyze.RunInfo}" /><Run Text=" · hover a card for its method · experiment ranges from data/reference/polymers.json" />
          </TextBlock>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsField}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,16,22,0">
          <!-- header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Force field · typing report" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="Explain every type, override with provenance, and block runs with missing parameters" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" IsEnabled="{Binding Field.NotWorking}">
              <StackPanel Spacing="3">
                <TextBlock Text="Force field" Classes="dim" />
                <ComboBox Width="300" ItemsSource="{Binding Field.Library}" SelectedIndex="{Binding Field.FfIndex}" ToolTip.Tip="{Binding Field.FfNote}" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="Charges" Classes="dim" />
                <ComboBox Width="170" ItemsSource="{x:Static vm:FieldViewModel.ChargeModes}" SelectedIndex="{Binding Field.ChargeMode}" />
              </StackPanel>
              <Button Classes="primary" Content="Assign · retype all" Click="OnFieldAssign" IsEnabled="{Binding HasDocument}" VerticalAlignment="Bottom" />
              <Button Content="Export ▾" VerticalAlignment="Bottom" IsEnabled="{Binding Field.Assigned}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="LAMMPS data with this force field…" Click="OnSaveData" />
                    <MenuItem Header="Types file (caps ff apply --types)…" Click="OnFieldSaveTypes" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Content="Clear" Click="OnFieldClear" IsEnabled="{Binding Field.Assigned}" VerticalAlignment="Bottom"
                      ToolTip.Tip="End the assignment and restore the file's own types and charges" />
            </StackPanel>
          </Grid>

          <!-- chips -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,12" IsVisible="{Binding Field.Assigned}">
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" /><TextBlock Text="{Binding Field.TypedText}" FontSize="11.5" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrB}" IsVisible="{Binding Field.HasUntyped}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" IsVisible="{Binding !Field.HasUntyped}" />
                <TextBlock Text="{Binding Field.UntypedText}" FontSize="11.5" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrB}" IsVisible="{Binding Field.HasMissing}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" IsVisible="{Binding !Field.HasMissing}" />
                <TextBlock Text="{Binding Field.MissingText}" FontSize="11.5" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" /><TextBlock Text="{Binding Field.EstimatedText}" FontSize="11.5" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" IsVisible="{Binding Field.ChargeOdd}" />
                <TextBlock Text="{Binding Field.ChargeText}" Classes="mono" FontSize="11" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- body -->
          <Grid Grid.Row="2" ColumnDefinitions="*,440" ColumnSpacing="16" Margin="0,0,0,12">
            <!-- no structure / not assigned -->
            <Border Grid.ColumnSpan="2" IsVisible="{Binding !Field.Assigned}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10"
                    Background="{DynamicResource Bg1B}" Margin="0,14,0,0" VerticalAlignment="Top">
              <StackPanel Spacing="10" Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Field.LibraryNote}" Classes="muted" />
                <TextBlock Text="Open or build a structure, choose a force field and assign it." FontSize="15" FontWeight="SemiBold" IsVisible="{Binding NoDocument}" />
                <TextBlock Text="{Binding Field.Log}" TextWrapping="Wrap" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Typing works from the bonds alone (mol2, PDB with CONECT, xyz, LAMMPS data): CAPS perceives bond orders, charges, rings and aromaticity, then applies the force field's SMARTS rules. PCFF, CVFF, GAFF, GAFF2, OPLS-AA and CGenFF have rules; other force fields take the atom names in the file as types." />
              </StackPanel>
            </Border>

            <!-- atoms + why -->
            <Grid RowDefinitions="*,Auto" RowSpacing="12" IsVisible="{Binding Field.Assigned}">
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,11">
                    <TextBlock Text="Atoms" FontWeight="SemiBold" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,12,16,6">
                    <TextBox Text="{Binding Field.FilterText}" Watermark="Filter: type, element, atom (C12), rule text, charge" />
                    <Border Grid.Column="1" Classes="seg">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="ffilter" Content="All" IsChecked="{Binding Field.FilterAll}" />
                        <RadioButton Classes="seg" GroupName="ffilter" Content="Untyped" IsChecked="{Binding Field.FilterUntyped}" />
                        <RadioButton Classes="seg" GroupName="ffilter" Content="Overridden" IsChecked="{Binding Field.FilterOverridden}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="70,44,74,90,*,190" Margin="28,6,16,4">
                    <TextBlock Text="ATOM" Classes="h3" /><TextBlock Grid.Column="1" Text="EL." Classes="h3" /><TextBlock Grid.Column="2" Text="TYPE" Classes="h3" />
                    <TextBlock Grid.Column="3" Text="Q (E)" Classes="h3" HorizontalAlignment="Right" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" Text="RULE (SMARTS)" Classes="h3" /><TextBlock Grid.Column="5" Text="SOURCE" Classes="h3" />
                  </Grid>
                  <ListBox Grid.Row="3" ItemsSource="{Binding Field.Rows}" SelectedItem="{Binding Field.SelectedRow}" Background="Transparent" Margin="12,0,12,4">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="16,2" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="CornerRadius" Value="5" />
                      </Style>
                      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2E343A" />
                      </Style>
                      <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#353C43" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldAtomRow">
                        <Grid ColumnDefinitions="70,44,74,90,*,190" Height="18">
                          <TextBlock Text="{Binding Atom}" Classes="mono" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Element}" Classes="mono" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding TypeShown}" Classes="mono" Foreground="{Binding TypeBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Charge}" Classes="mono" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding Rule}" Classes="mono" Foreground="{Binding RuleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Rule}" />
                          <TextBlock Grid.Column="5" Text="{Binding Source}" Classes="mono" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="4" Text="{Binding Field.RowsNote}" Classes="dim" Margin="16,2,16,10" />
                </Grid>
              </Border>
              <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
                <StackPanel>
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,11">
                    <TextBlock Text="{Binding Field.WhyTitle}" FontWeight="SemiBold" />
                  </Border>
                  <StackPanel Margin="16,12" Spacing="10">
                    <TextBlock Text="{Binding Field.WhyText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Field.HasSelection}" IsEnabled="{Binding Field.NotWorking}">
                      <TextBlock Text="Set type by hand" Classes="dim" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding Field.OverrideTypes}" SelectedItem="{Binding Field.OverrideType}" MinWidth="120" />
                      <Button Content="Set" Click="OnFieldOverride" ToolTip.Tip="The atom keeps this type through retyping; it is listed as overridden" />
                      <Button Content="Back to the rule" Click="OnFieldResetOverride" IsVisible="{Binding Field.SelectedOverridden}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- types in 3D + missing -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12" IsVisible="{Binding Field.Assigned}">
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Types in 3D" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Field.Swatches}" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FieldTypeSwatch">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,2,0,2" ToolTip.Tip="{Binding Description}">
                              <Ellipse Width="8" Height="8" Fill="{Binding Colour}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" Classes="mono" FontSize="11" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                  <Border Grid.Row="1" x:Name="FieldViewHost" Background="{DynamicResource Bg0B}" ClipToBounds="True" Focusable="True" MinHeight="240">
                    <Panel>
                      <Image x:Name="FieldImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <TextBlock Classes="dim" Margin="10" VerticalAlignment="Bottom" Text="Coloured by force-field type · click an atom to explain it · drag to rotate" />
                    </Panel>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
                <StackPanel>
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Missing before run" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#3A2323" IsVisible="{Binding Field.Incomplete}">
                        <TextBlock Text="Blocks Relax and Dynamics" Foreground="{DynamicResource ErrB}" FontSize="11" />
                      </Border>
                      <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#1F3324" IsVisible="{Binding Field.Complete}">
                        <TextBlock Text="Ready to run" Foreground="{DynamicResource OkB}" FontSize="11" />
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Margin="16,10" Spacing="8" IsEnabled="{Binding Field.NotWorking}">
                    <ListBox ItemsSource="{Binding Field.Missing}" SelectedItem="{Binding Field.SelectedMissing}" MaxHeight="170" Background="Transparent"
                             IsVisible="{Binding Field.Incomplete}">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0,2" /></Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        <Style Selector="ListBoxItem:selected Border.miss"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldMissingRow">
                          <Border Classes="miss" BorderBrush="#5A2E2B" BorderThickness="1" CornerRadius="6" Background="#2A1B1B" Padding="10,6">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Title}" Classes="mono" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Detail}" Classes="dim" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="CAPS never guesses parameters. Choose a source: import them from a published file, or enter them by hand; anything entered by hand is flagged estimated in the report and the output." />
                    <StackPanel Spacing="6" IsVisible="{Binding Field.CanEnterRule}">
                      <Grid ColumnDefinitions="Auto,*,Auto,110" ColumnSpacing="6">
                        <TextBlock Text="{Binding Field.EntryKind}" Classes="mono" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Field.EntryTypes}" ToolTip.Tip="Atom types (as the force field looks them up); * matches any" />
                        <TextBlock Grid.Column="2" Text="style" Classes="dim" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding Field.EntryStyle}" />
                      </Grid>
                      <TextBox Text="{Binding Field.EntryParams}" Watermark="{Binding Field.EntryHint}" />
                      <TextBlock Text="{Binding Field.EntryHint}" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Import parameters…" Click="OnFieldImport" ToolTip.Tip="caps-forcefield JSON or moltemplate .lt; its rules are added over the force field" />
                      <Button Content="Enter manually (estimated)" Click="OnFieldAddRule" IsEnabled="{Binding Field.CanEnterRule}" />
                      <Button Content="Remove added" Click="OnFieldRemoveRules" IsVisible="{Binding Field.HasEntered}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Field.Entered}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="mono" FontSize="11" Foreground="{DynamicResource AccB}" TextWrapping="Wrap" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Field.EnergyText}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding Field.Complete}" />
                    <ItemsControl ItemsSource="{Binding Field.Notes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="dim" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- footer -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6" Margin="-22,0" >
            <Grid ColumnDefinitions="*,Auto" Margin="22,0">
              <TextBlock Text="{Binding Field.FooterTyper}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Field.FooterDb}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar (lib.py statusbar): counts on the left, what the mouse does and the renderer on the right -->
    <Border Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusCounts}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
          <TextBlock Text="{Binding StatusSelection}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
          <TextBlock Text="{Binding StatusCell}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center"
                   Margin="18,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <TextBlock Text="Mouse: pick · drag rotates · ⇧ drag pans" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
          <TextBlock Text="Double precision" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
          <TextBlock x:Name="RenderStat" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Command palette (design/boards/CommandPalette): ⌘K -->
    <Panel Grid.RowSpan="3" IsVisible="{Binding PaletteOpen}">
      <Border Background="#8C000000" PointerPressed="OnPaletteBackdrop" />
      <Border Width="680" Margin="0,64,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Bg1B}"
              BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="12" BoxShadow="0 18 48 0 #66000000" ClipToBounds="True">
        <DockPanel MaxHeight="560">
          <Border DockPanel.Dock="Top" Height="56" Padding="18,0,14,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <local:Icon Kind="search" Size="18" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
              <TextBox x:Name="PaletteBox" Grid.Column="1" Text="{Binding PaletteQuery}" Classes="bare" FontSize="15" VerticalAlignment="Center"
                       Watermark="Run a command, open a document, or type a SMILES" KeyDown="OnPaletteKey" />
              <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="esc" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" />
              </Border>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Height="38" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="↑ ↓ move" Classes="dim" />
                <TextBlock Text="↵ run" Classes="dim" />
                <TextBlock Text="esc close" Classes="dim" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PaletteHint}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteRows}" SelectedIndex="{Binding PaletteIndex}" Background="Transparent" Padding="8,6"
                   Tapped="OnPaletteTapped">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="CornerRadius" Value="6" /></Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg2B}" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteRow">
                <Panel>
                  <TextBlock Text="{Binding Title}" Classes="h3" FontSize="10.5" Margin="10,12,0,6" IsVisible="{Binding IsHeader}" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Height="44" Margin="10,0" IsVisible="{Binding IsCommand}">
                    <local:Icon Kind="{Binding Icon}" Size="16" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Id}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            IsVisible="{Binding HasShortcut}">
                      <TextBlock Text="{Binding Shortcut}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
                    </Border>
                  </Grid>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
  </LayoutTransformControl>
</Window>
