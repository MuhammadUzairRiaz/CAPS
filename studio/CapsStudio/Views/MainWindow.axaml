<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CapsStudio.ViewModels"
        xmlns:local="using:CapsStudio.Views"
        xmlns:pages="using:CapsStudio.Views.Pages"
        x:Class="CapsStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CAPS Studio"
        Icon="/Assets/caps_256.png"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640">
  <Window.Styles>
    <!-- Compact layout (design/boards/CompactLayout): below 1440 px the rail and the toolbar's view options show icons
         only, the inspector and the project become drawers over the view, and the curves dock folds to its tabs. -->
    <Style Selector="Border#Rail.compact Button.rail TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border#Rail.compact Button.rail Panel"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /></Style>
    <Style Selector="StackPanel#ToolbarRight.compact Button TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="StackPanel#ToolbarRight.compact ToggleButton TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.histrow"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Margin" Value="0,0,0,2" /></Style>
    <Style Selector="Button.histrow.current /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
    <Style Selector="Button.histrow.undone"><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="Button.histrow TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource DimB}" /></Style>
    <Style Selector="Button.histrow.current TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource AccB}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.chip.sev TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
    <Style Selector="Border.chip.sev.check"><Setter Property="Background" Value="{DynamicResource SelBgB}" /></Style>
    <Style Selector="Border.chip.sev.check TextBlock"><Setter Property="Foreground" Value="{DynamicResource SelB}" /></Style>
    <Style Selector="Border.chip.sev.warning"><Setter Property="Background" Value="{DynamicResource WarnBgB}" /></Style>
    <Style Selector="Border.chip.sev.warning TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnB}" /></Style>
    <Style Selector="Border.chip.sev.blocks"><Setter Property="Background" Value="{DynamicResource ErrBgB}" /></Style>
    <Style Selector="Border.chip.sev.blocks TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrB}" /></Style>
    <Style Selector="Border.notice"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions></Setter></Style>
    <!-- below ~1700 px the labels of the panel toggles and the style menu give way to their icons (tooltips stay) -->
    <Style Selector="StackPanel#ToolbarRight.narrow ToggleButton TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="StackPanel#ToolbarRight.narrow Button.short TextBlock"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.sidetab"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="96" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="2,0,0,0" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="Button.sidetab.on"><Setter Property="Background" Value="{DynamicResource Bg3B}" /><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
    <Style Selector="Button.sidetab TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
    <Style Selector="Button.sidetab.on TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextB}" /></Style>
    <!-- pipeline strip -->
    <Style Selector="Button.pipestep"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,6" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.pipestep.current /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
    <Style Selector="Border.mark"><Setter Property="BorderBrush" Value="{DynamicResource DimB}" /><Setter Property="BorderThickness" Value="1.5" /></Style>
    <Style Selector="Border.mark.next"><Setter Property="BorderBrush" Value="{DynamicResource TextB}" /></Style>
    <Style Selector="Border.mark.optional"><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="Border.mark.done"><Setter Property="Background" Value="{DynamicResource OkB}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.mark.warn"><Setter Property="Background" Value="{DynamicResource WarnB}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.mark.cur"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="local|Icon.onmark"><Setter Property="Foreground" Value="{DynamicResource Bg0B}" /></Style>
    <Style Selector="TextBlock.marknum"><Setter Property="FontSize" Value="11" /><Setter Property="FontFamily" Value="{DynamicResource Mono}" /><Setter Property="Foreground" Value="{DynamicResource MutedB}" /></Style>
    <Style Selector="TextBlock.marknum.cur"><Setter Property="Foreground" Value="{DynamicResource AccB}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.stepname"><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.stepdetail"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource DimB}" /><Setter Property="MaxWidth" Value="150" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="TextBlock.stepdetail.ok"><Setter Property="Foreground" Value="{DynamicResource OkB}" /></Style>
  </Window.Styles>

  <DockPanel>
  <!-- the menu bar in the window on Windows and Linux (macOS shows it in the system menu bar) -->
  <NativeMenuBar DockPanel.Dock="Top" x:Name="MenuBarHost" />
  <LayoutTransformControl x:Name="ScaleRoot">
  <Grid RowDefinitions="44,Auto,*,26">

    <!-- Top bar (design/generator/lib.py topbar): logo, document tabs, command palette, compute -->
    <Border Grid.Row="0" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="72,Auto,Auto,*,Auto">
        <Viewbox Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="CAPS · Chain Assembly and Packing Suite">
          <Canvas Width="30" Height="30">
            <Path Data="M15 2 L26.3 8.5 L26.3 21.5 L15 28 L3.7 21.5 L3.7 8.5 Z" Stroke="{DynamicResource AccB}" StrokeThickness="2" />
            <Path Data="M15 9.5 V11.7 M19.8 17.8 L17.9 16.7 M10.2 17.8 L12.1 16.7" Stroke="{DynamicResource TextB}" StrokeThickness="1.4" />
            <Ellipse Canvas.Left="11.6" Canvas.Top="11.6" Width="6.8" Height="6.8" Fill="{DynamicResource AccB}" />
            <Ellipse Canvas.Left="13" Canvas.Top="5.5" Width="4" Height="4" Fill="{DynamicResource TextB}" />
            <Ellipse Canvas.Left="19.5" Canvas.Top="16.8" Width="4" Height="4" Fill="{DynamicResource TextB}" />
            <Ellipse Canvas.Left="6.5" Canvas.Top="16.8" Width="4" Height="4" Fill="{DynamicResource TextB}" />
          </Canvas>
        </Viewbox>
        <TextBlock Grid.Column="1" Text="{Binding Crumb}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,18,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
          <Button Classes="doctab on" IsVisible="{Binding NoDocument}" Click="OnModuleStudio" ToolTip.Tip="Start">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:Icon Kind="cube" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
              <TextBlock Text="Start" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- one tab per structure of the project; the active one is what every module works on -->
          <ItemsControl ItemsSource="{Binding ProjectItems}" IsVisible="{Binding HasDocument}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectItem">
                <Button Classes="doctab" Classes.on="{Binding Active}" ToolTip.Tip="{Binding Name}" Click="OnProjectTab" Tag="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:Icon Kind="{Binding IconKind}" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Classes="tool" Width="18" MinWidth="18" Height="18" MinHeight="18" Padding="0" Click="OnCloseProjectTab" Tag="{Binding}"
                            IsEnabled="{Binding $parent[local:MainWindow].((vm:MainViewModel)DataContext).Idle}" ToolTip.Tip="Close this structure (⌘W closes the active one)" VerticalAlignment="Center">
                      <local:Icon Kind="close" Size="12" />
                    </Button>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="tool" Width="30" MinWidth="30" Height="30" MinHeight="30" Margin="4,0,0,3" Command="{Binding $parent[local:MainWindow].OpenCommand}"
                  ToolTip.Tip="Open a structure or trajectory (⌘O)" IsEnabled="{Binding Idle}">
            <local:Icon Kind="plus" Size="15" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
          <Button Width="300" Height="30" MinHeight="30" Padding="10,0" HorizontalContentAlignment="Stretch" FontWeight="Normal" Click="OnCommandPalette"
                  ToolTip.Tip="Command palette (⌘K)">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <local:Icon Kind="search" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Run a command or find anything" Foreground="{DynamicResource DimB}" FontSize="12.5" VerticalAlignment="Center" />
              <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                <TextBlock Text="⌘K" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" />
              </Border>
            </Grid>
          </Button>
          <Button Classes="ghost" Height="30" MinHeight="30" Padding="10,0" FontWeight="Normal" FontSize="12" ToolTip.Tip="Where calculations run">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource OkB}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ComputeText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pipeline strip (design/boards/PipelineGrow): where the project is, each step one click away; Export at every step -->
    <Border Grid.Row="1" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Height="56" IsVisible="{Binding ShowPipelineStrip}">
      <Grid ColumnDefinitions="72,*,Auto">
        <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" />
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding PipelineSteps}" Margin="8,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="0" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PipelineStep">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <Button Classes="pipestep" Classes.current="{Binding Current}" Click="OnPipelineStep" ToolTip.Tip="{Binding Name}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Panel Width="22" Height="22" VerticalAlignment="Center">
                        <Border Classes="mark" Classes.done="{Binding IsDone}" Classes.warn="{Binding IsWarn}" Classes.optional="{Binding IsOptional}"
                                Classes.next="{Binding IsNext}" Classes.cur="{Binding Current}" CornerRadius="11" />
                        <local:Icon Kind="check" Size="13" Classes="onmark" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <local:Icon Kind="alert" Size="13" Classes="onmark" IsVisible="{Binding IsWarn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Classes="marknum" Classes.cur="{Binding Current}" Text="{Binding Mark}" IsVisible="{Binding ShowNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                      <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Classes="stepname" Text="{Binding Name}" />
                        <TextBlock Classes="stepdetail" Classes.ok="{Binding IsDone}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                  <Border Width="10" Height="1" Background="{DynamicResource LineB}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
          <Button Classes="primary small" Click="OnPipelineNext" IsVisible="{Binding HasPipelineNext}" ToolTip.Tip="The next step of the pipeline">
            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding PipelineNextLabel}" VerticalAlignment="Center" /><local:Icon Kind="chevr" Size="14" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="small" Click="OnExportCenter" ToolTip.Tip="LAMMPS and GROMACS files of the structure as it is now">
            <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="download" Size="14" VerticalAlignment="Center" /><TextBlock Text="Export now" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Body" Grid.Row="2" ColumnDefinitions="72,*,330" RowDefinitions="48,*">

      <!-- Module rail (lib.py rail): the workflow left to right, then the cross-cutting areas; settings at the bottom -->
      <Border x:Name="Rail" Grid.Column="0" Grid.RowSpan="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Classes="rail" Classes.on="{Binding IsSettings}" Height="44" MinHeight="44" Margin="0,0,0,8" HorizontalAlignment="Center"
                  ToolTip.Tip="Settings" Click="OnSettingsRail">
            <local:Icon Kind="gear" Size="19" />
          </Button>
          <StackPanel Spacing="1" Margin="0,6,0,0" HorizontalAlignment="Center">
          <!-- the pipeline in order (design/boards/PipelineGrow), then the cross-cutting areas -->
          <Button Classes="rail" Classes.on="{Binding IsStudioRail}" Click="OnModuleStudio" ToolTip.Tip="Build, view and inspect structures">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="hex" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Studio" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Border Width="36" Height="1" Background="{DynamicResource LineB}" Margin="0,3" HorizontalAlignment="Center" />
          <Button Classes="rail" Classes.on="{Binding IsBuildRail}" Click="OnModuleBuild" ToolTip.Tip="Build molecules, polymers, crystals, surfaces and biomolecules">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="flask" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Build" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsGrow}" Click="OnModuleGrow" ToolTip.Tip="Polymer cell (Grow): builds polymer chains monomer by monomer inside a periodic cell, at the density you set — an amorphous polymer, from repeat units">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="grow" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Polymer cell" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsField}" Click="OnModuleField" ToolTip.Tip="Force fields: which fit this structure, typing, charges and parameters, explained">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="tag" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Force field" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsPack}" Click="OnModulePack" ToolTip.Tip="Packing (Pack): places copies of molecules you already have (solvents, additives, fillers, crosslinkers, pre-built chains) into a box or region without overlaps — packmol input accepted">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="pack" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Packing" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsRelax}" Click="OnModuleRelax" ToolTip.Tip="Minimise: energy minimisation of the active structure (push-off, compression, cell relaxation)">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="relax" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Minimise" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsEquilibrate}" Click="OnModuleEquilibrate" ToolTip.Tip="Published equilibration protocols with convergence checks">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="equil" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Equilibrate" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsDynamics}" Click="OnModuleDynamics" ToolTip.Tip="Dynamics: molecular dynamics (NVE, NVT, NPT) of the active structure">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="dyn" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Dynamics" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsReact}" Click="OnModuleReact" ToolTip.Tip="Crosslinking and reactions from atom-mapped templates">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="react" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="React" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsAnalyzeRail}" Click="OnModuleAnalyze" ToolTip.Tip="Properties with errors, compared with experiment">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="chart" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Analyze" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsExportRail}" Click="OnExportCenter" ToolTip.Tip="Export center: LAMMPS and GROMACS files, structures and figures">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="download" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Export" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Border Width="36" Height="1" Background="{DynamicResource LineB}" Margin="0,3" HorizontalAlignment="Center" />
          <Button Classes="rail" Classes.on="{Binding IsJobs}" Click="OnModuleJobs" ToolTip.Tip="Every run with its progress, curves, log and provenance">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="jobs" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Jobs" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="rail" Classes.on="{Binding IsBench}" Click="OnModuleBench" ToolTip.Tip="The validation suite that regenerates the paper tables">
            <Panel Width="60" Height="48">
              <Border Classes="bar" Width="3" Height="28" CornerRadius="0,2,2,0" Background="{DynamicResource AccB}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:Icon Kind="bench" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="Bench" HorizontalAlignment="Center" FontSize="10" />
              </StackPanel>
            </Panel>
          </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Centre: toolbar, viewport, frame bar -->
      <!-- Toolbar (Main board): tools, builder tools, view options on the right -->
      <Border x:Name="Toolbar" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="10,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel x:Name="ToolbarRight" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" Click="OnExportDialog" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}" ToolTip.Tip="Export image or movie (⌘E)"><local:Icon Kind="download" Size="18" /></Button>
            <Button Classes="tool" Click="OnSplit" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}" ToolTip.Tip="Split view: this document beside another, cameras synced (design/boards/LightSplit)"><local:Icon Kind="layers" Size="18" /></Button>
            <ToggleButton Classes="tool" IsChecked="{Binding InteractionsOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="Interactions &amp; checks (design/boards/Interactions): H-bonds, contacts, clashes and fixes">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="link" Size="18" VerticalAlignment="Center" /><TextBlock Text="Checks" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding SelectionOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="Selection &amp; stereo (design/boards/SelectionStereo): select by SMARTS, element, type, charge, distance; named sets; tacticity">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="search" Size="18" VerticalAlignment="Center" /><TextBlock Text="Select" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding HistoryOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="History &amp; snapshots (design/boards/History): every edit, undone branches, named snapshots to compare">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="history" Size="18" VerticalAlignment="Center" /><TextBlock Text="History" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding StatesOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="Compare states (design/boards/Compare): superpose two states of the structure (start, now, a frame, a snapshot), RMSD and each atom's shift">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="layers" Size="18" VerticalAlignment="Center" /><TextBlock Text="Compare" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding LensOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="All-atom lens (design/boards/LensView): every atom inside, a lighter style outside; hold L to move it">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="search" Size="18" VerticalAlignment="Center" /><TextBlock Text="Lens" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding LodOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="Performance (design/boards/MillionAtoms): level of detail, frame time, memory">
              <local:Icon Kind="gauge" Size="18" />
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding AppearanceOpen}" IsEnabled="{Binding HasDocument}" IsVisible="{Binding IsStudio}"
                          ToolTip.Tip="Appearance (design/boards/Appearance): styles per selection, colour by charge, labels, surfaces">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="eye" Size="18" VerticalAlignment="Center" /><TextBlock Text="Appearance" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <Button Classes="tool short" ToolTip.Tip="{Binding StyleText, StringFormat='Display style: {0}'}" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="atom" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding StyleText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Ball &amp; stick" Tag="0" Click="OnStyleItem" /><MenuItem Header="Space filling" Tag="1" Click="OnStyleItem" />
                  <MenuItem Header="Sticks" Tag="2" Click="OnStyleItem" /><MenuItem Header="No hydrogens" Tag="3" Click="OnStyleItem" />
                  <MenuItem Header="Backbone" Tag="4" Click="OnStyleItem" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Colour atoms by" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="layers" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding ColourText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Element" Tag="0" Click="OnColourItem" /><MenuItem Header="Molecule" Tag="1" Click="OnColourItem" />
                  <MenuItem Header="Type" Tag="2" Click="OnColourItem" /><MenuItem Header="Distance to molecule centre" Tag="3" Click="OnColourItem" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Projection and camera" IsEnabled="{Binding HasDocument}">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="cube" Size="18" VerticalAlignment="Center" /><TextBlock Text="{Binding ProjectionText}" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Perspective" Click="OnPerspectiveOn" /><MenuItem Header="Orthographic" Click="OnPerspectiveOff" />
                  <Separator />
                  <MenuItem Header="Reset view (R)" Click="OnResetView" /><MenuItem Header="Frame selection (F)" Click="OnFrameSelection" /><MenuItem Header="Top" Click="OnViewTop" />
                  <MenuItem Header="Front" Click="OnViewFront" /><MenuItem Header="Side" Click="OnViewSide" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Rectangle Classes="vsep" />
            <ToggleButton Classes="tool" IsChecked="{Binding ShowRdf}" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Analysis dock: g(r), thermo, minimisation, molecules, chains">
              <local:Icon Kind="chart" Size="18" />
            </ToggleButton>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2" ClipToBounds="True">
            <Button Classes="tool" Classes.on="{Binding !MeasureTool}" Click="OnToolSelect" ToolTip.Tip="Select: click an atom · ⇧ click adds (up to 4 measure)"><local:Icon Kind="cursor" Size="18" /></Button>
          <Button Classes="tool" Classes.on="{Binding IsLassoTool}" Click="OnToolLasso" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Lasso select: drag around atoms (⇧ adds to the selection)"><local:Icon Kind="lasso" Size="18" /></Button>
          <Button Classes="tool" Classes.on="{Binding IsMoveTool}" Click="OnToolMove" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Translate: drag the selection, or the molecule under the cursor, in the view plane (undo with ⌘Z)"><local:Icon Kind="move" Size="18" /></Button>
            <Button Classes="tool" Click="OnResetView" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Reset the view (R); drag in the view rotates"><local:Icon Kind="rotate" Size="18" /></Button>
            <Rectangle Classes="vsep" />
          <Button Classes="tool" Classes.on="{Binding IsPlaceTool}" Click="OnToolPlace" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Place atom: click an atom to bond a new one to it (the element on the right)"><local:Icon Kind="atom" Size="18" /></Button>
          <Button Classes="tool" Classes.on="{Binding IsBondTool}" Click="OnToolBond" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Draw bond: click two atoms"><local:Icon Kind="bond" Size="18" /></Button>
          <Button Classes="tool" Classes.on="{Binding IsDeleteTool}" Click="OnToolDelete" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Delete: click atoms to remove them (Delete removes the picked ones)"><local:Icon Kind="scissors" Size="18" /></Button>
          <Button Classes="tool" Click="OnAddHydrogens" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Add the hydrogens the picked atoms (or all) lack"><TextBlock Text="+H" FontWeight="SemiBold" FontSize="13" /></Button>
          <Button Classes="tool" Click="OnFragmentTool" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Fragments: attach a group to the picked atom, or place a molecule"><local:Icon Kind="hex" Size="18" /></Button>
          <Button Classes="tool" Click="OnFuseRing" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Fuse ring: a benzene ring onto the bond between the two picked atoms (⇧ click them first)"><local:Icon Kind="ring" Size="18" /></Button>
            <Button Height="36" MinHeight="36" Padding="10,0" Margin="4,0,0,0" Click="OnElementPicker" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Element for new atoms (⇧E)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="22" Height="22" CornerRadius="4" Background="{Binding BuildElementColour}"><TextBlock Text="{Binding BuildElement}" FontWeight="Bold" FontSize="12" Foreground="#0F1113" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="{Binding BuildElementText}" FontSize="12" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                <local:Icon Kind="chev" Size="13" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Classes="vsep" />
            <Button Classes="tool" Classes.on="{Binding MeasureTool}" Click="OnToolMeasure" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Measure: click 2–4 atoms for a distance, angle or dihedral"><local:Icon Kind="ruler" Size="18" /></Button>
            <Button Classes="tool" Click="OnTorsionScan" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Torsion scan: the energy along the dihedral of four picked atoms (⇧ click them first)"><local:Icon Kind="chart" Size="18" /></Button>
          <Button Classes="tool" Click="OnPinMonitor" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Pin monitor: keep the distance, angle or dihedral of the picked atoms in the view; it follows the frames"><local:Icon Kind="pin" Size="18" /></Button>
          <Button Classes="tool" Click="OnInvert" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Invert the picked stereocentre (swap its two smallest branches)"><local:Icon Kind="mirror" Size="18" /></Button>
            <Rectangle Classes="vsep" />
          <Button Classes="tool" Click="OnAutoClean" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Auto-clean: minimise the picked atoms (or all) with UFF"><local:Icon Kind="wand" Size="18" /></Button>
          <Button Classes="tool" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (⌘Z)"><local:Icon Kind="undo" Size="18" /></Button>
          <Button Classes="tool" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (⇧⌘Z)"><local:Icon Kind="redo" Size="18" /></Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="0,*,Auto,Auto">
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
        <!-- Project (Main board): documents and what is in them; fragments for the builder -->
        <Border x:Name="ProjectPanel" Grid.Column="0" Width="260" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" IsVisible="{Binding ProjectPanelShown}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tool" Width="30" MinWidth="30" Height="30" MinHeight="30" Command="{Binding $parent[local:MainWindow].OpenCommand}" ToolTip.Tip="Add a file">
                  <local:Icon Kind="plus" Size="16" />
                </Button>
                <TextBlock Text="Project" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
              <StackPanel>
                <Border Classes="phead">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="small ghost" Content="Library…" Click="OnFragmentLibrary" ToolTip.Tip="The fragment library: rings, groups, monomers, rubber additives …" />
                    <TextBlock Text="Fragments" Classes="h2" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
                <StackPanel Margin="10" Spacing="10">
                  <TextBox Text="{Binding FragmentQuery}" Watermark="Search fragments" FontSize="12" KeyUp="OnFragmentSearchKey" />
                  <ItemsControl ItemsSource="{Binding QuickFragments}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FragmentItem">
                        <Button Margin="3" Height="62" MinHeight="62" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnQuickFragment" Tag="{Binding}"
                                ToolTip.Tip="{Binding Tip}" IsEnabled="{Binding $parent[local:MainWindow].((vm:MainViewModel)DataContext).HasDocument}">
                          <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:Icon Kind="{Binding Icon}" Size="20" StrokeWidth="1.4" Foreground="{DynamicResource TextB}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Short}" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
            <ScrollViewer>
              <StackPanel Margin="6,8" Spacing="1">
                <Border Height="26" Padding="10,0" CornerRadius="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <local:Icon Kind="chev" Size="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                    <local:Icon Kind="folder" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                    <TextBlock Text="Structures" Foreground="{DynamicResource MutedB}" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProjectCountText}" Foreground="{DynamicResource DimB}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasDocument}" />
                  </StackPanel>
                </Border>
                <!-- every structure of the project: pick one to work on it in any module -->
                <ItemsControl ItemsSource="{Binding ProjectItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectItem">
                      <Button Classes="projrow" Classes.on="{Binding Active}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,5,8,5"
                              Background="Transparent" BorderThickness="0" CornerRadius="5" Click="OnProjectTab" Tag="{Binding}" ToolTip.Tip="Work on this structure">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <Border Width="3" CornerRadius="2" Background="{DynamicResource AccB}" IsVisible="{Binding Active}" Margin="-12,0,0,0" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <local:Icon Kind="{Binding IconKind}" Size="14" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="190" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedB}" Margin="21,0,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ForceField}" FontSize="11" Foreground="{DynamicResource SelB}" Margin="21,0,0,0" IsVisible="{Binding HasForceField}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding History}" FontSize="11" Foreground="{DynamicResource OkB}" Margin="21,0,0,0" IsVisible="{Binding HasHistory}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="small ghost" HorizontalAlignment="Left" Margin="18,4,0,6" Click="OnDuplicateStructure" IsVisible="{Binding HasDocument}"
                        ToolTip.Tip="A copy of the active structure, force field kept: try another protocol on it and keep the original">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="layers" Size="13" VerticalAlignment="Center" /><TextBlock Text="Copy structure" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <TextBlock Text="MOLECULES OF THE ACTIVE STRUCTURE" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" Margin="18,6,0,2" IsVisible="{Binding HasDocument}" />
                <ItemsControl ItemsSource="{Binding MoleculeRows}" IsVisible="{Binding HasDocument}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoleculeRow">
                      <Border Height="24" Padding="18,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <local:Icon Kind="hex" Size="14" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
                          <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center">
                            <Run Text="Molecule " /><Run Text="{Binding Molecule}" /><Run Text=" · " /><Run Text="{Binding Atoms}" /><Run Text=" atoms" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <!-- Visualize pipeline (design/boards/VisPipeline): steps run bottom to top, data source, visual elements -->
        <Border Grid.Column="0" Width="300" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,1,0" IsVisible="{Binding IsVisualize}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="phead">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                  <Button Classes="tool" Width="30" Height="30" MinHeight="30" Click="OnAddStep" ToolTip.Tip="Add step"><local:Icon Kind="plus" Size="15" /></Button>
                  <Button Classes="tool" Width="30" Height="30" MinHeight="30" Click="OnPipelineMenu" ToolTip.Tip="Save, load or clear the pipeline"><local:Icon Kind="dots" Size="15" /></Button>
                </StackPanel>
                <TextBlock Text="Pipeline" Classes="h2" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10" Spacing="2">
              <TextBlock Text="VISUAL ELEMENTS" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" Margin="10,6,0,4" />
              <CheckBox Classes="toggle" Content="Simulation cell" IsChecked="{Binding ShowCell}" Margin="10,2" />
              <CheckBox Classes="toggle" Content="Colour legend" IsChecked="{Binding PipeLegendVisible}" Margin="10,2" />
              <CheckBox Classes="toggle" Content="Outlines" IsChecked="{Binding Outlines}" Margin="10,2" />
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Margin="8,4,8,8" Padding="10,8" CornerRadius="6" Background="{DynamicResource Bg0B}" BorderBrush="{DynamicResource LineB}" BorderThickness="1">
              <Button Classes="ghost" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPipeSource">
                <StackPanel Spacing="3">
                  <TextBlock Text="DATA SOURCE" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" />
                  <TextBlock Text="{Binding PipeSourceTitle}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PipeSourceDetail}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
                </StackPanel>
              </Button>
            </Border>
            <ScrollViewer>
              <StackPanel Margin="8" Spacing="3">
                <TextBlock Text="STEPS · RUN BOTTOM TO TOP" FontSize="11" LetterSpacing="0.6" Foreground="{DynamicResource DimB}" Margin="10,4" />
                <TextBlock Text="No steps: the file is shown as read. Add one with +." Classes="dim" TextWrapping="Wrap" Margin="10,4" IsVisible="{Binding !PipelineRows.Count}" />
                <ItemsControl ItemsSource="{Binding PipelineRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PipelineRow">
                      <StackPanel>
                      <Border IsVisible="{Binding GroupHeader}" Padding="6,6,10,4" Margin="0,4,0,2" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                          <Button Classes="ghost" Padding="2" BorderThickness="0" Background="Transparent" Click="OnGroupFold" Tag="{Binding}" ToolTip.Tip="Fold or unfold the group">
                            <local:Icon Kind="{Binding GroupChevron}" Size="12" Foreground="{DynamicResource MutedB}" />
                          </Button>
                          <local:Icon Grid.Column="1" Kind="layers" Size="13" Foreground="{DynamicResource SelB}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Group}" /><Run Text="  " /><Run Text="{Binding GroupLabel}" FontWeight="Normal" Foreground="{DynamicResource DimB}" FontSize="11" />
                          </TextBlock>
                          <CheckBox Grid.Column="3" Classes="toggle" IsChecked="{Binding GroupOn}" ToolTip.Tip="Every step of the group on or off" />
                        </Grid>
                      </Border>
                      <Button Classes="pipestep" Classes.sel="{Binding Selected}" Click="OnPipeStep" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Margin="0,0,0,3" IsVisible="{Binding RowVisible}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                          <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0" Padding="0" />
                          <local:Icon Grid.Column="1" Kind="{Binding Icon}" Size="14" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{Binding SummaryBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PipeError}" Foreground="{DynamicResource ErrB}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasPipeError}" Margin="10,4" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" x:Name="ViewHost" Background="{DynamicResource Bg0B}" ClipToBounds="True" Focusable="True" IsTabStop="True"
                AutomationProperties.Name="3D view · arrow keys walk the atoms, [ and ] the molecules, B the bonds">
          <Panel>
            <Image x:Name="ViewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <local:GlMolView x:Name="ViewGl" IsVisible="False" IsHitTestVisible="False" />
            <local:LabelOverlay x:Name="Labels" />
            <!-- pinned measurements (the toolbar's Pin monitor): they follow the frames and edits -->
            <Border Classes="hud" Padding="10,8" Margin="14,14,14,58" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding HasMonitors}">
              <StackPanel Spacing="4">
                <TextBlock Text="PINNED" Classes="label" FontSize="10.5" />
                <ItemsControl ItemsSource="{Binding Monitors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccB}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Ids}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
                          <TextBlock Text="{Binding Value}" Classes="mono" FontSize="11.5" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost" Content="×" Padding="4,0" Click="OnUnpin" Tag="{Binding}" ToolTip.Tip="Unpin" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Appearance legend (design/boards/Appearance): partial charge or surface potential -->
            <Border Classes="hud" Width="260" Padding="12,10" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding ShowAppLegend}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding AppLegendTitle}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
                <Rectangle Height="12" RadiusX="3" RadiusY="3" Fill="{Binding AppLegendBrush}" />
                <Grid ColumnDefinitions="*,Auto,*">
                  <TextBlock Text="{Binding AppLegendLo}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
                  <TextBlock Grid.Column="1" Text="0" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
                  <TextBlock Grid.Column="2" Text="{Binding AppLegendHi}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="hud" Padding="10,4" Margin="14,48,14,14" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding LabelNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding LabelNote}" FontSize="12" Foreground="{DynamicResource WarnB}" />
            </Border>
            <!-- Interactions legend (design/boards/Interactions) -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding ShowInteractionsPanel}">
              <Border Classes="hud" Padding="10,4"><StackPanel Orientation="Horizontal" Spacing="6"><Line StartPoint="0,0" EndPoint="16,0" Stroke="{DynamicResource SelB}" StrokeThickness="2" StrokeDashArray="3,2" VerticalAlignment="Center" /><TextBlock Text="H-bond" FontSize="12" /></StackPanel></Border>
              <Border Classes="hud" Padding="10,4"><StackPanel Orientation="Horizontal" Spacing="6"><Line StartPoint="0,0" EndPoint="16,0" Stroke="{DynamicResource ErrB}" StrokeThickness="2" VerticalAlignment="Center" /><TextBlock Text="clash" FontSize="12" /></StackPanel></Border>
            </StackPanel>
            <!-- Tacticity strip (design/boards/SelectionStereo): dyads between the stereocentres of the first chain -->
            <Border Height="150" VerticalAlignment="Bottom" Padding="18,14" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="ShowSelectionPanel" />
                  <Binding Path="HasDyads" />
                </MultiBinding>
              </Border.IsVisible>
              <StackPanel Spacing="10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" VerticalAlignment="Center" /><TextBlock Text="m (meso)" Foreground="{DynamicResource MutedB}" /></StackPanel></Border>
                    <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" /><TextBlock Text="r (racemo)" Foreground="{DynamicResource MutedB}" /></StackPanel></Border>
                  </StackPanel>
                  <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Tacticity along " /><Run Text="{Binding StereoChainText}" /><Run Text=" · dyads between stereocentres" /></TextBlock>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Dyads}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DyadCell">
                        <StackPanel Spacing="4">
                          <Border Width="44" Height="30" CornerRadius="5" Background="{DynamicResource SelB}" Classes.meso="{Binding IsMeso}" Classes="dyad">
                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccInkB}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding Label}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="chip" Background="{DynamicResource Bg3B}"><TextBlock Text="{Binding DyadCounts}" Classes="mono" /></Border>
                  <Border Classes="chip" Background="{DynamicResource Bg3B}"><TextBlock Text="{Binding TriadCounts}" Classes="mono" /></Border>
                  <Border Classes="chip"><TextBlock Text="computed from the structure" Foreground="{DynamicResource MutedB}" /></Border>
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Empty state -->
            <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" Text="The structure appears here when the run starts">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="NoDocument" />
                  <Binding Path="!IsStudio" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Performance HUD (design/boards/MillionAtoms) -->
            <Border Width="260" Padding="12,10" Margin="14,48,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource LineB}" Background="{DynamicResource HudB}" IsVisible="{Binding PerfHud}" IsHitTestVisible="False">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                <Grid.Styles><Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource Mono}" /><Setter Property="FontSize" Value="11.5" /></Style></Grid.Styles>
                <TextBlock Text="atoms" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Column="1" Text="{Binding PerfAtoms}" />
                <TextBlock Grid.Row="1" Text="frame time" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FrameText}" />
                <TextBlock Grid.Row="2" Text="target" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="60 fps · 16.7 ms" />
                <TextBlock Grid.Row="3" Text="LOD" Foreground="{DynamicResource MutedB}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LodHudText}" Foreground="{DynamicResource AccB}" />
              </Grid>
            </Border>
            <!-- HUD (Main board): selection and system chips, live monitors -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,12" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasDocument}">
              <Border Classes="chip" Background="{DynamicResource HudB}" IsVisible="{Binding HasSelection}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource SelB}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding HudSelection}" Foreground="{DynamicResource TextB}" />
                </StackPanel>
              </Border>
              <Border Classes="chip" Background="{DynamicResource HudB}">
                <TextBlock Text="{Binding HudInfo}" Foreground="{DynamicResource MutedB}" />
              </Border>
              <Border Classes="chip" Background="{DynamicResource HudB}" IsVisible="{Binding LoadIndexing}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" VerticalAlignment="Center" />
                  <TextBlock Text="frame 0 · ready" Foreground="{DynamicResource OkB}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Classes="hud" Width="230" Padding="12,10" Margin="14,12" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasMeasure}">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <local:Icon Kind="pin" Size="13" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
                  <TextBlock Text="LIVE MONITORS" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding MeasureText}" Classes="mono" Foreground="{DynamicResource AccB}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding ShowLegend}" Classes="hud"
                    Padding="12,10" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="190">
              <StackPanel Spacing="6">
                <TextBlock Text="Distance to molecule centre" Classes="dim" />
                <Rectangle Height="10" RadiusX="2" RadiusY="2">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="#440154" /><GradientStop Offset="0.125" Color="#472D7B" /><GradientStop Offset="0.25" Color="#3B528B" />
                      <GradientStop Offset="0.375" Color="#2C728E" /><GradientStop Offset="0.5" Color="#21918C" /><GradientStop Offset="0.625" Color="#28AE80" />
                      <GradientStop Offset="0.75" Color="#5EC962" /><GradientStop Offset="0.875" Color="#ADDC30" /><GradientStop Offset="1" Color="#FDE725" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding LegendLo}" Classes="mono" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding LegendHi}" Classes="mono" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock x:Name="HintText" IsVisible="False" />
            <!-- Visualize: the colour coding's legend -->
            <Border Classes="hud" Padding="12,10" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="260" IsVisible="{Binding ShowPipeLegend}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding PipeLegendTitle}" Classes="dim" />
                <ItemsControl ItemsSource="{Binding PipeLegendEntries}" IsVisible="{Binding PipeLegendCategorical}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegendSwatch">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,10,1">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="4" IsVisible="{Binding PipeLegendContinuous}" Width="180">
                  <Rectangle Height="10" RadiusX="2" RadiusY="2" IsVisible="{Binding !PipeLegendDiverging}">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#440154" /><GradientStop Offset="0.25" Color="#3B528B" /><GradientStop Offset="0.5" Color="#21918C" />
                        <GradientStop Offset="0.75" Color="#5EC962" /><GradientStop Offset="1" Color="#FDE725" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Rectangle Height="10" RadiusX="2" RadiusY="2" IsVisible="{Binding PipeLegendDiverging}">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#2166AC" /><GradientStop Offset="0.25" Color="#92C5DE" /><GradientStop Offset="0.5" Color="#F7F7F7" />
                        <GradientStop Offset="0.75" Color="#F4A582" /><GradientStop Offset="1" Color="#B2182B" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Grid ColumnDefinitions="*,*">
                    <TextBlock Text="{Binding PipeLegendLo}" Classes="mono" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding PipeLegendHi}" Classes="mono" FontSize="11" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- Render (design/boards/RenderOverlays): the output frame and its overlays -->
            <local:RenderGuideView x:Name="RenderGuide" IsVisible="{Binding IsRender}" IsHitTestVisible="False" />
            <!-- Select by query (design/boards/SmartSelect, ⌘F) -->
            <Border IsVisible="{Binding QueryOpen}" ZIndex="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Width="640"
                    CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg1B}" BoxShadow="0 12 32 0 #50000000">
              <StackPanel>
                <DockPanel Margin="12,10">
                  <Button DockPanel.Dock="Right" Classes="tool" Width="24" Height="24" Padding="0" Click="OnQueryClose" ToolTip.Tip="Close (Esc)"><local:Icon Kind="close" Size="12" /></Button>
                  <Border DockPanel.Dock="Right" Classes="chip" Margin="8,0" VerticalAlignment="Center" Classes.err="{Binding QueryBad}"><TextBlock Text="{Binding QueryInfo}" MaxWidth="260" TextTrimming="CharacterEllipsis" /></Border>
                  <local:Icon Kind="search" Size="15" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox x:Name="QueryBox" Text="{Binding QueryText}" Classes="mono" FontSize="13" BorderThickness="0" Background="Transparent"
                           Watermark="smarts &quot;c1ccccc1&quot; and chain 1 — Enter selects, ⇧Enter adds" KeyDown="OnQueryKey" VerticalAlignment="Center" />
                </DockPanel>
                <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="12,10">
                  <Grid ColumnDefinitions="*,220" ColumnSpacing="14">
                    <StackPanel Spacing="4">
                      <TextBlock Text="SAVED QUERIES" Classes="h3" />
                      <ItemsControl ItemsSource="{Binding SavedQueries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SavedQueryRow">
                            <Button Classes="histrow" Click="OnSavedQuery" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" ToolTip.Tip="{Binding Query}">
                              <Button.ContextFlyout><MenuFlyout><MenuItem Header="Remove" Click="OnSavedQueryDelete" Tag="{Binding}" /></MenuFlyout></Button.ContextFlyout>
                              <Grid ColumnDefinitions="130,*,50">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Query}" Classes="mono dim" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="GRAMMAR" Classes="h3" />
                      <TextBlock Classes="mono dim" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                                 Text="element C N O&#10;smarts &quot;…&quot;&#10;type c3 ca&#10;within 5.0 of sel&#10;chain 1-4 · index 1-20&#10;ring 5 · stereo R|S|*&#10;and · or · not · ( )" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="12,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <TextBox x:Name="QueryName" Width="130" Watermark="name" FontSize="12" />
                      <Button Classes="small" Content="Save query" Click="OnQuerySave" IsEnabled="{Binding !QueryBad}" />
                      <Button Classes="small" Content="Save as group" Click="OnQueryGroup" IsEnabled="{Binding !QueryBad}" />
                      <Button Classes="small primary" Content="Select" Click="OnQuerySelect" IsEnabled="{Binding !QueryBad}" />
                    </StackPanel>
                    <TextBlock Text="{Binding QueryTiming}" Classes="dim" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <!-- System states (design/boards/SystemStates): what happened, what still works, one primary action -->
            <ItemsControl ItemsSource="{Binding Notices}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,16,0" Width="380" ZIndex="8"
                          IsVisible="{Binding HasNotices}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Notice">
                  <Border Classes="notice" Padding="14,12" CornerRadius="10" BorderThickness="1" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}"
                          BoxShadow="0 8 24 0 #40000000">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="tool" Width="22" Height="22" Padding="0" Click="OnNoticeClose" Tag="{Binding}" ToolTip.Tip="Dismiss"><local:Icon Kind="close" Size="12" /></Button>
                        <Border DockPanel.Dock="Right" Classes="chip sev" Classes.check="{Binding IsCheck}" Classes.warning="{Binding IsWarning}" Classes.blocks="{Binding IsBlocks}"
                                Margin="8,0,6,0" VerticalAlignment="Center"><TextBlock Text="{Binding SeverityText}" /></Border>
                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource Bg3B}" Margin="0,0,10,0">
                          <local:Icon Kind="{Binding Icon}" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedB}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Body}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary small" Content="{Binding Primary}" IsVisible="{Binding HasPrimary}" Click="OnNoticePrimary" Tag="{Binding}" />
                        <Button Classes="small" Content="{Binding Secondary}" IsVisible="{Binding HasSecondary}" Click="OnNoticeSecondary" Tag="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Keyboard walk (design/boards/VisAccess): what a screen reader says, shown for sighted keyboard users -->
            <TextBlock Text="{Binding Announcement}" Opacity="0" IsHitTestVisible="False" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                       AutomationProperties.LiveSetting="Polite" />
            <Border Margin="16,14" Padding="12,10" VerticalAlignment="Bottom" CornerRadius="8" Background="{DynamicResource Bg1B}"
                    BorderBrush="{DynamicResource SelB}" BorderThickness="1" IsVisible="{Binding ShowAnnouncementBar}" IsHitTestVisible="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <local:Icon Kind="eye" Size="16" Foreground="{DynamicResource SelB}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="SCREEN READER ANNOUNCES" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.9" Foreground="{DynamicResource SelB}" />
                  <TextBlock Text="{Binding Announcement}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
              </Grid>
            </Border>
          </Panel>
        </Border>
        </Grid>

        <!-- Visualize: data inspector (design/boards/DataInspector) -->
        <Border Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Height="236">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasDocument" />
              <Binding Path="IsVisualize" />
            </MultiBinding>
          </Border.IsVisible>
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBox Width="260" Classes="mono" Watermark="Filter: Molecule == 1" Text="{Binding InspectorFilter}" IsVisible="{Binding IsParticlesTab}" FontSize="12" />
                  <ComboBox Width="240" ItemsSource="{Binding PipeTables}" SelectedItem="{Binding PipeTableName}" IsVisible="{Binding InspectorShowsTables}" />
                  <ComboBox Width="200" ItemsSource="{Binding PipeYColumns}" SelectedItem="{Binding PipeYColumnName}" IsVisible="{Binding InspectorShowsTables}" ToolTip.Tip="Column plotted" />
                  <Button Classes="small" Click="OnSeries" IsEnabled="{Binding SeriesIdle}" IsVisible="{Binding InspectorShowsTables}"
                          ToolTip.Tip="Run the pipeline on every frame and tabulate its attributes (cluster count, MSD, density …)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="history" Size="13" VerticalAlignment="Center" /><TextBlock Text="Over all frames" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </StackPanel>
                <TabStrip SelectedIndex="{Binding InspectorTab}" Classes="small">
                  <TabStripItem Content="Particles" /><TabStripItem Content="Bonds" /><TabStripItem Content="Global attributes" /><TabStripItem Content="Data tables" />
                </TabStrip>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="12,3">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsVisible="{Binding InspectorShowsTable}">
                  <Button Classes="small" Content="‹" Click="OnInspectorPrev" IsEnabled="{Binding InspectorCanPrev}" />
                  <Button Classes="small" Content="›" Click="OnInspectorNext" IsEnabled="{Binding InspectorCanNext}" />
                </StackPanel>
                <TextBlock Text="{Binding InspectorNote}" FontSize="11.5" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <Panel>
              <!-- particle and bond rows, and a data table's rows -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !InspectorShowsAttributes}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <StackPanel Margin="12,4">
                    <ItemsControl ItemsSource="{Binding InspectorColumns}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Width="96" Classes="label" TextAlignment="Right" Margin="0,0,8,2" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding InspectorRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableRow">
                          <Border Classes="trow" Classes.hl="{Binding Selected}" Height="21">
                            <ItemsControl ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Text="{Binding}" Width="96" Classes="mono" FontSize="11.5" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <local:LinePlot Grid.Column="1" Width="360" Margin="8,4,12,4" x:Name="PipeTablePlot" AutoRange="True" IsVisible="{Binding InspectorShowsTables}" />
              </Grid>
              <ScrollViewer IsVisible="{Binding InspectorShowsAttributes}">
                <ItemsControl ItemsSource="{Binding PipeAttributes}" Margin="14,6" MaxWidth="520" HorizontalAlignment="Left">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Row">
                      <Border Padding="0,3" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource MutedB}" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>
        <Border x:Name="AnalysisDock" Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,10" Height="230">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasDocument" />
              <Binding Path="ShowRdf" />
              <Binding Path="ShowAnalysisPanel" />
            </MultiBinding>
          </Border.IsVisible>
          <Panel>
          <TabControl x:Name="AnalysisTabs" Padding="0" Margin="0,-6,0,0">
            <TabItem Header="g(r)" FontSize="13">
              <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                <local:LinePlot x:Name="RdfPlot" XLabel="r (Å)" YLabel="g(r)" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="RADIAL DISTRIBUTION" Classes="h3" />
                  <ComboBox ItemsSource="{Binding RdfPairs}" SelectedIndex="{Binding RdfPairIndex}" HorizontalAlignment="Stretch" />
                  <CheckBox Content="Only between molecules" IsChecked="{Binding RdfInter}" />
                  <TextBlock Text="{Binding RdfNote}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

            </TabItem>
            <TabItem Header="Minimisation" FontSize="13">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <local:LinePlot x:Name="EnergyPlot" XLabel="iteration" YLabel="energy (kcal/mol)" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="ForcePlot" XLabel="iteration" YLabel="log₁₀ |F|max · dashed: tolerance" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Thermo" FontSize="13">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <local:LinePlot x:Name="TempPlot" XLabel="time (ps)" YLabel="T (K) · dashed: target" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="PressPlot" XLabel="time (ps)" YLabel="pressure (atm)" AutoRange="True" />
                <local:LinePlot Grid.Column="2" x:Name="DensPlot" XLabel="time (ps)" YLabel="density (g/cm³)" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Molecules" FontSize="13">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="70,70,110,90,90" Margin="0,4,0,4">
                  <TextBlock Text="MOL" Classes="h3" /><TextBlock Grid.Column="1" Text="ATOMS" Classes="h3" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="MASS (g/mol)" Classes="h3" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="RG (Å)" Classes="h3" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="κ²" Classes="h3" HorizontalAlignment="Right" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding MoleculeRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MoleculeRow">
                        <Grid ColumnDefinitions="70,70,110,90,90" Margin="0,1">
                          <TextBlock Text="{Binding Molecule}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Atoms}" Classes="mono" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="2" Text="{Binding Mass}" Classes="mono" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding Rg}" Classes="mono" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="{Binding Kappa2}" Classes="mono" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding MoleculeNote}" Classes="dim" Margin="0,4,0,0" />
              </Grid>
            </TabItem>
            <TabItem Header="Network" FontSize="13">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <local:LinePlot x:Name="ConvPlot" XLabel="cycle" YLabel="conversion α" AutoRange="True" />
                <local:LinePlot Grid.Column="1" x:Name="GelPlot" XLabel="conversion α" YLabel="largest cluster (mass fraction)" AutoRange="True" />
              </Grid>
            </TabItem>
            <TabItem Header="Around atom" FontSize="13" x:Name="FocusTab">
              <Grid ColumnDefinitions="440,*" ColumnSpacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Text="AROUND THE FOCUSED ATOM" Classes="h3" />
                  <Grid ColumnDefinitions="22*,22*,26*,30*" Margin="0,2">
                    <TextBlock Text="Neighbour" Classes="label" /><TextBlock Grid.Column="1" Text="Name" Classes="label" />
                    <TextBlock Grid.Column="2" Text="Molecule" Classes="label" /><TextBlock Grid.Column="3" Text="Distance (Å)" Classes="label" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding FocusRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FocusRow">
                        <Border Height="26" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="22*,22*,26*,30*">
                            <TextBlock Text="{Binding Id}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Molecule}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes="mono" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Click the view (or Tab to it), then ↑ ↓ to walk the atoms." Classes="dim" IsVisible="{Binding !HasFocusAtom}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="0,18,0,0">
                  <TextBlock Text="{Binding FocusTitle}" Classes="mono" FontSize="12" Foreground="{DynamicResource AccB}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="19"
                             Text="The 3D view is one focusable region. Inside it, keys walk the structure the way a reader walks text: atom, bond, molecule, frame. The amber ring marks focus; the announcement is also shown on screen, for sighted keyboard users." />
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Chains" FontSize="13">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="18">
                <local:LinePlot x:Name="ChainPlot" XLabel="n (backbone bonds apart)" YLabel="⟨R²(n)⟩ / (n ⟨b²⟩)" AutoRange="True" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="INTERNAL DISTANCES" Classes="h3" />
                  <TextBlock Text="{Binding ChainNote}" Classes="dim" TextWrapping="Wrap" />
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             Text="Mean-square distance between backbone atoms n bonds apart, divided by n ⟨b²⟩ (Theodorou and Suter 1985). Chains packed in strained shapes overshoot or bend away from a smooth rise to a plateau." />
                </StackPanel>
              </Grid>
            </TabItem>
          </TabControl>
          <Button x:Name="DockToggle" Classes="tool" IsVisible="{Binding Compact}" Click="OnDockToggle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                  ToolTip.Tip="Show or fold the curves">
            <local:Icon Kind="chev" Size="14" RenderTransformOrigin="50%,50%">
              <local:Icon.RenderTransform><RotateTransform Angle="{Binding DockChevronAngle}" /></local:Icon.RenderTransform>
            </local:Icon>
          </Button>
          </Panel>
        </Border>

        <!-- Reading the other frames (design/boards/VisLoading): how far the file has been read -->
        <Border Grid.Row="3" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="16,12" IsVisible="{Binding LoadIndexing}">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="the timeline opens when the frames are read · orbit, pick and measure now" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
              <TextBlock Text="frame 0" Classes="mono" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="10" MinHeight="10" CornerRadius="5" />
            <Grid ColumnDefinitions="*,Auto,*">
              <TextBlock Text="0" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
              <TextBlock Grid.Column="1" Text="{Binding LoadFramesText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
              <TextBlock Grid.Column="2" Text="{Binding LoadEndText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,8" IsVisible="{Binding HasFrames}" IsEnabled="{Binding Idle}">
          <StackPanel Spacing="6">
          <!-- Timeline (design/boards/Timeline): a sparkline and markers once a time series is computed -->
          <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasTimeline}">
            <ComboBox ItemsSource="{Binding TimelineAttributes}" SelectedItem="{Binding SparkAttribute}" FontSize="11.5" HorizontalAlignment="Stretch" ToolTip.Tip="Attribute drawn over the frames" />
            <local:TimelineView Grid.Column="1" x:Name="Timeline" Height="40" Cursor="Hand" />
            <TextBlock Grid.Column="2" Text="{Binding MarkerNote}" FontSize="11" Foreground="{DynamicResource WarnB}" VerticalAlignment="Center" MaxWidth="200" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Content="{Binding PlayLabel}" Click="OnPlay" Width="64" Margin="0,0,12,0" ToolTip.Tip="Play / pause (Space) · ← → step frames" />
            <Button Classes="small" Click="OnTrajectoryPlayer" Margin="0,0,12,0" IsVisible="{Binding IsStudio}" ToolTip.Tip="Trajectory player: linked plots (density, temperature from the log, a chain's Rg and Ree), loop, smoothing">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="chart" Size="13" VerticalAlignment="Center" /><TextBlock Text="Player" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Frame" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider Grid.Column="2" Minimum="0" Maximum="{Binding FrameMax}" Value="{Binding Frame}" TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="3" Text="{Binding FrameLabel}" Classes="mono" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Compact layout: the drawers' side tabs -->
      <Border x:Name="SideTabs" Grid.Row="1" Grid.Column="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0" IsVisible="False">
        <StackPanel>
          <Button Classes="sidetab" Classes.on="{Binding InspectorDrawer}" Click="OnInspectorDrawer" ToolTip.Tip="Inspector">
            <LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="90" /></LayoutTransformControl.LayoutTransform>
              <TextBlock Text="Inspector" FontSize="11.5" /></LayoutTransformControl>
          </Button>
          <Button Classes="sidetab" Classes.on="{Binding ProjectDrawer}" Click="OnProjectDrawer" ToolTip.Tip="Project and fragments">
            <LayoutTransformControl><LayoutTransformControl.LayoutTransform><RotateTransform Angle="90" /></LayoutTransformControl.LayoutTransform>
              <TextBlock Text="Project" FontSize="11.5" /></LayoutTransformControl>
          </Button>
        </StackPanel>
      </Border>
      <!-- Inspector -->
      <Border x:Name="InspectorPanel" Grid.Row="1" Grid.Column="2" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
        <Panel>
        <!-- Interactions & checks (design/boards/Interactions) -->
        <DockPanel IsVisible="{Binding ShowInteractionsPanel}">
          <Border DockPanel.Dock="Top" Classes="phead"><TextBlock Text="Interactions &amp; checks" Classes="h2" VerticalAlignment="Center" /></Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Click="OnIxExport"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="download" Size="15" VerticalAlignment="Center" /><TextBlock Text="Export list" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Classes="primary" Click="OnIxFixAll"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="wand" Size="15" VerticalAlignment="Center" /><TextBlock Text="Fix all safe issues" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="HYDROGEN BONDS" Classes="h3" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip" Background="{DynamicResource SelBgB}"><TextBlock Text="{Binding HbChip}" Classes="mono" Foreground="{DynamicResource SelB}" /></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding IxMoleculesChip}" Foreground="{DynamicResource MutedB}" /></Border>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="D···A max · Å" Classes="label" /><NumericUpDown Value="{Binding HbDistance}" Minimum="2" Maximum="5" Increment="0.1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="H–D···A max · °" Classes="label" /><NumericUpDown Value="{Binding HbAngle}" Minimum="5" Maximum="90" Increment="5" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="dim" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Text="Geometric criterion: Luzar &amp; Chandler, Nature 379, 55 (1996)" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="9">
                  <TextBlock Text="CONTACTS" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Show close contacts &lt; sum of vdW − 0.4 Å" IsChecked="{Binding ShowContacts}" />
                  <CheckBox Classes="toggle" Content="Show clashes &lt; 0.75 × sum of vdW" IsChecked="{Binding ShowClashes}" />
                  <CheckBox Classes="toggle" Content="Update while editing and during playback" IsChecked="{Binding InteractionsLive}" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip" Classes.err="{Binding IxHasErrors}"><TextBlock Text="{Binding IxErrorsChip}" Foreground="{DynamicResource MutedB}" /></Border>
                    <TextBlock Text="VALIDATION" Classes="h3" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding CheckIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CheckIssue">
                        <Grid ColumnDefinitions="22,*,Auto" Margin="0,0,0,8">
                          <local:Icon Kind="{Binding Icon}" Size="15" VerticalAlignment="Top" Margin="0,2,0,0" Classes.err="{Binding IsError}" Classes.warn="{Binding IsWarn}" Classes.ok="{Binding IsOk}" Classes="lvl" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="small link" Content="{Binding FixText}" IsVisible="{Binding HasFix}" Click="OnIxFix" Tag="{Binding}" VerticalAlignment="Top" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Padding="16,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding IxError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IxHasError}" />
                  <TextBlock Text="{Binding IxStatus}" Classes="dim" FontSize="11.5" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Selection & stereo (design/boards/SelectionStereo) -->
        <DockPanel IsVisible="{Binding ShowSelectionPanel}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center" Background="{DynamicResource SelBgB}"><TextBlock Text="{Binding SelectedChip}" Foreground="{DynamicResource SelB}" /></Border>
              <TextBlock Text="Selection" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <DockPanel>
              <Button DockPanel.Dock="Left" Classes="ghost" Content="Clear" Click="OnSelClear" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnInvert" ToolTip.Tip="Invert the picked stereocentre"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="mirror" Size="15" VerticalAlignment="Center" /><TextBlock Text="Invert centre" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Classes="primary" Click="OnSelApply" ToolTip.Tip="Replace the selection with the pattern's atoms"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="check" Size="15" VerticalAlignment="Center" /><TextBlock Text="Apply" VerticalAlignment="Center" /></StackPanel></Button>
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="SELECT BY" Classes="h3" />
                  <UniformGrid Columns="3">
                    <RadioButton Classes="seg" Content="SMARTS" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" Margin="0,0,4,4" />
                    <RadioButton Classes="seg" Content="Element" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" Margin="0,0,4,4" />
                    <RadioButton Classes="seg" Content="Atom type" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=2}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <RadioButton Classes="seg" Content="Charge range" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=3}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                    <RadioButton Classes="seg" Content="Within distance" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=4}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                    <RadioButton Classes="seg" Content="Grow along bonds" FontSize="11.5" Padding="2,0" GroupName="selmode" IsChecked="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=5}" HorizontalAlignment="Stretch" />
                  </UniformGrid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SelectPatternLabel}" Classes="label" />
                    <TextBox Text="{Binding SelectPattern}" Classes="mono" FontSize="12.5" IsVisible="{Binding SelectMode, Converter={x:Static local:IntLessConverter.Instance}, ConverterParameter=3}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding SelectModeIsCharge}">
                      <NumericUpDown Value="{Binding SelectChargeLo}" Increment="0.05" FormatString="0.00" ShowButtonSpinner="False" />
                      <NumericUpDown Grid.Column="1" Value="{Binding SelectChargeHi}" Increment="0.05" FormatString="0.00" ShowButtonSpinner="False" />
                    </Grid>
                    <NumericUpDown Value="{Binding SelectDistance}" Increment="0.5" FormatString="0.0" ShowButtonSpinner="False" IsVisible="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=4}" />
                    <NumericUpDown Value="{Binding SelectSteps}" Increment="1" FormatString="0" ShowButtonSpinner="False" IsVisible="{Binding SelectMode, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=5}" />
                    <TextBlock Text="{Binding SelectPatternHint}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Content="Replace" Click="OnSelOp" Tag="replace" />
                    <Button Classes="small" Content="Add" Click="OnSelOp" Tag="add" />
                    <Button Classes="small" Content="Subtract" Click="OnSelOp" Tag="subtract" />
                    <Button Classes="small" Content="Invert" Click="OnSelOp" Tag="invert" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="6">
                  <TextBlock Text="NAMED SETS" Classes="h3" />
                  <ItemsControl ItemsSource="{Binding NamedSets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NamedSet">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="32" MinHeight="32" Padding="10,0" Margin="0,0,0,6" Click="OnUseSet" Tag="{Binding}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Fill="{Binding Colour}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="small" HorizontalAlignment="Left" Click="OnSaveSet"><StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="save" Size="13" VerticalAlignment="Center" /><TextBlock Text="Save selection as set" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="8">
                  <TextBlock Text="STEREO" Classes="h3" />
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding StereoCentres}" Classes="mono" /><TextBlock Text="Stereocentres (CH)" Foreground="{DynamicResource MutedB}" FontSize="12.5" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TacticityLabel}" Classes="mono" /><TextBlock Text="Tacticity" Foreground="{DynamicResource MutedB}" FontSize="12.5" /></DockPanel>
                  <TextBlock FontSize="12" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" LineHeight="18" Text="Along a long chain these centres are pseudo-asymmetric, so tacticity is reported as m/r dyads rather than R/S labels." />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Content="Make isotactic" Click="OnMakeIso" />
                    <Button Classes="small" Content="Make syndiotactic" Click="OnMakeSyndio" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="16,12">
                <TextBlock Text="{Binding SelectError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding SelectHasError}" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Compare states (design/boards/Compare): the moving state superposed on the reference, shifts in the view -->
        <DockPanel IsVisible="{Binding ShowStatesPanel}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="tool" Click="OnStatesClose" ToolTip.Tip="Close (the view's colours go back)"><local:Icon Kind="close" Size="14" /></Button>
              <TextBlock Text="Compare states" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding CompareInfo}" Classes="dim" TextWrapping="Wrap" FontSize="11" />
          </Border>
          <ScrollViewer>
            <StackPanel Margin="14,12,14,14" Spacing="10">
              <TextBlock Text="Same atoms, matched one to one" Classes="dim" />
              <StackPanel Spacing="4">
                <TextBlock Text="Reference" Classes="label" />
                <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding CompareReference}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Moving (superposed on the reference)" Classes="label" />
                <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding CompareMoving}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Fit on" Classes="label" />
                <Border Classes="seg">
                  <UniformGrid Columns="4">
                    <RadioButton Classes="seg" GroupName="cmpfit" Content="All" IsChecked="{Binding CompareFit, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                    <RadioButton Classes="seg" GroupName="cmpfit" Content="Heavy" IsChecked="{Binding CompareFit, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                    <RadioButton Classes="seg" GroupName="cmpfit" Content="Backbone" IsChecked="{Binding CompareFit, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                    <RadioButton Classes="seg" GroupName="cmpfit" Content="Selection" IsChecked="{Binding CompareFit, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=3}" />
                  </UniformGrid>
                </Border>
              </StackPanel>
              <CheckBox Content="Colour the view by each atom's shift" IsChecked="{Binding CompareColour}" />
              <TextBlock Text="{Binding CompareError}" Classes="err" TextWrapping="Wrap" IsVisible="{Binding CompareHasError}" />
              <Border Classes="card" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="RMSD AFTER SUPERPOSITION" Classes="h3" />
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CompareRmsdAll}" Classes="mono" /><TextBlock Text="All atoms" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CompareRmsdHeavy}" Classes="mono" /><TextBlock Text="Heavy atoms" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CompareRmsdBackbone}" Classes="mono" /><TextBlock Text="Backbone" /></DockPanel>
                </StackPanel>
              </Border>
              <StackPanel Spacing="4">
                <TextBlock Text="SHIFT PER ATOM (Å)" Classes="h3" />
                <Border Height="120" Background="{DynamicResource Bg0B}" CornerRadius="6" Padding="4">
                  <local:LinePlot x:Name="ShiftPlot" AutoRange="True" />
                </Border>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="LARGEST SHIFTS" Classes="h3" />
                <ItemsControl ItemsSource="{Binding LargestShifts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShiftRow">
                      <Grid ColumnDefinitions="60,*,Auto" Margin="0,1">
                        <TextBlock Text="{Binding Label}" Classes="mono" />
                        <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="dim" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Shift}" Classes="mono" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="small" Content="Export CSV…" Click="OnStatesCsv" ToolTip.Tip="Atom, element, molecule and shift of every atom" />
                <Button Classes="small" Content="Take snapshot" Click="OnTakeSnapshot" ToolTip.Tip="Keep the structure now under a name, to compare later" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- History & snapshots (design/boards/History) -->
        <DockPanel IsVisible="{Binding ShowHistoryPanel}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <Button Classes="tool" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (⌘Z)"><local:Icon Kind="undo" Size="16" /></Button>
                <Button Classes="tool" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (⇧⌘Z)"><local:Icon Kind="redo" Size="16" /></Button>
              </StackPanel>
              <TextBlock Text="History" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding HistorySummary}" Classes="dim" />
          </Border>
          <ScrollViewer>
            <StackPanel Margin="10,10,10,14" Spacing="4">
              <ItemsControl ItemsSource="{Binding HistoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRow">
                    <Button Classes="histrow" Classes.current="{Binding IsCurrent}" Classes.undone="{Binding IsUndone}" Click="OnHistoryStep" Tag="{Binding}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Go back or forward to this step">
                      <Grid ColumnDefinitions="22,*,Auto">
                        <TextBlock Text="{Binding Number}" Classes="mono dim" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding What}" FontSize="12.5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Atoms}" Classes="mono dim" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="note" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="dim" TextWrapping="Wrap" Margin="4,6,4,0"
                         Text="Editing after an undo keeps the undone steps as a branch; nothing is lost until you delete it." />
              <ItemsControl ItemsSource="{Binding HistoryBranches}" IsVisible="{Binding HasBranches}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BranchRow">
                    <Border Classes="card" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Classes="small" Content="Restore" Click="OnBranchRestore" Tag="{Binding}" ToolTip.Tip="Make these the redo steps" />
                          <Button Classes="tool" Click="OnBranchDelete" Tag="{Binding}" ToolTip.Tip="Delete the branch"><local:Icon Kind="close" Size="12" /></Button>
                        </StackPanel>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Classes="dim" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="4,14,0,6">
                <Button DockPanel.Dock="Right" Classes="small" Click="OnTakeSnapshot" ToolTip.Tip="Keep the structure as it is now, under a name">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="plus" Size="12" VerticalAlignment="Center" /><TextBlock Text="Take snapshot" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <TextBlock Text="SNAPSHOTS" Classes="h3" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Snapshots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SnapshotRow">
                    <Border Classes="card" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Classes="small" Content="Compare" Click="OnSnapshotCompare" Tag="{Binding}" ToolTip.Tip="Compare the structure now with this snapshot" />
                          <Button Classes="tool" Click="OnSnapshotMenu" Tag="{Binding}" ToolTip.Tip="Restore or delete">
                            <local:Icon Kind="dots" Size="14" />
                            <Button.Flyout>
                              <MenuFlyout>
                                <MenuItem Header="Restore this snapshot" Click="OnSnapshotRestore" Tag="{Binding}" />
                                <MenuItem Header="Delete" Click="OnSnapshotDelete" Tag="{Binding}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                        <Border Width="64" Height="44" CornerRadius="5" Background="{DynamicResource Bg0B}" ClipToBounds="True" Margin="0,0,10,0">
                          <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Classes="dim" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No snapshots yet: take one before a risky edit to come back to it or compare." Classes="dim" TextWrapping="Wrap" Margin="4,0"
                         IsVisible="{Binding !HasSnapshots}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- All-atom lens (design/boards/LensView) -->
        <DockPanel IsVisible="{Binding ShowLensPanel}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="hold L to move" Foreground="{DynamicResource MutedB}" /></Border>
              <TextBlock Text="Lens" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <DockPanel><ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding LensOn}" OnContent="" OffContent="" /><TextBlock Text="INSIDE THE LENS" Classes="h3" VerticalAlignment="Center" /></DockPanel>
                  <StackPanel Spacing="4"><TextBlock Text="Style" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.DisplayNames}" SelectedIndex="{Binding LensInside}" HorizontalAlignment="Stretch" /></StackPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LensInsideCount}" Classes="mono" /><TextBlock Text="Atoms" Classes="muted" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LensInsideH}" Classes="mono" /><TextBlock Text="of them H" Classes="muted" /></DockPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="OUTSIDE" Classes="h3" />
                  <StackPanel Spacing="4"><TextBlock Text="Style" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.DisplayNames}" SelectedIndex="{Binding LensOutside}" HorizontalAlignment="Stretch" /></StackPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LensChains}" Classes="mono" /><TextBlock Text="Chains" Classes="muted" /></DockPanel>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LensModelAtoms}" Classes="mono" /><TextBlock Text="Atoms in model" Classes="muted" /></DockPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="LENS OPTIONS" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock Text="Radius · Å" Classes="label" /><NumericUpDown Value="{Binding LensRadius}" Minimum="2" Maximum="200" Increment="1" FormatString="0.#" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Follows" Classes="label" /><ComboBox ItemsSource="{Binding LensFollowNames}" SelectedIndex="{Binding LensFollows}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Dim outside" IsChecked="{Binding LensDim}" />
                  <CheckBox Classes="toggle" Content="Measurements only inside" IsChecked="{Binding LensMeasureInside}" />
                </StackPanel>
              </Border>
              <Border Classes="section" BorderThickness="0">
                <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="The lens is how large systems stay readable without losing atoms: detail where you look, tubes elsewhere, every atom still in the model." />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Performance (design/boards/MillionAtoms): level of detail, memory, quality -->
        <DockPanel IsVisible="{Binding ShowLodPanel}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="CPU renderer" Foreground="{DynamicResource MutedB}" /></Border>
              <TextBlock Text="Level of detail" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Click="OnBenchmarkView"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="bench" Size="15" VerticalAlignment="Center" /><TextBlock Text="Benchmark this view" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <DockPanel><ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding LodOn}" OnContent="" OffContent="" /><TextBlock Text="TIERS" Classes="h3" VerticalAlignment="Center" /></DockPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding LodOn}">
                    <StackPanel Spacing="6"><TextBlock Text="Near · Å (full)" Classes="label" /><NumericUpDown Value="{Binding LodNear}" Minimum="5" Increment="5" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Mid to · Å (spheres)" Classes="label" /><NumericUpDown Value="{Binding LodFar}" Minimum="5" Increment="5" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="Near the focus: atoms and bonds in full. Farther: spheres without bonds. Beyond: points. Distances from the centre of the view in its focal plane; exports always render in full." />
                  <TextBlock Text="{Binding LodTiers}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="8">
                  <TextBlock Text="MEMORY" Classes="h3" />
                  <TextBlock Text="{Binding LodMemory}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" Text="Measured from the document's own arrays. Large trajectories open frame 0 first and read the rest in the background." />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="9">
                  <TextBlock Text="QUALITY" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Ambient occlusion (near tier only)" IsChecked="{Binding LodAoNear}" />
                  <CheckBox Classes="toggle" Content="Outlines" IsChecked="{Binding Outlines}" />
                  <CheckBox Classes="toggle" Content="Adaptive: shrink the near tier to keep 60 fps" IsChecked="{Binding LodAdaptive}" />
                  <CheckBox Classes="toggle" Content="Performance HUD in the view" IsChecked="{Binding PerfHud}" />
                </StackPanel>
              </Border>
              <Border Classes="section" BorderThickness="0">
                <TextBlock Text="{Binding LodBench}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Appearance (design/boards/Appearance): styles per selection, colour, labels, surfaces, rendering -->
        <DockPanel IsVisible="{Binding ShowAppearance}">
          <Border DockPanel.Dock="Top" Classes="phead">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding AppChip}" Foreground="{DynamicResource MutedB}" /></Border>
              <TextBlock Text="Appearance" Classes="h2" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1B}">
            <DockPanel>
              <Button DockPanel.Dock="Left" Classes="ghost" Content="Reset" Click="OnAppearanceReset" ToolTip.Tip="Back to the view's style: no layers, surfaces or labels" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnAppearanceExport">
                  <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="download" Size="15" VerticalAlignment="Center" /><TextBlock Text="Export image" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Classes="primary" Click="OnAppearanceApply">
                  <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="check" Size="15" VerticalAlignment="Center" /><TextBlock Text="Apply" VerticalAlignment="Center" /></StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="STYLE" Classes="h3" />
                  <Border Classes="seg" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="2">
                      <RadioButton Classes="seg" Content="All atoms" GroupName="apptarget" IsChecked="{Binding AppTarget, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" />
                      <RadioButton Classes="seg" Content="Expression" GroupName="apptarget" IsChecked="{Binding AppTarget, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                  </Border>
                  <TextBox Text="{Binding AppExpression}" Classes="mono" FontSize="12" IsVisible="{Binding AppTargetIsExpression}" Watermark="Molecule &lt;= 3 · Element == &quot;O&quot; · Position.Z &gt; 20" />
                  <UniformGrid Columns="3">
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppBallStick, Mode=OneWay}" Click="OnAppStyle" Tag="0" Margin="0,0,6,6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="atom" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Ball &amp; stick" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppStick, Mode=OneWay}" Click="OnAppStyle" Tag="1" Margin="0,0,6,6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="bond" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Stick" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppWire, Mode=OneWay}" Click="OnAppStyle" Tag="2" Margin="0,0,0,6">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="relax" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Wireframe" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppSpace, Mode=OneWay}" Click="OnAppStyle" Tag="3" Margin="0,0,6,0">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="pack" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Space filling" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppPoly, Mode=OneWay}" Click="OnAppStyle" Tag="4" Margin="0,0,6,0">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="cube" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Polyhedra" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="tile" GroupName="appstyle" IsChecked="{Binding AppRibbon, Mode=OneWay}" Click="OnAppStyle" Tag="5">
                      <StackPanel Spacing="5" HorizontalAlignment="Center"><local:Icon Kind="grow" Size="18" HorizontalAlignment="Center" /><TextBlock Text="Ribbon" FontSize="11.5" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                  </UniformGrid>
                  <ItemsControl ItemsSource="{Binding AppLayers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StyleLayer">
                        <DockPanel Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Classes="ghost" Padding="4,0" MinHeight="22" Height="22" Click="OnRemoveLayer" Tag="{Binding}" ToolTip.Tip="Remove the layer"><local:Icon Kind="close" Size="12" /></Button>
                          <TextBlock Text="{Binding Title}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="8">
                  <TextBlock Text="COLOUR" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Colour by" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.AppColourNames}" SelectedIndex="{Binding AppColour}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding AppRampEnabled}"><TextBlock Text="Palette" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.AppRampNames}" SelectedIndex="{Binding AppRamp}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="8">
                  <TextBlock Text="LABELS" Classes="h3" />
                  <WrapPanel>
                    <CheckBox Content="Element" IsChecked="{Binding LabelElement}" Margin="0,0,14,0" />
                    <CheckBox Content="R/S" IsChecked="{Binding LabelRs}" Margin="0,0,14,0" ToolTip.Tip="Cahn–Ingold–Prelog configuration of tetrahedral centres" />
                    <CheckBox Content="Atom type" IsChecked="{Binding LabelType}" Margin="0,0,14,0" />
                    <CheckBox Content="Charge" IsChecked="{Binding LabelCharge}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="SURFACES" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="6"><TextBlock Text="Surface" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.AppSurfaceNames}" SelectedIndex="{Binding AppSurface}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding AppHasSurface}"><TextBlock Text="Probe · Å" Classes="label" /><NumericUpDown Value="{Binding AppProbe}" Minimum="0.5" Maximum="5" Increment="0.1" FormatString="0.0" ShowButtonSpinner="False" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding AppHasSurface}">
                    <StackPanel Spacing="6"><TextBlock Text="Map onto surface" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.AppMapNames}" SelectedIndex="{Binding AppSurfaceMap}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Opacity" Classes="label" /><ComboBox ItemsSource="{x:Static vm:MainViewModel.AppOpacities}" SelectedIndex="{Binding AppOpacity}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                  <TextBox Text="{Binding AppSurfaceAtoms}" Classes="mono" FontSize="12" IsEnabled="{Binding AppHasSurface}" Watermark="Atoms it wraps (empty: all) · Molecule == 1" />
                  <TextBlock Classes="dim" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Text="Lee &amp; Richards 1971 · Connolly 1983 · marching tetrahedra on a 0.6 Å grid; potential from the partial charges (ε = 1)" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="9">
                  <TextBlock Text="RENDERING" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Ambient occlusion" IsChecked="{Binding ViewAo}" />
                  <CheckBox Classes="toggle" Content="Edge outlines" IsChecked="{Binding Outlines}" />
                  <CheckBox Classes="toggle" Content="Depth cueing" IsChecked="{Binding DepthCue}" />
                </StackPanel>
              </Border>
              <Border Padding="16,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding AppError}" Classes="err" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AppHasError}" />
                  <TextBlock Text="{Binding AppInfo}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Studio inspector (Main board): Atom · Molecule · View · File -->
        <TabControl IsVisible="{Binding ShowStudioTabs}" Padding="0" Margin="0">
          <TabControl.Styles>
            <Style Selector="TabItem"><Setter Property="Margin" Value="6,0,0,0" /></Style>
          </TabControl.Styles>
          <TabItem Header="Atom">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section" IsVisible="{Binding !HasAtom}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="SELECTED ATOM" Classes="h3" />
                    <TextBlock Text="Click an atom in the view. ⇧ click adds up to four for a distance, angle or dihedral." Classes="muted" TextWrapping="Wrap" FontSize="12.5" />
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="h3"><Run Text="SELECTED ATOM · " /><Run Text="{Binding PickedTitle}" /></TextBlock>
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                      <TextBlock Text="Element" Classes="label" /><TextBlock Grid.Column="1" Text="Type" Classes="label" />
                      <TextBox Grid.Row="1" Text="{Binding PickedElement}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickedType}" IsReadOnly="True" Classes="mono" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="x (Å)" Classes="label" /><TextBlock Grid.Column="1" Text="y (Å)" Classes="label" /><TextBlock Grid.Column="2" Text="z (Å)" Classes="label" />
                      <TextBox Grid.Row="1" Text="{Binding PickedX}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickedY}" IsReadOnly="True" Classes="mono" />
                      <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PickedZ}" IsReadOnly="True" Classes="mono" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PickedRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="FORCE-FIELD TYPE" Classes="h3" />
                    <WrapPanel>
                      <Border Classes="chip acc" Margin="0,0,6,0"><TextBlock Text="{Binding PickedFf}" /></Border>
                      <Border Classes="chip" Background="{DynamicResource Bg3B}" Margin="0,0,6,0"><TextBlock Text="{Binding PickedType}" Classes="mono" Foreground="{DynamicResource TextB}" /></Border>
                      <Border Classes="chip"><TextBlock Text="{Binding PickedCharge}" Classes="mono" Foreground="{DynamicResource MutedB}" /></Border>
                    </WrapPanel>
                    <Border Classes="inset">
                      <TextBlock Text="{Binding PickedWhy}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedB}" LineHeight="18" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasAtom}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="NEAREST ATOMS" Classes="h3" />
                    <ItemsControl ItemsSource="{Binding NeighbourRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="mono" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="section" IsVisible="{Binding HasDocument}">
                  <StackPanel Spacing="9">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="link" Content="All checks…" Padding="0" FontSize="11.5" Click="OnChecks" />
                      <TextBlock Text="VALIDATION" Classes="h3" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FileChecks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileCheckRow">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2" ToolTip.Tip="{Binding Detail}">
                            <local:Icon Kind="{Binding Icon}" Size="15" Foreground="{Binding Colour}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Molecule">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="8">
                    <TextBlock Text="MOLECULES" Classes="h3" />
                    <Grid ColumnDefinitions="50,60,*,64,54">
                      <TextBlock Text="Mol" Classes="label" /><TextBlock Grid.Column="1" Text="Atoms" Classes="label" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="Mass" Classes="label" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="Rg (Å)" Classes="label" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="κ²" Classes="label" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MoleculeRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoleculeRow">
                          <Grid ColumnDefinitions="50,60,*,64,54" Margin="0,2">
                            <TextBlock Text="{Binding Molecule}" Classes="mono" /><TextBlock Grid.Column="1" Text="{Binding Atoms}" Classes="mono" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding Mass}" Classes="mono" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding Rg}" Classes="mono" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding Kappa2}" Classes="mono" HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoleculeNote}" Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <!-- Molecule inspector (design/boards/MoleculeInspector) -->
                <Border Classes="section" IsVisible="{Binding HasMolInfo}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding MolInspectorTitle}" Classes="h3" />
                    <ItemsControl ItemsSource="{Binding MolInfoRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MolInfoRow">
                          <Grid ColumnDefinitions="130,*" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="From the drawn geometry; standard atomic weights (IUPAC), monoisotopic ¹²C and ¹H. SMILES written from the perceived bonds (not canonical)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="small" Content="Copy table" Click="OnCopyMolTable" />
                      <Button Classes="small" Content="Add to library" Click="OnAddMolLibrary" ToolTip.Tip="The molecule's SMILES into the fragment library's My fragments" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="View">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="DISPLAY" Classes="h3" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="Background" Classes="label" />
                      <Border Classes="seg">
                        <UniformGrid Columns="2">
                          <RadioButton Classes="seg" GroupName="vbg" Content="Dark" IsChecked="{Binding !ViewIsLight}" Click="OnViewBgDark" />
                          <RadioButton Classes="seg" GroupName="vbg" Content="White (paper)" IsChecked="{Binding ViewIsLight}" Click="OnViewBgLight" />
                        </UniformGrid>
                      </Border>
                    </StackPanel>
                    <CheckBox Classes="toggle" Content="Outlines" IsChecked="{Binding Outlines}" />
                    <CheckBox Classes="toggle" Content="Depth cue" IsChecked="{Binding DepthCue}" />
                    <CheckBox Classes="toggle" Content="Cell edges" IsChecked="{Binding ShowCell}" />
                    <CheckBox Classes="toggle" Content="Wrap atoms into the cell" IsChecked="{Binding Wrap}" />
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="KEYBOARD &amp; READER" Classes="h3" />
                    <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                      <TextBlock Text="↑ ↓" Classes="mono" FontSize="12" /><TextBlock Grid.Column="1" Text="previous / next atom in molecule" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="1" Text="[ ]" Classes="mono" FontSize="12" /><TextBlock Grid.Row="1" Grid.Column="1" Text="previous / next molecule" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="2" Text="B" Classes="mono" FontSize="12" /><TextBlock Grid.Row="2" Grid.Column="1" Text="step along bonds" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="3" Text="Space" Classes="mono" FontSize="12" /><TextBlock Grid.Row="3" Grid.Column="1" Text="select focused atom" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="4" Text="M" Classes="mono" FontSize="12" /><TextBlock Grid.Row="4" Grid.Column="1" Text="measure to last selected" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="5" Text="← →" Classes="mono" FontSize="12" /><TextBlock Grid.Row="5" Grid.Column="1" Text="previous / next frame" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="6" Text="{Binding KeyAnnounce}" Classes="mono" FontSize="12" /><TextBlock Grid.Row="6" Grid.Column="1" Text="announce selection" FontSize="12" Foreground="{DynamicResource MutedB}" />
                      <TextBlock Grid.Row="7" Text="Esc" Classes="mono" FontSize="12" /><TextBlock Grid.Row="7" Grid.Column="1" Text="leave the walk" FontSize="12" Foreground="{DynamicResource MutedB}" />
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Verbosity" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Verbosities}" SelectedIndex="{Binding ReaderVerbosity}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <CheckBox Classes="toggle" Content="Announce frame changes" IsChecked="{Binding AnnounceFrames}" />
                    <CheckBox Classes="toggle" Content="Show announcements in the view" IsChecked="{Binding ShowAnnouncement}" />
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Text="EXPORT FIGURE" Classes="h3" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="Background" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.Backgrounds}" SelectedIndex="{Binding ExportBackground}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Size" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.SizePresets}" SelectedIndex="{Binding SizePreset}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Click="OnExportPng">
                        <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="download" Size="16" VerticalAlignment="Center" /><TextBlock Text="Export PNG…" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                      <Button Content="Export SVG…" Click="OnExportSvg" />
                    </StackPanel>
                    <Button Classes="small" Click="OnExportDialog" HorizontalAlignment="Left" ToolTip.Tip="4K, journal and poster sizes, 16-bit PNG, provenance in the file; movies of the frames or a turntable (⌘E)">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="download" Size="13" VerticalAlignment="Center" /><TextBlock Text="Image or movie…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnProjectPage" HorizontalAlignment="Left" ToolTip.Tip="This folder's structures, their status and a methods section from provenance">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="folder" Size="13" VerticalAlignment="Center" /><TextBlock Text="Project home…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnProvenancePage" HorizontalAlignment="Left" ToolTip.Tip="Every step that produced this structure: parameters, seeds, citations, approximations; BibTeX">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="history" Size="13" VerticalAlignment="Center" /><TextBlock Text="Provenance…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnViewportsPage" HorizontalAlignment="Left" ToolTip.Tip="Top, front, left and perspective views together">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="cube" Size="13" VerticalAlignment="Center" /><TextBlock Text="Four views…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnRenderPage" HorizontalAlignment="Left" ToolTip.Tip="Output frame, ambient occlusion, overlays, image sequences">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="eye" Size="13" VerticalAlignment="Center" /><TextBlock Text="Render…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small" Click="OnFigurePage" HorizontalAlignment="Left" ToolTip.Tip="Journal and slide sizes, backgrounds side by side, title, scale bar and legend">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="sliders" Size="13" VerticalAlignment="Center" /><TextBlock Text="Figure page…" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Transparent keeps an alpha channel in PNG and writes no background shape in SVG. Same camera as the view." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="File">
            <ScrollViewer>
              <StackPanel>
                <Border Classes="section">
                  <StackPanel Spacing="6">
                    <TextBlock Text="FILE" Classes="h3" />
                    <WrapPanel IsEnabled="{Binding Idle}" Margin="0,2,0,6">
                      <Button Classes="small" Margin="0,0,6,6" Click="OnSaveData" ToolTip.Tip="LAMMPS data with the force field when every atom is typed (⌘S)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="save" Size="14" VerticalAlignment="Center" /><TextBlock Text="LAMMPS data…" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                      <Button Classes="small" Margin="0,0,6,6" Content="PDB…" Click="OnSavePdb" />
                      <Button Classes="small" Margin="0,0,6,6" Content="XYZ…" Click="OnSaveXyz" />
                      <Button Classes="small" Margin="0,0,6,6" Content="Materials Studio…" Click="OnSaveCar" ToolTip.Tip=".car with its .mdf: the force-field types and charges, bonds across the cell" />
                      <Button Classes="small" Margin="0,0,6,6" Content="Trajectory…" Click="OnSaveTrajectory" IsVisible="{Binding HasFrames}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding SummaryRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:Row">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Key}" Classes="muted" FontSize="12.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <ScrollViewer IsVisible="{Binding !IsStudio}">
          <StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- Visualize: the selected step's editor -->
        <DockPanel IsVisible="{Binding IsVisualize}" Background="{DynamicResource Bg1B}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding HasPipeSelected}"><TextBlock Text="{Binding PipeStepNumber}" Foreground="{DynamicResource MutedB}" /></Border>
              <TextBlock Text="{Binding PipeStepTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="18,10,18,14" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" IsVisible="{Binding HasPipeSelected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="small" Click="OnStepUp" ToolTip.Tip="Move up (runs later)"><local:Icon Kind="chev" Size="13" RenderTransform="rotate(180deg)" /></Button>
              <Button Classes="small" Click="OnStepDown" ToolTip.Tip="Move down (runs earlier)"><local:Icon Kind="chev" Size="13" /></Button>
              <Button Classes="small" Content="Remove step" Click="OnStepRemove" />
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section" IsVisible="{Binding HasPipeSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SETTINGS" Classes="h3" />
                  <TextBlock Text="No settings: the step runs as it is." Classes="dim" IsVisible="{Binding !StepFields.Count}" />
                  <ItemsControl ItemsSource="{Binding StepFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StepField">
                        <StackPanel Spacing="4" Margin="0,0,0,10">
                          <TextBlock Text="{Binding Label}" Classes="label" IsVisible="{Binding !IsBool}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding IsText}">
                            <TextBox Text="{Binding Text}" Classes.mono="{Binding IsMono}" Watermark="{Binding Hint}" AcceptsReturn="False" />
                            <Button Grid.Column="1" Classes="small" Content="Choose…" IsVisible="{Binding IsFile}" Click="OnStepFile" Tag="{Binding}" />
                          </Grid>
                          <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                          <CheckBox Classes="toggle" Content="{Binding Label}" IsChecked="{Binding On}" IsVisible="{Binding IsBool}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding PipeIsExpression}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="small ghost" Content="Save this one" Click="OnSaveExpression" />
                    <TextBlock Text="SAVED EXPRESSIONS" Classes="h3" VerticalAlignment="Center" ToolTip.Tip="Counts on this frame" />
                  </DockPanel>
                  <TextBlock Text="{Binding ExprMeaning}" FontSize="12" Foreground="{DynamicResource AccB}" IsVisible="{Binding ExprMeaning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ItemsControl ItemsSource="{Binding SavedExpressions}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ExpressionRow">
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,5" Click="OnUseExpression" Tag="{Binding Expression}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Classes="mono" /><TextBlock Text="{Binding Expression}" Classes="mono" FontSize="11.5" TextTrimming="CharacterEllipsis" /></DockPanel>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" Text="Position.X · .Y · .Z, Type, Element, Charge, MoleculeIdentifier, Monomer, ParticleIdentifier, Selection, any imported column. Operators: == != &lt; &gt; &amp;&amp; || ! and math functions; vectors with norm(…) and dot(…). Re-evaluated on every frame." />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding PipeCanMakeReal}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MAKE REAL" Classes="h3" />
                  <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" Text="Replicas and deletions are views in the pipeline until you choose Make real, which opens a new document with unique atom and molecule IDs. The file is not changed." />
                  <Button Content="Make real" Click="OnMakeReal" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding HasPipeSelected}">
                <StackPanel Spacing="6">
                  <TextBlock Text="RESULT" Classes="h3" />
                  <TextBlock Text="{Binding PipeSelected.Summary}" FontSize="12.5" TextWrapping="Wrap" Foreground="{Binding PipeSelected.SummaryBrush}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="PIPELINE AT THIS FRAME" Classes="h3" />
                  <TextBlock Text="{Binding PipelineAtFrameText}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="PLAYBACK" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Every (frames)" Classes="label" /><NumericUpDown Value="{Binding PlaybackEvery}" Minimum="1" Maximum="10000" Increment="1" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Frames per second" Classes="label" /><NumericUpDown Value="{Binding PlaybackFps}" Minimum="1" Maximum="60" Increment="1" FormatString="0" /></StackPanel>
                  </Grid>
                  <CheckBox Classes="toggle" Content="Loop" IsChecked="{Binding PlaybackLoop}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="MARKERS" Classes="h3" />
                  <ComboBox ItemsSource="{Binding TimelineAttributes}" SelectedItem="{Binding MarkerAttribute}" HorizontalAlignment="Stretch" ToolTip.Tip="A marker wherever this attribute changes" />
                  <TextBlock Text="{Binding MarkerNote}" Classes="dim" FontSize="11.5" TextWrapping="Wrap" />
                  <CheckBox Classes="toggle" Content="Show on the timeline" IsChecked="{Binding ShowMarkers}" />
                </StackPanel>
              </Border>
              <Border Classes="section" IsVisible="{Binding !HasPipeSelected}">
                <StackPanel Spacing="8">
                  <TextBlock Text="DATA SOURCE" Classes="h3" />
                  <TextBlock Text="{Binding PipeSourceTitle}" FontSize="12.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PipeSourceDetail}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="18"
                             Text="Steps never change the file. They run on every frame you show, bottom to top; each reads what the steps below it made. Pick a step to edit it, or add one with +." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Render (design/boards/RenderOverlays) -->
        <DockPanel IsVisible="{Binding IsRender}" Background="{DynamicResource Bg1B}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="small" Content="Back" Click="OnRenderBack" VerticalAlignment="Center" />
              <TextBlock Text="Render" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding RenderProgress}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource AccB}" IsVisible="{Binding Rendering}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Click="OnRenderImage" IsEnabled="{Binding RenderIdle}">
                  <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="eye" Size="14" VerticalAlignment="Center" /><TextBlock Text="Render image" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Content="Movie…" Click="OnRenderMovie" IsEnabled="{Binding RenderIdle}" ToolTip.Tip="Every chosen frame as a numbered PNG in a folder" />
                <Button Content="Stop" Click="OnRenderStop" IsVisible="{Binding Rendering}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer>
            <StackPanel>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="OUTPUT" Classes="h3" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Width (px)" Classes="label" /><NumericUpDown Value="{Binding RenderW}" Minimum="64" Maximum="8192" Increment="16" FormatString="0" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Height (px)" Classes="label" /><NumericUpDown Value="{Binding RenderH}" Minimum="64" Maximum="8192" Increment="16" FormatString="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Renderer" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="CAPS · CPU ray cast" Classes="mono" FontSize="12" /></Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Background" Classes="label" />
                    <Border Classes="seg">
                      <UniformGrid Columns="3">
                        <RadioButton Classes="seg" GroupName="rbg" Content="Dark" IsChecked="{Binding RenderBgDark}" />
                        <RadioButton Classes="seg" GroupName="rbg" Content="White" IsChecked="{Binding RenderBgWhite}" />
                        <RadioButton Classes="seg" GroupName="rbg" Content="Transparent" IsChecked="{Binding RenderBgTransparent}" />
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="10">
                  <TextBlock Text="QUALITY" Classes="h3" />
                  <CheckBox Classes="toggle" Content="Ambient occlusion" IsChecked="{Binding RenderAo}" />
                  <CheckBox Classes="toggle" Content="Depth cue (fog)" IsChecked="{Binding RenderDepth}" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4"><TextBlock Text="Antialias" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.RenderAntialias}" SelectedIndex="{Binding RenderAa}" HorizontalAlignment="Stretch" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Frames" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:MainViewModel.RenderFrameChoices}" SelectedIndex="{Binding RenderFrames}" HorizontalAlignment="Stretch" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="4">
                  <TextBlock Text="OVERLAYS" Classes="h3" Margin="0,0,0,6" />
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvLabel}" />
                        <StackPanel><TextBlock Text="Text label" FontSize="12" /><TextBlock Text="{Binding OvLabelNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" /></StackPanel>
                      </DockPanel>
                      <TextBox Text="{Binding OvText}" Classes="mono" FontSize="11.5" IsVisible="{Binding OvLabel}" />
                      <TextBox Text="{Binding OvSub}" Classes="mono" FontSize="11.5" IsVisible="{Binding OvLabel}" />
                      <TextBlock Text="{x:Static vm:MainViewModel.RenderTokens}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" IsVisible="{Binding OvLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvLegend}" />
                      <StackPanel><TextBlock Text="Colour legend" FontSize="12" /><TextBlock Text="{Binding OvLegendNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvBar}" />
                      <StackPanel><TextBlock Text="Scale bar" FontSize="12" /><TextBlock Text="{Binding OvBarNote}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Padding="0,5" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Classes="toggle" IsChecked="{Binding OvTripod}" />
                      <StackPanel><TextBlock Text="Axis tripod" FontSize="12" /><TextBlock Text="bottom right · follows the camera" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" /></StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <!-- Opening a large trajectory (design/boards/VisLoading): the stages, then the inspector again -->
        <DockPanel Background="{DynamicResource Bg1B}" IsVisible="{Binding ShowLoadPanel}">
          <Border DockPanel.Dock="Top" Height="48" Padding="18,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding LoadStep}" Foreground="{DynamicResource AccB}" /></Border>
              <TextBlock Text="{Binding LoadTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,16" Spacing="8">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="File size" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="{Binding LoadSize}" Classes="mono" FontSize="12.5" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Time left" Classes="muted" FontSize="12.5" /><TextBlock Grid.Column="1" Text="{Binding LoadTimeLeft}" Classes="mono" FontSize="12.5" /></Grid>
            <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                       Text="Frame 0 is already usable: orbit, pick and measure work while the other frames are read. Cancel keeps the frames read so far." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Cancel" Click="OnLoadCancel" />
              <Button Click="OnLoadBackground">
                <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="jobs" Size="14" VerticalAlignment="Center" /><TextBlock Text="Open in background" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LoadStages}" Margin="18,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LoadStage">
                  <Border Padding="0,10" BorderBrush="{DynamicResource Bg2B}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <local:Icon Kind="{Binding Icon}" Size="15" Foreground="{Binding Colour}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding State}" Classes="mono" FontSize="11" Foreground="{Binding Colour}" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" Margin="25,0,0,0" TextWrapping="Wrap" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Margin="25,0,0,0" Height="6" MinHeight="6" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- Field: typing report (design/boards/ForceField). Covers the viewport and the inspector; its own view shows the types. -->
      <!-- React (design/boards/React.dc.html) -->
      <!-- Polymer builder (design/boards/PolymerBuilder) -->
      <pages:PolymerPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsPolymer}" />
      <!-- Surface & interface builder (design/boards/SurfaceBuilder) -->
      <pages:SurfacePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSurface}" />
      <!-- Analyze focus pages (design/boards/Mechanics, Scattering, FreeVolume) -->
      <pages:MechanicsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsMechanics}" />
      <pages:ScatteringPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsScattering}" />
      <pages:FreeVolumePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsFreeVolume}" />
      <!-- Reaction template editor (design/boards/ReactionTemplate) -->
      <pages:TemplatePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsTemplate}" />
      <pages:ColourVisionPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsColourVision}" />
      <pages:GlassPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsGlass}" />
      <pages:InterfacePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsInterfacePage}" />
      <pages:DiffusionPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsDiffusion}" />
      <pages:ChargesPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCharges}" />
      <pages:PeriodicPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsPeriodic}" />
      <pages:OrientationPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsOrientation}" />
      <pages:RecipesPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsRecipes}" />
      <pages:ComposerPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsComposer}" />
      <pages:ChainStatsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsChainStats}" />
      <pages:DensityCalcPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsDensityCalc}" />
      <pages:SurfaceAreaPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSurfaceArea}" />
      <pages:CellEditorPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCellEditor}" />
      <pages:PolydispersityPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsPolydispersity}" />
      <pages:CopolymerPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCopolymer}" />
      <pages:SolventScreenPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSolventScreen}" />
      <pages:TacticityPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsTacticityStats}" />
      <pages:BlendPhasePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBlendPhase}" />
      <pages:ElectrostaticsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsElectrostatics}" />
      <pages:DisplayStylesPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsDisplayStyles}" />
      <pages:AddHydrogensPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsAddHydrogens}" />
      <pages:ModelResolutionPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsModelResolution}" />
      <!-- Coarse-grained melts (design/boards/CoarseGrained) -->
      <pages:CgPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCg}" />
      <!-- Parameter sweep (design/boards/ParameterSweep) -->
      <pages:SweepPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSweep}" />
      <!-- Project home (design/boards/ProjectHome) -->
      <pages:ProjectPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsProject}" />
      <!-- Theory manual (design/boards/TheoryManual) -->
      <pages:ManualPageView Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsManual}" />
      <!-- Provenance (design/boards/Provenance) -->
      <pages:ProvenancePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsProvenance}" />
      <!-- Macro recorder (design/boards/MacroRecorder) -->
      <pages:MacroPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsMacro}" />
      <!-- Fragment library (design/boards/FragmentLibrary) -->
      <pages:FragmentPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsFragments}" />
      <!-- Split view (design/boards/LightSplit) -->
      <pages:SplitPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSplit}" />
      <!-- Torsion scan (design/boards/TorsionScan) -->
      <pages:TorsionPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsTorsion}" />
      <!-- Trajectory player (design/boards/Trajectory) -->
      <pages:TrajectoryPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsTrajectory}" />
      <!-- Solvation builder (design/boards/SolvationBuilder) -->
      <pages:SolvationPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSolvation}" />
      <!-- Biomolecule builder (design/boards/BioBuilder) -->
      <pages:BioPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBio}" />
      <!-- Crystal builder (design/boards/CrystalBuilder) -->
      <pages:CrystalPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCrystal}" />
      <!-- Nanostructure builder (design/boards/NanoBuilder, Nanoparticle) -->
      <pages:NanoPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsNano}" />
      <!-- Blend builder (design/boards/BlendBuilder) -->
      <pages:BlendPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBlend}" />
      <!-- Export image / movie (design/boards/ExportDialog) -->
      <pages:ExportDialog x:Name="ExportDlg" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" ZIndex="21" IsVisible="{Binding ExportDialogOpen}" />
      <!-- Update available (design/boards/UpdateDialog) -->
      <pages:UpdateDialog Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" ZIndex="22" IsVisible="{Binding UpdateOpen}" />
      <!-- Import (design/boards/ImportDialog): files without a topology -->
      <pages:ImportDialog Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" ZIndex="21" IsVisible="{Binding ImportOpen}" />
      <!-- Element picker (design/boards/ElementPicker): the periodic table, the element for new atoms -->
      <Panel Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" ZIndex="20" IsVisible="{Binding ElementPickerOpen}">
        <Border Background="#B307080A" PointerPressed="OnPickerBackdrop" />
        <Border Width="1120" Height="640" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineB}" Background="{DynamicResource Bg1B}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="52" Padding="20,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tool" Click="OnPickerClose" ToolTip.Tip="Close (Esc)"><local:Icon Kind="close" Size="16" /></Button>
                <TextBlock DockPanel.Dock="Right" Text="type a symbol to jump · ⇧E opens this" FontSize="12" Foreground="{DynamicResource DimB}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Element" Classes="h2" VerticalAlignment="Center" />
                  <Border Classes="chip"><TextBlock Text="stripe = element colour · bright = common in polymers" Foreground="{DynamicResource MutedB}" /></Border>
                  <TextBox x:Name="PickerSearch" Width="80" Watermark="Symbol" FontSize="12" KeyUp="OnPickerType" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnPickerReplace"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="rotate" Size="15" VerticalAlignment="Center" /><TextBlock Text="Replace selected atom" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Classes="primary" Click="OnPickerPlace"><StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="atom" Size="15" VerticalAlignment="Center" /><TextBlock Text="{Binding PickerPlaceText}" VerticalAlignment="Center" /></StackPanel></Button>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,*" Margin="20">
              <ItemsControl ItemsSource="{Binding PeriodicTable}" Width="738" Height="420" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter" x:DataType="vm:PeriodicCell">
                    <Setter Property="Canvas.Left" Value="{Binding X}" /><Setter Property="Canvas.Top" Value="{Binding Y}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PeriodicCell">
                    <Button Width="38" Height="38" MinHeight="38" Padding="0" CornerRadius="5" Click="OnPickerCell" Tag="{Binding Symbol}" ToolTip.Tip="{Binding Tip}"
                            Classes.common="{Binding Common}" Classes="pt" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                      <Panel>
                        <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="{Binding Colour}" />
                        <TextBlock Text="{Binding ZText}" FontFamily="{DynamicResource Mono}" FontSize="8" Opacity="0.75" Margin="6,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Symbol}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Column="1" Padding="20,0,0,0" Margin="24,0,0,0" BorderBrush="{DynamicResource LineB}" BorderThickness="1,0,0,0">
                <StackPanel Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource AccB}">
                      <TextBlock Text="{Binding PickerSymbol}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccInkB}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PickerName}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PickerLine}" Classes="mono" FontSize="12" Foreground="{DynamicResource MutedB}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="ISOTOPES" Classes="h3" />
                    <TextBlock Text="{Binding PickerIsotopes}" FontSize="11.5" Foreground="{DynamicResource DimB}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="FORMAL CHARGE" Classes="h3" />
                    <Border Classes="seg" HorizontalAlignment="Stretch">
                      <UniformGrid Columns="4">
                        <RadioButton Classes="seg" Content="−1" GroupName="pcharge" IsChecked="{Binding BuildCharge, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" />
                        <RadioButton Classes="seg" Content="0" GroupName="pcharge" IsChecked="{Binding BuildCharge, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" />
                        <RadioButton Classes="seg" Content="+1" GroupName="pcharge" IsChecked="{Binding BuildCharge, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=2}" HorizontalAlignment="Stretch" />
                        <RadioButton Classes="seg" Content="+2" GroupName="pcharge" IsChecked="{Binding BuildCharge, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=3}" HorizontalAlignment="Stretch" />
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="8">
                    <TextBlock Text="GEOMETRY ON PLACEMENT" Classes="h3" />
                    <Border Classes="seg" HorizontalAlignment="Stretch">
                      <UniformGrid Columns="4">
                        <RadioButton Classes="seg" Content="auto" GroupName="pgeo" IsChecked="{Binding BuildGeometry, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=0}" HorizontalAlignment="Stretch" ToolTip.Tip="From the parent's bonds" />
                        <RadioButton Classes="seg" Content="sp³" GroupName="pgeo" IsChecked="{Binding BuildGeometry, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=1}" HorizontalAlignment="Stretch" />
                        <RadioButton Classes="seg" Content="sp²" GroupName="pgeo" IsChecked="{Binding BuildGeometry, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=2}" HorizontalAlignment="Stretch" />
                        <RadioButton Classes="seg" Content="sp" GroupName="pgeo" IsChecked="{Binding BuildGeometry, Converter={x:Static local:IntEqualsConverter.Instance}, ConverterParameter=3}" HorizontalAlignment="Stretch" />
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding PickerRadius}" Classes="mono" FontSize="12" Foreground="{DynamicResource MutedB}" />
                  <TextBlock Classes="dim" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Text="Radii: Cordero et al., Dalton Trans. 2832 (2008); Bondi, J. Phys. Chem. 68, 441 (1964)" />
                </StackPanel>
              </Border>
            </Grid>
          </DockPanel>
        </Border>
      </Panel>
      <!-- Add pipeline step (design/boards/PipelineSteps) -->
      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding StepLibraryOpen}" ZIndex="2">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="22,10" Background="{DynamicResource Bg1B}" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Width="320" Watermark="Search steps" Text="{Binding StepSearch}" />
                <Button Content="Close" Click="OnCloseStepLibrary" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="Add pipeline step" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Each step is also a command: the same JSON runs with caps pipeline FILE --steps" FontSize="12.5" Foreground="{DynamicResource MutedB}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer Padding="22,14">
            <ItemsControl ItemsSource="{Binding StepLibraryRows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepKind">
                  <Button Classes="tile" Margin="6" Padding="14,10" Click="OnPickStep" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <local:Icon Kind="{Binding Icon}" Size="18" Foreground="{DynamicResource AccB}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="{Binding About}" FontSize="11.5" Foreground="{DynamicResource MutedB}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Group}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Nothing open (design/boards/VisEmpty): Analyze before a trajectory is open -->
      <pages:EmptyPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding ShowEmpty}" ZIndex="1" />
      <!-- Studio › Viewports (design/boards/FourViewports) -->
      <pages:ViewportsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsViewports}" />
      <!-- Analyze › Visualize › Colour by (design/boards/ColourBy) -->
      <pages:ColourByPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsColourBy}" />
      <!-- Analyze › Compare (design/boards/CompareCells) -->
      <pages:ComparePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsCompare}" />
      <!-- Analyze › Batch (design/boards/BatchRun) -->
      <pages:BatchPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBatch}" />
      <!-- Save pipeline (design/boards/SavePipeline) -->
      <pages:SavePipelinePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSavePipeline}" />
      <!-- Open file (design/boards/OpenLammps, OpenGromacs) -->
      <pages:OpenPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsOpenPreview}" ZIndex="3" />
      <!-- Export › Figure bundle (design/boards/FigureBundle) -->
      <pages:BundlePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBundle}" />
      <!-- Export › Data (design/boards/ExportData) -->
      <pages:ExportPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsExport}" />
      <pages:ExportCenterPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsExportCenter}" />
      <!-- Export › Figure (design/boards/FigureBackground) -->
      <pages:FigurePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsFigure}" />
      <!-- File checks (design/boards/VisProblems) -->
      <pages:ChecksPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsChecks}" />
      <!-- Bench (design/boards/Bench) -->
      <pages:BenchPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsBench}" />
      <!-- Jobs (design/boards/Jobs, FailedJob) -->
      <pages:JobsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsJobs}" />
      <!-- Settings (design/boards/Settings) -->
      <pages:SettingsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsSettings}" />
      <!-- Molecule (design/boards/Sketch): sketch or SMILES to 3D -->
      <pages:MoleculePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding IsMolecule}" />
      <!-- Start (design/boards/Start): the Studio with nothing open -->
      <pages:StartPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
        <pages:StartPage.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="NoDocument" />
            <Binding Path="IsStudio" />
          </MultiBinding>
        </pages:StartPage.IsVisible>
      </pages:StartPage>
      <pages:ReactPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsReact}" />

      <!-- Equilibrate (design/boards/Convergence.dc.html) -->
      <pages:EquilibratePage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsEquilibrate}" />

      <!-- Dynamics (design/boards/Dynamics.dc.html) -->
      <pages:DynamicsPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsDynamics}" />

      <!-- Relax (design/boards/Relax.dc.html) -->
      <pages:RelaxPage Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsRelax}" />

      <!-- Pack (design/boards/Pack.dc.html) -->
      <pages:PackPage x:Name="PackPageView" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsPack}" />

      <!-- Grow (design/boards/Grow.dc.html) -->
      <pages:GrowPage x:Name="GrowPageView" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsGrow}" />

      <!-- Analyze › Properties: calculations over the frames, results compared with experiment -->
      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsAnalyze}">
        <Border.Styles>
          <Style Selector="ToggleButton.chip">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
          </Style>
          <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccB}" />
            <Setter Property="Foreground" Value="{DynamicResource AccInkB}" />
          </Style>
          <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
          </Style>
        </Border.Styles>
        <Grid RowDefinitions="Auto,*,Auto" Margin="22,16,22,0">
          <!-- header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock FontSize="20" FontWeight="SemiBold">
                <Run Text="Analyze · " /><Run Text="{Binding Analyze.SourceText}" />
              </TextBlock>
              <TextBlock Classes="muted" Text="Properties with their uncertainty and method, compared against experiment, ready for the paper tables" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <StackPanel Spacing="3">
                <TextBlock Text="Compare with" Classes="dim" />
                <ComboBox Width="220" ItemsSource="{Binding Analyze.References}" SelectedIndex="{Binding Analyze.RefIndex}" />
              </StackPanel>
              <Button Click="OnOpenVisualize" VerticalAlignment="Bottom" ToolTip.Tip="Pipeline of selection, colouring and measuring steps, with the data inspector">
                <StackPanel Orientation="Horizontal" Spacing="7"><local:Icon Kind="eye" Size="14" VerticalAlignment="Center" /><TextBlock Text="Visualize" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Content="Export CSV / LaTeX…" Click="OnAnalyzeExport" IsEnabled="{Binding Analyze.HasResults}" VerticalAlignment="Bottom" />
              <Button Classes="primary" Content="Run selected" Click="OnAnalyzeRun" IsVisible="{Binding Analyze.NotWorking}" VerticalAlignment="Bottom">
                <Button.IsEnabled>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasDocument" />
                    <Binding Path="Idle" />
                  </MultiBinding>
                </Button.IsEnabled>
              </Button>
              <Button Content="Cancel" Click="OnAnalyzeCancel" IsVisible="{Binding Analyze.Working}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,14,0,12">
            <!-- calculations and source -->
            <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
              <ScrollViewer>
                <StackPanel Margin="16,12" Spacing="10" IsEnabled="{Binding Analyze.NotWorking}">
                  <TextBlock Text="CALCULATIONS" Classes="h3" />
                  <ItemsControl ItemsSource="{Binding Analyze.Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalcGroup">
                        <StackPanel Spacing="5" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Name}" Classes="dim" />
                          <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CalcChip">
                                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn}" IsEnabled="{Binding Available}" ToolTip.Tip="{Binding Tip}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="SOURCE" Classes="h3" Margin="0,6,0,0" />
                  <TextBlock Text="Trajectory" Classes="dim" />
                  <TextBlock Text="{Binding Analyze.SourceText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Analyze.FramesText}" Classes="mono" FontSize="11" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                    <Grid.Styles><Style Selector="NumericUpDown"><Setter Property="ShowButtonSpinner" Value="False" /></Style></Grid.Styles>
                    <TextBlock Text="First frame" Classes="dim" /><TextBlock Grid.Column="1" Text="Last (−1: end)" Classes="dim" /><TextBlock Grid.Column="2" Text="Every" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FirstD}" Minimum="0" Increment="1" FormatString="0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.LastD}" Minimum="-1" Increment="1" FormatString="0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Analyze.StrideD}" Minimum="1" Increment="1" FormatString="0" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                    <TextBlock Text="ps per frame (0: file)" Classes="dim" /><TextBlock Grid.Column="1" Text="MD step (fs)" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FramePsD}" Minimum="0" Increment="0.5" FormatString="0.###" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TimestepFsD}" Minimum="0.01" Increment="0.5" FormatString="0.##" />
                  </Grid>

                  <TextBlock Text="GROUPS" Classes="h3" Margin="0,6,0,0" />
                  <TextBlock Text="g(r) pair" Classes="dim" />
                  <ComboBox ItemsSource="{x:Static vm:AnalyzeViewModel.Pairs}" SelectedIndex="{Binding Analyze.PairIndex}" HorizontalAlignment="Stretch" />
                  <CheckBox Content="Only between molecules" IsChecked="{Binding Analyze.InterOnly}" />

                  <TextBlock Text="SETTINGS" Classes="h3" Margin="0,6,0,0" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Probe radius (Å)" Classes="dim" /><TextBlock Grid.Column="1" Text="Grid (Å)" Classes="dim" />
                    <NumericUpDown Grid.Row="1" Value="{Binding Analyze.ProbeD}" Minimum="0" Increment="0.1" FormatString="0.00" ToolTip.Tip="0: points outside every van der Waals sphere; He 1.28 Å, N₂ 1.82 Å" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.GridD}" Minimum="0.1" Maximum="2" Increment="0.1" FormatString="0.00" />
                    <TextBlock Grid.Row="2" Text="Fit MSD from" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="to (fraction of run)" Classes="dim" Margin="0,4,0,0" />
                    <NumericUpDown Grid.Row="3" Value="{Binding Analyze.FitFromD}" Minimum="0" Maximum="0.95" Increment="0.05" FormatString="0.00" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.FitToD}" Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" />
                  </Grid>
                  <!-- protocols: shown when switched on -->
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.TgChip.IsOn}">
                    <TextBlock Text="COOLING PROTOCOL (Tg)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="From (K)" Classes="dim" /><TextBlock Grid.Column="1" Text="To (K)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.TgFromD}" Minimum="10" Maximum="2000" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TgToD}" Minimum="10" Maximum="2000" Increment="10" FormatString="0" />
                      <TextBlock Grid.Row="2" Text="Step (K)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="NPT per step (ps)" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.TgStepD}" Minimum="1" Increment="5" FormatString="0" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.TgPsD}" Minimum="1" Increment="50" FormatString="0" />
                    </Grid>
                    <TextBlock Text="Equilibrate at the start temperature first (ps)" Classes="dim" />
                    <NumericUpDown Value="{Binding Analyze.EqPsD}" Minimum="0" Increment="10" FormatString="0" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Fit: two lines, free hinge, bootstrap error. Runs on a copy of the current frame; simulated cooling rates are 10⁹–10¹¹ K/s, so Tg comes out above experiment." />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.TensileChip.IsOn}">
                    <TextBlock Text="DEFORMATION (stress–strain)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="Axis" Classes="dim" /><TextBlock Grid.Column="1" Text="Temperature (K)" Classes="dim" />
                      <ComboBox Grid.Row="1" ItemsSource="{x:Static vm:AnalyzeViewModel.Axes}" SelectedIndex="{Binding Analyze.TensAxis}" HorizontalAlignment="Stretch" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.TensTD}" Minimum="1" Increment="10" FormatString="0" />
                      <TextBlock Grid.Row="2" Text="Rate (1/ps)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Final strain" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.TensRateD}" Minimum="0.000001" Increment="0.0005" FormatString="0.######" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.TensMaxD}" Minimum="0.005" Maximum="2" Increment="0.05" FormatString="0.###" />
                    </Grid>
                    <TextBlock Text="{Binding Analyze.TensRateText}" Classes="mono" FontSize="11" />
                    <TextBlock Text="NPT first (ps)" Classes="dim" />
                    <NumericUpDown Value="{Binding Analyze.EqPsD}" Minimum="0" Increment="10" FormatString="0" />
                    <CheckBox Content="Lateral faces fixed (uniaxial strain)" IsChecked="{Binding Analyze.TensFixed}" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.PullOn}">
                    <TextBlock Text="PULL TEST (interface)" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Text="Distance (Å)" Classes="dim" /><TextBlock Grid.Column="1" Text="Rate (Å/ps)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.PullDistD}" Minimum="0.5" Maximum="200" Increment="1" FormatString="0.0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.PullRateD}" Minimum="0.01" Maximum="100" Increment="0.5" FormatString="0.##" />
                      <TextBlock Grid.Row="2" Text="Temperature (K)" Classes="dim" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="NVT first (ps)" Classes="dim" Margin="0,4,0,0" />
                      <NumericUpDown Grid.Row="3" Value="{Binding Analyze.PullTD}" Minimum="1" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Analyze.PullEqD}" Minimum="0" Increment="1" FormatString="0.#" />
                    </Grid>
                    <TextBlock Text="Shear axis" Classes="dim" />
                    <ComboBox ItemsSource="{x:Static vm:AnalyzeViewModel.PullAxes}" SelectedIndex="{Binding Analyze.PullAxis}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="The surface (molecule 1) is held; a spring (10 kcal/mol/Å²) drags the film's centre. Steered-MD forces grow with the rate: compare systems at one rate." />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.StrainChip.IsOn}">
                    <TextBlock Text="STATIC ELASTIC CONSTANTS" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="Strain ±" Classes="dim" /><TextBlock Grid.Column="1" Text="Configurations" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.CijStrainD}" Minimum="0.000001" Maximum="0.01" Increment="0.0001" FormatString="0.######" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.CijConfigsD}" Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding Analyze.FluctChip.IsOn}">
                    <TextBlock Text="STRESS FLUCTUATIONS" Classes="h3" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto">
                      <TextBlock Text="NVT temperature (K)" Classes="dim" /><TextBlock Grid.Column="1" Text="Sampled (ps)" Classes="dim" />
                      <NumericUpDown Grid.Row="1" Value="{Binding Analyze.FluctTD}" Minimum="1" Increment="10" FormatString="0" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Analyze.FluctPsD}" Minimum="1" Increment="50" FormatString="0" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Bonded systems converge slowly: the fluctuation term cancels most of the Born term. Check the block errors; the static method is cheaper." />
                  </StackPanel>
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             Text="Energies use the force field assigned in Field; without one, the built-in GAFF typing of C and H. Protocols (Tg, stress–strain, static Cij) run on a copy of the current frame. Grey calculations are not built yet." />
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- results -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,280" RowSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Analyze.Log}" Classes="muted" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding Analyze.Progress}" Minimum="0" Maximum="1" Height="4" IsVisible="{Binding Analyze.Working}" />
              </StackPanel>
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Analyze.Results}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultCard">
                      <Border Width="272" Margin="0,0,12,12" Padding="14,12" CornerRadius="10" BorderBrush="{DynamicResource LineB}" BorderThickness="1"
                              Background="{DynamicResource Bg1B}" ToolTip.Tip="{Binding Method}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Name}" Classes="dim" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="SemiBold" Classes="mono" />
                            <TextBlock Text="{Binding ErrorText}" Classes="mono" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding UnitText}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                          </StackPanel>
                          <StackPanel IsVisible="{Binding HasRef}" Spacing="1">
                            <TextBlock Text="{Binding RefText}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RefSource}" Classes="dim" FontSize="11" TextWrapping="Wrap" FontStyle="Italic" />
                            <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Text="{Binding ExtraText}" IsVisible="{Binding HasExtra}" Classes="mono" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedB}" />
                          <TextBlock Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarnB}" />
                          <TextBlock Text="{Binding Method}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Grid.Row="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}" Padding="14,10"
                      IsVisible="{Binding Analyze.HasResults}">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="CURVE" Classes="h3" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Analyze.Curves}" SelectedIndex="{Binding Analyze.CurveIndex}" MinWidth="320" HorizontalAlignment="Left" />
                  </Grid>
                  <local:LinePlot Grid.Row="1" x:Name="PropPlot" AutoRange="True" />
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <TextBlock Grid.Row="2" Classes="dim" Margin="0,0,0,10">
            <Run Text="{Binding Analyze.RunInfo}" /><Run Text=" · hover a card for its method · experiment ranges from data/reference/polymers.json" />
          </TextBlock>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource Bg0B}" IsVisible="{Binding IsField}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,16,22,0">
          <!-- header -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Force field · typing report" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="Explain every type, override with provenance, and block runs with missing parameters" />
              <local:StructurePicker Margin="0,8,0,0" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" IsEnabled="{Binding Field.NotWorking}">
              <StackPanel Spacing="3">
                <TextBlock Text="Force field" Classes="dim" />
                <ComboBox Width="300" ItemsSource="{Binding Field.Library}" SelectedIndex="{Binding Field.FfIndex}" ToolTip.Tip="{Binding Field.FfNote}" />
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Text="Charges" Classes="dim" />
                <ComboBox Width="170" ItemsSource="{x:Static vm:FieldViewModel.ChargeModes}" SelectedIndex="{Binding Field.ChargeMode}" />
              </StackPanel>
              <Button Classes="primary" Content="Assign · retype all" Click="OnFieldAssign" IsEnabled="{Binding HasDocument}" VerticalAlignment="Bottom" />
              <Button Content="Export ▾" VerticalAlignment="Bottom" IsEnabled="{Binding Field.Assigned}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="LAMMPS data with this force field…" Click="OnSaveData" />
                    <MenuItem Header="Types file (caps ff apply --types)…" Click="OnFieldSaveTypes" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Content="Clear" Click="OnFieldClear" IsEnabled="{Binding Field.Assigned}" VerticalAlignment="Bottom"
                      ToolTip.Tip="End the assignment and restore the file's own types and charges" />
            </StackPanel>
          </Grid>

          <!-- chips -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,12" IsVisible="{Binding Field.Assigned}">
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" /><TextBlock Text="{Binding Field.TypedText}" FontSize="11.5" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrB}" IsVisible="{Binding Field.HasUntyped}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" IsVisible="{Binding !Field.HasUntyped}" />
                <TextBlock Text="{Binding Field.UntypedText}" FontSize="11.5" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrB}" IsVisible="{Binding Field.HasMissing}" />
                <Ellipse Width="7" Height="7" Fill="{DynamicResource OkB}" IsVisible="{Binding !Field.HasMissing}" />
                <TextBlock Text="{Binding Field.MissingText}" FontSize="11.5" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" /><TextBlock Text="{Binding Field.EstimatedText}" FontSize="11.5" /></StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg2B}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccB}" IsVisible="{Binding Field.ChargeOdd}" />
                <TextBlock Text="{Binding Field.ChargeText}" Classes="mono" FontSize="11" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- body -->
          <Grid Grid.Row="2" ColumnDefinitions="*,440" ColumnSpacing="16" Margin="0,0,0,12">
            <!-- no structure / not assigned -->
            <Border Grid.ColumnSpan="2" IsVisible="{Binding !Field.Assigned}" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10"
                    Background="{DynamicResource Bg1B}" Margin="0,14,0,0" VerticalAlignment="Top">
              <StackPanel Spacing="10" Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Field.LibraryNote}" Classes="muted" />
                <TextBlock Text="Open or build a structure, choose a force field and assign it." FontSize="15" FontWeight="SemiBold" IsVisible="{Binding NoDocument}" />
                <TextBlock Text="{Binding Field.Log}" TextWrapping="Wrap" />
                <TextBlock Classes="dim" TextWrapping="Wrap"
                           Text="Typing works from the bonds alone (mol2, PDB with CONECT, xyz, LAMMPS data): CAPS perceives bond orders, charges, rings and aromaticity, then applies the force field's SMARTS rules. PCFF, CVFF, GAFF, GAFF2, OPLS-AA and CGenFF have rules; other force fields take the atom names in the file as types." />
              </StackPanel>
            </Border>

            <!-- atoms + why -->
            <Grid RowDefinitions="*,Auto" RowSpacing="12" IsVisible="{Binding Field.Assigned}">
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,11">
                    <TextBlock Text="Atoms" FontWeight="SemiBold" />
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,12,16,6">
                    <TextBox Text="{Binding Field.FilterText}" Watermark="Filter: type, element, atom (C12), rule text, charge" />
                    <Border Grid.Column="1" Classes="seg">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="ffilter" Content="All" IsChecked="{Binding Field.FilterAll}" />
                        <RadioButton Classes="seg" GroupName="ffilter" Content="Untyped" IsChecked="{Binding Field.FilterUntyped}" />
                        <RadioButton Classes="seg" GroupName="ffilter" Content="Overridden" IsChecked="{Binding Field.FilterOverridden}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Grid Grid.Row="2" ColumnDefinitions="70,44,74,90,*,190" Margin="28,6,16,4">
                    <TextBlock Text="ATOM" Classes="h3" /><TextBlock Grid.Column="1" Text="EL." Classes="h3" /><TextBlock Grid.Column="2" Text="TYPE" Classes="h3" />
                    <TextBlock Grid.Column="3" Text="Q (E)" Classes="h3" HorizontalAlignment="Right" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" Text="RULE (SMARTS)" Classes="h3" /><TextBlock Grid.Column="5" Text="SOURCE" Classes="h3" />
                  </Grid>
                  <ListBox Grid.Row="3" ItemsSource="{Binding Field.Rows}" SelectedItem="{Binding Field.SelectedRow}" Background="Transparent" Margin="12,0,12,4">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="16,2" />
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="CornerRadius" Value="5" />
                      </Style>
                      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Bg3B}" />
                      </Style>
                      <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource LineB}" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldAtomRow">
                        <Grid ColumnDefinitions="70,44,74,90,*,190" Height="18">
                          <TextBlock Text="{Binding Atom}" Classes="mono" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Element}" Classes="mono" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding TypeShown}" Classes="mono" Foreground="{Binding TypeBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Charge}" Classes="mono" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{Binding Rule}" Classes="mono" Foreground="{Binding RuleBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Rule}" />
                          <TextBlock Grid.Column="5" Text="{Binding Source}" Classes="mono" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Grid.Row="4" Text="{Binding Field.RowsNote}" Classes="dim" Margin="16,2,16,10" />
                </Grid>
              </Border>
              <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}">
                <StackPanel>
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,11">
                    <TextBlock Text="{Binding Field.WhyTitle}" FontWeight="SemiBold" />
                  </Border>
                  <StackPanel Margin="16,12" Spacing="10">
                    <TextBlock Text="{Binding Field.WhyText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Field.HasSelection}" IsEnabled="{Binding Field.NotWorking}">
                      <TextBlock Text="Set type by hand" Classes="dim" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding Field.OverrideTypes}" SelectedItem="{Binding Field.OverrideType}" MinWidth="120" />
                      <Button Content="Set" Click="OnFieldOverride" ToolTip.Tip="The atom keeps this type through retyping; it is listed as overridden" />
                      <Button Content="Back to the rule" Click="OnFieldResetOverride" IsVisible="{Binding Field.SelectedOverridden}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- types in 3D + missing -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12" IsVisible="{Binding Field.Assigned}">
              <Border BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Types in 3D" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Field.Swatches}" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FieldTypeSwatch">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,2,0,2" ToolTip.Tip="{Binding Description}">
                              <Ellipse Width="8" Height="8" Fill="{Binding Colour}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" Classes="mono" FontSize="11" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                  <Border Grid.Row="1" x:Name="FieldViewHost" Background="{DynamicResource Bg0B}" ClipToBounds="True" Focusable="True" MinHeight="240">
                    <Panel>
                      <Image x:Name="FieldImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <TextBlock Classes="dim" Margin="10" VerticalAlignment="Bottom" Text="Coloured by force-field type · click an atom to explain it · drag to rotate" />
                    </Panel>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Row="1" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg1B}" MaxHeight="430">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Border BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Missing before run" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="{DynamicResource ErrBgB}" IsVisible="{Binding Field.Incomplete}">
                        <TextBlock Text="Blocks Relax and Dynamics" Foreground="{DynamicResource ErrB}" FontSize="11" />
                      </Border>
                      <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="{DynamicResource OkBgB}" IsVisible="{Binding Field.Complete}">
                        <TextBlock Text="Ready to run" Foreground="{DynamicResource OkB}" FontSize="11" />
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Margin="16,10" Spacing="8" IsEnabled="{Binding Field.NotWorking}">
                    <!-- coverage: why this force field cannot describe the structure, and which ones can -->
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource WarnB}" Background="{DynamicResource WarnBgB}" Padding="12,10"
                            IsVisible="{Binding Field.ShowCoverage}">
                      <StackPanel Spacing="8">
                        <DockPanel>
                          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="40" Height="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding Field.CoverageBusy}" />
                          <TextBlock Text="{Binding Field.CoverageNote}" TextWrapping="Wrap" FontSize="12.5" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Field.UntypedGroups}" IsVisible="{Binding Field.HasUntypedGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UntypedGroupRow">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Text="{Binding Title}" Classes="mono" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="These atoms have no type in the assigned force field" />
                                <Button Grid.Column="1" Classes="small" Content="Select" Tag="{Binding}" Click="OnUntypedSelect" ToolTip.Tip="Select these atoms in the view" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Field.BalanceNote}" IsVisible="{Binding Field.HasBalanceNote}" Foreground="{DynamicResource ErrB}" TextWrapping="Wrap" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding Field.Alternatives}" IsVisible="{Binding Field.HasAlternatives}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoverageRow">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Detail}" Classes="dim" FontSize="11.5" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="small" Content="Use" Tag="{Binding Id}" Click="OnUseForceField" ToolTip.Tip="Assign this force field instead" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Button Classes="small" Content="Which force fields describe this structure?" Click="OnCheckCoverage" HorizontalAlignment="Left"
                            IsVisible="{Binding !Field.ShowCoverage}" ToolTip.Tip="Try every force field of the library on the open structure" />
                    <ListBox ItemsSource="{Binding Field.Missing}" SelectedItem="{Binding Field.SelectedMissing}" MaxHeight="170" Background="Transparent"
                             IsVisible="{Binding Field.Incomplete}">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0,2" /></Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
                        <Style Selector="ListBoxItem:selected Border.miss"><Setter Property="BorderBrush" Value="{DynamicResource AccB}" /></Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldMissingRow">
                          <Border Classes="miss" BorderBrush="{DynamicResource ErrB}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ErrBgB}" Padding="10,6">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Title}" Classes="mono" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Detail}" Classes="dim" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="CAPS never guesses parameters. Choose a source: import them from a published file, or enter them by hand; anything entered by hand is flagged estimated in the report and the output." />
                    <StackPanel Spacing="6" IsVisible="{Binding Field.CanEnterRule}">
                      <Grid ColumnDefinitions="Auto,*,Auto,110" ColumnSpacing="6">
                        <TextBlock Text="{Binding Field.EntryKind}" Classes="mono" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Field.EntryTypes}" ToolTip.Tip="Atom types (as the force field looks them up); * matches any" />
                        <TextBlock Grid.Column="2" Text="style" Classes="dim" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding Field.EntryStyle}" />
                      </Grid>
                      <TextBox Text="{Binding Field.EntryParams}" Watermark="{Binding Field.EntryHint}" />
                      <TextBlock Text="{Binding Field.EntryHint}" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Fill gaps from…" Click="OnFieldFill" ToolTip.Tip="Another force field's bonds, angles and torsions used only where this one defines none (OPLS-AA 2024's missing alkene torsions from OPLS 2005 …); every borrowed term is listed; impropers are never borrowed" />
                      <Button Content="Import parameters…" Click="OnFieldImport" ToolTip.Tip="caps-forcefield JSON, moltemplate .lt, AMBER frcmod or a GROMACS .itp/.top ([ *types ] sections); its rules are added over the force field" />
                      <Button Content="Enter manually (estimated)" Click="OnFieldAddRule" IsEnabled="{Binding Field.CanEnterRule}" />
                      <Button Content="Remove added" Click="OnFieldRemoveRules" IsVisible="{Binding Field.HasEntered}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Field.Entered}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="mono" FontSize="11" Foreground="{DynamicResource AccB}" TextWrapping="Wrap" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Field.EnergyText}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding Field.Complete}" />
                    <ItemsControl ItemsSource="{Binding Field.Notes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="dim" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>

          <!-- footer -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="0,6" Margin="-22,0" >
            <Grid ColumnDefinitions="*,Auto" Margin="22,0">
              <TextBlock Text="{Binding Field.FooterTyper}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Field.FooterDb}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar (lib.py statusbar): counts on the left, what the mouse does and the renderer on the right -->
    <Border Grid.Row="3" Classes="panel" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0" Padding="14,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusCounts}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
          <TextBlock Text="{Binding DisplayStatus}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
          <TextBlock Text="{Binding StatusSelection}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
          <TextBlock Text="{Binding StatusCell}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" IsVisible="{Binding HasDocument}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" VerticalAlignment="Center"
                   Margin="18,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <TextBlock Text="Mouse: pick · drag rotates · ⇧ drag pans" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
          <TextBlock Text="Double precision" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
          <TextBlock x:Name="RenderStat" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Command palette (design/boards/CommandPalette): ⌘K -->
    <Panel Grid.RowSpan="4" IsVisible="{Binding PaletteOpen}">
      <Border Background="#8C000000" PointerPressed="OnPaletteBackdrop" />
      <Border Width="680" Margin="0,64,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Bg1B}"
              BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="12" BoxShadow="0 18 48 0 #66000000" ClipToBounds="True">
        <DockPanel MaxHeight="560">
          <Border DockPanel.Dock="Top" Height="56" Padding="18,0,14,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <local:Icon Kind="search" Size="18" Foreground="{DynamicResource AccB}" VerticalAlignment="Center" />
              <TextBox x:Name="PaletteBox" Grid.Column="1" Text="{Binding PaletteQuery}" Classes="bare" FontSize="15" VerticalAlignment="Center"
                       Watermark="Run a command, open a document, or type a SMILES" KeyDown="OnPaletteKey" />
              <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="esc" Classes="mono" FontSize="11" Foreground="{DynamicResource DimB}" />
              </Border>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Height="38" Padding="16,0" BorderBrush="{DynamicResource LineB}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="↑ ↓ move" Classes="dim" />
                <TextBlock Text="↵ run" Classes="dim" />
                <TextBlock Text="esc close" Classes="dim" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PaletteHint}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteRows}" SelectedIndex="{Binding PaletteIndex}" Background="Transparent" Padding="8,6"
                   Tapped="OnPaletteTapped">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="CornerRadius" Value="6" /></Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg3B}" /></Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bg2B}" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteRow">
                <Panel>
                  <TextBlock Text="{Binding Title}" Classes="h3" FontSize="10.5" Margin="10,12,0,6" IsVisible="{Binding IsHeader}" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Height="44" Margin="10,0" IsVisible="{Binding IsCommand}">
                    <local:Icon Kind="{Binding Icon}" Size="16" Foreground="{DynamicResource MutedB}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Id}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource DimB}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource LineB}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            IsVisible="{Binding HasShortcut}">
                      <TextBlock Text="{Binding Shortcut}" Classes="mono" FontSize="11" Foreground="{DynamicResource MutedB}" />
                    </Border>
                  </Grid>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
    <!-- First-run tour (design/boards/FirstRunTour) -->
    <local:TourOverlay x:Name="Tour" Grid.RowSpan="4" ZIndex="40" IsVisible="{Binding TourOpen}" />
  </Grid>
  </LayoutTransformControl>
  </DockPanel>
</Window>
