{
 "format": "caps-typing",
 "version": 1,
 "forcefield": "ClayFF (Cygan 2004)",
 "unknown_types": "untyped",
 "bonds": "defined",
 "rules": [
  {
   "type": "st",
   "smarts": "[Si]",
   "priority": 0,
   "description": "tetrahedral silicon"
  },
  {
   "type": "ao",
   "smarts": "[Al]",
   "priority": 0,
   "description": "octahedral aluminium"
  },
  {
   "type": "at",
   "smarts": "[Al;X4]",
   "priority": 1,
   "description": "tetrahedral aluminium (four O)"
  },
  {
   "type": "mgo",
   "smarts": "[Mg;!X0]",
   "priority": 0,
   "description": "octahedral magnesium"
  },
  {
   "type": "mgh",
   "smarts": "[Mg;!X0;!$(*~[O;H0])]",
   "priority": 1,
   "description": "magnesium of a hydroxide (every O around it an OH)"
  },
  {
   "type": "Ca",
   "smarts": "[Ca]",
   "priority": 0,
   "description": "aqueous calcium ion (Ca holding no hydroxyl O: interlayer, in water)"
  },
  {
   "type": "cao",
   "smarts": "[Ca;$(*~[O;H1])]",
   "priority": 1,
   "description": "octahedral calcium (holds a hydroxyl O)"
