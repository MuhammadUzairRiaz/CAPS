  },
  {
   "type": "obss",
   "smarts": "[O;H0;$(*~[Al;X4]);$(*~[Mg,Fe,Li])]",
   "priority": 3,
   "description": "bridging oxygen next to a tetrahedral and an octahedral substitution"
