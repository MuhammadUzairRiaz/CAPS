  {
   "type": "obos",
   "smarts": "[O;H0;$(*~[Mg,Fe,Li]);$(*~[Si,Al])]",
   "priority": 2,
   "description": "bridging oxygen next to an octahedral substitution"
  },
  {
   "type": "obss",
   "smarts": "[O;H0;$(*(~[Mg,Fe,Li])~[Mg,Fe,Li]);$(*~[Si,Al])]",
