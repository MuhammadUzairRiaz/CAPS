   "priority": 0,
   "description": "octahedral lithium"
  },
  {
   "type": "Na",
   "smarts": "[Na]",
   "priority": 0,
   "description": "aqueous Na ion"
  },
  {
   "type": "K",
   "smarts": "[K]",
   "priority": 0,
   "description": "aqueous K ion"
  },
  {
   "type": "Cs",
   "smarts": "[Cs]",
   "priority": 0,
   "description": "aqueous Cs ion"
  },
  {
   "type": "Ba",
   "smarts": "[Ba]",
   "priority": 0,
   "description": "aqueous Ba ion"
  },
  {
   "type": "Cl",
   "smarts": "[Cl]",
   "priority": 0,
